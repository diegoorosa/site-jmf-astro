---

<section class="py-16 bg-[#dbeafe] overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-[#0f172a]">
        Saiba quem são os nossos parceiros,<br />
        <span class="text-[#1e40af]">que acreditam na nossa qualidade!</span>
      </h2>
    </div>
  </div>

  <div id="parceiros-viewport" class="relative max-w-3xl mx-auto overflow-hidden cursor-grab select-none">
    <div id="parceiros-track" class="flex items-center gap-12 w-max">
      {[0, 1].map(() => partners.map(p => (
        p.href
          ? <a href={p.href} target="_blank" rel="noopener" draggable="false" class="flex-shrink-0 flex items-center justify-center h-[120px]">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" draggable="false" class="h-[120px] w-auto max-w-[250px] object-contain opacity-70 hover:opacity-100 transition-opacity" />
            </a>
          : <div class="flex-shrink-0 flex items-center justify-center h-[120px]">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" draggable="false" class="h-[120px] w-auto max-w-[250px] object-contain opacity-70 hover:opacity-100 transition-opacity" />
            </div>
      )))}
    </div>

    <ProgressiveBlur direction="left" className="absolute inset-y-0 left-0 w-32 md:w-40 z-10" blurIntensity={1} />
    <ProgressiveBlur direction="right" className="absolute inset-y-0 right-0 w-32 md:w-40 z-10" blurIntensity={1} />
  </div>
</section>

<script>
  function initParceirosMarquee() {
    const viewport = document.getElementById('parceiros-viewport');
    const track = document.getElementById('parceiros-track');
    if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

    const SPEED = 0.04; // px/ms — calmo
    let trackWidth = track.scrollWidth / 2;
    new ResizeObserver(() => { trackWidth = track.scrollWidth / 2; }).observe(track);

    let pos = 0;
    let hovered = false;
    let dragging = false;
    let dragMoved = false;
    let startX = 0;
    let startPos = 0;
    let lastTime: number | null = null;

    const wrap = (p: number) => {
      if (trackWidth <= 0) return 0;
      p %= trackWidth;
      return p < 0 ? p + trackWidth : p;
    };

    function frame(time: number) {
      if (lastTime === null) lastTime = time;
      const dt = time - lastTime;
      lastTime = time;
      if (!hovered && !dragging) {
        pos = wrap(pos + SPEED * dt);
      }
      track.style.transform = `translateX(${-pos}px)`;
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    viewport.addEventListener('pointerenter', () => { hovered = true; });
    viewport.addEventListener('pointerleave', () => { hovered = false; dragging = false; });

    viewport.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragMoved = false;
      startX = e.clientX;
      startPos = pos;
      viewport.classList.add('cursor-grabbing');
      viewport.setPointerCapture(e.pointerId);
    });

    viewport.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) dragMoved = true;
      pos = wrap(startPos - dx);
    });

    function endDrag() {
      dragging = false;
      viewport.classList.remove('cursor-grabbing');
    }
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // Evita abrir o link do parceiro quando o usuário só estava arrastando
    viewport.addEventListener('click', (e) => {
      if (dragMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, { capture: true });
  }

  initParceirosMarquee();
</script>
