<style>
  :root { --jmf-nav-c: #06B6D4; }

  /* Nav base — transparente, vira blur+border no scroll */
  .jmf-nav {
    background: linear-gradient(180deg, rgba(15,23,42,0.94) 0%, rgba(2,6,23,0.88) 100%);
    backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid rgba(103,232,249,0.18);
    box-shadow: 0 10px 30px -16px rgba(2,6,23,0.55), 0 1px 0 rgba(103,232,249,0.08) inset;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .jmf-nav.is-scrolled {
    background: linear-gradient(180deg, rgba(15,23,42,0.97) 0%, rgba(2,6,23,0.95) 100%);
    backdrop-filter: saturate(180%) blur(22px);
    border-bottom-color: rgba(103,232,249,0.32);
    box-shadow: 0 12px 40px -16px rgba(2,6,23,0.7), 0 1px 0 rgba(103,232,249,0.14) inset;
  }

  /* Logo aura no hover — maior agora (4.5rem inline) */
  .jmf-logo { transition: filter 0.3s ease, transform 0.3s ease; }
  .jmf-logo:hover { filter: drop-shadow(0 0 14px rgba(103,232,249,0.65)); transform: scale(1.02); }

  /* Links nav — pill ciano + underline animado */
  .jmf-nav-link {
    position: relative;
    color: rgba(226,232,240,0.88);
    transition: color 0.25s ease, background 0.25s ease;
    border-radius: 10px;
  }
  /* Pill sutil de fundo no hover */
  .jmf-nav-link::before {
    content: '';
    position: absolute;
    inset: 4px 8px;
    border-radius: 8px;
    background: rgba(103,232,249,0.1);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  /* Underline gradiente embaixo */
  .jmf-nav-link::after {
    content: '';
    position: absolute;
    left: 16px; right: 16px; bottom: 2px;
    height: 2px;
    background: linear-gradient(90deg, #06B6D4, #67E8F9);
    transform: scaleX(0);
    transform-origin: center center;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(103,232,249,0.6);
  }
  .jmf-nav-link:hover { color: #fff; }
  .jmf-nav-link:hover::before { opacity: 1; transform: scale(1); }
  .jmf-nav-link:hover::after { transform: scaleX(1); }

  /* Dropdown toggle underline fixo mais discreto */
  .jmf-dd-btn { position: relative; }
  .jmf-dd-btn .chev { transition: transform 0.3s ease, color 0.25s ease; }
  .jmf-dd-btn[aria-expanded="true"] .chev { transform: rotate(180deg); color: #06B6D4; }

  /* Dropdown panel — glass dark nivel top */
  .jmf-dd {
    background: rgba(15,23,42,0.97);
    backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgba(103,232,249,0.22);
    box-shadow: 0 24px 60px -20px rgba(2,6,23,0.55), 0 0 0 1px rgba(103,232,249,0.08) inset;
    border-radius: 14px;
  }
  .jmf-dd::before {
    content: '';
    position: absolute;
    top: -1px; left: 20px;
    width: 60px; height: 2px;
    background: linear-gradient(90deg, transparent, #06B6D4, transparent);
    border-radius: 2px;
  }

  /* Item do dropdown — hover ciano elegante */
  .jmf-dd-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(226,232,240,0.82);
    transition: color 0.2s ease, background 0.2s ease, padding-left 0.2s ease;
    border-radius: 8px;
    position: relative;
  }
  .jmf-dd-item .ic {
    font-size: 0.85rem;
    color: rgba(103,232,249,0.55);
    width: 18px;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .jmf-dd-item:hover {
    background: linear-gradient(90deg, rgba(6,182,212,0.14), transparent);
    color: #fff;
    padding-left: 1.25rem;
  }
  .jmf-dd-item:hover .ic { color: #67E8F9; transform: translateX(2px); }

  /* CTA Área do Cliente — gradiente animado */
  .jmf-cta {
    position: relative;
    background: linear-gradient(120deg, #1e40af 0%, #0891b2 50%, #06B6D4 100%);
    background-size: 200% 100%;
    color: #fff;
    transition: background-position 0.5s ease, box-shadow 0.3s ease, transform 0.2s ease;
    box-shadow: 0 4px 14px -4px rgba(6,182,212,0.55);
  }
  .jmf-cta:hover {
    background-position: 100% 0;
    box-shadow: 0 6px 22px -4px rgba(6,182,212,0.7);
    transform: translateY(-1px);
  }
  .jmf-cta .ic { transition: transform 0.25s ease; }
  .jmf-cta:hover .ic { transform: translateX(2px); }

  /* Hamburger animado */
  .jmf-burger span {
    display: block;
    width: 24px; height: 2px;
    background: #0e7490;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.25s ease;
  }
  .jmf-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .jmf-burger.is-open span:nth-child(2) { opacity: 0; }
  .jmf-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile drawer */
  .jmf-drawer-overlay {
    position: fixed; inset: 0;
    background: rgba(2,6,23,0.5);
    backdrop-filter: blur(4px);
    z-index: 1099;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .jmf-drawer-overlay.is-open { opacity: 1; pointer-events: auto; }

  .jmf-drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 86%; max-width: 380px;
    background: rgba(15,23,42,0.98);
    backdrop-filter: blur(20px);
    border-left: 1px solid rgba(103,232,249,0.18);
    z-index: 1100;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
    overflow-y: auto;
  }
  .jmf-drawer.is-open { transform: translateX(0); }
  .jmf-drawer a {
    color: rgba(226,232,240,0.85);
    padding: 0.85rem 1.5rem;
    display: block;
    border-bottom: 1px solid rgba(148,163,184,0.08);
    transition: background 0.2s ease, color 0.2s ease, padding-left 0.2s ease;
  }
  .jmf-drawer a:hover { background: rgba(6,182,212,0.12); color: #67E8F9; padding-left: 1.75rem; }
  .jmf-drawer .dd-head { padding: 0.85rem 1.5rem; color: #67E8F9; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; }
</style>

