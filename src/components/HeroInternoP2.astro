---
/**
 * HeroInternoP2.astro — Hero interno no padrão P2 (igual ao index).
 * Eyebrinho com ponto pulsante + headline bicolor com gradiente animado + CTAs P2.
 */
import '../styles/index-2.css';

interface Props {
  eyebrow?: string;
  title: string;
  titleHi?: string;       // parte com gradiente animado (segunda linha)
  subtitle?: string;
  breadcrumb: { label: string; href?: string }[];
  ctas?: { label: string; href: string; variant: 'cta' | 'outline' | 'link' }[];
}

const { eyebrow, title, titleHi, subtitle, breadcrumb, ctas = [] } = Astro.props;
const siteOrigin = 'https://www.jmfcontabilidade.com.br';
const breadcrumbForSchema = breadcrumb.filter((item, index) => item.href || index === breadcrumb.length - 1);
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbForSchema.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.label,
    ...(item.href ? { "item": new URL(item.href, siteOrigin).href } : {})
  }))
});
---

<script type="application/ld+json" set:html={breadcrumbSchema} />
<section class="jmf-hero-p2 jmf-hero-int-p2">
  <svg class="jmf-hero-grid" preserveAspectRatio="none">
    <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
    <line x1="8%" y1="32%" x2="100%" y2="32%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
    <line x1="38%" y1="0" x2="38%" y2="68%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
    <line x1="38%" y1="68%" x2="100%" y2="68%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
    <line x1="76%" y1="0" x2="76%" y2="100%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
    <line x1="0" y1="86%" x2="100%" y2="86%" stroke="#67E8F9" stroke-width="1" opacity="0.25"/>
  </svg>

  <div class="jmf-container">
    <div class="jmf-hero-int-copy" data-reveal>

      <nav aria-label="breadcrumb" class="jmf-bc">
        <ol>
          {breadcrumb.map((item, i) => (
            <>
              {i > 0 && <li class="jmf-bc-sep">›</li>}
              <li>
                {item.href
                  ? <a href={item.href} class="jmf-bc-link">{item.label}</a>
                  : <span class="jmf-bc-current">{item.label}</span>
                }
              </li>
            </>
          ))}
        </ol>
      </nav>

      {eyebrow && <span class="jmf-eyebrow on-dark">{eyebrow}</span>}

      <h1 class="jmf-hero-p2-title jmf-hero-int-title">
        {title}{titleHi && <br/>}
        {titleHi && <span class="jmf-hero-p2-grad">{titleHi}</span>}
      </h1>

      {subtitle && <p class="jmf-hero-p2-lead">{subtitle}</p>}

      {ctas.length > 0 && (
        <div class="jmf-hero-p2-actions">
          {ctas.map(cta => (
            cta.variant === 'cta'
              ? <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined}
                   rel={cta.href.startsWith('http') ? 'noopener' : undefined}
                   class="jmf-p2-cbtn jmf-p2-cbtn-cyan jmf-ring" style="animation:jmfGlowPulse 3.5s ease-in-out infinite;">
                   {cta.label}
                   <i class="bi bi-arrow-right" style="font-size:0.9em;margin-left:0.35rem;"></i>
                 </a>
              : cta.variant === 'outline'
              ? <a href={cta.href} class="jmf-p2-cbtn jmf-p2-cbtn-ghost">{cta.label}</a>
              : <a href={cta.href} class="jmf-p2-cbtn jmf-p2-cbtn-link">{cta.label}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .jmf-hero-int-p2 { padding: 7rem 1.5rem 5rem; text-align: center; }
  .jmf-hero-int-copy { display: flex; flex-direction: column; align-items: center; max-width: 48rem; margin: 0 auto; }
  .jmf-bc { margin-bottom: 1.25rem; }
  .jmf-bc ol { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; font-size: 0.85rem; color: rgba(148,163,184,0.7); }
  .jmf-bc-sep { color: rgba(100,116,139,0.5); }
  .jmf-bc-link { color: rgba(148,163,184,0.8); }
  .jmf-bc-link:hover { color: var(--p2-cyan-l); }
  .jmf-bc-current { color: var(--p2-cyan-l); }
  .jmf-eyebrow.on-dark { margin-bottom: 1rem; }
  .jmf-hero-int-title { text-align: center; }
  .jmf-hero-int-copy .jmf-hero-p2-lead { text-align: center; margin-left: auto; margin-right: auto; }
  .jmf-hero-int-copy .jmf-hero-p2-actions { justify-content: center; }
  @media (max-width: 640px) {
    .jmf-hero-int-p2 { padding: 5rem 1.25rem 3.5rem; }
  }
</style>
