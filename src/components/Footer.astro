---
const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const ano = new Date().getFullYear();
---

<style>
  :root { --jmf-foot-c: #06B6D4; }

  /* Base — gradiente dark profundo igual Navbar */
  .jmf-foot {
    position: relative;
    background:
      radial-gradient(900px 500px at 88% 0%, rgba(6,182,212,0.10), transparent 60%),
      radial-gradient(900px 500px at 5% 100%, rgba(30,64,175,0.14), transparent 60%),
      linear-gradient(180deg, #0f172a 0%, #020617 100%);
    color: #e2e8f0;
    overflow: hidden;
  }
  /* Linha de brilho no topo */
  .jmf-foot::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(103,232,249,0.55), transparent);
    animation: jmfFootBeam 8s ease-in-out infinite;
  }
  @keyframes jmfFootBeam {
    0%, 100% { opacity: 0.4; transform: scaleX(0.85); }
    50% { opacity: 1; transform: scaleX(1); }
  }

  .jmf-foot-inner {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 3rem;
  }

  /* Top bar: logo + selo CRC + CTA WhatsApp */
  .jmf-foot-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(103,232,249,0.12);
  }
  @media (min-width: 768px) {
    .jmf-foot-top { grid-template-columns: auto 1fr auto; gap: 2.5rem; }
  }
  .jmf-foot-logo {
    transition: filter 0.3s ease, transform 0.3s ease;
  }
  .jmf-foot-logo:hover {
    filter: drop-shadow(0 0 16px rgba(103,232,249,0.55));
    transform: scale(1.02);
  }
  .jmf-foot-selo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'SF Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(103,232,249,0.85);
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(103,232,249,0.28);
    border-radius: 999px;
    background: rgba(6,182,212,0.07);
  }
  .jmf-foot-selo::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #06B6D4;
    box-shadow: 0 0 10px rgba(6,182,212,0.85);
    animation: jmfFootPulse 2.4s ease-in-out infinite;
  }
  @keyframes jmfFootPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.25); }
  }
  .jmf-foot-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.4rem;
    border-radius: 12px;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(120deg, #0891b2 0%, #06B6D4 50%, #3b82f6 100%);
    background-size: 200% auto;
    box-shadow: 0 8px 28px -10px rgba(6,182,212,0.55), 0 1px 0 rgba(255,255,255,0.12) inset;
    transition: background-position 0.5s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .jmf-foot-cta:hover {
    background-position: right center;
    transform: translateY(-2px);
    box-shadow: 0 14px 38px -10px rgba(6,182,212,0.7), 0 1px 0 rgba(255,255,255,0.18) inset;
  }
  .jmf-foot-cta i { font-size: 1.15rem; }

  /* Grid principal de colunas */
  .jmf-foot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .jmf-foot-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .jmf-foot-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 3rem; }
  }

  /* Coluna de marca/contato */
  .jmf-foot-col-main p {
    color: rgba(203,213,225,0.72);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
    max-width: 22rem;
  }
  .jmf-foot-contact {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 1.4rem;
  }
  .jmf-foot-contact a, .jmf-foot-contact span {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: rgba(226,232,240,0.78);
    font-size: 0.88rem;
    line-height: 1.5;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .jmf-foot-contact a:hover {
    color: #67e8f9;
    transform: translateX(2px);
  }
  .jmf-foot-contact i {
    color: #06B6D4;
    font-size: 1rem;
    width: 1.3rem;
    flex-shrink: 0;
    text-align: center;
    margin-top: 0.1rem;
  }

  /* Social row */
  .jmf-foot-social {
    display: flex;
    gap: 0.6rem;
  }
  .jmf-foot-social a {
    width: 2.4rem; height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(103,232,249,0.12);
    color: rgba(226,232,240,0.82);
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .jmf-foot-social a:hover {
    color: #67e8f9;
    background: rgba(6,182,212,0.14);
    border-color: rgba(103,232,249,0.5);
    transform: translateY(-3px);
    box-shadow: 0 10px 22px -10px rgba(6,182,212,0.6);
  }

  /* Mapa */
  .jmf-foot-map {
    margin-top: 1.4rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(103,232,249,0.18);
    box-shadow: 0 14px 40px -16px rgba(2,6,23,0.6);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .jmf-foot-map:hover {
    border-color: rgba(103,232,249,0.4);
  }
  .jmf-foot-map iframe {
    display: block;
    filter: grayscale(0.25) brightness(0.85) saturate(0.85);
    transition: filter 0.4s ease;
  }
  .jmf-foot-map:hover iframe {
    filter: grayscale(0) brightness(1) saturate(1);
  }

  /* Colunas de links */
  .jmf-foot-col h5 {
    font-family: 'SF Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(103,232,249,0.85);
    margin-bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .jmf-foot-col h5::before {
    content: '';
    width: 14px;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(103,232,249,0), #06B6D4);
  }
  .jmf-foot-col ul {
    list-style: none;
    padding: 0; margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .jmf-foot-col ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(226,232,240,0.74);
    font-size: 0.88rem;
    line-height: 1.5;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .jmf-foot-col ul a::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(103,232,249,0.4);
    flex-shrink: 0;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .jmf-foot-col ul a:hover {
    color: #fff;
    transform: translateX(4px);
  }
  .jmf-foot-col ul a:hover::before {
    background: #06B6D4;
    box-shadow: 0 0 8px rgba(6,182,212,0.6);
    transform: scale(1.3);
  }

  /* Reveal stagger on scroll */
  .jmf-foot-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .jmf-foot.is-visible .jmf-foot-reveal {
    opacity: 1;
    transform: translateY(0);
  }
  .jmf-foot.is-visible .jmf-foot-reveal[data-d='1'] { transition-delay: 0.1s; }
  .jmf-foot.is-visible .jmf-foot-reveal[data-d='2'] { transition-delay: 0.2s; }
  .jmf-foot.is-visible .jmf-foot-reveal[data-d='3'] { transition-delay: 0.3s; }
  .jmf-foot.is-visible .jmf-foot-reveal[data-d='4'] { transition-delay: 0.4s; }

  /* Bottom bar — copyright + privacidade */
  .jmf-foot-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid rgba(103,232,249,0.12);
    color: rgba(148,163,184,0.7);
    font-size: 0.8rem;
  }
  .jmf-foot-bottom a {
    color: rgba(148,163,184,0.7);
    transition: color 0.25s ease;
  }
  .jmf-foot-bottom a:hover { color: #67e8f9; }
  .jmf-foot-bottom .jmf-foot-crc {
    font-family: 'SF Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: rgba(103,232,249,0.8);
  }
  .jmf-foot-bottom .jmf-foot-divider {
    display: none;
    color: rgba(103,232,249,0.28);
  }
  @media (min-width: 640px) {
    .jmf-foot-bottom {
      flex-direction: row;
      gap: 1rem;
    }
    .jmf-foot-bottom .jmf-foot-divider { display: inline; }
  }
</style>

