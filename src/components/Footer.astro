<script>
  // Reveal stagger on scroll
  (function () {
    const foot = document.getElementById('jmf-foot');
    if (!foot) return;
    if (typeof IntersectionObserver === 'undefined') {
      foot.classList.add('is-visible');
      return;
    }
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          foot.classList.add('is-visible');
          obs.disconnect();
        }
      });
    }, { threshold: 0.18 });
    obs.observe(foot);
  })();
</script>
