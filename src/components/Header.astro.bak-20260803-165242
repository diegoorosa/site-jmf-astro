---
const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
---

<nav
  class="bg-white shadow-sm sticky top-0 z-[1030] py-2"
  x-data="{ open: false }"
>
  <div class="container mx-auto px-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="https://www.jmfcontabilidade.com.br" aria-label="JMF Contabilidade Blumenau">
      <img
        src="/assets/images/jmf-contabilidade-jean-254x159.webp"
        alt="JMF Contabilidade"
        width="254" height="159"
        style="height:4.5rem;width:auto;"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Mobile hamburger -->
    <button
      @click="open = !open"
      class="lg:hidden flex flex-col gap-[5px] p-2 border border-[#1e40af] rounded"
      aria-label="Abrir menu"
      :aria-expanded="open"
    >
      <span class="block w-6 h-0.5 bg-[#1e40af]"></span>
      <span class="block w-6 h-0.5 bg-[#1e40af]"></span>
      <span class="block w-6 h-0.5 bg-[#1e40af]"></span>
    </button>

    <!-- Nav links -->
    <div
      :class="open ? 'flex' : 'hidden lg:flex'"
      class="absolute lg:static top-full left-0 right-0 bg-white lg:bg-transparent
