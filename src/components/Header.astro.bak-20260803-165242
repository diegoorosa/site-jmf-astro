        INÍCIO
      </a>

      <a href="/sobre"
         class="block lg:inline-block px-4 py-2 text-sm font-semibold text-[#0f172a] hover:text-[#1e40af] tracking-wide">
        SOBRE
      </a>

      <a href="/blog"
         class="block lg:inline-block px-4 py-2 text-sm font-semibold text-[#0f172a] hover:text-[#1e40af] tracking-wide">
        BLOG
      </a>

      <!-- Dropdown Ferramentas -->
      <div class="relative w-full lg:w-auto" x-data="{ show: false }" @mouseleave.window="show = false">
        <button
          @click="show = !show"
          class="flex items-center gap-1 px-4 py-2 text-sm font-semibold text-[#0f172a] hover:text-[#1e40af] tracking-wide w-full lg:w-auto"
        >
          FERRAMENTAS
          <i class="bi bi-chevron-down text-xs transition-transform" :class="show ? 'rotate-180' : ''"></i>
        </button>
        <ul
          x-show="show"
          @click.outside="show = false"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="lg:absolute bg-white shadow-xl rounded-lg py-2 mt-1 min-w-[260px] z-50"
          style="display:none"
        >
          <li><a href="/calculadora-fator-r" class="block px-6 py-3 text-sm text-[#334155] hover:bg-[#dbeafe] hover:text-[#1e40af]">Calculadora do Fator R</a></li>
          <li><a href="/simulador-regime-tributario" class="block px-6 py-3 text-sm text-[#334155] hover:bg-[#dbeafe] hover:text-[#1e40af]">Simulador de Regime Tributário</a></li>
