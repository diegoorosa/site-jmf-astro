    /* Beam — barra vertical que percorre periodicamente por cima das barras */
    .jmf-hd-beam {
      position: absolute;
      top: 0;
      bottom: 0;
      left: -8%;
      width: 2px;
      background: linear-gradient(180deg, transparent, #67E8F9, transparent);
      box-shadow: 0 0 8px rgba(103,232,249,0.85);
      opacity: 0.85;
      animation: jmfHdBeam 5s ease-in-out infinite;
      pointer-events: none;
      z-index: 1;
    }
    @keyframes jmfHdBeam {
      0%   { left: -8%; opacity: 0; }
      10%  { opacity: 0.85; }
      90%  { opacity: 0.85; }
      100% { left: 100%; opacity: 0; }
    }
    .jmf-hd-bar {
      flex: 1;
      background: linear-gradient(180deg, rgba(103,232,249,0.85), rgba(6,182,212,0.4));
      border-radius: 2px 2px 0 0;
      height: var(--h, 50%);
