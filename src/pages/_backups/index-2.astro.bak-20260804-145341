    .jmf-hd-line {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .jmf-hd-line-path {
      fill: none;
      stroke: #67E8F9;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      filter: drop-shadow(0 0 5px rgba(103,232,249,0.7));
      stroke-dasharray: 700;
      stroke-dashoffset: 700;
      animation: jmfHdLineDraw 3s ease-out 0.4s forwards;
    }
    @keyframes jmfHdLineDraw { to { stroke-dashoffset: 0; } }
    .jmf-hd-line-dot {
      fill: #67E8F9;
      filter: drop-shadow(0 0 8px rgba(103,232,249,0.95));
      animation: jmfPulse 1.6s infinite;
