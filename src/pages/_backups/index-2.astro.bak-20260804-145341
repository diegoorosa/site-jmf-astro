    .jmf-hd-log .dot.wait { background: #facc15; box-shadow: 0 0 8px rgba(250,204,21,0.85); animation: jmfPulse 1.4s infinite; }
    .jmf-hd-log .dot.info { background: #67E8F9; box-shadow: 0 0 8px rgba(103,232,249,0.85); }
    /* Ticker discreto (credenciais Blumenau/região) */
    .jmf-hero-ticker {
      position: relative;
      z-index: 1;
      margin-top: 3rem;
      padding: 0.7rem 0;
