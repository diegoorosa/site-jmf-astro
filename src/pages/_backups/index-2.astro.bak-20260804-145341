    .jmf-hd-bar:nth-child(3n) { animation-delay: 0.8s; }
    @keyframes jmfBarBreathe {
      0%, 100% { opacity: 0.7; transform: scaleY(0.95); }
      50% { opacity: 1; transform: scaleY(1); }
