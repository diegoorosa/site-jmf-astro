---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Fale Conosco — JMF Contabilidade",
  "url": "https://www.jmfcontabilidade.com.br/fale-conosco",
  "mainEntity": {
    "@id": "https://www.jmfcontabilidade.com.br/#organization"
  }
});
---

<Layout
  title="Fale Conosco | JMF Contabilidade Blumenau | (47) 3326-5123"
  description="Fale com a JMF Contabilidade em Blumenau/SC pelo WhatsApp, telefone (47) 3326-5123 ou formulário. Diagnóstico gratuito e resposta no mesmo dia útil."
  canonical="https://www.jmfcontabilidade.com.br/fale-conosco"
  ogUrl="https://www.jmfcontabilidade.com.br/fale-conosco"
  schema={schema}
  heroInterno
>

  <HeroInterno
    title="Fale Conosco"
    subtitle="Entrar em contato conosco é fácil e ágil! Use as nossas informações de contato para falar conosco ainda hoje."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Fale Conosco" }
    ]}
    ctas={[
      { label: "WhatsApp Agora", href: WA, variant: "cta" },
      { label: "Ir ao Formulário", href: "#formulario", variant: "outline" }
    ]}
  />

  <!-- Informações de Contato + Mapa -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">

        <!-- Informações -->
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">Nossas informações</h2>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#dbeafe] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-geo-alt text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">Endereço</h5>
              <a href="https://maps.app.goo.gl/MeVSo9QPre838yoHA" target="_blank" rel="noopener noreferrer"
                class="text-[#1e40af] hover:text-[#1e3a8a] leading-relaxed">
                Rua Rodolfo Freygang, 15, Sala 506<br />
                Edifício Itaçú, Centro<br />
                Blumenau/SC — CEP: 89010-060
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#dbeafe] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-telephone text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">Telefone</h5>
              <a href="tel:+554733265123" class="text-[#1e40af] hover:text-[#1e3a8a] text-lg font-semibold">(47) 3326-5123</a>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#dbeafe] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">WhatsApp</h5>
              <a href={WA} target="_blank" rel="noopener noreferrer"
                class="text-[#1e40af] hover:text-[#1e3a8a] text-lg font-semibold">(47) 3326-5123</a>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#dbeafe] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">E-mail</h5>
              <a href="mailto:contato@jmfcontabilidade.com.br"
                class="text-[#1e40af] hover:text-[#1e3a8a] text-lg font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-[#dbeafe] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-clock text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">Horário de Atendimento</h5>
              <p class="text-gray-600">Segunda a Sexta: 08:00 – 18:00</p>
            </div>
          </div>
        </div>

        <!-- Mapa -->
        <div class="lg:w-1/2">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3557.4748768090267!2d-49.06704552461313!3d-26.92015599351466!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94df18c1c9a5ab59%3A0x813a374a25373e0b!2sJMF%20Contabilidade%20-%20Escrit%C3%B3rio%20de%20Contabilidade!5e0!3m2!1spt-BR!2sbr!4v1781225059891!5m2!1spt-BR!2sbr"
            width="100%" height="450"
            style="border:0;border-radius:12px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localização JMF Contabilidade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Não perca tempo, fale com a gente agora mesmo!</h2>
          <p class="text-gray-600 text-lg">Preencha o formulário abaixo e entraremos em contato o mais breve possível.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <ContactForm phoneName="phone" phoneLabel="Telefone / WhatsApp" phoneRequired={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- Redes Sociais -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 text-center">
      <h3 class="text-2xl font-bold text-[#0f172a] mb-3">Nos siga nas redes sociais!</h3>
      <p class="text-gray-600 mb-8 text-lg">Fique por dentro das novidades e dicas sobre contabilidade.</p>
      <div class="flex justify-center gap-4">
        <a href="https://www.facebook.com/jmfcontabilidadebnu/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
           class="w-14 h-14 rounded-full bg-[#dbeafe] flex items-center justify-center hover:bg-[#1e40af] hover:text-white text-[#1e40af] transition-all text-2xl">
          <i class="bi bi-facebook"></i>
        </a>
        <a href="https://twitter.com/jmfcontab" target="_blank" rel="noopener noreferrer" aria-label="Twitter"
           class="w-14 h-14 rounded-full bg-[#dbeafe] flex items-center justify-center hover:bg-[#1e40af] hover:text-white text-[#1e40af] transition-all text-2xl">
          <i class="bi bi-twitter"></i>
        </a>
        <a href="https://www.instagram.com/jmf.contabilidade/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
           class="w-14 h-14 rounded-full bg-[#dbeafe] flex items-center justify-center hover:bg-[#1e40af] hover:text-white text-[#1e40af] transition-all text-2xl">
          <i class="bi bi-instagram"></i>
        </a>
        <a href="https://www.linkedin.com/company/jmf-contabilidade/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
           class="w-14 h-14 rounded-full bg-[#dbeafe] flex items-center justify-center hover:bg-[#1e40af] hover:text-white text-[#1e40af] transition-all text-2xl">
          <i class="bi bi-linkedin"></i>
        </a>
      </div>
    </div>
  </section>

</Layout>
