---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Imposto de Renda Pessoa Física",
  "provider": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
  "areaServed": [{ "@type": "City", "name": "Blumenau" },{ "@type": "City", "name": "Indaial" },{ "@type": "City", "name": "Gaspar" },{ "@type": "City", "name": "Pomerode" },{ "@type": "City", "name": "Timbó" },{ "@type": "State", "name": "Santa Catarina" }]
});
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Em que época se faz a declaração de Imposto de Renda?", "acceptedAnswer": { "@type": "Answer", "text": "A declaração do IRPF 2026 (ano-calendário 2025) teve prazo entre 23 de março e 29 de maio de 2026. Quem não declarou está sujeito a multa de 1% ao mês sobre o imposto devido, mínimo R$ 165,74 e máximo 20%. A JMF ajuda a regularizar a situação o quanto antes." } },
    { "@type": "Question", "name": "O que eu devo declarar no Imposto de Renda?", "acceptedAnswer": { "@type": "Answer", "text": "Todos os rendimentos tributáveis (salários, honorários, aluguéis, pró-labore) e isentos (FGTS em rescisão, lucros e dividendos). Bens e direitos acima de R$ 300: imóveis, veículos, aplicações financeiras, contas bancárias. Deduções: despesas médicas sem limite, educação até R$ 3.561,50, INSS, pensão judicial e PGBL." } },
    { "@type": "Question", "name": "Qual a vantagem de fazer a declaração com o contador?", "acceptedAnswer": { "@type": "Answer", "text": "Maximização das deduções legais (diferença entre R$ 2.000 e R$ 6.000 de restituição), proteção contra malha fina e segurança jurídica. A Receita Federal tem até 5 anos para autuar erros (Lei 9.430/96). Com a JMF, especialista disponível para responder intimações durante esse período." } },
    { "@type": "Question", "name": "Como posso ter o auxílio da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123, atendimento no mesmo dia útil. Envio de documentos por e-mail ou WhatsApp. Presencial: Rua Rodolfo Freygang, 15, Sala 506, Centro, Blumenau, segunda a sexta 08h às 18h. Revisão de declarações de anos anteriores (prazo prescricional de 5 anos)." } },
    { "@type": "Question", "name": "Fazem declaração de IRPF para quem mora em Indaial, Gaspar, Pomerode ou Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade declara o Imposto de Renda para clientes de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com envio de documentos por e-mail ou WhatsApp e atendimento por videoconferência quando necessário." } }
  ]
});
const schema = [serviceSchema, faqSchema];
---

<Layout
  title="Perdeu o Prazo do IRPF 2026? Declare em Atraso em Blumenau | JMF"
  description="O prazo da declaração de IRPF 2026 (ano-base 2025) encerrou em 29/05. Quem não declarou está sujeito a multa e precisa regularizar. A JMF Contabilidade em Blumenau/S"
  canonical="https://www.jmfcontabilidade.com.br/imposto-de-renda"
  ogUrl="https://www.jmfcontabilidade.com.br/imposto-de-renda"
  schema={schema}
  heroInterno
>

  <HeroInterno
    title="Declarou em Atraso o Imposto de Renda? A JMF Regulariza Sua Situação em Blumenau"
    subtitle="O prazo da declaração 2026 (ano-base 2025) encerrou em 29 de maio. Quem ainda não declarou já está sujeito a multa — mas quanto antes regularizar, menor o valor a pagar. Fale com quem entende do assunto."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Imposto de Renda" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver como funciona", href: "#vantagens", variant: "outline" },
      { label: "Prefiro formulário", href: "#formulario", variant: "link" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: junho de 2026</span>
    </div>
  </div>

  <!-- Alerta de prazo encerrado -->
  <div class="bg-amber-50 border-b border-amber-200">
    <div class="container mx-auto px-4 py-4">
      <p class="text-amber-800 text-sm md:text-base font-semibold flex items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill text-amber-600"></i>
        O prazo de entrega da declaração de IRPF 2026 (referente a 2025) encerrou em 29/05/2026. Quem ainda não declarou já está sujeito a multa — regularize o quanto antes para não pagar mais.
      </p>
    </div>
  </div>

  <!-- Fuja da Malha Fina -->
  <section id="vantagens" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Perdeu o prazo? Ainda dá tempo de regularizar</h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            O prazo da declaração de Imposto de Renda 2026 (ano-base 2025) terminou em 29 de maio. Quem não entregou está sujeito a multa de no mínimo R$ 165,74, que aumenta 1% ao mês de atraso até o limite de 20% do imposto devido — por isso, quanto antes declarar, menor o valor pago.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Converse agora com um dos nossos profissionais e regularize sua situação com segurança.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x610.webp" alt="Imposto de Renda JMF"
            width="1036" height="610" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Quem precisa declarar -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Quem era obrigado a declarar o Imposto de Renda em 2026?</h2>
        <p class="text-gray-500 text-lg">Confira os critérios da Receita Federal para o ano-calendário 2025 (declaração com entrega encerrada em 29/05/2026). Se você se encaixa em algum desses critérios e ainda não declarou, regularize agora.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <div class="bg-[#f0f7ff] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-cash-coin text-[#1e40af] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Rendimentos tributáveis acima do limite</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Quem recebeu rendimentos tributáveis acima de <strong>R$ 35.584,00</strong> em 2025 é obrigado a declarar.</p>
        </div>
        <div class="bg-[#fff7ed] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-graph-up-arrow text-[#c2410c] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Rendimentos isentos ou não tributáveis</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Rendimentos isentos, não tributáveis ou de tributação exclusiva acima de <strong>R$ 200.000,00</strong> em 2025.</p>
        </div>
        <div class="bg-[#f0fdf4] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-house text-[#15803d] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Bens e Direitos</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Possuía bens ou direitos, incluindo terra nua, de valor total superior a <strong>R$ 800.000,00</strong> em 31/12/2025.</p>
        </div>
        <div class="bg-[#fdf2f8] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-bar-chart text-[#7c3aed] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Operações em Bolsa de Valores</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Realizou operações na bolsa de valores com soma de alienações superior a <strong>R$ 40.000,00</strong>, ou apurou qualquer ganho líquido sujeito ao imposto.</p>
        </div>
        <div class="bg-[#fff7ed] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-tractor text-[#c2410c] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Atividade Rural</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Obteve receita bruta de atividade rural em valor superior a <strong>R$ 177.920,00</strong> ou pretende compensar prejuízos de anos anteriores.</p>
        </div>
        <div class="bg-[#f0f7ff] rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <i class="bi bi-building text-[#1e40af] text-2xl"></i>
            <h3 class="font-bold text-[#0f172a]">Ganho de Capital ou Isenção de IR</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">Obteve ganho de capital na alienação de bens ou direitos sujeitos à incidência do imposto, ou usufruiu de isenção de IR.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Documentos necessários -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Confira quais são os documentos exigidos para declarar o IRPF!</h2>

          <div class="mb-6">
            <h5 class="font-bold text-[#1e40af] mb-3">DADOS PESSOAIS:</h5>
            <ul class="text-gray-600 space-y-1 text-sm leading-relaxed">
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>CPF, RG, título de eleitor e certidão de nascimento</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Nome, CPF e data de nascimento de dependentes, cônjuge e alimentandos</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Endereço atualizado e dados da conta bancária para restituição</li>
            </ul>
          </div>

          <div class="mb-6">
            <h5 class="font-bold text-[#1e40af] mb-3">RENDIMENTOS:</h5>
            <ul class="text-gray-600 space-y-1 text-sm leading-relaxed">
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Informes de rendimentos de salários, aposentadoria, pensão, aluguéis</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Informes de rendimentos de contas bancárias, investimentos e aplicações</li>
            </ul>
          </div>

          <div class="mb-6">
            <h5 class="font-bold text-[#1e40af] mb-3">BENS E DIREITOS:</h5>
            <ul class="text-gray-600 space-y-1 text-sm leading-relaxed">
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Documentos que comprovem a compra e venda de bens e direitos em 2025</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Cópia da matrícula do imóvel e/ou escritura de compra e venda e boleto do IPTU</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Número do Renavam e/ou registro de veículos, aeronaves e embarcações</li>
            </ul>
          </div>

          <div>
            <h5 class="font-bold text-[#1e40af] mb-3">DESPESAS DEDUTÍVEIS:</h5>
            <ul class="text-gray-600 space-y-1 text-sm leading-relaxed">
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Recibos ou informes de rendimentos de plano ou seguro de saúde</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Recibos e notas fiscais de despesas médicas, odontológicas e de ensino</li>
              <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Informe da Previdência Privada</li>
            </ul>
          </div>

          <div class="flex flex-wrap gap-3 mt-6">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-1/2">
          <img src="/assets/images/mbr-5-1036x691.webp" alt="Documentos Imposto de Renda"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Declaração IRPF em Blumenau -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Declaração do Imposto de Renda em Blumenau: como a JMF pode ajudar você</h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-5">
          Blumenau concentra um perfil de contribuinte diversificado: médicos, engenheiros, advogados e profissionais de TI que atuam como autônomos ou sócios de empresas, além de industriais e comerciantes com rendimentos de múltiplas fontes. Cada perfil tem particularidades importantes na hora de declarar o IRPF — e é justamente nessas particularidades que erros acontecem.
        </p>
        <p class="text-gray-600 text-lg leading-relaxed mb-5">
          A JMF Contabilidade atende pessoas físicas em Blumenau há mais de 35 anos. Nosso processo é simples: você envia os documentos por WhatsApp ou e-mail, nossa equipe monta a declaração completa com análise comparativa entre o modelo completo e simplificado, e você aprova antes de qualquer envio à Receita Federal.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-6">
          <div class="bg-[#dbeafe] rounded-xl p-5 text-center">
            <i class="bi bi-search text-[#1e40af] text-3xl mb-3 block"></i>
            <h3 class="font-bold text-[#0f172a] mb-2">Análise de malha fina</h3>
            <p class="text-gray-600 text-sm">Verificamos cruzamentos com informes de bancos, empregadores e planos de saúde antes de enviar.</p>
          </div>
          <div class="bg-[#dbeafe] rounded-xl p-5 text-center">
            <i class="bi bi-cash-coin text-[#1e40af] text-3xl mb-3 block"></i>
            <h3 class="font-bold text-[#0f172a] mb-2">Máxima restituição</h3>
            <p class="text-gray-600 text-sm">Identificamos todas as deduções legais: médicas sem limite, educação, dependentes, PGBL e livro-caixa.</p>
          </div>
          <div class="bg-[#dbeafe] rounded-xl p-5 text-center">
            <i class="bi bi-arrow-repeat text-[#1e40af] text-3xl mb-3 block"></i>
            <h3 class="font-bold text-[#0f172a] mb-2">Retificação até 5 anos</h3>
            <p class="text-gray-600 text-sm">Revisamos declarações dos últimos 5 anos. Muitos clientes recuperam valores pagos indevidamente.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Esqueça-se dos trâmites burocráticos que envolvem a sua empresa!</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Facilite agora a sua administração com uma contabilidade especializada no seu empreendimento e alcance de forma rápida o triunfo empresarial que você aspira. Estamos aqui para te auxiliar!
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>AGENDE UMA REUNIÃO
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="text-[#1e40af]">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Em que época se faz a declaração de Imposto de Renda?</summary>
              <div class="accordion-body">
                <p>A declaração do IRPF 2026, relativa ao ano-calendário 2025, teve prazo de entrega entre 23 de março e 29 de maio de 2026, conforme divulgado pela Receita Federal — esse prazo já encerrou. Quem não declarou está sujeito a multa de 1% ao mês sobre o imposto devido, com valor mínimo de R$ 165,74 e máximo de 20%, e a situação fica irregular junto à Receita até a regularização. Era obrigatória para quem recebeu rendimentos tributáveis acima de R$ 35.584,00 em 2025, teve rendimentos isentos acima de R$ 200 mil, possuía bens acima de R$ 800 mil em 31/12/2025, realizou operações em bolsa de valores ou exerceu atividade rural. A JMF ajuda quem ainda não declarou a regularizar a situação o quanto antes, identificando todas as deduções legais disponíveis para reduzir o imposto devido e a multa.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que eu devo declarar no Imposto de Renda?</summary>
              <div class="accordion-body">
                <p>Devem ser informados todos os rendimentos tributáveis recebidos — salários, honorários, aluguéis, pró-labore, pensão alimentícia recebida. Também os rendimentos isentos: FGTS em rescisão sem justa causa, lucros e dividendos, indenizações. Além dos rendimentos, é obrigatório declarar todos os bens e direitos com valor acima de R$ 300 na data de aquisição: imóveis, veículos, aplicações financeiras, participações societárias e contas bancárias. Para reduzir o imposto, é possível deduzir despesas médicas sem limite, educação até R$ 3.561,50 por dependente, INSS, pensão judicial e PGBL. A JMF identifica todas as deduções cabíveis na sua situação específica.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Qual a vantagem de fazer a declaração com o contador?</summary>
              <div class="accordion-body">
                <p>A principal vantagem é a maximização das deduções legais: muitos contribuintes perdem restituições expressivas por não lançar corretamente despesas médicas, educação, dependentes, PGBL e INSS. Um erro de classificação incorreta pode ser a diferença entre receber R$ 2.000 ou R$ 6.000 de restituição. A segunda vantagem é a proteção contra malha fina: a Receita Federal cruza informações de centenas de fontes. A terceira é a segurança jurídica: conforme a Lei 9.430/96, a Receita Federal tem até 5 anos para autuar erros na declaração. Com a JMF, você tem um especialista disponível para responder qualquer intimação durante esse período.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como eu posso ter o auxílio da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>Contratar a JMF para a declaração de IRPF em Blumenau é simples e pode ser feito de forma totalmente digital. Pelo WhatsApp (47) 3326-5123 nossa equipe agenda o atendimento no mesmo dia útil. Você pode enviar seus documentos — informes de rendimentos, recibos médicos, comprovantes de educação, extratos bancários — por e-mail ou WhatsApp. Para quem prefere o atendimento presencial, estamos na Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro, Blumenau, de segunda a sexta das 08h às 18h. Também revisamos declarações de anos anteriores: o prazo prescricional para retificação é de 5 anos.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Fazem declaração de IRPF para quem mora em Indaial, Gaspar, Pomerode ou Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade declara o Imposto de Renda para clientes de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com envio de documentos por e-mail ou WhatsApp e atendimento por videoconferência quando necessário.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/blog/irpf-2026-como-declarar-imposto-de-renda"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
