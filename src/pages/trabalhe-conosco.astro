---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20e%20quero%20enviar%20meu%20curr%C3%ADculo.";
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Trabalhe Conosco — JMF Contabilidade",
  "url": "https://www.jmfcontabilidade.com.br/trabalhe-conosco",
  "description": "Página para envio espontâneo de currículo para a JMF Contabilidade em Blumenau/SC. Sem vaga ativa no momento — currículos recebidos ficam disponíveis para contato em caso de futuras oportunidades.",
  "isPartOf": { "@id": "https://www.jmfcontabilidade.com.br/#website" },
  "about": { "@id": "https://www.jmfcontabilidade.com.br/#organization" }
});
---

<Layout
  title="Trabalhe Conosco | JMF Contabilidade Blumenau/SC"
  description="Envie seu currículo para a JMF Contabilidade em Blumenau/SC. Cultura colaborativa, tecnologia e crescimento real."
  canonical="https://www.jmfcontabilidade.com.br/trabalhe-conosco"
  ogUrl="https://www.jmfcontabilidade.com.br/trabalhe-conosco"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Trabalhe Conosco"
    subtitle="Faça parte de uma equipe que une tecnologia, expertise..."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Trabalhe Conosco" }
    ]}
    ctas={[
      { label: "Enviar Currículo", href: WA, variant: "cta" },
      { label: "Ver oportunidades", href: "#beneficios", variant: "outline" }
    ]}
  />

  <!-- Por que trabalhar conosco -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Por que trabalhar na<br/><span class="pp3-grad">JMF Contabilidade?</span></h2>
        <p class="text-gray-600 text-lg">Somos um escritório moderno, com tecnologia de ponta e um time que valoriza cada profissional</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-lightbulb"></i></div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-3">Ambiente Inovador</h4>
          <p class="text-gray-600">Trabalhamos com as tecnologias mais modernas do mercado, incluindo automação, IA e ferramentas cloud.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-graph-up-arrow"></i></div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-3">Crescimento Profissional</h4>
          <p class="text-gray-600">Investimos no desenvolvimento da nossa equipe com treinamentos, cursos e certificações.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-people-fill"></i></div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-3">Equipe Colaborativa</h4>
          <p class="text-gray-600">Cultura de respeito, transparência e trabalho em equipe. Valorizamos cada membro do time.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-award"></i></div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-3">Mais de 35 Anos</h4>
          <p class="text-gray-600">Uma empresa sólida, com mais de 35 anos no mercado, que combina experiência com modernidade.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulário e Contato -->
  <section id="beneficios" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">

        <!-- Coluna Esquerda - Informações -->
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Faça um contato<br/><span class="pp3-grad">com a gente</span></h2>
          <p class="text-gray-600 text-lg mb-6">
            Envie seu currículo via WhatsApp ou email, ou preencha o formulário ao lado que retornaremos o mais breve possível.
          </p>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white text-lg"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">WhatsApp</h5>
              <a href={WA} target="_blank" rel="noopener noreferrer" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
              <p class="text-gray-500 text-sm mt-1">Envie seu currículo diretamente pelo WhatsApp</p>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white text-lg"></i>
            </div>
            <div>
              <h5 class="font-semibold text-[#0f172a] mb-1">E-mail</h5>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
              <p class="text-gray-500 text-sm mt-1">Ou envie seu currículo por email</p>
            </div>
          </div>

          <div class="bg-white rounded-xl p-5">
            <h5 class="font-semibold text-[#0f172a] mb-2">
              <i class="bi bi-info-circle text-[#1e40af] mr-2"></i>Dica Importante
            </h5>
            <p class="text-gray-600 text-sm">
              No assunto do email ou mensagem, coloque: <strong>"Currículo - [Sua Área de Interesse]"</strong><br />
              Exemplo: "Currículo - Auxiliar Contábil"
            </p>
          </div>
        </div>

        <!-- Coluna Direita - Formulário -->
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <h3 class="text-xl font-bold text-[#0f172a] mb-6">Ou preencha o formulário abaixo</h3>
            <form
              action="https://formspree.io/f/xldnlbpk"
              method="POST"
              x-data="{ sent: false, error: false, loading: false }"
              @submit.prevent="
                loading = true;
                fetch($el.action, { method: 'POST', body: new FormData($el), headers: { Accept: 'application/json' } })
                  .then(r => { if (r.ok) { sent = true; $el.reset(); } else { error = true; } })
                  .catch(() => { error = true; })
                  .finally(() => { loading = false; });
              "
            >
              <div x-show="sent" x-transition class="mb-4 p-4 bg-green-100 text-green-800 rounded-lg border border-green-200">
                Obrigado pela mensagem! Entraremos em contato em breve.
              </div>
              <div x-show="error" x-transition class="mb-4 p-4 bg-red-100 text-red-800 rounded-lg border border-red-200">
                Erro ao enviar. Tente novamente ou entre em contato pelo WhatsApp.
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <input type="text" name="name" placeholder="Nome Completo" required class="form-field" />
                <input type="email" name="email" placeholder="E-mail" required class="form-field" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <input type="tel" name="phone" placeholder="WhatsApp" class="form-field" />
                <select name="area" class="form-field" required>
                  <option value="">Área de Interesse</option>
                  <option value="contabil">Contábil</option>
                  <option value="fiscal">Fiscal</option>
                  <option value="pessoal">Departamento Pessoal</option>
                  <option value="administrativo">Administrativo</option>
                  <option value="ti">TI</option>
                  <option value="outro">Outra área</option>
                </select>
              </div>
              <div class="mb-6">
                <textarea name="message" placeholder="Conte um pouco sobre você e sua experiência..." rows={4} class="form-field resize-y min-h-[100px]"></textarea>
              </div>
              <button
                type="submit"
                :disabled="loading"
                class="w-full py-3.5 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors disabled:opacity-60"
              >
                <span x-show="!loading"><i class="bi bi-send mr-2"></i>Enviar Candidatura</span>
                <span x-show="loading">Enviando...</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
