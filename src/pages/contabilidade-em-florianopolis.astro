---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20a%20JMF%20Contabilidade%20e%20quero%20saber%20sobre%20contabilidade%20para%20minha%20empresa%20em%20Florian%C3%B3polis.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-em-florianopolis#localbusiness",
  "name": "JMF Contabilidade – Florianópolis",
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-em-florianopolis",
  "description": "Contabilidade para empresas em Florianópolis/SC: Simples Nacional ou Lucro Presumido, abertura de empresa. Atendimento digital para tech, turismo, construção, comércio, serviços e órgãos públicos. 140km de Blumenau.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Atendimento digital / Sede em Blumenau: Rua Rodolfo Freygang, 15, Sala 506",
    "addressLocality": "Florianópolis",
    "addressRegion": "SC",
    "postalCode": "88010-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -27.5954,
    "longitude": -48.5480
  },
  "areaServed": [
    { "@type": "City", "name": "Florianópolis" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "A JMF Contabilidade atende empresas em Florianópolis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Atendemos empresas de Florianópolis/SC 100% digital. Floripa fica a 140km de Blumenau (2h10), capital do estado, maior polo tech do Sul, turismo premium, sede de órgãos públicos. Fechamento mensal, documentos e comunicação via WhatsApp, portal e videoconferência."
      }
    },
    {
      "@type": "Question",
      "name": "Quais impostos para empresas em Florianópolis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Florianópolis tem economia diversificada: tech (maior polo Sul), turismo (praias, eventos), construção civil, comércio, serviços, órgãos públicos, educação. Simples Nacional (Anexo III/V via Fator R), Lucro Presumido. ISS municipal 2-5% (legislação própria). Tech: Lei do Bem (requer Lucro Real — a JMF atende apenas Simples Nacional ou Lucro Presumido, indicamos parceiro), incentivos ACATE/Softex. Simulamos o regime ideal."
      }
    },
    {
      "@type": "Question",
      "name": "Florianópolis tem incentivos para tech e inovação?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Floripa é o maior polo tech do Sul (ACATE, Softex, SAPIENS Parque, CIAIP). Incentivos: Lei do Bem (P&D, exige Lucro Real — a JMF atende apenas Simples Nacional ou Lucro Presumido, indicamos parceiro), Lei de Informática, PRODEC/TTD, incentivos municipais (ISS tech), fundos de investimento (FIPs, CRI/CRA). A JMF assessora captação, estruturação societária e compliance de incentivos."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona o atendimento remoto para Florianópolis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WhatsApp (47) 3326-5123, portal do cliente, e-mail, videoconferência. Para presença física, Blumenau a 140km (2h10 pela BR-101). Resposta no mesmo dia útil. Rotina mensal: docs até dia 5, fechamento até dia 15, guias até dia 20. Atendemos também via escritório parceiro em Floripa para demandas presenciais."
      }
    }
  ]
});

const schema = [localBusinessSchema, faqSchema];
---

<Layout
  title="Contabilidade em Florianópolis/SC | JMF Contabilidade"
  description="Contabilidade para empresas em Florianópolis/SC: tech, turismo, construção, comércio, serviços, órgãos públicos.  Simples Nacional ou Lucro Presumido."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-em-florianopolis"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-em-florianopolis"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para empresas em Florianópolis"
    subtitle="Capital catarinense: maior polo tech do Sul, turismo premium, construção, órgãos públicos. Atendimento digital, 140km de Blumenau."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Áreas de Atuação" },
      { label: "Contabilidade em Florianópolis" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver serviços", href: "#servicos", variant: "outline" }
    ]}
  />

  <section id="servicos" class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Contabilidade em Florianópolis:<br/><span class="pp3-grad">capital: tech, turismo, construção, órgãos públicos</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Florianópolis, capital de Santa Catarina, concentra a maior economia do estado e o maior polo de tecnologia e inovação do Sul do Brasil (ACATE, Softex, SAPIENS Parque). Turismo premium (Jurerê, Norte da Ilha, Centro), construção civil verticalizada, comércio forte, setor público (sedes estaduais/federais), educação (UFSC, UDESC) e serviços especializados. Cada setor exige contabilidade com expertise específica.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A JMF Contabilidade atende empresas de Florianópolis com expertise multissetorial: tech (Lei do Bem, P&D, captação, stock options), turismo (Fator R, sazonalidade premium), construção (RET, Patrimônio Afetação), órgãos públicos (licitações, contratos administrativos), comércio/serviços (ISS próprio, Simples, Presumido, Real). Atendimento 100% digital, estrutura de 35+ anos em Blumenau (140km / 2h10), com suporte de parceiro local para demandas presenciais.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Tech e Inovação (Lei do Bem, ACATE)</h3>
          <p class="text-slate-600 leading-relaxed">
            Startups, scale-ups, software houses: Lei do Bem exige Lucro Real (a JMF atende apenas Simples Nacional ou Lucro Presumido — indicamos parceiro), dedução 60-100% P&D, crédito financeiro, stock options (Plano de Opção), vesting, cliff, cap table, SAFE, convertible notes, due diligence investimento.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Turismo Premium (Jurerê, Norte, Centro)</h3>
          <p class="text-slate-600 leading-relaxed">
            Resorts, beach clubs, restaurantes high-end, eventos corporativos, casamentos destino: Simples (Fator R), ISS 2-5%, gorjetas (Lei 13.419), folha sazonal, Holding imobiliária aluguel temporada luxo, compliance ambiental (APAs).
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Construção Civil e Incorporação</h3>
          <p class="text-slate-600 leading-relaxed">
            Alto padrão (Jurerê, Centro, Beira-Mar): RET (1-4%), Patrimônio Afetação (Lei 10.931), INSS obra, ISS obra, CNDs, medições, fluxo de caixa obra, financiamento CEF/bancos, SPE/SCP estruturas societárias.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Órgãos Públicos, Licitações e Contratos</h3>
          <p class="text-slate-600 leading-relaxed">
            Empresas que atendem governo estadual/federal/municipal: Lei 14.133/2021 (nova lei licitações), retenções na fonte (IR, CSLL, PIS, COFINS, INSS), balanço patrimonial para habilitação, compliance anticorrupção, pregão eletrônico.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Florianópolis — Capital Multissetorial:<br/><span class="pp3-grad">particularidades tributárias por setor</span></h2>

      <p class="text-lg text-slate-600 mb-6 leading-relaxed">
        Florianópolis combina a maior diversidade econômica do estado com legislação municipal própria:
      </p>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Tech — Lei do Bem e captação:</strong> exige Lucro Real para dedução 60-100% P&D (a JMF atende apenas Simples Nacional ou Lucro Presumido — indicamos parceiro para Lucro Real). Exige segregação de centros de custo, laudos técnicos, prestação de contas MCTI. Stock options: tributação no exercício (IRPF 27,5% + INSS) ou ganho de capital. Captação (SAFE, equity): estruturação societária, valuation, due diligence.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Turismo premium — Fator R e Holding:</strong> Jurerê/Norte da Ilha: ticket altíssimo, sazonalidade + eventos o ano todo. Fator R planejado mantém Anexo III (6%). Holding imobiliária para aluguel temporada luxo (imóveis R$ 2M+): Simples vs Presumido, proteção patrimonial, sucessão.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>ISS municipal — Floripa tem lei própria:</strong> alíquotas 2-5% com tratamentos diferenciados por CNAE. Tech (desenvolvimento, SaaS, suporte), saúde (clinicas, hospitais), educação, construção, eventos têm regras específicas. Planejamento por CNAE economiza até 3 pp.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Licitações e contratos públicos (Lei 14.133/2021):</strong> capital concentra sedes. Retenções na fonte: IR 1,5%, CSLL 1%, PIS 0,65%, COFINS 3%, INSS 11% (serviços) a 20% (obra). Balanço para habilitação, certidões negativas, compliance anticorrupção (Lei 12.846/2013).</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Dado real:</strong> Scale-up tech em Floripa, faturamento R$ 50M, 200 funcionários (P&D 40%). Lei do Bem exige Lucro Real (a JMF atende apenas Simples Nacional ou Lucro Presumido — indicamos parceiro para Lucro Real): dedução 100% P&D (R$ 8M) = economia IRPJ/CSLL ~R$ 2.7M/ano. Stock options bem estruturado: diferimento IR para exercício, alíquota ganho capital (15-22,5%) vs salário (27,5%). A JMF estrutura: contabilidade, P&D, cap table, captação (com parceiro para regime Lucro Real).
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Atendimento para<br/><span class="pp3-grad">Florianópolis</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>100% Digital:</strong> WhatsApp (47) 3326-5123, portal, e-mail, videoconferência. Especialistas: tech (Lei do Bem, captação, stock options), turismo premium (Fator R, Holding), construção (RET, SPE/SCP), licitações públicas (Lei 14.133).
        </p>
        <p>
          <strong>Presencial quando quiser:</strong> Blumenau a 140km (2h10 pela BR-101). Sede: Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro. Suporte de parceiro local em Floripa para demandas presenciais.
        </p>
        <p>
          <strong>Rotina capital:</strong> Docs até dia 5, fechamento até dia 15, guias até dia 20. Tech: trimestral Lei do Bem, cap table update. Turismo: Fator R tracking mensal. Licitações: certidões e balanço sob demanda.
        </p>
      </div>
    </div>
  </section>

  <section id="formulario" class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Fale com a <span class="pp3-grad">JMF</span></h2>
      <p class="text-lg text-slate-600 mb-8">Resposta no mesmo dia útil. Levantamento de obrigações pendentes sem custo. Diagnóstico multissetorial gratuito (tech + turismo + construção + licitações).</p>
      <ContactForm />
    </div>
  </section>

</Layout>