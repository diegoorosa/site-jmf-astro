---
import Layout from '../layouts/Layout.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20cheguei%20numa%20p%C3%A1gina%20que%20n%C3%A3o%20encontrei%20no%20site%20da%20JMF.";
---

<Layout
  title="Página não encontrada | JMF Contabilidade"
  description="A página que você procura não existe ou foi movida. Volte para a home da JMF Contabilidade ou fale com nossa equipe."
  noindex={true}
>

  <section class="py-24 bg-white min-h-[60vh] flex items-center">
    <div class="container mx-auto px-4 text-center">
      <p class="text-6xl font-bold text-gray-300 mb-4">404</p>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Página não encontrada</h1>
      <p class="text-gray-600 text-lg mb-8 max-w-xl mx-auto">
        A página que você procura não existe, foi movida ou o endereço foi digitado incorretamente.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="px-6 py-3 rounded-lg bg-[#1e40af] text-white font-semibold hover:bg-[#1e3a8a] transition">Voltar para a home</a>
        <a href="/blog" class="px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition">Ver o blog</a>
        <a href={WA} target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition">Falar com a JMF</a>
      </div>
    </div>
  </section>
</Layout>
