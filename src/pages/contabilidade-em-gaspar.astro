  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-em-gaspar#localbusiness",
  "name": "JMF Contabilidade – Gaspar, SC",
  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-em-gaspar",
  "description": "Contabilidade para empresas em Gaspar/SC: Simples Nacional ou Lucro Presumido. Fechamento mensal, obrigações acessórias e planejamento tributário para o Médio Vale do Itajaí.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
