const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "A JMF Contabilidade atende empresas em Gaspar?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. A JMF Contabilidade atende empresas de Gaspar/SC remotamente. O fechamento mensal, envio de documentos e comunicação são feitos digitalmente. Gaspar fica a 12km de Blumenau, no Médio Vale do Itajaí." } },
    { "@type": "Question", "name": "Quais são os impostos para empresa em Gaspar?", "acceptedAnswer": { "@type": "Answer", "text": "As empresas em Gaspar seguem a legislação estadual de Santa Catarina (ICMS via SEFAL) e a legislação municipal (ISS para serviços). O regime tributário define a composição dos tributos. Empresas industriais de Gaspar, com perfil de metalurgia e plásticos, frequentemente se beneficiam do Lucro Presumido ou Real." } },
    { "@type": "Question", "name": "Gaspar tem incentivos fiscais para indústrias?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Gaspar participa dos programas estaduais de incentivo como o PRODEC e o TTD (Lei 489/1997 de SC). Para indústrias de base (metalurgia, plásticos), esses programas podem reduzir significativamente a carga de ICMS. As condições variam por porte e investimento." } },
    { "@type": "Question", "name": "Posso contratar a JMF sem ir ao escritório em Blumenau?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Todo o atendimento contábil pode ser feito remotamente via WhatsApp, e-mail e videoconferência. Para reuniões presenciais, Blumenau fica a apenas 12km de Gaspar." } }
  ]
