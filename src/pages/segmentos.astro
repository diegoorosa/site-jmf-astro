const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Por que eu preciso de contabilidade alinhada ao meu segmento de negócio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cada atividade possui regras próprias de tributação, CNAEs, cálculo do Fator R no Simples Nacional e emissão de notas fiscais. Uma assessoria contábil que conhece as particularidades do seu setor evita impostos pagos a maior e mantém sua empresa regular."
      }
    },
    {
      "@type": "Question",
      "name": "Quais segmentos de negócio a JMF Contabilidade atende?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Atendemos empresas enquadradas no Simples Nacional e Lucro Presumido nos segmentos de Prestação de Serviços, Saúde e Clínicas Médicas, Tecnologia e TI, Varejo e Comércio, Engenharia, Arquitetura e Construtoras (com mão de obra terceirizada), Pequenas Indústrias e Confecções, e Transporte e Logística leve."
      }
    },
    {
      "@type": "Question",
      "name": "Como a contabilidade pode reduzir os impostos da minha empresa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Por meio do enquadramento correto entre Simples Nacional e Lucro Presumido, do acompanhamento mensal do Fator R (reduzindo a alíquota inicial de serviços de 15,5% para 6%), da segregação de produtos monofásicos de PIS/COFINS no comércio e da escrituração contábil regular para distribuição de lucros isenta."
      }
    },
    {
      "@type": "Question",
      "name": "Qual a diferença entre Simples Nacional e Lucro Presumido para esses segmentos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "O Simples Nacional unifica os impostos em uma única guia mensal (DAS) para empresas com faturamento até R$ 4,8 milhões/ano, sendo muito vantajoso para serviços que se enquadram no Fator R e pequenos comércios. Já o Lucro Presumido costuma ser indicado quando o faturamento supera os limites vantajosos do Simples ou em atividades específicas de serviços e construtoras."
      }
    },
    {
      "@type": "Question",
      "name": "Como faço para saber qual o melhor enquadramento para a minha empresa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nossa equipe analisa os CNAEs, o faturamento previsto e a folha de pagamento da sua empresa para indicar o melhor enquadramento entre Simples Nacional e Lucro Presumido antes da abertura do CNPJ ou durante a migração da contabilidade."
      }
    }
  ]
});

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [JSON.parse(localBusinessSchema), JSON.parse(faqSchema)]
});
---

<Layout
  title="Contabilidade por Segmento de Negócio em Blumenau | JMF Contabilidade"
  description="Contabilidade mensal em Blumenau/SC para prestadores de serviços, saúde, tecnologia, comércio, engenharia e pequenas indústrias no Simples Nacional e Lucro Presumido."
  canonical="https://www.jmfcontabilidade.com.br/segmentos"
  ogUrl="https://www.jmfcontabilidade.com.br/segmentos"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade Especializada por Segmento"
    subtitle="Assessoria contábil, fiscal e trabalhista recorrente para empresas de serviços, saúde, tecnologia, comércio, engenharia e pequenas indústrias no Simples Nacional e Lucro Presumido."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Contabilidade por Segmento" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA.replace('[SEU%20SEGMENTO]', 'seu%20segmento'), variant: "cta" },
      { label: "Ver como funciona", href: "#como-funciona", variant: "outline" }
    ]}
  />

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">
            Contabilidade que entende o seu<br/><span class="pp3-grad">negócio como ninguém</span>
          </h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Cada atividade econômica possui suas próprias regras de tributação, emissão de notas fiscais e obrigações acessórias. Na JMF Contabilidade, acompanhamos a rotina mensal da sua empresa com foco em segurança fiscal e economia dentro da lei.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Com mais de 35 anos de experiência atendendo empresas em Blumenau e Santa Catarina no Simples Nacional e Lucro Presumido, combinamos atendimento próximo com processos digitais ágeis para manter tudo em dia.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA.replace('[SEU%20SEGMENTO]', 'seu%20segmento')} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-5/12">
          <img src="/assets/images/segmentos-1-1036x691.webp" alt="Contabilidade Especializada por Segmento JMF"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- Como Funciona -->
  <section id="como-funciona" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">
          Como funciona a<br/><span class="pp3-grad">contabilidade por segmento</span>
        </h2>
        <p class="text-gray-600 text-lg">Processo organizado para manter sua empresa regular e pagar menos impostos</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4">1</div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Análise da Atividade e CNAEs</h4>
          <p class="text-gray-600 text-sm">
            Analisamos seus CNAEs, atividades exercidas e estrutura de faturamento para identificar o enquadramento fiscal mais adequado.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4">2</div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Enquadramento Tributário</h4>
          <p class="text-gray-600 text-sm">
            Comparamos Simples Nacional (incluindo cálculo mensal do Fator R) e Lucro Presumido para reduzir legalmente sua carga tributária.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4">3</div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Atendimento Direto</h4>
          <p class="text-gray-600 text-sm">
            Contato ágil com nossa equipe contábil, fiscal e trabalhista para tirar dúvidas de emissão de notas, contratos e folha de pagamento.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4">4</div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Obrigações Acessórias em Dia</h4>
          <p class="text-gray-600 text-sm">
            Cumprimos rigorosamente todas as entregas mensais e anuais (PGDAS-D, eSocial, DCTFWeb, EFD-Reinf, ECD/ECF) sem atrasos.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4">5</div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Contabilidade e Balanço Regular</h4>
          <p class="text-gray-600 text-sm">
            Conciliação bancária via extratos, emissão de Balanço Patrimonial e DRE para distribuição de lucros isenta de IRPF aos sócios.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border-2 border-[#1e40af]">
          <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-lg font-bold mb-4"><i class="bi bi-check-lg"></i></div>
          <h4 class="text-lg font-semibold text-[#0f172a] mb-2">Tranquilidade para Crescer</h4>
          <p class="text-gray-600 text-sm">
            Sua empresa opera com segurança fiscal, previsibilidade de caixa e suporte contábil confiável em Blumenau e Santa Catarina.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Nossos Segmentos de Especialização -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-[#0f172a] mb-8 text-center">
        Principais Segmentos<br/><span class="pp3-grad">Atendidos pela JMF</span>
      </h2>
      <p class="text-gray-600 text-lg text-center mb-12">
        Contabilidade recorrente no Simples Nacional e Lucro Presumido para cada perfil de negócio
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Varejo e Comércio -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-shop"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Varejo e Comércio</h3>
          <p class="text-gray-600 text-sm">
            Gestão fiscal de lojas físicas e e-commerce, segregação de produtos monofásicos de PIS/COFINS no Simples Nacional, ICMS-ST e fechamento mensal completo.
          </p>
        </div>

        <!-- Pequenas Indústrias e Confecções -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-buildings"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Pequenas Indústrias e Confecções</h3>
          <p class="text-gray-600 text-sm">
            Assessoria para pequenas fábricas, confecções e facções têxteis no Simples Nacional (Anexo II) e Lucro Presumido, emissão de NF-e e folha de pagamento.
          </p>
        </div>

        <!-- Prestação de Serviços -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-people"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Prestação de Serviços</h3>
          <p class="text-gray-600 text-sm">
            Especialização em ISS municipal, emissão de NFS-e, acompanhamento mensal do Fator R (reduzindo a alíquota a partir de 6%) e pró-labore para consultorias, agências e escritórios.
          </p>
        </div>

        <!-- Engenharia, Arquitetura e Construtoras -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-house-door"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Engenharia, Arquitetura e Construtoras</h3>
          <p class="text-gray-600 text-sm">
            Contabilidade mensal para escritórios de engenharia, arquitetura e construtoras no Lucro Presumido com mão de obra terceirizada, emissão de notas e planejamento pelo Fator R.
          </p>
        </div>

        <!-- Saúde e Clínicas Médicas -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-heart-pulse"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Saúde e Clínicas Médicas</h3>
          <p class="text-gray-600 text-sm">
            Contabilidade para médicos, dentistas, psicólogos e clínicas em Blumenau: abertura de CNPJ médico, Fator R, equiparação hospitalar no Lucro Presumido, DMED e alvará VISA.
          </p>
        </div>

        <!-- Tecnologia e TI -->
        <div class="bg-[#f8fafc] rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-[#1e40af] text-white flex items-center justify-center text-2xl flex-shrink-0 mb-4 mx-auto">
            <i class="bi bi-laptop"></i>
          </div>
          <h3 class="font-bold text-[#0f172a] mb-3">Tecnologia e TI</h3>
          <p class="text-gray-600 text-sm">
            Assessoria para desenvolvedores, empresas de software, SaaS e agências digitais: enquadramento no Simples Nacional com Fator R, emissão de notas de serviço e exportação de serviços.
          </p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href={WA.replace('[SEU%20SEGMENTO]', 'seu%20segmento')} target="_blank" rel="noopener"
          class="inline-block px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
          Solicitar proposta para o meu segmento
        </a>
      </div>
    </div>
  </section>

  <!-- Benefícios da Especialização -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-[#0f172a] mb-8 text-center">
        Benefícios da<br/><span class="pp3-grad">contabilidade alinhada ao seu negócio</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Conformidade Total</h3>
          <p class="text-gray-600">
            Cumprimento rigoroso das obrigações fiscais e trabalhistas da sua atividade, evitando multas e pendências cadastrais.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Economia Fiscal Legal</h3>
          <p class="text-gray-600">
            Enquadramento adequado entre Simples Nacional (Fator R) e Lucro Presumido e segregação correta de receitas para pagar o menor imposto dentro da lei.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Relatórios Contábeis Claros</h3>
          <p class="text-gray-600">
            Balancetes, DRE e Balanço Patrimonial atualizados para acompanhar a saúde financeira da empresa e comprovar rendimentos dos sócios.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Suporte na Emissão de Notas</h3>
          <p class="text-gray-600">
            Orientação prática sobre códigos de serviço, CFOP, NCM e retenções na fonte antes de você emitir suas notas fiscais.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Processos Digitais Ágeis</h3>
          <p class="text-gray-600">
            Troca rápida de documentos e atendimento direto via WhatsApp e e-mail sem burocracia desnecessária.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6">
          <h3 class="font-bold text-[#0f172a] mb-4">Tradição desde 1989</h3>
          <p class="text-gray-600">
            Mais de 35 anos de experiência no Vale do Itajaí oferecendo segurança e estabilidade para empresas da região.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-[#0f172a]">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-2xl font-bold text-white mb-3">
        Sua empresa merece<br/><span class="pp3-grad-light">contabilidade que entende</span>
      </h2>
      <p class="text-white/70 mb-6">
        Converse com a equipe da JMF Contabilidade e veja como podemos cuidar da contabilidade mensal do seu negócio no Simples Nacional ou Lucro Presumido.
      </p>
      <a href={WA.replace('[SEU%20SEGMENTO]', 'seu%20segmento')} target="_blank" rel="noopener"
