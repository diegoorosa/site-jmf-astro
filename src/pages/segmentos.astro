    { "@type": "City", "name": "Blumenau" },
    { "@type": "City", "name": "Indaial" },
    { "@type": "City", "name": "Gaspar" },
    { "@type": "City", "name": "Pomerode" },
    { "@type": "City", "name": "Timbó" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "hasOfferCatalog": {
