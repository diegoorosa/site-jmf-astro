---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20tenho%20uma%20empresa%20no%20segmento%20de%20[SEU%20SEGMENTO]%20e%20gostaria%20de%20uma%20proposta%20cont%C3%A1bil.";

