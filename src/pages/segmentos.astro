    "name": "Serviços de Contabilidade por Segmento de Negócio",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Varejo e Comércio" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Pequenas Indústrias e Confecções" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Prestação de Serviços" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Engenharia, Arquitetura e Construtoras" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Saúde e Clínicas Médicas" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
    "https://www.linkedin.com/company/jmf-contabilidade/",
    "https://twitter.com/jmfcontab",
    "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
