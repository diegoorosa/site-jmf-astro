---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20uma%20proposta%20cont%C3%A1bil%20para%20minha%20ind%C3%BAstria.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-para-industria#localbusiness",
  "name": "JMF Contabilidade – Contabilidade para Pequenas Indústrias e Confecções",
  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-para-industria",
  "image": "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.webp",
  "description": "Contabilidade mensal para pequenas indústrias, confecções, facções têxteis e empresas de fabricação no Simples Nacional (Anexo II) e Lucro Presumido em Blumenau e Vale do Itajaí.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89010-060",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.92016,
    "longitude": -49.06705
  },
  "foundingDate": "1989-05-24",
  "areaServed": [
    { "@type": "City", "name": "Blumenau" },
    { "@type": "City", "name": "Timbó" },
    { "@type": "City", "name": "Indaial" },
    { "@type": "City", "name": "Pomerode" },
    { "@type": "City", "name": "Gaspar" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Contabilidade para Pequenas Indústrias",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade para Pequenas Indústrias e Confecções (Simples e Presumido)" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Enquadramento Tributário: Simples Nacional (Anexo II) vs. Lucro Presumido" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Orientação Fiscal para Emissão de NF-e Industrial e Industrialização por Encomenda" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Folha de Pagamento da Produção e Obrigações do eSocial" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abertura de Empresa e Legalização Industrial em Blumenau e Região" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
    "https://www.linkedin.com/company/jmf-contabilidade/",
    "https://twitter.com/jmfcontab",
    "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
    "https://www.yelp.com/biz/jmf-contabilidade-escrit%C3%B3rio-de-contabilidade-blumenau",
    "https://www.apontador.com.br/local/sc/blumenau/assessoria_contabil/6a43ca8942af5752cc2a601d/jmf_contabilidade.html"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "00:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Qual o melhor regime tributário para uma pequena indústria ou confecção em SC?", "acceptedAnswer": { "@type": "Answer", "text": "Para pequenas indústrias, confecções e empresas de fabricação com faturamento até R$ 4,8 milhões/ano, o Simples Nacional (Anexo II) costuma oferecer a melhor relação entre carga tributária reduzida e simplicidade operacional. Conforme o negócio cresce, avaliamos também a viabilidade do Lucro Presumido." } },
    { "@type": "Question", "name": "Como funciona a tributação para facções têxteis e industrialização por encomenda?", "acceptedAnswer": { "@type": "Answer", "text": "Facções têxteis e prestadores de serviços de industrialização por encomenda (como costura, estamparia, corte e beneficiamento) possuem regras específicas de CFOP (5.124 / 5.902) e tributação entre o Anexo II ou Anexo III do Simples Nacional. A JMF orienta o enquadramento e a emissão correta das notas fiscais." } },
    { "@type": "Question", "name": "Vocês atendem indústrias no Lucro Real ou auditoria complexa de Bloco K?", "acceptedAnswer": { "@type": "Answer", "text": "Nosso foco de atendimento é voltado exclusivamente para pequenas e médias indústrias, confecções e oficinas enquadradas no Simples Nacional e no Lucro Presumido. Não atuamos com regime de Lucro Real, auditoria de Bloco K de chão de fábrica ou projetos especiais como PRODEC e TTD." } },
    { "@type": "Question", "name": "Vocês atendem empresas de Timbó, Pomerode, Indaial e Gaspar?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. A JMF Contabilidade atende pequenas indústrias e confecções em todo o Vale do Itajaí: Blumenau, Timbó, Pomerode, Indaial, Gaspar e Brusque, com atendimento digital ágil e suporte presencial na nossa sede em Blumenau." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  serviceName: "Contabilidade para Pequenas Indústrias e Confecções",
  description: "Contabilidade mensal para pequenas indústrias, confecções, facções têxteis e empresas de fabricação no Simples Nacional (Anexo II) e Lucro Presumido em Blumenau e Vale do Itajaí.",
  url: "https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
};
---

<Layout
  title="Contabilidade para Pequenas Indústrias e Confecções em Blumenau | JMF Contabilidade"
  description="Contabilidade mensal para pequenas indústrias, confecções e facções têxteis no Simples Nacional (Anexo II) e Lucro Presumido em Blumenau e Vale do Itajaí."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para pequenas indústrias e confecções em Blumenau"
    subtitle="Assessoria contábil, fiscal e trabalhista para pequenas fábricas, confecções e facções têxteis enquadradas no Simples Nacional (Anexo II) e Lucro Presumido."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Especialidades" },
      { label: "Contabilidade para Indústria" }
    ]}
    ctas={[
      { label: "Solicitar Proposta Contábil", href: WA, variant: "cta" },
      { label: "Simular Regime Tributário", href: "/simulador-regime-tributario", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: novembro de 2026</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-6">Contabilidade para pequenas indústrias:<br/><span class="pp3-grad">segurança fiscal e folha em dia</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Blumenau, Timbó, Pomerode, Indaial, Gaspar e Brusque concentram milhares de pequenas indústrias, confecções, facções têxteis, marcenarias e empresas de fabricação própria que movimentam a economia do Vale do Itajaí.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Fundada em Blumenau em 1989, a <strong>JMF Contabilidade</strong> acompanha o dia a dia de pequenas e médias indústrias enquadradas no <strong>Simples Nacional</strong> e no <strong>Lucro Presumido</strong>, cuidando da emissão correta de notas fiscais de venda e industrialização, apuração de impostos e gestão completa da folha de pagamento.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Enquadramento Simples (Anexo II) vs. Presumido</h3>
          <p class="text-slate-600 leading-relaxed">
            Avaliamos o faturamento e a atividade da sua fábrica para manter o enquadramento tributário mais econômico entre o Simples Nacional (Anexo II) e o Lucro Presumido.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Emissão de NF-e Industrial e Remessas</h3>
          <p class="text-slate-600 leading-relaxed">
            Orientação prática sobre CFOPs de venda de produção própria (5.101/6.101), remessa e retorno de industrialização por encomenda (5.901/5.902/5.124), NCM e Substituição Tributária.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Departamento Pessoal e eSocial</h3>
          <p class="text-slate-600 leading-relaxed">
            Gestão completa da folha da equipe de produção e administrativo, adicionais, férias, rescisões, pró-labore dos sócios e cumprimento das convenções coletivas da região.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Abertura e Legalização de Fábricas</h3>
          <p class="text-slate-600 leading-relaxed">
            Consulta de viabilidade de zoneamento, abertura na JUCESC, inscrição estadual na SEF/SC e obtenção de alvarás municipais para você iniciar a produção dentro da lei.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Particularidades tributárias -->
  <section class="py-16 bg-slate-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Cuidados fiscais essenciais<br/><span class="pp3-grad">para pequenas indústrias em SC</span></h2>

      <p class="text-lg text-slate-600 mb-6 leading-relaxed">
        Na rotina industrial, pequenos erros de cadastro de produto ou natureza de operação geram impostos pagos a maior ou pendências na Receita Estadual:
      </p>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Classificação Fiscal (NCM e CEST):</strong> manter a NCM correta dos produtos fabricados evita erro no cálculo de IPI, ICMS-ST e tributação monofásica no Simples Nacional.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Industrialização por Encomenda (Facções):</strong> controle dos prazos legais de retorno de mercadoria remetida para beneficiamento ou costura, evitando a cobrança de ICMS por decurso de prazo.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Vendas Interestaduais (DIFAL e Antecipação):</strong> orientação clara sobre o recolhimento do Diferencial de Alíquota nas vendas para consumidor final fora de Santa Catarina.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Contabilidade Regular e Balanço:</strong> conciliação bancária e emissão de Balanço Patrimonial e DRE para facilitar acesso a crédito bancário e distribuição de lucros isenta aos sócios.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Escopo de atuação:</strong> Nossa assessoria industrial é direcionada exclusivamente a empresas enquadradas no <strong>Simples Nacional</strong> e no <strong>Lucro Presumido</strong>. Não atendemos indústrias no regime de Lucro Real, auditorias complexas de Bloco K de chão de fábrica ou projetos especiais como PRODEC e TTD.
        </p>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Como funciona<br/><span class="pp3-grad">nosso atendimento mensal</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>1. Conversa Inicial:</strong> pelo WhatsApp (47) 3326-5123 ou presencialmente no escritório, entendemos a atividade da sua empresa, número de funcionários e faturamento.
        </p>
        <p>
          <strong>2. Revisão de Enquadramento:</strong> conferimos o regime tributário mais vantajoso entre Simples Nacional (Anexo II) e Lucro Presumido para a sua operação.
        </p>
        <p>
          <strong>3. Rotina Mensal Organizada:</strong> recebimento dos arquivos XML e documentos até o dia 5, fechamento contábil, folha de pagamento e envio antecipado das guias (DAS, ICMS, IPI, INSS, FGTS) e obrigações acessórias.
        </p>
      </div>

      <p class="mt-8 text-lg text-slate-600 leading-relaxed">
        Atendemos pequenas indústrias e confecções em <strong>Blumenau</strong>, <strong>Timbó</strong>, <strong>Pomerode</strong>, <strong>Indaial</strong>, <strong>Gaspar</strong> e <strong>Brusque</strong> — com atendimento digital rápido e suporte presencial na nossa sede no Centro de Blumenau.
      </p>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Mantenha a contabilidade da sua fábrica<br/><span class="pp3-grad-light">organizada e sem sustos</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Com mais de 35 anos de experiência no Vale do Itajaí, a JMF Contabilidade cuida da escrita fiscal, contabilidade e folha de pagamento da sua pequena indústria ou confecção no Simples Nacional e Lucro Presumido.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Falar com a Equipe da JMF Contabilidade
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - Contabilidade para Indústria"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="pp3-grad">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Qual o melhor regime tributário para uma pequena indústria ou confecção em SC?</summary>
              <div class="accordion-body">
                <p>Para pequenas indústrias, confecções e empresas de fabricação com faturamento até R$ 4,8 milhões/ano, o Simples Nacional (Anexo II) costuma oferecer a melhor relação entre carga tributária reduzida e simplicidade operacional. Conforme o negócio cresce, avaliamos também a viabilidade do Lucro Presumido.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como funciona a tributação para facções têxteis e industrialização por encomenda?</summary>
              <div class="accordion-body">
                <p>Facções têxteis e prestadores de serviços de industrialização por encomenda (como costura, estamparia, corte e beneficiamento) possuem regras específicas de CFOP (5.124 / 5.902) e tributação entre o Anexo II ou Anexo III do Simples Nacional. A JMF orienta o enquadramento e a emissão correta das notas fiscais.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Vocês atendem indústrias no Lucro Real ou auditoria complexa de Bloco K?</summary>
              <div class="accordion-body">
                <p>Nosso foco de atendimento é voltado exclusivamente para pequenas e médias indústrias, confecções e oficinas enquadradas no Simples Nacional e no Lucro Presumido. Não atuamos com regime de Lucro Real, auditoria de Bloco K de chão de fábrica ou projetos especiais como PRODEC e TTD.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Vocês atendem empresas de Timbó, Pomerode, Indaial e Gaspar?</summary>
              <div class="accordion-body">
                <p>Sim. A JMF Contabilidade atende pequenas indústrias e confecções em todo o Vale do Itajaí: Blumenau, Timbó, Pomerode, Indaial, Gaspar e Brusque, com atendimento digital ágil e suporte presencial na nossa sede em Blumenau.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Conteúdos úteis da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/regimes-tributarios"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Enquadramento</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Simples Nacional ou Lucro Presumido: qual regime escolher?</p>
        </a>
        <a href="/simples-nacional"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Tributação</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Guia completo do Simples Nacional: tabelas, anexos e limites</p>
        </a>
        <a href="/simulador-regime-tributario"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Ferramenta</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Simulador de Regime Tributário Gratuito</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e solicite<br/><span class="pp3-grad">uma proposta para sua indústria!</span></h2>
          <p class="text-gray-600 text-lg mb-6">Se você possui uma pequena indústria, confecção ou facção no Simples Nacional ou Lucro Presumido e busca uma contabilidade ágil para cuidar da sua rotina fiscal e trabalhista mensal, fale com nossa equipe.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
