---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const WAsim = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20quero%20uma%20simula%C3%A7%C3%A3o%20tribut%C3%A1ria%20gratuita%20para%20minha%20ind%C3%BAstria.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-para-industria#localbusiness",
  "name": "JMF Contabilidade – Contabilidade para Indústria",
  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-para-industria",
  "description": "Contabilidade especializada para indústrias no Vale do Itajaí: Bloco K, recuperação de créditos ICMS/IPI/PIS/COFINS, Lucro Real e adequação à Reforma Tributária. Atendimento em Blumenau, Timbó, Indaial, Pomerode e região.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89010-060",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.92016,
    "longitude": -49.06705
  },
  "foundingDate": "1989-05-24",
  "areaServed": [
    { "@type": "City", "name": "Blumenau" },
    { "@type": "City", "name": "Timbó" },
    { "@type": "City", "name": "Indaial" },
    { "@type": "City", "name": "Pomerode" },
    { "@type": "City", "name": "Gaspar" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Contabilidade Industrial",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Auditoria de Bloco K e Estoques" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Planejamento Tributário Industrial (Lucro Real)" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Recuperação de Créditos ICMS, IPI, PIS/COFINS" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contabilidade de Custos e Gestão Fabril" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Departamento Pessoal e SST para Indústrias" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Adequação à Reforma Tributária (IBS/CBS)" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
    "https://www.linkedin.com/company/jmf-contabilidade/",
    "https://twitter.com/jmfcontab",
    "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
    "https://www.yelp.com/biz/jmf-contabilidade-escrit%C3%B3rio-de-contabilidade-blumenau",
    "https://www.apontador.com.br/local/sc/blumenau/assessoria_contabil/6a43ca8942af5752cc2a601d/jmf_contabilidade.html"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "00:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Qual o melhor regime tributário para uma indústria em Santa Catarina?", "acceptedAnswer": { "@type": "Answer", "text": "Depende da margem de lucro operacional e do volume de insumos adquiridos com direito a crédito. Indústrias em fase inicial ou com faturamento até R$ 4,8 milhões podem iniciar no Simples Nacional (Anexo II). Contudo, fábricas com margens menores, despesas elevadas de matéria-prima ou clientes corporativos que exigem crédito integral de ICMS e IPI economizam substancialmente no Lucro Real." } },
    { "@type": "Question", "name": "O que é o Bloco K do SPED Fiscal e como evitar multas na indústria?", "acceptedAnswer": { "@type": "Answer", "text": "O Bloco K é o Livro de Registro de Controle da Produção e do Estoque digital. A Receita Federal e a SEF/SC cruzam o consumo de matérias-primas com o produto final fabricado. Divergências no inventário físico ou falta de escrituração de perdas geram pesadas autuações. A JMF realiza a conciliação preventiva das ordens de produção com o SPED Fiscal." } },
    { "@type": "Question", "name": "Como funciona a recuperação de créditos de ICMS, IPI e PIS/COFINS?", "acceptedAnswer": { "@type": "Answer", "text": "A indústria pode se creditar dos tributos recolhidos na compra de matérias-primas, materiais de embalagem, produtos intermediários que sofrem desgaste na produção, energia elétrica consumida no processo fabril e máquinas/equipamentos através do CIAP (em 48 meses). Mapeamos todos os insumos para aproveitar 100% dos créditos devidos." } },
    { "@type": "Question", "name": "Como a indústria deve se preparar para a Reforma Tributária (IBS/CBS)?", "acceptedAnswer": { "@type": "Answer", "text": "Com a unificação dos tributos sobre o consumo, a indústria precisará auditar seus sistemas ERP para garantir a não-cumulatividade plena (crédito financeiro total nas compras) e adequar a precificação ao novo mecanismo de recolhimento na liquidação financeira (Split Payment)." } },
    { "@type": "Question", "name": "Vocês atendem indústrias de Timbó, Pomerode, Indaial e Gaspar?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. A JMF Contabilidade atende indústrias em toda a bacia fabril do Vale do Itajaí: Blumenau, Timbó, Pomerode, Indaial, Gaspar, Brusque, Joinville e Jaraguá do Sul. O atendimento é 100% digital com suporte presencial quando necessário." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  serviceName: "Contabilidade para Indústria",
  description: "Contabilidade especializada para indústrias no Vale do Itajaí: Bloco K, recuperação de créditos ICMS/IPI/PIS/COFINS, Lucro Real e adequação à Reforma Tributária.",
  url: "https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
};
---

<Layout
  title="Contabilidade para Indústria em Blumenau e SC | JMF Contabilidade"
  description="Contabilidade especializada para indústrias no Vale do Itajaí: Bloco K, recuperação de créditos ICMS/IPI/PIS/COFINS, Lucro Real e adequação à Reforma Tributária."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-para-industria"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para indústrias em Blumenau e Vale do Itajaí"
    subtitle="Bloco K, recuperação de créditos tributários, Lucro Real e preparação para a Reforma Tributária. Gestão contábil que protege a margem da sua fábrica."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Especialidades" },
      { label: "Contabilidade para Indústria" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Simular Regime", href: "/simulador-regime-tributario", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: agosto de 2026</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-6">Contabilidade para indústria:<br/><span class="pp3-grad">por que escolher a JMF</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        O Vale do Itajaí é o coração industrial de Santa Catarina. Blumenau, Timbó, Pomerode, Indaial, Gaspar, Brusque, Joinville e Jaraguá do Sul concentram milhares de fábricas — têxteis, metalmecânicas, plásticas, químicas, de alimentos e automação. Indústrias da região precisam de contabilidade que entenda o chão de fábrica: custos industriais, Bloco K, créditos de ICMS/IPI/PIS/COFINS, Lucro Real e agora a Reforma Tributária.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A JMF Contabilidade nasceu em Blumenau em 1989. São 35+ anos atendendo indústrias da região com sede própria no Centro (Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú). Conhecemos a dinâmica dos polos fabris catarinenses — e usamos esse conhecimento para sua indústria pagar menos imposto, blindar o SPED Fiscal e ter relatórios de custos que a diretoria usa para decidir.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Bloco K Blindado</h3>
          <p class="text-slate-600 leading-relaxed">
            Auditoria preventiva de fichas técnicas (Reg. 0200/0210), apontamento de perdas normais do processo e conciliação inventário físico vs SPED. Evita autuações por divergência de consumo.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Créditos Tributários Plenos</h3>
          <p class="text-slate-600 leading-relaxed">
            Mapeamento completo de insumos para creditamento de ICMS, IPI, PIS/COFINS — inclusive energia elétrica fabril, embalagens, CIAP de ativo imobilizado. Recuperação do que é seu por lei.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Lucro Real Otimizado</h3>
          <p class="text-slate-600 leading-relaxed">
            Simulação comparativa Simples (Anexo II) vs Lucro Presumido vs Lucro Real. Identificamos o regime que maximiza crédito de matéria-prima e depreciação — economia real na margem líquida.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Contabilidade de Custos Fabris</h3>
          <p class="text-slate-600 leading-relaxed">
            DRE por linha de produto, centro de custos industriais, margem de contribuição, custeio por absorção e variável. Números do chão de fábrica para a diretoria tomar decisão.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Particularidades tributárias -->
  <section class="py-16 bg-slate-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Particularidades tributárias<br/><span class="pp3-grad">da indústria catarinense</span></h2>

      <p class="text-lg text-slate-600 mb-6 leading-relaxed">
        Santa Catarina tem legislação própria que impacta diretamente o planejamento tributário industrial. Conhecer esses detalhes faz a diferença entre pagar o justo e deixar dinheiro na mesa:
      </p>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>ICMS interno SC:</strong> alíquotas de 7%, 12%, 17% e 18% conforme o produto. Indústrias têxteis, metalúrgicas e plásticas do Vale lidam com diferencial de alíquota interestadual (DIFAL) — fator decisivo no planejamento de compras e vendas interestaduais.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Incentivos estaduais (PRODEC, Pró-Emprego, TTD 489/409):</strong> para indústrias com projeto de investimento relevante (implantação, expansão ou modernização), geram diferimento de ICMS e ampliação de limites de crédito. Exigem análise de enquadramento junto à SEF/SC.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Bloco K obrigatório:</strong> indústrias enquadradas no Lucro Real ou com faturamento acima do limite devem entregar o Bloco K mensalmente. A SEF/SC cruza consumo de MP com produto acabado — divergência gera autuação automática por presunção de omissão de receita.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Reforma Tributária (IBS/CBS):</strong> a transição para não-cumulatividade plena e Split Payment exige parametrização do ERP agora. Indústrias que adiarem a adequação terão passivo de créditos não aproveitados e risco de precificação incorreta.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>ISS em serviços industriais:</strong> serviços de usinagem, tratamento de superfície, manutenção industrial e projetos de engenharia pagam ISS municipal (mínimo 2%). Blumenau e cidades do Vale têm legislação própria — enquadramento correto evita bitributação ICMS/ISS.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Dado real:</strong> Indústrias catarinenses no Lucro Real que fazem gestão ativa de créditos (ICMS sobre energia, CIAP, PIS/COFINS não-cumulativo) reduzem a carga efetiva em 3 a 8 pontos percentuais sobre o faturamento. A JMF mapeia 100% dos insumos da sua fábrica para garantir o creditamento integral.
        </p>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Como funciona<br/><span class="pp3-grad">o atendimento industrial</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>1. Diagnóstico Fabril:</strong> WhatsApp (47) 3326-5123 ou formulário. Levantamento da estrutura produtiva, regime atual, Bloco K, créditos atuais, passivos trabalhistas/SST e ERP. Sem custo.
        </p>
        <p>
          <strong>2. Planejamento Tributário:</strong> simulação de regimes (Simples Anexo II, Lucro Presumido, Lucro Real) com projeção de 12 meses. Identificação de incentivos estaduais aplicáveis (PRODEC, TTD) e mapa de créditos recuperáveis.
        </p>
        <p>
          <strong>3. Implantação:</strong> parametrização fiscal do ERP, estruturação do plano de contas gerencial por centro de custos, rotinas de conferência de Bloco K, integração DP/SST ao eSocial.
        </p>
        <p>
          <strong>4. Rotina Mensal:</strong> fechamento contábil e fiscal, apuração de impostos, Bloco K, guias de recolhimento, relatórios de custos por produto/linha, DRE gerencial, fluxo de caixa — tudo no prazo, com reunião de alinhamento mensal.
        </p>
      </div>

      <p class="mt-8 text-lg text-slate-600 leading-relaxed">
        Atendemos indústrias em <strong>Blumenau</strong>, <strong>Timbó (15km)</strong>, <strong>Pomerode (25km)</strong>, <strong>Indaial (15km)</strong>, <strong>Gaspar (12km)</strong>, <strong>Brusque (25km)</strong>, <strong>Joinville (90km)</strong>, <strong>Jaraguá do Sul (60km)</strong> — com a mesma qualidade, 100% digital quando preferir.
      </p>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Tenha uma contabilidade<br/><span class="pp3-grad-light">que protege a margem da sua fábrica!</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Com 35+ anos de experiência no mercado industrial de Blumenau e Vale do Itajaí, conhecemos as particularidades dos polos têxtil, metalmecânico, plástico, químico e de alimentos de Santa Catarina. Fale conosco e veja a diferença no seu fechamento mensal e na gestão de créditos.
      </p>
      <a href={WAsim} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Diagnóstico Tributário Industrial Gratuito
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - Contabilidade para Indústria"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="pp3-grad">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Qual o melhor regime tributário para uma indústria em Santa Catarina?</summary>
              <div class="accordion-body">
                <p>Depende da margem de lucro operacional e do volume de insumos adquiridos com direito a crédito. Indústrias em fase inicial ou com faturamento até R$ 4,8 milhões podem iniciar no Simples Nacional (Anexo II). Contudo, fábricas com margens menores, despesas elevadas de matéria-prima ou clientes corporativos que exigem crédito integral de ICMS e IPI economizam substancialmente no Lucro Real.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que é o Bloco K do SPED Fiscal e como evitar multas na indústria?</summary>
              <div class="accordion-body">
                <p>O Bloco K é o Livro de Registro de Controle da Produção e do Estoque digital. A Receita Federal e a SEF/SC cruzam o consumo de matérias-primas com o produto final fabricado. Divergências no inventário físico ou falta de escrituração de perdas geram pesadas autuações. A JMF realiza a conciliação preventiva das ordens de produção com o SPED Fiscal.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como funciona a recuperação de créditos de ICMS, IPI e PIS/COFINS?</summary>
              <div class="accordion-body">
                <p>A indústria pode se creditar dos tributos recolhidos na compra de matérias-primas, materiais de embalagem, produtos intermediários que sofrem desgaste na produção, energia elétrica consumida no processo fabril e máquinas/equipamentos através do CIAP (em 48 meses). Mapeamos todos os insumos para aproveitar 100% dos créditos devidos.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como a indústria deve se preparar para a Reforma Tributária (IBS/CBS)?</summary>
              <div class="accordion-body">
                <p>Com a unificação dos tributos sobre o consumo, a indústria precisará auditar seus sistemas ERP para garantir a não-cumulatividade plena (crédito financeiro total nas compras) e adequar a precificação ao novo mecanismo de recolhimento na liquidação financeira (Split Payment).</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Vocês atendem indústrias de Timbó, Pomerode, Indaial e Gaspar?</summary>
              <div class="accordion-body">
                <p>Sim. A JMF Contabilidade atende indústrias em toda a bacia fabril do Vale do Itajaí: Blumenau, Timbó, Pomerode, Indaial, Gaspar, Brusque, Joinville e Jaraguá do Sul. O atendimento é 100% digital com suporte presencial quando necessário.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/reforma-tributaria-atualizacao-erp-sistemas-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Reforma Tributária</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Reforma Tributária 2026: como preparar o ERP da sua indústria para IBS/CBS</p>
        </a>
        <a href="/blog/creditos-icms-ipi-pis-cofins-industria"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Créditos Tributários</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Recuperação de créditos ICMS, IPI, PIS/COFINS na indústria: o que a maioria esquece</p>
        </a>
        <a href="/blog/bloco-k-sped-fiscal-como-evitar-multas"
