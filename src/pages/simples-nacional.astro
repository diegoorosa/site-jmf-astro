    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Quem pode optar pelo Simples Nacional?", "acceptedAnswer": { "@type": "Answer", "text": "Microempresas (ME, faturamento anual até R$ 360.000) e Empresas de Pequeno Porte (EPP, até R$ 4,8 milhões/ano) podem optar. O MEI tem regras e limite próprios (R$ 81.000/ano). Empresas que já estão no Lucro Presumido ou Real podem migrar com o plano de transição adequado." } },
    { "@type": "Question", "name": "Como funciona o cálculo do DAS no Simples Nacional?", "acceptedAnswer": { "@type": "Answer", "text": "O DAS (Documento de Arrecadação do Simples Nacional) é calculado por faixa de faturamento: (RBT12 × Alíquota nominal − Parcela a deduzir) ÷ RBT12. As alíquotas variam de 6% a 33% para Anexo III (serviços) e 15,5% a 30,5% para Anexo V. O cálculo considera o faturamento dos últimos 12 meses e o total de pró-labore e salários (Fator R)." } },
    { "@type": "Question", "name": "Qual o prazo para pagar o DAS e o que acontece se atrasar?", "acceptedAnswer": { "@type": "Answer", "text": "O DAS normalmente vence no dia 20 do mês subsequente ao período de apuração. Em caso de atraso, a recomendação é consultar o PGDAS-D e emitir uma guia atualizada, verificando a situação do débito antes de decidir entre quitação ou parcelamento." } },
    { "@type": "Question", "name": "Como migrar do Simples Nacional para Lucro Presumido ou Real?", "acceptedAnswer": { "@type": "Answer", "text": "A migração requer planejamento: o prazo de opção costuma ser em janeiro ou julho. A JMF realiza simulação comparativa com seus números reais para definir o regime mais vantajoso. A saída do Simples pode gerar efeitos sobre créditos PIS/COFINS e o momento da migração impacta o Fator R do próximo ano." } },
    { "@type": "Question", "name": "Como regularizar DAS em atraso?", "acceptedAnswer": { "@type": "Answer", "text": "Consulte a apuração e emita a guia atualizada pelo canal oficial. Para débitos declarados no PGDAS-D, o parcelamento pode ser uma alternativa conforme a situação da empresa e as condições apresentadas no serviço oficial." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  name: "Simples Nacional",
  description: "Hub completo sobre o Simples Nacional: tabelas de alíquotas, Fator R, limites, quando mudar de regime e como reduzir a carga tributária legalmente."
};
---

<Layout
  title="Simples Nacional: Tabelas, Fator R e Regime Tributário | JMF"
  description="Entenda Simples Nacional, tabelas, Fator R, limites, DAS em atraso e como avaliar o regime tributário com dados da sua empresa."
  canonical="https://www.jmfcontabilidade.com.br/simples-nacional"
  ogUrl="https://www.jmfcontabilidade.com.br/simples-nacional"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Simples Nacional"
    subtitle="Tabelas, Fator R, limites e os pontos que sua empresa precisa conferir antes de decidir."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Simples Nacional" }
    ]}
    ctas={[
      { label: "Falar com Especialista", href: WA, variant: "cta" },
      { label: "Simular Regime", href: "/simulador-regime-tributario", variant: "outline" }
    ]}
  />

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-gray-600 text-lg leading-relaxed mb-6">
        O <strong>Simples Nacional</strong> é um regime tributário voltado a micro e pequenas empresas, com pagamento por meio do DAS. Para decidir se ele faz sentido, não basta olhar a alíquota inicial: atividade, faturamento, folha, Fator R, obrigações e momento da empresa mudam a análise.
      </p>
      <p class="text-gray-600 text-lg leading-relaxed mb-6">
        Este hub reúne todos os artigos da JMF sobre o Simples Nacional e regime tributário para ajudar você a tomar a melhor decisão para o seu negócio.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-[#f0fdf4] rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-[#0f172a]">R$ 4,8 mi</p>
          <p class="text-gray-500 text-sm">Limite de faturamento anual</p>
        </div>
        <div class="bg-[#f0fdf4] rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-[#0f172a]">6% a 33%</p>
          <p class="text-gray-500 text-sm">Faixas de alíquota</p>
        </div>
        <div class="bg-[#f0fdf4] rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-[#0f172a]">28%</p>
          <p class="text-gray-500 text-sm">Fator R para Anexo III</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resumo completo -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl font-bold text-[#0f172a] mb-6">Quem pode optar pelo <span class="pp3-grad">Simples Nacional</span></h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        O Simples Nacional reúne oito tributos em uma única guia mensal — o <strong>DAS</strong> (IRPJ, CSLL, PIS, COFINS, IPI, ICMS, ISS e a contribuição patronal/CPP, exceto no Anexo IV). Podem optar Microempresas (ME, faturamento anual até R$ 360.000) e Empresas de Pequeno Porte (EPP, até R$ 4.800.000/ano) — o MEI tem regras e limite próprios (R$ 81.000/ano). <strong>Atenção:</strong> o teto de R$ 4,8 milhões não é corrigido desde 2018, e a perda de valor real pela inflação acumulada já passa de 50% — empresas em crescimento atingem o teto mais facilmente do que no passado.
      </p>

      <h3 class="text-xl font-bold text-[#0f172a] mt-8 mb-3">Tabelas dos anexos (alíquotas 2026)</h3>
      <p class="text-gray-600 leading-relaxed mb-4">
        A alíquota efetiva é calculada por: <code class="bg-gray-100 px-2 py-1 rounded text-sm">(RBT12 × Alíquota nominal − Parcela a deduzir) ÷ RBT12</code>, onde RBT12 é o faturamento bruto acumulado nos últimos 12 meses.
      </p>

      <h4 class="font-bold text-[#0f172a] mt-6 mb-2">Anexo III — Serviços (com Fator R)</h4>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm border border-gray-200 rounded-lg">
          <thead class="bg-[#f8fafc]"><tr><th class="text-left p-2 border-b border-gray-200">RBT12</th><th class="text-left p-2 border-b border-gray-200">Alíquota Nominal</th><th class="text-left p-2 border-b border-gray-200">Parcela a Deduzir</th></tr></thead>
          <tbody>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 180.000</td><td class="p-2 border-b border-gray-100">6,00%</td><td class="p-2 border-b border-gray-100">R$ 0</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 360.000</td><td class="p-2 border-b border-gray-100">11,20%</td><td class="p-2 border-b border-gray-100">R$ 9.360</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 720.000</td><td class="p-2 border-b border-gray-100">13,50%</td><td class="p-2 border-b border-gray-100">R$ 17.640</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 1.800.000</td><td class="p-2 border-b border-gray-100">16,00%</td><td class="p-2 border-b border-gray-100">R$ 35.640</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 3.600.000</td><td class="p-2 border-b border-gray-100">21,00%</td><td class="p-2 border-b border-gray-100">R$ 125.640</td></tr>
            <tr><td class="p-2">Até R$ 4.800.000</td><td class="p-2">33,00%</td><td class="p-2">R$ 648.000</td></tr>
          </tbody>
        </table>
      </div>

      <h4 class="font-bold text-[#0f172a] mt-6 mb-2">Anexo V — Serviços (sem Fator R)</h4>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm border border-gray-200 rounded-lg">
          <thead class="bg-[#f8fafc]"><tr><th class="text-left p-2 border-b border-gray-200">RBT12</th><th class="text-left p-2 border-b border-gray-200">Alíquota Nominal</th><th class="text-left p-2 border-b border-gray-200">Parcela a Deduzir</th></tr></thead>
          <tbody>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 180.000</td><td class="p-2 border-b border-gray-100">15,50%</td><td class="p-2 border-b border-gray-100">R$ 0</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 360.000</td><td class="p-2 border-b border-gray-100">18,00%</td><td class="p-2 border-b border-gray-100">R$ 4.500</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 720.000</td><td class="p-2 border-b border-gray-100">19,50%</td><td class="p-2 border-b border-gray-100">R$ 9.900</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 1.800.000</td><td class="p-2 border-b border-gray-100">20,50%</td><td class="p-2 border-b border-gray-100">R$ 17.100</td></tr>
            <tr><td class="p-2 border-b border-gray-100">Até R$ 3.600.000</td><td class="p-2 border-b border-gray-100">23,00%</td><td class="p-2 border-b border-gray-100">R$ 62.100</td></tr>
            <tr><td class="p-2">Até R$ 4.800.000</td><td class="p-2">30,50%</td><td class="p-2">R$ 540.000</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-500 text-sm mb-6">Os Anexos I (comércio), II (indústria) e IV (serviços com INSS patronal separado) seguem tabelas próprias — veja o <a href="/blog/simples-nacional-2026-tabelas-e-limites" class="text-[#1e40af] hover:underline font-semibold">artigo completo com todas as faixas</a>.</p>

      <h3 class="text-xl font-bold text-[#0f172a] mt-8 mb-3">Fator R: quando a folha muda o anexo aplicável</h3>
      <p class="text-gray-600 leading-relaxed mb-4">
        Para atividades sujeitas ao Fator R, a relação entre folha e faturamento dos últimos 12 meses pode influenciar o anexo aplicável. A referência de 28% é importante, mas o efeito depende da atividade, da faixa de receita e dos dados efetivos da empresa. Use a <a href="/calculadora-fator-r" class="text-[#1e40af] hover:underline font-semibold">Calculadora do Fator R</a> como estimativa inicial e valide a conclusão antes de optar ou alterar uma rotina.
      </p>

      <h3 class="text-xl font-bold text-[#0f172a] mt-8 mb-3">DAS em atraso e mudanças de regime: pontos de atenção</h3>
      <p class="text-gray-600 leading-relaxed mb-4">
        Se o DAS venceu, confira a apuração e emita uma guia atualizada pelo canal oficial antes de tomar qualquer decisão. Veja o nosso [guia para DAS do Simples Nacional atrasado](/blog/das-atrasado-simples-nacional-como-regularizar) para organizar o procedimento. Mudanças tributárias também devem ser acompanhadas com dados da operação, especialmente em empresas que vendem para outras empresas ou avaliam troca de regime.
      </p>
    </div>
  </section>

  <!-- Artigos do cluster -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl font-bold text-[#0f172a] mb-8">Artigos sobre <span class="pp3-grad">Simples Nacional e Regime Tributário</span></h2>

      <div class="space-y-6">
        <a href="/blog/simples-nacional-2026-tabelas-e-limites" class="block bg-white rounded-xl border border-gray-100 p-6 hover:border-[#1e40af] hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
              <i class="bi bi-table text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg group-hover:text-[#1e40af] mb-1">Simples Nacional 2026: Tabelas, Limites e Tudo Que Você Precisa Saber</h3>
              <p class="text-gray-500 text-sm leading-relaxed">Tabelas dos anexos, alíquotas nominais, parcelas a deduzir e pontos de atenção para análise do regime.</p>
              <span class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm mt-2 group-hover:gap-2 transition-all">Ler artigo <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </a>

        <a href="/blog/fator-r-simples-nacional-como-calcular" class="block bg-white rounded-xl border border-gray-100 p-6 hover:border-[#1e40af] hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
              <i class="bi bi-calculator-fill text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg group-hover:text-[#1e40af] mb-1">Fator R no Simples Nacional: Como Calcular e Reduzir Seu Imposto</h3>
              <p class="text-gray-500 text-sm leading-relaxed">O Fator R determina se sua empresa paga 6% (Anexo III) ou 15,5% (Anexo V). Fórmula exata, exemplo prático e calculadora gratuita.</p>
              <span class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm mt-2 group-hover:gap-2 transition-all">Ler artigo <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </a>

        <a href="/blog/lucro-presumido-vs-lucro-real" class="block bg-white rounded-xl border border-gray-100 p-6 hover:border-[#1e40af] hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
              <i class="bi bi-graph-up text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg group-hover:text-[#1e40af] mb-1">Lucro Presumido vs Lucro Real: Qual é Melhor para Sua Empresa?</h3>
              <p class="text-gray-500 text-sm leading-relaxed">Comparação completa: presunção de lucro, alíquotas, PIS/COFINS cumulativo vs não cumulativo e quando cada regime compensa mais.</p>
              <span class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm mt-2 group-hover:gap-2 transition-all">Ler artigo <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </a>

        <a href="/blog/planejamento-tributario-como-pagar-menos-imposto-legalmente" class="block bg-white rounded-xl border border-gray-100 p-6 hover:border-[#1e40af] hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
              <i class="bi bi-lightbulb text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg group-hover:text-[#1e40af] mb-1">Planejamento Tributário: Como Pagar Menos Imposto Legalmente</h3>
              <p class="text-gray-500 text-sm leading-relaxed">Estratégias legais: escolha do regime, distribuição de lucros, pró-labore vs dividendos, holding familiar e créditos fiscais.</p>
              <span class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm mt-2 group-hover:gap-2 transition-all">Ler artigo <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </a>

        <a href="/blog/das-atrasado-simples-nacional-como-regularizar" class="block bg-white rounded-xl border border-gray-100 p-6 hover:border-[#1e40af] hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
              <i class="bi bi-exclamation-triangle text-[#1e40af] text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg group-hover:text-[#1e40af] mb-1">DAS Atrasado no Simples Nacional: Como Regularizar</h3>
              <p class="text-gray-500 text-sm leading-relaxed">O que fazer quando o DAS ficou para trás: multa automática no dia 21, parcelamento, efeitos da exclusão e como voltar ao Simples.</p>
              <span class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm mt-2 group-hover:gap-2 transition-all">Ler artigo <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Ferramentas -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl font-bold text-[#0f172a] mb-8"><span class="pp3-grad">Ferramentas Gratuitas</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <a href="/simulador-regime-tributario" class="flex items-center gap-4 bg-white border border-gray-200 hover:border-[#1e40af] rounded-2xl p-6 shadow-sm hover:shadow-md transition-all group">
          <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
            <i class="bi bi-graph-up text-[#1e40af] text-xl"></i>
          </div>
          <div>
            <h3 class="font-bold text-[#0f172a] group-hover:text-[#1e40af]">Simulador de Regime Tributário</h3>
            <p class="text-gray-500 text-sm">Compare Simples Nacional e Lucro Presumido</p>
          </div>
        </a>
        <a href="/calculadora-fator-r" class="flex items-center gap-4 bg-white border border-gray-200 hover:border-[#1e40af] rounded-2xl p-6 shadow-sm hover:shadow-md transition-all group">
          <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center shrink-0">
            <i class="bi bi-calculator-fill text-[#1e40af] text-xl"></i>
          </div>
          <div>
            <h3 class="font-bold text-[#0f172a] group-hover:text-[#1e40af]">Calculadora do Fator R</h3>
            <p class="text-gray-500 text-sm">Descubra se sua empresa está no Anexo III ou V</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-[#0f172a]">
