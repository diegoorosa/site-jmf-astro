---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const title = "Contabilidade para Importação e TTD em SC | JMF Contabilidade";
const description = "Contabilidade especializada em tradings e importadoras em Santa Catarina. Benefício fiscal TTD 409, habilitação no RADAR Siscomex e redução legal de ICMS.";
const canonical = "https://www.jmfcontabilidade.com.br/contabilidade-para-importacao-sc";
const ogUrl = canonical;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AccountingService",
      "name": "JMF Contabilidade - Especializada em Importação e Comércio Exterior",
      "url": canonical,
      "telephone": "+55-47-3326-5123",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Centro",
        "addressLocality": "Blumenau",
        "addressRegion": "SC",
        "postalCode": "89010-060",
        "addressCountry": "BR"
      },
      "areaServed": [
        "Itajaí", "Navegantes", "Blumenau", "Joinville", "Itapoá", "São Francisco do Sul", "Florianópolis"
      ],
      "priceRange": "$$"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o TTD 409 em Santa Catarina e quem pode solicitar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O TTD 409 (Tratamento Tributário Diferenciado) é um regime especial concedido pela SEF/SC que permite o diferimento do ICMS no desembaraço aduaneiro de mercadorias importadas por portos e aeroportos catarinenses e concede crédito presumido na saída interestadual, reduzindo a carga tributária efetiva de ICMS para percentuais entre 0,6% e 2,6%."
          }
        },
        {
          "@type": "Question",
          "name": "Qual o regime tributário necessário para usufruir do TTD de Importação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A empresa deve ser optante pelo Lucro Real ou Lucro Presumido. Empresas do Simples Nacional não podem usufruir do crédito presumido do TTD, sendo altamente recomendada a abertura de uma trading ou filial específica no Lucro Real/Presumido para operar o benefício."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona a habilitação no RADAR Siscomex?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O RADAR é a licença concedida pela Receita Federal para operar no comércio exterior. É dividido em Expressa (até US$ 50 mil/semestre), Limitada (até US$ 160 mil/semestre) e Ilimitada (acima de US$ 160 mil). Nossa equipe organiza a capacidade financeira da empresa e faz o protocolo para obtenção e revisão de limite."
          }
        },
        {
          "@type": "Question",
          "name": "Como fica o TTD de Santa Catarina com a Reforma Tributária?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os incentivos fiscais estaduais como o TTD de SC possuem transição garantida pela Emenda Constitucional nº 132/2023 até 2032 através do Fundo de Compensação de Benefícios Fiscais. Estruturar sua trading agora garante segurança jurídica e competitividade durante toda a fase de transição."
          }
        }
      ]
    }
  ]
};

const whatsappUrl = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20gostaria%20de%20uma%20an%C3%A1lise%20de%20viabilidade%20do%20TTD%20e%20importa%C3%A7%C3%A3o%20em%20SC.";

const faqs = [
  {
    q: "O que é o TTD 409 em Santa Catarina e quem pode solicitar?",
    a: "O TTD 409 (Tratamento Tributário Diferenciado) é um regime especial concedido pela SEF/SC que permite o diferimento do ICMS no desembaraço aduaneiro de mercadorias importadas por portos e aeroportos catarinenses e concede crédito presumido na saída interestadual, reduzindo a carga tributária efetiva de ICMS para percentuais entre 0,6% e 2,6%."
  },
  {
    q: "Qual o regime tributário necessário para usufruir do TTD de Importação?",
    a: "A empresa deve ser optante pelo Lucro Real ou Lucro Presumido. Empresas do Simples Nacional não podem usufruir do crédito presumido do TTD, sendo altamente recomendada a abertura de uma trading ou filial específica no Lucro Real/Presumido para operar o benefício."
  },
  {
    q: "Como funciona a habilitação no RADAR Siscomex?",
    a: "O RADAR é a licença concedida pela Receita Federal para operar no comércio exterior. É dividido em Expressa (até US$ 50 mil/semestre), Limitada (até US$ 160 mil/semestre) e Ilimitada (acima de US$ 160 mil). Nossa equipe organiza a capacidade financeira da empresa e faz o protocolo para obtenção e revisão de limite."
  },
  {
    q: "Como fica o TTD de Santa Catarina com a Reforma Tributária?",
    a: "Os incentivos fiscais estaduais como o TTD de SC possuem transição garantida pela Emenda Constitucional nº 132/2023 até 2032 através do Fundo de Compensação de Benefícios Fiscais. Estruturar sua trading agora garante segurança jurídica e competitividade durante toda a fase de transição."
  }
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogUrl={ogUrl}
  schema={schema}
  heroInterno
  bodyClass="pagina-importacao"
>
  <!-- HERO SECTION -->
  <section class="relative bg-slate-900 text-white py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block py-1.5 px-4 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold tracking-wide uppercase mb-6 border border-blue-400/30">
          Assessoria Tributária em Comércio Exterior • Hub Portuário de SC
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-6">
          Contabilidade Especializada para Importadoras e Tradings em Santa Catarina
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed">
          Reduza a carga tributária da sua importação com o TTD 409/410, habilite sua empresa no RADAR Siscomex e opere com conformidade fiscal e desembaraço ágil pelos portos de Itajaí, Navegantes, Itapoá e São Francisco do Sul.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-xl text-white bg-green-600 hover:bg-green-700 shadow-lg shadow-green-600/30 transition duration-200"
          >
            Solicitar Análise de Viabilidade do TTD
          </a>
          <a
            href="#solucoes"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-xl text-slate-200 bg-slate-800 hover:bg-slate-700 border border-slate-700 transition duration-200"
          >
            Conhecer Soluções de Comex
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CARDS PROVAS E DIFERENCIAIS -->
  <section class="py-10 bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-white rounded-xl shadow-sm border border-slate-200">
          <p class="text-3xl font-extrabold text-blue-900 mb-1">TTD 409 e 410</p>
          <p class="text-sm font-medium text-slate-600">Implantação e Manutenção na SEF/SC</p>
        </div>
        <div class="p-4 bg-white rounded-xl shadow-sm border border-slate-200">
          <p class="text-3xl font-extrabold text-blue-900 mb-1">0,6% a 2,6%</p>
          <p class="text-sm font-medium text-slate-600">Carga Efetiva de ICMS Interestadual</p>
        </div>
        <div class="p-4 bg-white rounded-xl shadow-sm border border-slate-200">
          <p class="text-3xl font-extrabold text-blue-900 mb-1">RADAR Siscomex</p>
          <p class="text-sm font-medium text-slate-600">Habilitação e Revisão de Limites</p>
        </div>
        <div class="p-4 bg-white rounded-xl shadow-sm border border-slate-200">
          <p class="text-3xl font-extrabold text-blue-900 mb-1">35+ Anos</p>
          <p class="text-sm font-medium text-slate-600">Tradição e Governança Fiscal em SC</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GARGALOS DAS IMPORTADORAS -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          Onde as importadoras mais perdem dinheiro e tempo na aduana?
        </h2>
        <p class="text-lg text-slate-600">
          A complexidade das operações de comércio exterior exige controle milimétrico. Pequenas falhas fiscais, aduaneiras e de parametrização geram custos ocultos que corroem a margem da sua operação.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:shadow-md transition">
          <div class="w-12 h-12 bg-red-100 text-red-700 rounded-xl flex items-center justify-center font-bold text-xl mb-4">1</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Desembaraço Travado por NF-e de Entrada</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Erros na composição da base de cálculo do ICMS na Nota Fiscal de Entrada da DI/Duimp (II, IPI, PIS, COFINS, Taxa Siscomex, AFRMM e capatazia).
          </p>
        </div>

        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:shadow-md transition">
          <div class="w-12 h-12 bg-red-100 text-red-700 rounded-xl flex items-center justify-center font-bold text-xl mb-4">2</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Perda do Benefício Fiscal do TTD</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Descumprimento de obrigações acessórias estaduais (DIME, DCIP e EFD-ICMS/IPI) ou falta de recolhimento de fundos obrigatórios (Fundo Pró-Emprego/Fundo Social).
          </p>
        </div>

        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:shadow-md transition">
          <div class="w-12 h-12 bg-red-100 text-red-700 rounded-xl flex items-center justify-center font-bold text-xl mb-4">3</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Limite Insuficiente no RADAR</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Trava de importação na modalidade Expressa (US$ 50 mil) por falta de comprovação de capacidade financeira perante a Receita Federal.
          </p>
        </div>

        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:shadow-md transition">
          <div class="w-12 h-12 bg-red-100 text-red-700 rounded-xl flex items-center justify-center font-bold text-xl mb-4">4</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Bitributação e Glosa de Créditos</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Problemas na retenção de tributos federais e na aplicação da alíquota interestadual de 4% da Resolução do Senado nº 13/2012.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NOSSAS SOLUÇÕES PARA COMÉRCIO EXTERIOR -->
  <section id="solucoes" class="py-16 lg:py-24 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold uppercase tracking-wider text-sm">Nossa Expertise</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2 mb-4">
          Gestão Contábil, Aduaneira e Fiscal de Ponta a Ponta
        </h2>
        <p class="text-lg text-slate-600">
          Integração dos dados da nacionalização à venda interestadual com foco em conformidade fiscal e redução legal da carga tributária.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Pleito e Gestão do TTD 409/410/411</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Solicitação inicial, acompanhamento junto à SEF/SC e apuração mensal rigorosa do crédito presumido de ICMS.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Habilitação e Aumento de RADAR Siscomex</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Auditoria do balanço patrimonial, comprovação de capacidade contributiva via DCTFWeb/eSocial e protocolo junto à Receita Federal.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Parametrização da NF-e de Importação</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Validação de CFOPs (3.101, 3.102), NCMs, CSTs e cálculo automatizado dos impostos incidentes na nacionalização.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Planejamento: Importação Própria, Encomenda ou Conta e Ordem</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Estruturação societária e contratual para tradings atenderem clientes em todo o território nacional.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Abertura de Tradings e Filiais Portuárias</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Constituição societária ágil em Blumenau, Itajaí, Navegantes ou Joinville para usufruir dos incentivos catarinenses.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TABELA COMPARATIVA (IMPORTAÇÃO TRADICIONAL VS. TTD 409 SC) -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          Importação Comum vs. TTD 409: O Diferencial Catarinense
        </h2>
        <p class="text-lg text-slate-600">
          Veja por que importar por Santa Catarina com o TTD 409 é a escolha estratégica para tradings e importadoras:
        </p>
      </div>

      <div class="overflow-x-auto shadow-sm rounded-2xl border border-slate-200">
        <table class="w-full text-left text-sm text-slate-700">
          <thead class="bg-slate-900 text-white font-semibold">
            <tr>
              <th class="py-4 px-6">Etapa Fiscal</th>
              <th class="py-4 px-6">Importação Comum (Outros Estados)</th>
              <th class="py-4 px-6">Importação em SC com TTD 409</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-slate-50">
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">ICMS no Desembaraço</td>
              <td class="py-4 px-6">Pagamento à vista de 17% a 19% antes de liberar a carga</td>
              <td class="py-4 px-6 font-bold text-green-700">Diferimento Total (zero desembolso no desembaraço aduaneiro)</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Impacto no Caixa</td>
              <td class="py-4 px-6">Descapitalização imediata na nacionalização do contêiner</td>
              <td class="py-4 px-6 font-bold text-green-700">Fluxo de caixa 100% preservado até a venda da mercadoria</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">ICMS Efetivo na Venda Interestadual</td>
              <td class="py-4 px-6">Carga de 4% com acúmulo de créditos de difícil ressarcimento</td>
              <td class="py-4 px-6 font-bold text-green-700">Crédito Presumido resultando em carga efetiva de 0,6% a 2,6%</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Segurança Jurídica</td>
              <td class="py-4 px-6">Sujeito a glosas fiscais e bitributação</td>
              <td class="py-4 px-6 font-bold text-green-700">Regime especial consolidado e resguardado pela legislação de SC</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- TERMINAIS E PORTOS ATENDIDOS -->
  <section class="py-16 lg:py-20 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold mb-4">
          Operações Integradas nos Maiores Portos e Aeroportos de SC
        </h2>
        <p class="text-slate-300">
          Atendimento presencial e suporte digital nos terminais que movimentam o comércio exterior catarinense:
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-slate-800 rounded-xl border border-slate-700">
          <h3 class="font-bold text-xl text-blue-400 mb-2">Complexo Portuário Itajaí / Navegantes (Portonave)</h3>
          <p class="text-slate-300 text-sm">Maior polo de movimentação de contêineres e tradings do Sul do Brasil.</p>
        </div>
        <div class="p-6 bg-slate-800 rounded-xl border border-slate-700">
          <h3 class="font-bold text-xl text-blue-400 mb-2">Porto de Itapoá</h3>
          <p class="text-slate-300 text-sm">Terminal de águas profundas de alta tecnologia para navios de grande porte.</p>
        </div>
        <div class="p-6 bg-slate-800 rounded-xl border border-slate-700">
          <h3 class="font-bold text-xl text-blue-400 mb-2">Porto de São Francisco do Sul</h3>
          <p class="text-slate-300 text-sm">Referência em granéis sólidos, químicos e cargas industriais.</p>
        </div>
        <div class="p-6 bg-slate-800 rounded-xl border border-slate-700">
          <h3 class="font-bold text-xl text-blue-400 mb-2">Aeroportos Internacionais (Navegantes e Florianópolis)</h3>
          <p class="text-slate-300 text-sm">Desembaraço aduaneiro aéreo de componentes eletrônicos, insumos urgentes e cargas fracionadas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Perguntas Frequentes sobre TTD e Importação em SC</h2>
        <p class="text-slate-600">Tire suas dúvidas sobre benefícios fiscais, RADAR Siscomex e comércio exterior.</p>
      </div>

      <div class="space-y-6">
        {faqs.map(faq => (
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{faq.q}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-16 bg-blue-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-6">
        Quer importar por Santa Catarina com a menor carga tributária do país?
      </h2>
      <p class="text-lg text-blue-100 mb-8 max-w-2xl mx-auto">
        Fale com os consultores de comércio exterior da JMF Contabilidade. Analisamos a viabilidade do TTD 409 e o enquadramento do seu RADAR para sua empresa operar com máxima economia e conformidade.
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-10 py-5 text-lg font-bold rounded-2xl text-slate-900 bg-green-400 hover:bg-green-300 shadow-xl shadow-green-500/30 transition duration-200"
      >
        Falar com um Especialista em TTD e Importação
      </a>
      <p class="mt-4 text-xs text-blue-200">Atendimento rápido via WhatsApp • Sede em Blumenau/SC</p>
    </div>
  </section>
</Layout>