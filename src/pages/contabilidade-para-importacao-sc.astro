const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "O que é o TTD 409 em Santa Catarina e quem pode solicitar?", "acceptedAnswer": { "@type": "Answer", "text": "O TTD 409 (Tratamento Tributário Diferenciado) é um regime especial concedido pela SEF/SC que permite o diferimento do ICMS no desembaraço aduaneiro de mercadorias importadas por portos e aeroportos catarinenses e concede crédito presumido na saída interestadual, reduzindo a carga tributária efetiva de ICMS para percentuais entre 0,6% e 2,6%." } },
    { "@type": "Question", "name": "Qual o regime tributário necessário para usufruir do TTD de Importação?", "acceptedAnswer": { "@type": "Answer", "text": "A empresa deve ser optante pelo Lucro Real ou Lucro Presumido. Empresas do Simples Nacional não podem usufruir do crédito presumido do TTD, sendo altamente recomendada a abertura de uma trading ou filial específica no Lucro Real/Presumido para operar o benefício." } },
    { "@type": "Question", "name": "Como funciona a habilitação no RADAR Siscomex?", "acceptedAnswer": { "@type": "Answer", "text": "O RADAR é a licença concedida pela Receita Federal para operar no comércio exterior. É dividido em Expressa (até US$ 50 mil/semestre), Limitada (até US$ 160 mil/semestre) e Ilimitada (acima de US$ 160 mil). Nossa equipe organiza a capacidade financeira da empresa e faz o protocolo para obtenção e revisão de limite." } },
    { "@type": "Question", "name": "Como fica o TTD de Santa Catarina com a Reforma Tributária?", "acceptedAnswer": { "@type": "Answer", "text": "Os incentivos fiscais estaduais como o TTD de SC possuem transição garantida pela Emenda Constitucional nº 132/2023 até 2032 através do Fundo de Compensação de Benefícios Fiscais. Estruturar sua trading agora garante segurança jurídica e competitividade durante toda a fase de transição." } }
