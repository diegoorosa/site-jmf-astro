      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Parametrização da NF-e de Importação" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abertura de tradings e filiais em SC" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Planejamento tributário de importação" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
