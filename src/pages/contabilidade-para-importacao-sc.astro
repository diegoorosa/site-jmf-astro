import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const WAsim = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20quero%20avaliar%20o%20benef%C3%ADcio%20fiscal%20do%20TTD%20409%2F410%20e%20a%20abertura%20de%20filial%20importadora%20em%20SC.";

