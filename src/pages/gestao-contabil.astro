  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "O que a gestão contábil proporciona?", "acceptedAnswer": { "@type": "Answer", "text": "A gestão contábil registra, organiza e interpreta todas as movimentações financeiras da empresa, transformando dados em decisões estratégicas. Inclui Balanços Patrimoniais e DRE mensais precisos, além de relatórios que mostram onde o negócio ganha e perde dinheiro. Conforme as normas do CFC (ITG 1000), toda empresa é obrigada a manter escrituração contábil regular." } },
    { "@type": "Question", "name": "Quais são as vantagens da gestão contábil?", "acceptedAnswer": { "@type": "Answer", "text": "Previsibilidade (balanços mensais precisos para saber antecipadamente quanto pagar de imposto), precificação segura (custos reais calculados corretamente), decisões embasadas em dados, acesso facilitado a crédito (bancos exigem demonstrações financeiras) e proteção patrimonial do sócio contra responsabilização em autuação fiscal." } },
    { "@type": "Question", "name": "Quais são as tarefas que a gestão contábil executa?", "acceptedAnswer": { "@type": "Answer", "text": "Mensalmente: escrituração contábil, apuração de tributos, emissão de guias e conciliação bancária. Anualmente: Balanço Patrimonial e DRE. Obrigações acessórias: ECD e ECF ao SPED, PGDAS-D para Simples Nacional. Additionally, Informe de Rendimentos anual para sócios e relatórios gerenciais customizados." } },
    { "@type": "Question", "name": "Como posso ter o suporte da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123 com retorno no mesmo dia útil. Reunião de diagnóstico gratuita no escritório (Rua Rodolfo Freygang, 15, Sala 506, Centro, Blumenau) ou remotamente. Empresas que migraram de outro escritório passam por onboarding estruturado com regularização de pendências." } },
    { "@type": "Question", "name": "Fazem gestão contábil de empresas de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade presta gestão contábil para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com escrituração e envio de relatórios totalmente digitais." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];
---

<Layout
  title="Gestão Contábil em Blumenau | JMF Contabilidade"
  description="Gestão contábil em Blumenau/SC: escrituração, balanços, DRE, ECD e SPED no prazo. Balancete mensal entregue até o dia 15. Mais de 35 anos de experiência."
  canonical="https://www.jmfcontabilidade.com.br/gestao-contabil"
  ogUrl="https://www.jmfcontabilidade.com.br/gestao-contabil"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Gestão Contábil para Empresas em Blumenau/SC"
    subtitle="Mantenha sua empresa organizada, em conformidade e pronta..."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Gestão Contábil" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver vantagens", href: "#vantagens", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: agosto de 2026</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-6">Gestão Contábil:<br/><span class="pp3-grad">escrituração precisa para decisões seguras</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A gestão contábil vai muito além de cumprir obrigações fiscais. É a base para decisões estratégicas: precificação correta, controle de custos, análise de rentabilidade por produto ou filial, e preparação de demonstrações financeiras que bancos e investidores exigem.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A JMF Contabilidade entrega balancete mensal até o dia 15, com conciliação bancária completa e apuração de tributos no prazo. Nossa equipe atende empresas de Blumenau, Indaial, Gaspar, Pomerode, Timbó e região — 100% digital quando você preferir.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Balanços e DRE Mensais</h3>
          <p class="text-slate-600 leading-relaxed">
            Balanço Patrimonial e DRE entregues até o dia 15 do mês seguinte. Conciliação bancária, apuração de resultado e análise de variações incluídas.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Obrigações Acessórias (SPED)</h3>
          <p class="text-slate-600 leading-relaxed">
            ECD, ECF, DCTF, EFD-Contribuições e PGDAS-D transmitidos no prazo. Sem multas por atraso ou erros de preenchimento.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Relatórios Gerenciais</h3>
          <p class="text-slate-600 leading-relaxed">
            DRE por centro de custo, fluxo de caixa projetado, indicadores de rentabilidade e liquidez. Dados para você decidir com confiança.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Análise de Custos</h3>
          <p class="text-slate-600 leading-relaxed">
            Custeio por absorção e variável, ponto de equilíbrio, margem de contribuição. Precificação baseada em custo real, não em chute.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Particularidades -->
  <section class="py-16 bg-slate-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">O que diferencia<br/><span class="pp3-grad">nossa gestão contábil</span></h2>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Prazo garantido:</strong> balancete até o dia 15. Se não entregarmos no prazo, o mês é por nossa conta.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Conciliação 100%:</strong> todas as contas conciliadas mensalmente — bancos, cartões, contas a receber/pagar.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>SPED sem erro:</strong> validação automática + revisão manual antes de transmitir. Zero retrabalho.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Relatórios que você entende:</strong> sem "contabilês". DRE comentada, gráficos de evolução, alertas de desvios.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Dica:</strong> empresas que migram para a JMF ganham diagnóstico gratuito de pendências contábeis e fiscais — regularizamos tudo antes de assumir a rotina.
        </p>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Como funciona<br/><span class="pp3-grad">a rotina contábil</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>1. Envio de documentos:</strong> portal do cliente, WhatsApp ou e-mail. Notas fiscais, extratos, comprovantes — tudo digital.
        </p>
        <p>
          <strong>2. Escrituração e conciliação:</strong> nossa equipe lança, concilia e apura. Dúvidas são resolvidas no mesmo dia via WhatsApp.
        </p>
        <p>
          <strong>3. Entrega do balancete:</strong> até o dia 15, com DRE, balanço, conciliações e relatório de pendências (se houver).
        </p>
        <p>
          <strong>4. Reunião mensal (opcional):</strong> videoconferência de 15-30 min para revisar números, alinhar expectativas e planejar o mês seguinte.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Quer balancete no prazo<br/><span class="pp3-grad-light">e relatórios que você entende?</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        35+ anos de experiência, balancete até o dia 15, SPED sem erro. Fale com a JMF e veja a diferença na sua gestão contábil.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Falar com Especialista
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - Gestão Contábil"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Dúvidas sobre<br />
            <span class="pp3-grad">gestão contábil</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">O que a gestão contábil proporciona?</summary>
              <div class="accordion-body">
                <p>A gestão contábil registra, organiza e interpreta todas as movimentações financeiras da empresa, transformando dados em decisões estratégicas. Inclui Balanços Patrimoniais e DRE mensais precisos, além de relatórios que mostram onde o negócio ganha e perde dinheiro. Conforme as normas do CFC (ITG 1000), toda empresa é obrigada a manter escrituração contábil regular.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Quais são as vantagens da gestão contábil?</summary>
              <div class="accordion-body">
                <p>Previsibilidade (balanços mensais precisos para saber antecipadamente quanto pagar de imposto), precificação segura (custos reais calculados corretamente), decisões embasadas em dados, acesso facilitado a crédito (bancos exigem demonstrações financeiras) e proteção patrimonial do sócio contra responsabilização em autuação fiscal.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Quais são as tarefas que a gestão contábil executa?</summary>
              <div class="accordion-body">
                <p>Mensalmente: escrituração contábil, apuração de tributos, emissão de guias e conciliação bancária. Anualmente: Balanço Patrimonial e DRE. Obrigações acessórias: ECD e ECF ao SPED, PGDAS-D para Simples Nacional. Além disso, Informe de Rendimentos anual para sócios e relatórios gerenciais customizados.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como posso ter o suporte da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>WhatsApp (47) 3326-5123 com retorno no mesmo dia útil. Reunião de diagnóstico gratuita no escritório (Rua Rodolfo Freygang, 15, Sala 506, Centro, Blumenau) ou remotamente. Empresas que migraram de outro escritório passam por onboarding estruturado com regularização de pendências.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Fazem gestão contábil de empresas de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade presta gestão contábil para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com escrituração e envio de relatórios totalmente digitais.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/planejamento-tributario-como-pagar-menos-imposto-legalmente"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento tributário</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">7 estratégias para pagar menos imposto legalmente em 2026</p>
        </a>
        <a href="/blog/pro-labore-e-dividendos-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Distribuição de resultados</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Pró-labore e dividendos 2026: quanto retirar e como pagar menos imposto</p>
        </a>
        <a href="/blog/holding-familiar-vale-a-pena-para-pequenos-empresarios"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento patrimonial</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Holding familiar: vale a pena para pequenos empresários?</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e vamos juntos<br/><span class="pp3-grad">fazer a diferença no seu negócio!</span></h2>
          <p class="text-gray-600 text-lg mb-6">Se você precisa de um parceiro estratégico em contabilidade, você encontrou o lugar certo. Entre em contato e marque uma consulta sem custo.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>