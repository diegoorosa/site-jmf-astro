---
import Layout from '../../layouts/Layout.astro';
import HeroInterno from '../../components/HeroInterno.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.pubDate <= new Date())).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
  }).format(date);
}

// Build ItemList schema with all blog posts
const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": posts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "url": `https://www.jmfcontabilidade.com.br/blog/${post.id}`,
      "datePublished": post.data.pubDate.toISOString(),
      "author": {
        "@type": "Person",
        "name": post.data.author || "Equipe JMF Contabilidade"
      },
      "image": post.data.image ? `https://www.jmfcontabilidade.com.br${post.data.image}` : undefined,
      "publisher": {
        "@type": "AccountingService",
        "name": "JMF Contabilidade",
        "url": "https://www.jmfcontabilidade.com.br"
      }
    }
  }))
});

const blogSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog JMF Contabilidade",
  "url": "https://www.jmfcontabilidade.com.br/blog",
  "description": "Artigos e notícias sobre contabilidade, tributação, abertura de empresa e empreendedorismo.",
  "publisher": {
    "@type": "AccountingService",
    "name": "JMF Contabilidade",
    "url": "https://www.jmfcontabilidade.com.br"
  },
  "blogPosts": posts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "url": `https://www.jmfcontabilidade.com.br/blog/${post.id}`,
    "datePublished": post.data.pubDate.toISOString()
  }))
});

const schema = [blogSchema, itemListSchema];
---

<Layout
  title="Blog JMF | Contabilidade, Tributação e Empreendedorismo"
  description="Blog JMF Contabilidade: guias práticos sobre tributação, Simples Nacional, IRPF, abertura de empresa e gestão para empresários em Blumenau/SC e todo o Brasil."
  canonical="https://www.jmfcontabilidade.com.br/blog"
  ogUrl="https://www.jmfcontabilidade.com.br/blog"
  schema={schema}
  heroInterno
>
  <HeroInterno
    title="Blog JMF Contabilidade"
    subtitle="Artigos, notícias e guias sobre tributação, abertura de empresa e empreendedorismo — escritos pela equipe JMF para ajudar seu negócio a crescer."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Blog" }
    ]}
  />

  <section class="py-16 bg-[#f8fafc] min-h-[50vh]">
    <div class="container mx-auto px-4">

      {posts.length === 0 ? (
        <p class="text-center text-gray-500 py-20">Nenhum artigo publicado ainda.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => (
            <article class="bg-white rounded-sm overflow-hidden border border-[#0f172a]/10 hover:border-[#1e40af] transition-colors duration-300 flex flex-col">
              {post.data.image ? (
                <a href={`/blog/${post.id}`} class="block overflow-hidden">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    width="800" height="400"
                  />
                </a>
              ) : (
                <a href={`/blog/${post.id}`} class="block w-full h-48 bg-gradient-to-br from-[#1e40af] to-[#0f172a] flex items-center justify-center">
                  <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </a>
              )}
              <div class="p-5 flex flex-col flex-1">
                <time
                  class="text-xs font-semibold text-[#1e40af] uppercase tracking-wider mb-2"
                  datetime={post.data.pubDate.toISOString()}
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <h2 class="text-base font-bold text-[#0f172a] mb-2 leading-snug">
                  <a href={`/blog/${post.id}`} class="hover:text-[#1e40af] transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm text-gray-500 line-clamp-3 mb-4 flex-1">{post.data.description}</p>
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm hover:gap-2 transition-all mt-auto group"
                >
                  Ler artigo
                  <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-[#0f172a]">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-2xl font-bold text-white mb-3">Ficou com dúvida sobre algum tema?</h2>
      <p class="text-white/70 mb-6">Nossa equipe responde no mesmo dia útil — sem custo e sem compromisso.</p>
      <a
        href="https://wa.me/554733265123?text=Ol%C3%A1%2C%20li%20um%20artigo%20no%20blog%20da%20JMF%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida."
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#25d366] hover:bg-[#22c55e] text-white font-bold rounded-xl transition-colors shadow-lg"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Falar com um Especialista
      </a>
    </div>
  </section>

</Layout>
