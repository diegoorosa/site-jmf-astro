          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fator R no Simples Nacional (Redução para 6%)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Adequação à Lei do Bem (Inovação Tecnológica)" } },
