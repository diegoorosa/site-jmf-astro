---
import Layout from '../../layouts/Layout.astro';
import HeroInterno from '../../components/HeroInterno.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.pubDate <= new Date());

  // Definir os autores suportados
  const authors = [
    {
      slug: 'diego-rosa',
      name: 'Diego Rosa',
      role: 'Sócio-Administrador & Head de TI/Operações',
      title: 'Contador e Especialista em Cloud',
      crc: 'CRC SC-035810/O',
      bio: 'Sócio-administrador e líder de Operações e TI da JMF Contabilidade, atuando na empresa desde 2006. É Bacharel em Ciências Contábeis pela FURB (2010) e certificado AWS Certified Cloud Practitioner. Une a sólida experiência fiscal e contábil à tecnologia aplicada, desenvolvendo integrações com Inteligência Artificial, ferramentas internas e fluxos de automação em Python e n8n para entregar uma gestão ágil e moderna.',
      image: '/assets/images/team-diego.webp',
      imageAlt: 'Diego Schlemper Rosa — Sócio-Administrador, CRC SC-035810/O',
    },
    {
      slug: 'fabricio-rosa',
      name: 'Fabricio Rosa',
      role: 'Sócio-Administrador & Consultor Societário',
      title: 'Contador e Especialista Tributário',
      crc: 'CRC SC-029833/O',
      bio: 'Sócio-administrador da JMF Contabilidade, atuando na empresa desde 2001. Bacharel em Ciências Contábeis pela FURB (2007) e pós-graduado em Contabilidade e Gestão Tributária (2011). É o especialista responsável pelas áreas de Legalização e Direito Societário do escritório, liderando a constituição de novas empresas, transformações societárias complexas, elaboração de contratos sociais personalizados e alterações contratuais estratégicas na JUCESC, além de atuar no planejamento fiscal preventivo nos regimes Simples Nacional, Lucro Presumido e Lucro Real.',
      image: '/assets/images/team-fabricio.webp',
      imageAlt: 'Fabricio Rosa — Sócio-Administrador, CRC SC-029833/O',
    },
    {
      slug: 'joel-rosa',
      name: 'Joel Rosa',
      role: 'Fundador & Conselheiro Estratégico',
      title: 'Contador Sênior',
      crc: 'CRC SC-007091/O',
      bio: 'Fundador da JMF Contabilidade, com mais de 55 anos de sólida trajetória contábil e empresarial. Técnico em Contabilidade desde 1971 e Bacharel em Ciências Contábeis pela FURB (1987), fundou o escritório em 1989. Atua como conselheiro sênior e mentor consultivo, com ampla vivência em grupos econômicos, governança corporativa, planejamento sucessório e reestruturações complexas. Acompanhou de perto todas as grandes transições fiscais e econômicas do país, sendo a referência técnica e a bússola de segurança jurídica para os clientes da JMF.',
      image: '/assets/images/team-joel.webp',
      imageAlt: 'Joel Rosa — Fundador & Sócio, CRC SC-007091/O',
    },
  ];

  // Gerar slugs válidos
  function slugify(str: string): string {
    return str
      .toLowerCase()
      .replace(/[áàãâä]/g, 'a')
      .replace(/[éèêë]/g, 'e')
      .replace(/[íìîï]/g, 'i')
      .replace(/[óòõôö]/g, 'o')
      .replace(/[úùûü]/g, 'u')
      .replace(/ç/g, 'c')
      .replace(/\s+/g, '-');
  }

  const paths = authors.flatMap(author => {
    // Filtrar posts deste autor batendo diretamente pelo slug cadastrado ou nome completo
    const authorPosts = posts
      .filter(post => {
        const postAuthor = post.data.author.split(',')[0].trim();
        const postAuthorSlug = slugify(postAuthor);
        return postAuthorSlug === author.slug || postAuthorSlug === slugify(author.name);
      })
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { slug: author.slug },
      props: { author, posts: authorPosts },
    };
  });

  return paths;
}

const { author, posts } = Astro.props;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
  }).format(date);
}

// Schema ProfilePage + Person
const profileSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["ProfilePage", "Person"],
  "name": author.name,
  "alternateName": author.name,
  "description": `${author.role} na JMF Contabilidade. ${author.bio}`,
  "url": `https://www.jmfcontabilidade.com.br/autor/${author.slug}`,
  "image": `https://www.jmfcontabilidade.com.br${author.image}`,
  "sameAs": [
    "https://www.linkedin.com/company/jmf-contabilidade",
    "https://www.instagram.com/jmfcontabilidade",
  ],
  "jobTitle": author.title,
  "worksFor": {
    "@type": "AccountingService",
    "name": "JMF Contabilidade",
    "url": "https://www.jmfcontabilidade.com.br",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "postalCode": "89010-060",
      "addressCountry": "BR"
    },
    "telephone": "+55-47-3326-5123",
    "email": "contato@jmfcontabilidade.com.br"
  },
  "knowsAbout": [
    "Contabilidade",
    "Tributação",
    "Planejamento Tributário",
    "Simples Nacional",
    "Lucro Presumido",
    "Abertura de Empresa"
  ],
  "credential": author.crc,
});

const ogImageUrl = `https://www.jmfcontabilidade.com.br${author.image}`;

const WA = `https://wa.me/554733265123?text=Ol%C3%A1%2C%20vi%20o%20perfil%20de%20${encodeURIComponent(author.name)}%20no%20site%20da%20JMF%20e%20gostaria%20de%20falar%20com%20um%20especialista.`;

---

<Layout
  title={`${author.name} | Autor JMF Contabilidade`}
  description={`${author.role} e ${author.title} na JMF Contabilidade. ${author.crc}. ${author.bio.slice(0, 150)}...`}
  canonical={`https://www.jmfcontabilidade.com.br/autor/${author.slug}`}
  ogUrl={`https://www.jmfcontabilidade.com.br/autor/${author.slug}`}
  ogImage={ogImageUrl}
  schema={profileSchema}
  heroInterno
>
  <Fragment slot="head">
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content={author.name.split(' ')[0]} />
    <meta property="profile:last_name" content={author.name.split(' ').slice(1).join(' ')} />
    <meta property="profile:username" content={author.slug} />
  </Fragment>

  <HeroInterno
    title={author.name}
    subtitle={`${author.role} · ${author.title} · ${author.crc}`}
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Blog", href: "https://www.jmfcontabilidade.com.br/blog" },
      { label: "Autores", href: "https://www.jmfcontabilidade.com.br/autor" },
      { label: author.name }
    ]}
  />

  <!-- Author Header / Profile Card -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
        <img
          src={author.image}
          alt={author.imageAlt}
          width="160"
          height="160"
          loading="eager"
          class="w-28 h-28 md:w-32 md:h-32 rounded-full object-cover flex-shrink-0 shadow-lg ring-4 ring-white"
        />
        <div class="text-center md:text-left flex-1">
          <h1 class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-2">{author.name}</h1>
          <p class="text-lg text-[#1e40af] font-semibold mb-1">{author.role}</p>
          <p class="text-lg text-gray-600 mb-1">{author.title} — {author.crc}</p>
          <p class="text-gray-600 mt-4 max-w-2xl mx-auto md:mx-0 leading-relaxed">{author.bio}</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4 justify-center md:justify-start">
        <a
          href="https://wa.me/554733265123"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[#25d366] hover:bg-[#22c55e] text-white font-bold rounded-xl transition-colors shadow-md"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Falar com {author.name.split(' ')[0]}
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-bold rounded-xl hover:bg-[#1e40af] hover:text-white transition-colors"
        >
          Ver todos os artigos
        </a>
      </div>
    </div>
  </section>

  <!-- Artigos do Autor -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0f172a]">
          Artigos de {author.name.split(' ')[0]}
        </h2>
        <span class="text-sm text-gray-500 bg-white px-3 py-1 rounded-full border border-gray-200">
          {posts.length} artigo{posts.length !== 1 ? 's' : ''}
        </span>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-20 bg-white rounded-2xl border border-gray-100">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <p class="text-gray-500 text-lg">Nenhum artigo publicado por este autor ainda.</p>
          <a href="/blog" class="mt-4 inline-flex items-center gap-1 text-[#1e40af] font-semibold hover:underline">
            Ver todos os artigos do blog
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => {
            // Gerar slug do autor do post para link
            const postAuthorName = post.data.author.split(',')[0].trim();
            const postAuthorSlug = postAuthorName
              .toLowerCase()
              .replace(/[áàãâä]/g, 'a')
              .replace(/[éèêë]/g, 'e')
              .replace(/[íìîï]/g, 'i')
              .replace(/[óòõôö]/g, 'o')
              .replace(/[úùûü]/g, 'u')
              .replace(/ç/g, 'c')
              .replace(/\s+/g, '-');

            return (
              <article class="bg-white rounded-sm overflow-hidden border border-[#0f172a]/10 hover:border-[#1e40af] transition-colors duration-300 flex flex-col">
                {post.data.image ? (
                  <a href={`/blog/${post.id}`} class="block overflow-hidden">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt || post.data.title}
                      class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                      width="800" height="400"
                    />
                  </a>
                ) : (
                  <a href={`/blog/${post.id}`} class="block w-full h-48 bg-gradient-to-br from-[#1e40af] to-[#0f172a] flex items-center justify-center">
                    <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </a>
                )}
                <div class="p-5 flex flex-col flex-1">
                  <time
                    class="text-xs font-semibold text-[#1e40af] uppercase tracking-wider mb-2"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <h2 class="text-base font-bold text-[#0f172a] mb-2 leading-snug">
                    <a href={`/blog/${post.id}`} class="hover:text-[#1e40af] transition-colors">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-sm text-gray-500 line-clamp-3 mb-4 flex-1">{post.data.description}</p>
                  <div class="flex items-center justify-between">
                    <a
                      href={`/autor/${postAuthorSlug}`}
                      class="text-xs text-gray-400 hover:text-[#1e40af] transition-colors"
                    >
                      {post.data.author.split(',')[0].trim()}
                    </a>
                    <a
                      href={`/blog/${post.id}`}
                      class="inline-flex items-center gap-1 text-[#1e40af] font-semibold text-sm hover:gap-2 transition-all group"
                    >
                      Ler artigo
                      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-[#0f172a]">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-2xl font-bold text-white mb-3">Precisa de orientação contábil especializada?</h2>
      <p class="text-white/70 mb-6">{author.name.split(' ')[0]} e a equipe JMF respondem no mesmo dia útil — sem custo e sem compromisso.</p>
      <a
        href={WA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#25d366] hover:bg-[#22c55e] text-white font-bold rounded-xl transition-colors shadow-lg"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Falar com um Especialista
      </a>
    </div>
  </section>

</Layout>

<style is:global>
  .prose-jmf {
    font-size: 1.125rem;
    line-height: 1.85;
    color: #1e293b;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
</style>
