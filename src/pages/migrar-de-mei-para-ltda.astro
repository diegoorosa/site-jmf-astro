---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20quero%20migrar%20de%20MEI%20para%20LTDA%20e%20preciso%20de%20orienta%C3%A7%C3%A3o.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/migrar-de-mei-para-ltda#localbusiness",
  "name": "JMF Contabilidade – Migração MEI para LTDA Blumenau",
  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/migrar-de-mei-para-ltda",
  "description": "Migração de MEI para LTDA em Blumenau/SC: processo completo, custos reais, simulação tributária e onboarding contábil. Atendimento digital para todo o Médio Vale.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89010-060",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.92016,
    "longitude": -49.06705
  },
  "foundingDate": "1989-05-24",
  "areaServed": [
    { "@type": "City", "name": "Blumenau" },
    { "@type": "City", "name": "Indaial" },
    { "@type": "City", "name": "Gaspar" },
    { "@type": "City", "name": "Pomerode" },
    { "@type": "City", "name": "Timbó" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Migração MEI → LTDA",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnóstico e Simulação Tributária" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Elaboração de Contrato Social" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Registro na JUCESC e CNPJ" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Baixa do MEI e Regularização" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Onboarding Contábil Completo" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
    "https://www.linkedin.com/company/jmf-contabilidade/",
    "https://twitter.com/jmfcontab",
    "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
    "https://www.yelp.com/biz/jmf-contabilidade-escrit%C3%B3rio-de-contabilidade-blumenau",
    "https://www.apontador.com.br/local/sc/blumenau/assessoria_contabil/6a43ca8942af5752cc2a601d/jmf_contabilidade.html"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "00:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Quando devo migrar de MEI para LTDA?", "acceptedAnswer": { "@type": "Answer", "text": "Os principais sinais são: faturamento próximo ou acima de R$ 81.000/ano, necessidade de ter sócios, demanda por contratos com empresas que exigem LTDA, desejo de proteção patrimonial e oportunidade de distribuir lucros isentos de IR. A JMF faz a análise gratuita para definir o melhor momento." } },
    { "@type": "Question", "name": "Quanto custa migrar de MEI para LTDA?", "acceptedAnswer": { "@type": "Answer", "text": "Os custos incluem: taxa JUCESC (~R$ 300-500), alvará de funcionamento (~R$ 200-400), inscrições estadual e municipal, e honorários contábeis. O custo total varia conforme a atividade e o tipo de empresa. A JMF apresenta o orçamento completo antes de iniciar o processo." } },
    { "@type": "Question", "name": "Quanto tempo leva o processo de migração?", "acceptedAnswer": { "@type": "Answer", "text": "O processo leva de 5 a 15 dias úteis dependendo da atividade. Inclui: baixa do MEI (quando aplicável), registro da LTDA na JUCESC, obtenção do novo CNPJ, inscrições estadual e municipal, e alvará de funcionamento. A JMF cuida de todos os trâmites sem que você precise ir a nenhum órgão." } },
    { "@type": "Question", "name": "O que muda nos impostos ao virar LTDA?", "acceptedAnswer": { "@type": "Answer", "text": "Como MEI, você paga um DAS fixo (R$ 82 a R$ 87/mês em 2026). Como LTDA no Simples Nacional, os impostos são calculados por faixa de faturamento (6% a 33%). Para muitas empresas, a diferença é compensada pela possibilidade de distribuir lucros isentos de IR e deduzir despesas reais. A JMF faz a simulação comparativa antes da migração." } },
    { "@type": "Question", "name": "Posso continuar atendendo os mesmos clientes após a migração?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. A mudança de MEI para LTDA não afeta seus contratos ou relacionamento com clientes. O que muda é a estrutura jurídica e tributária da empresa. A JMF cuida da transferência de inscrições e regularização para que não haja interrupção nas atividades." } },
    { "@type": "Question", "name": "Fazem a migração de MEI para LTDA em Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade conduz a migração de MEI para LTDA para empreendedores de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com todo o processo feito digitalmente." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];
---

<Layout
  title="Migrar de MEI para LTDA em Blumenau/SC | JMF Contabilidade"
  description="Migração de MEI para LTDA em Blumenau/SC: processo completo, custos reais, o que muda nos impostos e como fazer a transição sem problemas."
  canonical="https://www.jmfcontabilidade.com.br/migrar-de-mei-para-ltda"
  ogUrl="https://www.jmfcontabilidade.com.br/migrar-de-mei-para-ltda"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Migrar de MEI para LTDA em Blumenau/SC"
    subtitle="O negócio cresceu e o MEI não comporta mais — processo completo, custos reais, simulação tributária e onboarding contábil com acompanhamento digital para todo o Médio Vale."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Migração MEI → LTDA" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver o processo", href: "#processo", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: junho de 2026</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Chegou a hora de<br/><span class="pp3-grad">"se graduar"</span></h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            O MEI foi o ponto de partida ideal para formalizar seu negócio. Mas quando o faturamento cresce, o número de clientes aumenta ou a empresa precisa de sócios, a estrutura do MEI começa a limitar — e migrar para uma LTDA deixa de ser opção e vira necessidade.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            A boa notícia: o processo é mais rápido e simples do que parece — <strong>desde que feito com orientação correta</strong>. A JMF Contabilidade cuida de toda a transição para que você não perca tempo nem pague mais do que deve.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Migração de MEI para LTDA — JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- Sinais de que é hora de migrar -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block bg-[#dbeafe] text-[#1e40af] text-xs font-semibold px-3 py-1 rounded-full mb-4">QUANDO MIGRAR</span>
        <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Sinais de que o MEI<br/><span class="pp3-grad">já não é suficiente</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {[
          { icon: "bi-graph-up-arrow", title: "Faturamento acima de R$ 81 mil", desc: "O limite do MEI não é corrigido desde 2019. Se seu faturamento anual se aproxima ou ultrapassou R$ 81 mil, o desenquadramento é obrigatório." },
          { icon: "bi-people", title: "Quer ter sócios", desc: "O MEI é individual por definição. Se você vai se associar com alguém, precisará de outra estrutura jurídica." },
          { icon: "bi-shield-check", title: "Proteção patrimonial", desc: "No MEI, o patrimônio pessoal responde pelas dívidas sem limite. Na LTDA, a responsabilidade é limitada ao capital social." },
          { icon: "bi-cash-stack", title: "Distribuição de lucros isenta", desc: "Na LTDA regularmente escriturada, a distribuição de lucros para os sócios é isenta de Imposto de Renda. Essa vantagem não existe no MEI." },
          { icon: "bi-building", title: "Credibilidade para contratos", desc: "Muitas empresas médias e grandes exigem fornecedores com CNPJ em LTDA. O MEI pode ser um impedimento." },
          { icon: "bi-calculator", title: "Regime tributário mais vantajoso", desc: "Com faturamento maior, o Simples Nacional como LTDA pode resultar em carga tributária menor proporcionalmente ao que o MEI pagaria." }
        ].map(s => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md transition-all">
            <div class="w-12 h-12 bg-[#dbeafe] rounded-xl flex items-center justify-center mb-4">
              <i class={`bi ${s.icon} text-[#1e40af] text-xl`}></i>
            </div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-2">{s.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Processo -->
  <section id="processo" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block bg-[#dbeafe] text-[#1e40af] text-xs font-semibold px-3 py-1 rounded-full mb-4">COMO FUNCIONA</span>
        <h2 class="text-3xl font-bold text-[#0f172a] mb-4">O processo de migração<br/><span class="pp3-grad">passo a passo</span></h2>
        <p class="text-gray-500 text-lg">A JMF cuida de cada etapa para que você não precise ir a nenhum órgão.</p>
      </div>
      <div class="max-w-4xl mx-auto space-y-6">
        {[
          { step: "1", title: "Diagnóstico gratuito", desc: "Analisamos sua situação atual: faturamento, atividade, regime tributário e definimos se a migração faz sentido e qual o melhor tipo jurídico (Ltda., SLU)." },
          { step: "2", title: "Simulação tributária", desc: "Comparamos a carga tributária como MEI versus LTDA nos regimes Simples Nacional e Lucro Presumido, usando seus números reais." },
          { step: "3", title: "Documentação", desc: "Coletamos RG, CPF, comprovante de residência e endereço comercial de cada sócio. A JMF elabora o contrato social e toda a documentação necessária." },
          { step: "4", title: "Registro e abertura", desc: "Registro na JUCESC, CNPJ na Receita Federal, inscrição estadual na Sefaz-SC, inscrição municipal na Prefeitura de Blumenau e alvará de funcionamento." },
          { step: "5", title: "Baixa do MEI (se aplicável)", desc: "Se o MEI ainda estiver ativo, realizamos a baixa formal junto à Receita Federal, evitando duplicidade de obrigações." },
          { step: "6", title: "Onboarding contábil", desc: "Configuramos sua empresa em nossos sistemas, criamos o calendário de obrigações e assumimos a rotina contábil e fiscal completa." }
        ].map(s => (
          <div class="flex gap-5 items-start">
            <div class="w-12 h-12 rounded-full bg-[#1e40af] text-white flex items-center justify-center font-bold text-lg shrink-0">{s.step}</div>
            <div>
              <h3 class="font-bold text-[#0f172a] text-lg mb-1">{s.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={WA} target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg shadow-sm">
          Começar agora pelo WhatsApp
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Diferenciais -->
  <section class="py-16 bg-[#0f172a]">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block bg-white/5 text-blue-300 text-xs font-semibold px-3 py-1 rounded-full border border-white/10 mb-4">VANTAGENS</span>
        <h2 class="text-3xl font-bold text-white mb-3">Por que migrar<br/><span class="pp3-grad-light">com a JMF</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { icon: "bi-clock-history", title: "Sem interrupção", desc: "Durante todo o processo, suas obrigações continuam sendo entregues. Não há gap fiscal entre o MEI e a LTDA." },
          { icon: "bi-shield-lock", title: "CNPJ preservado", desc: "Quando possível, mantemos a continuidade do CNPJ para não perder contratos e cadastros existentes." },
          { icon: "bi-graph-down", title: "Menor carga tributária", desc: "A simulação comparativa garante que você escolha o regime mais econômico desde o primeiro dia como LTDA." }
        ].map(s => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-8 text-center hover:bg-white/[0.08] transition-colors">
            <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
              <i class={`bi ${s.icon} text-blue-400 text-2xl`}></i>
            </div>
            <h3 class="text-white font-bold text-lg mb-3">{s.title}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-2-1036x691.webp" alt="Perguntas Frequentes - Migração MEI para LTDA"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Perguntas frequentes sobre<br />
            <span class="pp3-grad">migração de MEI para LTDA</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Quando devo migrar de MEI para LTDA?</summary>
              <div class="accordion-body">
                <p>Os principais sinais são: faturamento próximo ou acima de R$ 81.000/ano, necessidade de ter sócios, demanda por contratos com empresas que exigem LTDA, desejo de proteção patrimonial e oportunidade de distribuir lucros isentos de IR. A JMF faz a análise gratuita para definir o melhor momento.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Quanto custa migrar de MEI para LTDA?</summary>
              <div class="accordion-body">
                <p>Os custos incluem: taxa JUCESC (~R$ 300-500), alvará de funcionamento (~R$ 200-400), inscrições estadual e municipal, e honorários contábeis. O custo total varia conforme a atividade e o tipo de empresa. A JMF apresenta o orçamento completo antes de iniciar o processo.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Quanto tempo leva o processo de migração?</summary>
              <div class="accordion-body">
                <p>O processo leva de 5 a 15 dias úteis dependendo da atividade. Inclui: baixa do MEI (quando aplicável), registro da LTDA na JUCESC, obtenção do novo CNPJ, inscrições estadual e municipal, e alvará de funcionamento. A JMF cuida de todos os trâmites sem que você precise ir a nenhum órgão.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que muda nos impostos ao virar LTDA?</summary>
              <div class="accordion-body">
                <p>Como MEI, você paga um DAS fixo (R$ 82 a R$ 87/mês em 2026). Como LTDA no Simples Nacional, os impostos são calculados por faixa de faturamento (6% a 33%). Para muitas empresas, a diferença é compensada pela possibilidade de distribuir lucros isentos de IR e deduzir despesas reais. A JMF faz a simulação comparativa antes da migração.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Posso continuar atendendo os mesmos clientes?</summary>
              <div class="accordion-body">
                <p>Sim. A mudança de MEI para LTDA não afeta seus contratos ou relacionamento com clientes. O que muda é a estrutura jurídica e tributária da empresa. A JMF cuida da transferência de inscrições e regularização para que não haja interrupção nas atividades.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Fazem a migração de MEI para LTDA em Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade conduz a migração de MEI para LTDA para empreendedores de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com todo o processo feito digitalmente.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/blog/migrar-de-mei-para-ltda-guia-completo-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Guia completo</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Migrar de MEI para LTDA: guia completo 2026</p>
        </a>
        <a href="/blog/mei-estourou-o-faturamento-o-que-fazer-agora"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">MEI</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">MEI estourou o faturamento: o que fazer agora</p>
        </a>
        <a href="/blog/desenquadramento-mei-retroativo-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Desenquadramento</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Desenquadramento MEI Retroativo</p>
        </a>
        <a href="/blog/desenquadramento-mei-por-faturamento-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Desenquadramento</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Desenquadramento MEI por Faturamento</p>
        </a>
        <a href="/blog/desenquadramento-mei-excesso-receita-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group lg:col-span-1">
          <p class="text-xs text-gray-400 mb-1">Desenquadramento</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Desenquadramento MEI por Excesso de Receita</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
