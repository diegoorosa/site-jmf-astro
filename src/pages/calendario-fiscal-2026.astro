---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20tenho%20d%C3%BAvidas%20sobre%20obriga%C3%A7%C3%B5es%20fiscais%20de%202026%20e%20gostaria%20de%20conversar%20com%20um%20especialista%20da%20JMF.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["WebPage", "Service", "Dataset"],
  "@id": "https://www.jmfcontabilidade.com.br/calendario-fiscal-2026",
  "name": "Calendário Fiscal 2026 — Obrigações Tributárias e Trabalhistas",
  "description": "Calendário completo e interativo com todas as obrigações fiscais de 2026 para empresas no Simples Nacional, MEI e Lucro Presumido. DAS, FGTS, DEFIS, ECF, IRPF, ECD, ECF, 13º salário e feriados nacionais com ajustes de prazos para fins de semana.",
  "url": "https://www.jmfcontabilidade.com.br/calendario-fiscal-2026",
  "inLanguage": "pt-BR",
  "isPartOf": { "@id": "https://www.jmfcontabilidade.com.br/#website" },
  "publisher": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "url": "https://www.jmfcontabilidade.com.br",
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "logo": "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.webp"
  },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "url": "https://www.jmfcontabilidade.com.br",
    "sameAs": [
      "https://wa.me/554733265123",
      "https://www.instagram.com/jmfcontabilidade"
    ]
  },
  "areaServed": {
    "@type": "GeoShape",
    "addressCountry": "BR",
    "description": "Brasil — prazos federais válidos nacionalmente; prazos municipais/estaduais podem variar"
  },
  "serviceType": "Calendário fiscal interativo 2026 com filtros por regime (Simples Nacional, MEI, Lucro Presumido, Pessoa Física)",
  "category": "FinancialPlanning",
  "featureList": [
    "12 meses com obrigações federais, trabalhistas, anuais e feriados",
    "Filtro por regime tributário (Simples Nacional, MEI, Lucro Presumido, PF)",
    "Navegação por mês com contadores de obrigações por mês",
    "Indicação da próxima obrigação vencendo com contagem regressiva",
    "Ajuste automático de prazos para feriados nacionais e fins de semana",
    "Tabela anual consolidada com regimes aplicáveis",
    "Lista de 14 feriados nacionais 2026 com impacto nos prazos",
    "Legenda por categoria: Federal, Trabalhista, Anual, Feriado"
  ],
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.jmfcontabilidade.com.br/calendario-fiscal-2026"
  },
  "datePublished": "2025-12-01",
  "dateModified": "2026-01-15",
  "temporalCoverage": "2026-01-01/2026-12-31",
  "spatialCoverage": {
    "@type": "Place",
    "geo": {
      "@type": "GeoShape",
      "addressCountry": "BR"
    }
  },
  "keywords": ["calendário fiscal 2026", "DAS Simples Nacional", "FGTS", "DEFIS", "ECF", "ECD", "IRPF 2026", "13º salário", "obrigações acessórias", "prazos tributários"],
  "subjectOf": {
    "@type": "WebPage",
    "@id": "https://www.jmfcontabilidade.com.br/calendario-fiscal-2026"
  }
});
---

<Layout
  title="Calendário Fiscal 2026 — Obrigações Tributárias Completo"
  description="Calendário fiscal 2026: DAS Simples Nacional, FGTS, DEFIS, ECF, IRPF e obrigações acessórias com datas ajustadas para feriados e fins de semana."
  canonical="https://www.jmfcontabilidade.com.br/calendario-fiscal-2026"
  ogUrl="https://www.jmfcontabilidade.com.br/calendario-fiscal-2026"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Calendário Fiscal 2026"
    subtitle="Todas as obrigações tributárias e trabalhistas do ano, com filtros por regime, feriados nacionais e ajustes de prazos para fins de semana."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Ferramentas" },
      { label: "Calendário Fiscal 2026" }
    ]}
    ctas={[
      { label: "Ver obrigações", href: "#calendario", variant: "cta" },
      { label: "Falar com contador", href: WA, variant: "outline" }
    ]}
  />

  <!-- PRÓXIMA OBRIGAÇÃO -->
  <div id="banner-proximo" class="bg-[#1e40af] text-white py-3 px-4" style="display:none">
    <div class="container mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <i class="bi bi-alarm-fill text-yellow-300 text-lg flex-shrink-0"></i>
        <span class="text-sm font-medium">Próxima obrigação: <strong id="proximo-titulo">—</strong> — <span id="proximo-data"></span></span>
      </div>
      <span id="proximo-dias" class="text-xs font-bold bg-white/20 rounded-full px-3 py-1 whitespace-nowrap"></span>
    </div>
  </div>

  <!-- AVISO -->
  <div class="bg-amber-50 border-b border-amber-200 py-2.5 px-4">
    <div class="container mx-auto text-xs text-amber-800 text-center">
      <i class="bi bi-info-circle mr-1"></i>
      Este calendário é orientativo. Datas ajustadas conforme feriados nacionais de 2026.
      Prazos municipais e estaduais podem variar. Confirme com seu contador.
    </div>
  </div>

  <!-- FILTROS + MESES -->
  <section id="calendario" class="py-8 bg-white border-b border-gray-100 sticky top-0 z-20 shadow-sm">
    <div class="container mx-auto px-4">

      <!-- Filtro de regime -->
      <div class="flex flex-wrap items-center gap-2 mb-5 justify-center">
        <span class="text-xs font-semibold text-gray-500 mr-1">Filtrar por:</span>
        {[
          { id: "todos",     label: "Todos",             icon: "bi-grid" },
          { id: "simples",   label: "Simples Nacional",  icon: "bi-receipt" },
          { id: "mei",       label: "MEI",               icon: "bi-person-badge" },
          { id: "presumido", label: "Lucro Presumido",   icon: "bi-graph-up" },
        ].map(f => (
          <button
            data-filtro={f.id}
            class={`filtro-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border-2 transition-all ${f.id === 'todos' ? 'bg-[#1e40af] text-white border-[#1e40af]' : 'bg-white text-gray-600 border-gray-200 hover:border-[#1e40af] hover:text-[#1e40af]'}`}
          >
            <i class={`bi ${f.icon}`}></i>{f.label}
          </button>
        ))}
      </div>

      <!-- Seletor de mês -->
      <div class="grid grid-cols-6 sm:grid-cols-12 gap-1" id="month-tabs">
        {["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"].map((m, i) => (
          <button
            data-mes={i + 1}
            class={`mes-btn flex flex-col items-center py-2 px-1 rounded-xl text-xs font-bold transition-all ${i + 1 === 6 ? 'bg-[#1e40af] text-white shadow-md' : 'bg-gray-50 text-gray-500 hover:bg-[#dbeafe] hover:text-[#1e40af]'}`}
          >
            <span>{m}</span>
            <span data-count={i + 1} class="text-[10px] font-normal opacity-70 mt-0.5">—</span>
          </button>
        ))}
      </div>

    </div>
  </section>

  <!-- CORPO DO CALENDÁRIO -->
  <section class="py-10 bg-gray-50 min-h-64">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">

        <!-- Header do mês -->
        <div class="flex items-center justify-between mb-6">
          <h2 id="mes-titulo" class="text-2xl font-bold text-[#0f172a] pp3-grad">Junho 2026</h2>
          <span id="mes-total" class="text-sm text-gray-400"></span>
        </div>

        <!-- Lista de eventos -->
        <div id="eventos-lista" class="space-y-3">
          <!-- Renderizado por JS -->
        </div>

        <!-- Estado vazio -->
        <div id="eventos-vazio" class="text-center py-16" style="display:none">
          <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-4">
            <i class="bi bi-calendar-x text-gray-300 text-2xl"></i>
          </div>
          <p class="text-gray-400 font-medium">Nenhuma obrigação encontrada para este filtro neste mês.</p>
        </div>

        <!-- Legenda -->
        <div class="mt-8 pt-6 border-t border-gray-200 flex flex-wrap gap-4">
          <span class="text-xs text-gray-500 font-semibold mr-1">Legenda:</span>
          {[
            { cor: "bg-blue-100 text-blue-800", label: "Federal" },
            { cor: "bg-green-100 text-green-800", label: "Trabalhista" },
            { cor: "bg-amber-100 text-amber-800", label: "Anual" },
            { cor: "bg-gray-100 text-gray-600", label: "Feriado" },
          ].map(l => (
            <div class="flex items-center gap-1.5">
              <span class={`${l.cor} text-xs px-2 py-0.5 rounded-full font-semibold`}>{l.label}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- TABELA ANUAL COMPACTA -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-2">Resumo anual das<br/><span class="pp3-grad">obrigações</span></h2>
        <p class="text-gray-500 mb-8">Principais prazos do ano em uma visão consolidada.</p>

        <div class="overflow-x-auto rounded-xl border border-gray-100 shadow-sm">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-[#0f172a] text-white">
                <th class="p-3 text-left font-semibold">Mês</th>
                <th class="p-3 text-left font-semibold">Obrigações principais</th>
                <th class="p-3 text-center font-semibold">Regime</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {[
                { mes: "Janeiro",   obs: "DAS (dia 20) • FGTS (dia 20) • IRPJ/CSLL Q4/25 (dia 30)", regimes: ["SN","MEI","LP"] },
                { mes: "Fevereiro", obs: "DAS (dia 20) • FGTS (dia 20) • Carnaval", regimes: ["SN","MEI","LP"] },
                { mes: "Março",     obs: "DAS (dia 20) • FGTS (dia 20) • DEFIS (dia 31) • IRPF abre (dia 23)", regimes: ["SN","PF"] },
                { mes: "Abril",     obs: "DAS (dia 20) • FGTS (dia 20) • IRPJ/CSLL Q1 (dia 30)", regimes: ["SN","LP"] },
                { mes: "Maio",      obs: "DAS (dia 20) • FGTS (dia 20) • ECD (dia 29) • IRPF fecha (dia 29)", regimes: ["SN","LP","PF"] },
                { mes: "Junho",     obs: "DASN-SIMEI (dia 01) • DAS (dia 22) • FGTS (dia 19) • Corpus Christi", regimes: ["MEI","SN"] },
                { mes: "Julho",     obs: "DAS (dia 20) • FGTS (dia 20) • ECF (dia 31) • IRPJ/CSLL Q2 (dia 31)", regimes: ["SN","LP"] },
                { mes: "Agosto",    obs: "DAS (dia 20) • FGTS (dia 20)", regimes: ["SN","MEI","LP"] },
                { mes: "Setembro",  obs: "DAS (dia 21) • FGTS (dia 18) • Independência", regimes: ["SN","MEI","LP"] },
                { mes: "Outubro",   obs: "DAS (dia 20) • FGTS (dia 20) • IRPJ/CSLL Q3 (dia 30)", regimes: ["SN","LP"] },
                { mes: "Novembro",  obs: "DAS (dia 23) • FGTS (dia 19) • 13º 1ª parcela (dia 30)", regimes: ["SN","MEI","LP"] },
                { mes: "Dezembro",  obs: "DAS (dia 21) • FGTS (dia 18) • 13º 2ª parcela (dia 18)", regimes: ["SN","MEI","LP"] },
              ].map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/60'}>
                  <td class="p-3 font-semibold text-[#0f172a] whitespace-nowrap">{row.mes}</td>
                  <td class="p-3 text-gray-600">{row.obs}</td>
                  <td class="p-3 text-center">
                    <div class="flex flex-wrap gap-1 justify-center">
                      {row.regimes.map(r => (
                        <span class={`text-xs px-1.5 py-0.5 rounded font-bold ${r === 'SN' ? 'bg-blue-100 text-blue-700' : r === 'MEI' ? 'bg-purple-100 text-purple-700' : r === 'LP' ? 'bg-orange-100 text-orange-700' : 'bg-gray-100 text-gray-600'}`}>{r}</span>
                      ))}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-400 mt-3 text-center">SN = Simples Nacional · MEI = Microempreendedor Individual · LP = Lucro Presumido · PF = Pessoa Física</p>
      </div>
    </div>
  </section>

  <!-- FERIADOS 2026 -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-2">Feriados nacionais<br/><span class="pp3-grad">2026</span></h2>
        <p class="text-gray-600 mb-6">Datas que podem deslocar vencimentos de obrigações fiscais.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {[
            { d: "01/01", n: "Qui", f: "Confraternização Universal" },
            { d: "16/02", n: "Seg", f: "Carnaval — feriado municipal (muitas cidades)" },
            { d: "17/02", n: "Ter", f: "Carnaval — feriado municipal (muitas cidades)" },
            { d: "03/04", n: "Sex", f: "Sexta-feira Santa" },
            { d: "05/04", n: "Dom", f: "Páscoa" },
            { d: "21/04", n: "Ter", f: "Tiradentes" },
            { d: "01/05", n: "Sex", f: "Dia do Trabalho" },
            { d: "04/06", n: "Qui", f: "Corpus Christi" },
            { d: "07/09", n: "Seg", f: "Independência" },
            { d: "12/10", n: "Seg", f: "Nossa Senhora Aparecida" },
            { d: "02/11", n: "Seg", f: "Finados" },
            { d: "15/11", n: "Dom", f: "Proclamação da República — domingo, sem impacto" },
            { d: "20/11", n: "Sex", f: "Dia da Consciência Negra — DAS prorroga para 23/11 (seg); FGTS e INSS antecipam para 19/11 (qui)" },
            { d: "25/12", n: "Sex", f: "Natal" },
          ].map(h => (
            <div class="flex items-center gap-3 bg-white rounded-lg p-3 shadow-sm">
              <div class="text-center flex-shrink-0 min-w-[52px]">
                <div class="text-lg font-black text-[#1e40af] leading-tight">{h.d}</div>
                <div class="text-xs text-gray-400">{h.n}</div>
              </div>
              <span class="text-sm text-gray-700">{h.f}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <div class="w-16 h-16 bg-[#f97316] rounded-full flex items-center justify-center mx-auto mb-6">
        <i class="bi bi-calendar-check-fill text-white text-2xl"></i>
      </div>
      <h2 class="text-3xl font-bold text-white mb-4">Não perca<br/><span class="pp3-grad-light">nenhum prazo</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        A JMF Contabilidade envia um calendário de obrigações personalizado para cada cliente — com os prazos específicos para o seu regime e atividade. Sem susto de última hora.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={WA} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
          <i class="bi bi-whatsapp"></i>Falar com a JMF
        </a>
        <a href="/fale-conosco"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-lg">
          <i class="bi bi-envelope"></i>Enviar por e-mail
        </a>
      </div>
    </div>
  </section>

  <script>
  // ─────────────────────────────────────────────────────────────────
  // CALENDÁRIO FISCAL 2026 — JMF Contabilidade
  // Fontes: Receita Federal, CGSN 140/2018, LC 123/2006, CLT
  // ─────────────────────────────────────────────────────────────────

  type Evento = {
    d: string;      // "2026-MM-DD"
    t: string;      // título
    s: string;      // subtítulo/detalhe
    r: string[];    // regimes: "simples" | "mei" | "presumido" | "pf"
    c: string;      // categoria: "federal" | "trabalhista" | "anual" | "feriado"
    nota?: string;  // nota opcional
  };

  const EVENTOS: Evento[] = [
    // ────── FERIADOS NACIONAIS ─────────────────────────────────────
    { d:"2026-01-01", t:"Confraternização Universal", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-02-16", t:"Carnaval", s:"Feriado municipal em muitas cidades — segunda-feira", r:[], c:"feriado" },
    { d:"2026-02-17", t:"Carnaval", s:"Feriado municipal em muitas cidades — terça-feira", r:[], c:"feriado" },
    { d:"2026-04-03", t:"Sexta-feira Santa", s:"Feriado nacional — Semana Santa", r:[], c:"feriado" },
    { d:"2026-04-05", t:"Páscoa", s:"Domingo de Páscoa", r:[], c:"feriado" },
    { d:"2026-04-21", t:"Tiradentes", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-05-01", t:"Dia do Trabalho", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-06-04", t:"Corpus Christi", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-09-07", t:"Independência do Brasil", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-10-12", t:"Nossa Senhora Aparecida", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-11-02", t:"Finados", s:"Feriado nacional", r:[], c:"feriado" },
    { d:"2026-11-15", t:"Proclamação da República", s:"Cai em domingo — sem impacto em dias úteis", r:[], c:"feriado" },
    { d:"2026-11-20", t:"Dia da Consciência Negra", s:"Feriado nacional — DAS prorroga para 23/11 (seg); FGTS e INSS antecipam para 19/11 (qui)", r:[], c:"feriado" },
    { d:"2026-12-25", t:"Natal", s:"Feriado nacional", r:[], c:"feriado" },

    // ────── JANEIRO ───────────────────────────────────────────────
    { d:"2026-01-20", t:"FGTS", s:"Competência dezembro/2025 — se tiver funcionários CLT", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-01-20", t:"DAS — Simples Nacional", s:"Competência dezembro/2025", r:["simples","mei"], c:"federal" },
    { d:"2026-01-20", t:"INSS Patronal (GPS)", s:"Competência dezembro/2025", r:["presumido"], c:"federal" },
    { d:"2026-01-30", t:"IRPJ/CSLL — 4º Trimestre/2025", s:"Apuração trimestral outubro-dezembro/2025 — Lucro Presumido", r:["presumido"], c:"federal", nota:"Último dia útil de janeiro de 2026 (dia 31 é sábado)" },

    // ────── FEVEREIRO ─────────────────────────────────────────────
    { d:"2026-02-20", t:"FGTS", s:"Competência janeiro/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-02-20", t:"DAS — Simples Nacional", s:"Competência janeiro/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-02-20", t:"INSS Patronal (GPS)", s:"Competência janeiro/2026", r:["presumido"], c:"federal" },

    // ────── MARÇO ─────────────────────────────────────────────────
    { d:"2026-03-20", t:"FGTS", s:"Competência fevereiro/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-03-20", t:"DAS — Simples Nacional", s:"Competência fevereiro/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-03-20", t:"INSS Patronal (GPS)", s:"Competência fevereiro/2026", r:["presumido"], c:"federal" },
    { d:"2026-03-23", t:"IRPF 2026 — Abertura", s:"Início do prazo para entrega da declaração do Imposto de Renda (ano-base 2025)", r:["pf"], c:"anual", nota:"Obrigatório para rendimentos tributáveis acima de R$ 35.584,00 em 2025" },
    { d:"2026-03-31", t:"DEFIS 2025", s:"Declaração de Informações Socioeconômicas e Fiscais — Simples Nacional (ano-base 2025)", r:["simples"], c:"anual", nota:"Obrigatório para todas as ME e EPP no Simples Nacional, exceto MEI" },

    // ────── ABRIL ─────────────────────────────────────────────────
    { d:"2026-04-20", t:"FGTS", s:"Competência março/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-04-20", t:"DAS — Simples Nacional", s:"Competência março/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-04-20", t:"INSS Patronal (GPS)", s:"Competência março/2026", r:["presumido"], c:"federal" },
    { d:"2026-04-30", t:"IRPJ/CSLL — 1º Trimestre", s:"Apuração trimestral janeiro-março/2026 — Lucro Presumido", r:["presumido"], c:"federal", nota:"Último dia útil de abril de 2026" },

    // ────── MAIO ──────────────────────────────────────────────────
    { d:"2026-05-20", t:"FGTS", s:"Competência abril/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-05-20", t:"DAS — Simples Nacional", s:"Competência abril/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-05-20", t:"INSS Patronal (GPS)", s:"Competência abril/2026", r:["presumido"], c:"federal" },
    { d:"2026-05-29", t:"ECD — Escrituração Contábil Digital", s:"Ano-base 2025 — último dia útil de maio de 2026", r:["presumido"], c:"anual", nota:"Obrigatório para empresas no Lucro Real e Lucro Presumido" },
    { d:"2026-05-29", t:"IRPF 2026 — Prazo Final", s:"Último dia para entrega da declaração do IRPF (ano-base 2025)", r:["pf"], c:"anual", nota:"Após este prazo, a declaração pode ser entregue com multa mínima de R$ 165,74" },

    // ────── JUNHO ─────────────────────────────────────────────────
    { d:"2026-06-01", t:"DASN-SIMEI 2025", s:"Declaração Anual Simplificada do MEI (ano-base 2025) — 31/05 cai em domingo → 01/06", r:["mei"], c:"anual", nota:"Obrigatório mesmo com faturamento zero. Multa mínima de R$ 50,00 por mês de atraso" },
    { d:"2026-06-19", t:"FGTS", s:"Competência maio/2026 (dia 20 = sábado → antecipado para 19/06 sexta)", r:["simples","mei","presumido"], c:"trabalhista", nota:"FGTS antecipa para o dia útil imediatamente anterior quando o vencimento cai em fim de semana ou feriado — regra do FGTS Digital" },
    { d:"2026-06-19", t:"INSS Patronal (GPS)", s:"Competência maio/2026 (dia 20 = sábado → antecipado para 19/06 sexta)", r:["presumido"], c:"federal", nota:"GPS/INSS antecipa para o dia útil imediatamente anterior — Decreto 3.048/1999, Art. 337" },
    { d:"2026-06-22", t:"DAS — Simples Nacional", s:"Competência maio/2026 (dia 20 = sábado → prorrogado para 22/06 segunda)", r:["simples","mei"], c:"federal" },

    // ────── JULHO ─────────────────────────────────────────────────
    { d:"2026-07-20", t:"FGTS", s:"Competência junho/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-07-20", t:"DAS — Simples Nacional", s:"Competência junho/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-07-20", t:"INSS Patronal (GPS)", s:"Competência junho/2026", r:["presumido"], c:"federal" },
    { d:"2026-07-31", t:"ECF — Escrituração Contábil Fiscal", s:"Ano-base 2025 — último dia útil de julho de 2026", r:["presumido"], c:"anual", nota:"Obrigatório para empresas no Lucro Real e Lucro Presumido (IN RFB 2004/2021)" },
    { d:"2026-07-31", t:"IRPJ/CSLL — 2º Trimestre", s:"Apuração trimestral abril-junho/2026 — Lucro Presumido", r:["presumido"], c:"federal", nota:"Mesmo dia do ECF e último dia útil de julho" },

    // ────── AGOSTO ────────────────────────────────────────────────
    { d:"2026-08-20", t:"FGTS", s:"Competência julho/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-08-20", t:"DAS — Simples Nacional", s:"Competência julho/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-08-20", t:"INSS Patronal (GPS)", s:"Competência julho/2026", r:["presumido"], c:"federal" },

    // ────── SETEMBRO ──────────────────────────────────────────────
    { d:"2026-09-18", t:"FGTS", s:"Competência agosto/2026 (dia 20 = domingo → antecipado para 18/09 sexta)", r:["simples","mei","presumido"], c:"trabalhista", nota:"FGTS antecipa para o dia útil imediatamente anterior quando o vencimento cai em fim de semana ou feriado — regra do FGTS Digital" },
    { d:"2026-09-18", t:"INSS Patronal (GPS)", s:"Competência agosto/2026 (dia 20 = domingo → antecipado para 18/09 sexta)", r:["presumido"], c:"federal", nota:"GPS/INSS antecipa para o dia útil imediatamente anterior — Decreto 3.048/1999, Art. 337" },
    { d:"2026-09-21", t:"DAS — Simples Nacional", s:"Competência agosto/2026 (dia 20 = domingo → prorrogado para 21/09 segunda)", r:["simples","mei"], c:"federal" },

    // ────── OUTUBRO ───────────────────────────────────────────────
    { d:"2026-10-20", t:"FGTS", s:"Competência setembro/2026", r:["simples","mei","presumido"], c:"trabalhista" },
    { d:"2026-10-20", t:"DAS — Simples Nacional", s:"Competência setembro/2026", r:["simples","mei"], c:"federal" },
    { d:"2026-10-20", t:"INSS Patronal (GPS)", s:"Competência setembro/2026", r:["presumido"], c:"federal" },
    { d:"2026-10-30", t:"IRPJ/CSLL — 3º Trimestre", s:"Apuração trimestral julho-setembro/2026 — Lucro Presumido (último dia útil de outubro)", r:["presumido"], c:"federal" },

    // ────── NOVEMBRO ──────────────────────────────────────────────
    { d:"2026-11-19", t:"FGTS", s:"Competência outubro/2026 (dia 20 = feriado Consciência Negra → antecipado para 19/11 quinta)", r:["simples","mei","presumido"], c:"trabalhista", nota:"FGTS antecipa para o dia útil imediatamente anterior quando o vencimento cai em fim de semana ou feriado — regra do FGTS Digital" },
    { d:"2026-11-19", t:"INSS Patronal (GPS)", s:"Competência outubro/2026 (dia 20 = sexta feriado Consciência Negra → antecipado para 19/11 quinta)", r:["presumido"], c:"federal", nota:"GPS/INSS antecipa para o dia útil imediatamente anterior — Decreto 3.048/1999, Art. 337" },
    { d:"2026-11-23", t:"DAS — Simples Nacional", s:"Competência outubro/2026 (dia 20 = sexta feriado Consciência Negra → prorrogado para 23/11 segunda)", r:["simples","mei"], c:"federal", nota:"Atenção: dia 20/11 é feriado nacional (Dia da Consciência Negra). FGTS e INSS têm prazo diferente do DAS: antecipam para 19/11" },
    { d:"2026-11-30", t:"13º Salário — 1ª Parcela", s:"Prazo para pagamento da primeira parcela do décimo-terceiro a todos os funcionários CLT", r:["simples","mei","presumido"], c:"trabalhista", nota:"Obrigatório para empresas com funcionários CLT. Corresponde a 50% do salário bruto" },

    // ────── DEZEMBRO ──────────────────────────────────────────────
    { d:"2026-12-18", t:"FGTS", s:"Competência novembro/2026 (dia 20 = domingo → antecipado para 18/12 sexta)", r:["simples","mei","presumido"], c:"trabalhista", nota:"FGTS antecipa para o dia útil imediatamente anterior quando o vencimento cai em fim de semana ou feriado — regra do FGTS Digital" },
    { d:"2026-12-18", t:"INSS Patronal (GPS)", s:"Competência novembro/2026 (dia 20 = domingo → antecipado para 18/12 sexta)", r:["presumido"], c:"federal", nota:"GPS/INSS antecipa para o dia útil imediatamente anterior — Decreto 3.048/1999, Art. 337" },
    { d:"2026-12-21", t:"DAS — Simples Nacional", s:"Competência novembro/2026 (dia 20 = domingo → prorrogado para 21/12 segunda)", r:["simples","mei"], c:"federal" },
    { d:"2026-12-18", t:"13º Salário — 2ª Parcela", s:"Prazo para pagamento da segunda parcela do 13º salário (dia 20 = domingo → antecipado para 18/12 sexta)", r:["simples","mei","presumido"], c:"trabalhista", nota:"Inclui desconto do IRRF e INSS do empregado sobre o valor total do 13º. Lei 4.090/1962: se o dia 20 não for útil, o pagamento é antecipado, nunca postergado" },
  ];

  const MESES_PT = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
  const DIAS_PT  = ["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"];

  const CAT_CONFIG: Record<string, { bg: string; text: string; label: string; icon: string }> = {
    federal:     { bg: "bg-blue-100",   text: "text-blue-800",   label: "Federal",     icon: "bi-receipt" },
    trabalhista: { bg: "bg-green-100",  text: "text-green-800",  label: "Trabalhista", icon: "bi-people-fill" },
    anual:       { bg: "bg-amber-100",  text: "text-amber-800",  label: "Anual",       icon: "bi-calendar-check-fill" },
    feriado:     { bg: "bg-gray-100",   text: "text-gray-600",   label: "Feriado",     icon: "bi-flag-fill" },
  };

  const REGIME_CONFIG: Record<string, { label: string; bg: string; text: string }> = {
    simples:   { label: "Simples Nacional", bg: "bg-blue-50",   text: "text-blue-700" },
    mei:       { label: "MEI",              bg: "bg-purple-50", text: "text-purple-700" },
    presumido: { label: "Lucro Presumido",  bg: "bg-orange-50", text: "text-orange-700" },
    pf:        { label: "Pessoa Física",    bg: "bg-pink-50",   text: "text-pink-700" },
  };

  let mesSelecionado = 6;
  let filtroAtivo = "todos";

  function formatDate(dateStr: string) {
    const d = new Date(dateStr + "T12:00:00");
    const day = String(d.getDate()).padStart(2, "0");
    const mon = String(d.getMonth() + 1).padStart(2, "0");
    return { dd: day, mm: mon, dow: DIAS_PT[d.getDay()] };
  }

  function isPassado(dateStr: string) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const d = new Date(dateStr + "T00:00:00");
    return d < today;
  }

  function filtrarEventos(mes: number, regime: string): Evento[] {
    return EVENTOS
      .filter(e => {
        const d = new Date(e.d + "T12:00:00");
        if (d.getMonth() + 1 !== mes) return false;
        if (regime === "todos") return true;
        if (e.c === "feriado") return true;
        return e.r.includes(regime);
      })
      .sort((a, b) => a.d.localeCompare(b.d));
  }

  function renderEvento(ev: Evento): string {
    const { dd, mm, dow } = formatDate(ev.d);
    const cat = CAT_CONFIG[ev.c] || CAT_CONFIG.feriado;
    const passado = isPassado(ev.d);
    const regimeBadges = ev.r.length
      ? ev.r.map(r => {
          const rc = REGIME_CONFIG[r] || { label: r, bg: "bg-gray-50", text: "text-gray-600" };
          return `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${rc.bg} ${rc.text}">${rc.label}</span>`;
        }).join("")
      : "";

    const notaHtml = ev.nota
      ? `<div class="mt-2 text-xs text-gray-400 flex items-start gap-1"><i class="bi bi-info-circle flex-shrink-0 mt-0.5"></i><span>${ev.nota}</span></div>`
      : "";

    return `
      <div class="flex gap-4 bg-white rounded-xl p-4 shadow-sm border border-gray-100 ${passado ? 'opacity-50' : ''} transition-all hover:shadow-md">
        <div class="flex-shrink-0 text-center min-w-[52px]">
          <div class="text-2xl font-black text-[#0f172a] leading-tight ${passado ? 'line-through text-gray-300' : ''}">${dd}/${mm}</div>
          <div class="text-xs text-gray-400 mt-0.5">${dow}</div>
          ${passado ? '<div class="text-[9px] text-gray-400 font-semibold mt-0.5 uppercase">concluído</div>' : ''}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full ${cat.bg} ${cat.text}">
              <i class="bi ${cat.icon}"></i>${cat.label}
            </span>
            ${regimeBadges}
          </div>
          <h3 class="font-bold text-[#0f172a] text-sm leading-tight">${ev.t}</h3>
          <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">${ev.s}</p>
          ${notaHtml}
        </div>
      </div>
    `;
  }

  function renderMes() {
    const evs = filtrarEventos(mesSelecionado, filtroAtivo);
    const lista = document.getElementById("eventos-lista")!;
    const vazio = document.getElementById("eventos-vazio")!;
    const titulo = document.getElementById("mes-titulo")!;
    const total = document.getElementById("mes-total")!;

    titulo.textContent = `${MESES_PT[mesSelecionado - 1]} 2026`;

    const naoFeriado = evs.filter(e => e.c !== "feriado");
    total.textContent = naoFeriado.length === 0
      ? "Nenhuma obrigação neste filtro"
      : `${naoFeriado.length} obrigação${naoFeriado.length > 1 ? "s" : ""}`;

    if (evs.length === 0 || (filtroAtivo !== "todos" && naoFeriado.length === 0)) {
      lista.innerHTML = "";
      lista.style.display = "none";
      vazio.style.display = "block";
    } else {
      lista.style.display = "flex";
      lista.style.flexDirection = "column";
      lista.style.gap = "0.75rem";
      lista.innerHTML = evs.map(renderEvento).join("");
      vazio.style.display = "none";
    }
  }

  function atualizarCounters() {
    for (let m = 1; m <= 12; m++) {
      const evs = filtrarEventos(m, filtroAtivo).filter(e => e.c !== "feriado");
      const el = document.querySelector(`[data-count="${m}"]`);
      if (el) el.textContent = evs.length > 0 ? `${evs.length} itens` : "—";
    }
  }

  function atualizarMesBtns() {
    document.querySelectorAll<HTMLButtonElement>(".mes-btn").forEach(btn => {
      const m = parseInt(btn.dataset.mes || "0");
      if (m === mesSelecionado) {
        btn.className = "mes-btn flex flex-col items-center py-2 px-1 rounded-xl text-xs font-bold transition-all bg-[#1e40af] text-white shadow-md";
      } else {
        btn.className = "mes-btn flex flex-col items-center py-2 px-1 rounded-xl text-xs font-bold transition-all bg-gray-50 text-gray-500 hover:bg-[#dbeafe] hover:text-[#1e40af]";
      }
    });
  }

  function atualizarFiltroBtns() {
    document.querySelectorAll<HTMLButtonElement>(".filtro-btn").forEach(btn => {
      const f = btn.dataset.filtro || "";
      if (f === filtroAtivo) {
        btn.className = "filtro-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border-2 transition-all bg-[#1e40af] text-white border-[#1e40af]";
      } else {
        btn.className = "filtro-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border-2 transition-all bg-white text-gray-600 border-gray-200 hover:border-[#1e40af] hover:text-[#1e40af]";
      }
    });
  }

  function calcProximoVencimento() {
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    const futuros = EVENTOS
      .filter(e => e.c !== "feriado" && new Date(e.d + "T00:00:00") >= hoje)
      .sort((a, b) => a.d.localeCompare(b.d));

    if (futuros.length === 0) return;
    const prox = futuros[0];
    const dd = new Date(prox.d + "T12:00:00");
    const diffMs = dd.getTime() - hoje.getTime();
    const diffDias = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

    const banner = document.getElementById("banner-proximo")!;
    const tituloEl = document.getElementById("proximo-titulo")!;
    const dataEl = document.getElementById("proximo-data")!;
    const diasEl = document.getElementById("proximo-dias")!;

    tituloEl.textContent = prox.t;
    dataEl.textContent = `${String(dd.getDate()).padStart(2,"0")}/${String(dd.getMonth()+1).padStart(2,"0")}/${dd.getFullYear()} (${DIAS_PT[dd.getDay()]})`;
    diasEl.textContent = diffDias === 0 ? "Vence HOJE" : diffDias === 1 ? "Vence amanhã" : `Em ${diffDias} dias`;
    banner.style.display = "block";
  }

  // ── Inicialização ──
  document.addEventListener("DOMContentLoaded", () => {
    // Mês atual
    const hoje = new Date();
    mesSelecionado = hoje.getMonth() + 1;
    if (mesSelecionado < 1 || mesSelecionado > 12) mesSelecionado = 6;

    atualizarMesBtns();
    atualizarCounters();
    renderMes();
    calcProximoVencimento();

    // Clicks nos meses
    document.querySelectorAll<HTMLButtonElement>(".mes-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        mesSelecionado = parseInt(btn.dataset.mes || "6");
        atualizarMesBtns();
        renderMes();
        document.getElementById("calendario")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Clicks nos filtros
    document.querySelectorAll<HTMLButtonElement>(".filtro-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        filtroAtivo = btn.dataset.filtro || "todos";
        atualizarFiltroBtns();
        atualizarCounters();
        renderMes();
      });
    });
  });
  </script>

</Layout>
