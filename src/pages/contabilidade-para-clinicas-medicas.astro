      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abertura e Regularização de PJ Médica" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Distribuição de Lucros Isenta" } },
