---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const WAsim = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20sou%20m%C3%A9dico%20e%20gostaria%20de%20saber%20se%20abrir%20empresa%20compensa%20no%20meu%20caso.";

