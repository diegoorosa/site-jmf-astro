const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "O que é a Equiparação Hospitalar e como ela reduz os impostos da clínica?", "acceptedAnswer": { "@type": "Answer", "text": "A Equiparação Hospitalar é um benefício fiscal respaldado pela Lei nº 9.249/95 e pelo Tema 328 do STJ. Ela permite que clínicas médicas e odontológicas que realizam procedimentos ambulatoriais, cirurgias ou exames reduzam a base de presunção do IRPJ de 32% para 8% e da CSLL de 32% para 12% no Lucro Presumido, gerando uma redução de até 60% nos tributos federais." } },
    { "@type": "Question", "name": "Quais os requisitos para uma clínica médica obter a Equiparação Hospitalar?", "acceptedAnswer": { "@type": "Answer", "text": "A clínica precisa: 1) Ser constituída sob a forma de Sociedade Empresária (LTDA); 2) Estar enquadrada no regime do Lucro Presumido; 3) Possuir alvará sanitário regular emitido pela Vigilância Sanitária atendendo às normas da RDC 50 da Anvisa; 4) Prestar serviços médicos voltados à promoção da saúde e procedimentos (consultas simples continuam tributadas na alíquota padrão)." } },
    { "@type": "Question", "name": "Quando vale a pena optar pelo Simples Nacional com Fator R?", "acceptedAnswer": { "@type": "Answer", "text": "Para consultórios individuais ou clínicas médicas com faturamento menor e que prestam majoritariamente consultas clínicas, o Simples Nacional é muito vantajoso. Ao manter a folha de pagamento e o pró-labore em no mínimo 28% do faturamento bruto (Fator R), a tributação cai do Anexo V (15,5%) para o Anexo III (iniciando em 6%)." } },
    { "@type": "Question", "name": "Como funciona a distribuição de lucros isenta de IRPF para médicos sócios?", "acceptedAnswer": { "@type": "Answer", "text": "Com a escrituração contábil regular realizada pela JMF Contabilidade, todo o lucro líquido contábil apurado pela PJ (após pagamento dos tributos e pró-labore com recolhimento de INSS) pode ser transferido para as contas bancárias físicas dos médicos com 100% de isenção de Imposto de Renda." } }
  ]
