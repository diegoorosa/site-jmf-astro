---
import Layout from '../layouts/Layout.astro';
import HeroInternoP2 from '../components/HeroInternoP2.astro';
import Parceiros from '../components/Parceiros.astro';
import '../styles/index-2.css';
import '../styles/sobre-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const schema = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Sobre a JMF Contabilidade",
    "url": "https://www.jmfcontabilidade.com.br/sobre"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.jmfcontabilidade.com.br/sobre#joel-rosa",
    "name": "Joel Rosa",
    "jobTitle": "Fundador & Conselheiro Estratégico",
    "image": "https://www.jmfcontabilidade.com.br/assets/images/team-joel.webp",
    "worksFor": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "FURB — Universidade Regional de Blumenau" },
    "hasCredential": { "@type": "EducationalOccupationalCredential", "name": "CRC SC-007091/O" },
    "description": "Fundador e Conselheiro Estratégico da JMF Contabilidade. Mais de 55 anos de carreira contábil, formado pela FURB (1987) e técnico desde 1971. Especialista em gestão de grupos econômicos, reestruturação empresarial e consultoria sênior."
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.jmfcontabilidade.com.br/sobre#fabricio-rosa",
    "name": "Fabricio Rosa",
    "jobTitle": "Sócio-Administrador & Especialista Societário",
    "image": "https://www.jmfcontabilidade.com.br/assets/images/team-fabricio.webp",
    "worksFor": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "FURB — Universidade Regional de Blumenau" },
    "hasCredential": { "@type": "EducationalOccupationalCredential", "name": "CRC SC-029833/O" },
    "description": "Sócio-Administrador da JMF Contabilidade, na empresa desde 2001. Bacharel em Ciências Contábeis pela FURB (2007) e pós-graduado em Gestão Tributária (2011). Especialista em legalização de empresas, contratos sociais, direito societário e planejamento tributário."
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://www.jmfcontabilidade.com.br/sobre#diego-rosa",
    "name": "Diego Rosa",
    "jobTitle": "Sócio-Administrador e Head de TI",
    "image": "https://www.jmfcontabilidade.com.br/assets/images/team-diego.webp",
    "worksFor": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "FURB — Universidade Regional de Blumenau" },
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "name": "CRC SC-035810/O" },
      { "@type": "EducationalOccupationalCredential", "name": "AWS Certified Cloud Practitioner" }
    ],
    "description": "Sócio-Administrador da JMF Contabilidade, na empresa desde 2006. Bacharel em Ciências Contábeis pela FURB (2010) e certificado AWS Cloud Practitioner. Lidera TI, automação e integrações de IA."
  }),
];
---

<Layout
  title="Sobre a JMF Contabilidade | Solidez Familiar e Tecnologia em Blumenau/SC"
  description="Conheça a história da JMF Contabilidade em Blumenau/SC: quase 4 décadas de mercado, sucessão familiar sólida e processos modernos orientados por tecnologia."
  canonical="https://www.jmfcontabilidade.com.br/sobre"
  ogUrl="https://www.jmfcontabilidade.com.br/sobre"
  schema={schema}
  heroInterno
>

  <HeroInternoP2
    eyebrow="Sobre a JMF Contabilidade"
    title="A solidez de quase 4 décadas."
    titleHi="A agilidade da contabilidade moderna."
    subtitle="Fundada em 1989 e movida por princípios éticos, inteligência artificial e processos ágeis. Gestão contábil e fiscal de sócio para sócio, sem burocracia."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Sobre nós" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Conhecer nossa história", href: "#historia", variant: "outline" }
    ]}
  />

  <!-- Quem Somos & A História da Sigla -->
  <section id="historia" class="jmf-sp-py jmf-sp-light">
    <div class="jmf-container">
      <div class="jmf-sp-grid jmf-sp-grid-2">
        <div data-reveal>
          <span class="jmf-eyebrow-paper on-light">Nossa História & DNA</span>
          <h2 class="jmf-sp-h2">
            A solidez de uma família,<br/>
            <span class="jmf-sp-grad">a força da contabilidade moderna</span>
          </h2>
          <p class="jmf-sp-lead">
            Em 1989, Joel e Marise Rosa fundaram a <strong>JMR Contabilidade</strong>. Na época dos livros fiscais preenchidos à mão e carimbos, construíram com rigor técnico e integridade uma relação de confiança tão sólida que mantemos clientes ativos desde aquele primeiro ano.
          </p>
          <p class="jmf-sp-lead">
            Com a formação e a entrada de <strong>Fabricio Rosa</strong> nos anos 2000, o escritório deu seu primeiro grande passo na reestruturação societária e no planejamento tributário estratégico, passando a assinar como <strong>JMF Contabilidade (Joel, Marise e Fabricio)</strong>.
          </p>
          <p class="jmf-sp-lead">
            Anos mais tarde, com a chegada de <strong>Diego Rosa</strong> assumindo a infraestrutura e a modernização digital, a sigla encontrou seu propósito definitivo: em vez de somar letras, o <strong>F</strong> passou a representar <strong>Filhos</strong>. A linhagem familiar seguiu firme, honrando os princípios e a bagagem dos pais, mas incorporando sistemas em nuvem, automação de rotinas e inteligência artificial.
          </p>
          <p class="jmf-sp-lead">
            Hoje, a JMF é o equilíbrio exato entre tradição e futuro: não somos uma plataforma automatizada fria e sem rosto, nem um escritório arcaico de gaveta. Somos uma empresa familiar sólida, ágil e focada em proteger o patrimônio de quem produz.
          </p>
        </div>
        <div class="jmf-sp-thumb" data-reveal>
          <div class="jmf-sp-glow"></div>
          <img src="/assets/images/background1-1.webp" alt="Escritório JMF Contabilidade em Blumenau"
            width="1900" height="1200"
            class="jmf-sp-img" loading="eager" fetchpriority="high" decoding="async" />
          <div class="jmf-sp-badge">
            <span class="jmf-sp-badge-dot"></span>
            <span>Blumenau, SC · Desde 1989</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nossa Equipe -->
  <section class="jmf-sp-py jmf-sp-dark">
    <div class="jmf-sp-grid-bg"></div>
    <div class="jmf-container">
      <div class="jmf-sp-head" data-reveal>
        <span class="jmf-eyebrow-paper on-dark">Nossa Equipe</span>
        <h2 class="jmf-sp-h2 on-dark">
          Contadores registrados no CRC/SC<br/>
          <span class="jmf-sp-grad on-dark">com décadas de dedicação</span>
        </h2>
        <p class="jmf-sp-lead on-dark">Experiência contábil e transformação digital lado a lado — unindo a solidez clássica da profissão com ferramentas de ponta.</p>
      </div>

      <div class="jmf-team-grid" data-reveal-stagger>
        <!-- Joel Rosa -->
        <article class="jmf-team-card">
          <div class="jmf-team-card-pulse"></div>
          <div class="jmf-team-avatar">
            <div class="jmf-team-avatar-glow"></div>
            <img src="/assets/images/team-joel.webp"
              alt="Joel Rosa — Fundador e Contador, CRC SC-007091/O"
              width="128" height="128"
              loading="lazy" />
          </div>
          <h3 class="jmf-team-name">Joel Rosa</h3>
          <p class="jmf-team-role">Fundador & Conselheiro</p>
          <p class="jmf-team-crc">CRC SC-007091/O</p>
          <p class="jmf-team-bio">
            Mais de 55 anos de experiência contábil e empresarial. Técnico em Contabilidade desde 1971 e Bacharel em Ciências Contábeis pela FURB (1987), fundou o escritório em 1989 (originalmente JMR). Atua como conselheiro sênior, com histórico ímpar na condução contábil de grupos econômicos, reestruturações societárias e proteção patrimonial, mantendo vivos os princípios éticos que deram origem à empresa.
          </p>
        </article>

        <!-- Fabricio Rosa -->
        <article class="jmf-team-card">
          <div class="jmf-team-card-pulse"></div>
          <div class="jmf-team-avatar">
            <div class="jmf-team-avatar-glow"></div>
            <img src="/assets/images/team-fabricio.webp"
              alt="Fabricio Rosa — Sócio-Administrador, CRC SC-029833/O"
              width="128" height="128"
              loading="lazy" />
          </div>
          <h3 class="jmf-team-name">Fabricio Rosa</h3>
          <p class="jmf-team-role">Sócio-Administrador & Societário</p>
          <p class="jmf-team-crc">CRC SC-029833/O</p>
          <p class="jmf-team-bio">
            Na JMF desde 2001, marco que inaugurou a transição da marca. Bacharel em Ciências Contábeis pela FURB (2007) e pós-graduado em Gestão Tributária (2011). Lidera a área de Legalização e Direito Societário, especialista na estruturação de contratos sociais estratégicos, alterações na JUCESC e enquadramento tributário preventivo no Simples Nacional, Presumido e Real.
          </p>
        </article>

        <!-- Diego Rosa -->
        <article class="jmf-team-card">
          <div class="jmf-team-card-pulse"></div>
          <div class="jmf-team-avatar">
            <div class="jmf-team-avatar-glow"></div>
            <img src="/assets/images/team-diego.webp"
              alt="Diego Rosa — Sócio-Administrador, CRC SC-035810/O"
              width="128" height="128"
              loading="lazy" />
          </div>
          <h3 class="jmf-team-name">Diego Rosa</h3>
          <p class="jmf-team-role">Sócio-Administrador & TI</p>
          <p class="jmf-team-crc">CRC SC-035810/O</p>
          <p class="jmf-team-bio">
            Na JMF desde 2006, consolidando a união familiar da sigla ('Filhos'). Bacharel em Ciências Contábeis pela FURB (2010) e certificado AWS Cloud Practitioner. Lidera a arquitetura de TI e a modernização de rotinas contábeis, integrando inteligência artificial, pipelines em nuvem e automações para eliminar a lentidão burocrática dos clientes.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Diferenciais -->
  <section id="diferenciais" class="jmf-sp-py jmf-sp-light">
    <div class="jmf-container">
      <div class="jmf-sp-head" data-reveal>
        <span class="jmf-eyebrow-paper on-light">Nossos Diferenciais</span>
        <h2 class="jmf-sp-h2">
          O que nos torna<br/>
          <span class="jmf-sp-grad">o parceiro ideal</span>
        </h2>
        <p class="jmf-sp-lead">A segurança de quem conhece a legislação a fundo com a eficiência de processos automatizados.</p>
      </div>

      <div class="jmf-dif-grid jmf-dif-grid--two" data-reveal-stagger>
        <article class="jmf-dif-card jmf-dif-card-on-light">
          <div class="jmf-dif-pulse"></div>
          <div class="jmf-dif-icon"><i class="bi bi-graph-up-arrow"></i></div>
          <h4 class="jmf-dif-title">Planejamento Tributário</h4>
          <p class="jmf-dif-desc">Estruturação preventiva para reduzir legalmente a carga tributária do seu negócio, mitigando riscos e aproveitando benefícios fiscais da legislação catarinense e federal.</p>
        </article>
        <article class="jmf-dif-card jmf-dif-card-on-light">
          <div class="jmf-dif-pulse"></div>
          <div class="jmf-dif-icon"><i class="bi bi-briefcase"></i></div>
          <h4 class="jmf-dif-title">Consultoria Estratégica</h4>
          <p class="jmf-dif-desc">Atendimento consultivo direto com os sócios. Orientação prática e rápida para abertura, transição societária e tomada de decisão embasada em números reais.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Nossa Missão (dark P2 com beam ciano) -->
  <section class="jmf-cta-sec jmf-sp-missao" id="nossa-missao">
    <div class="jmf-cta-bg"></div>
    <div class="jmf-cta-grid"></div>
    <div class="jmf-cta-beam"></div>

    <div class="jmf-container">
      <div class="jmf-cta-inner" data-reveal>
        <span class="jmf-eyebrow-paper on-dark">Nosso Propósito</span>
        <h2 class="jmf-cta-title">
          Agilidade e inteligência<br/>
          <span class="jmf-sp-grad on-dark">a serviço do seu patrimônio</span>
        </h2>
        <p class="jmf-cta-lead">Eliminamos o atrito contábil para que você tenha clareza e liberdade para expandir seu negócio.</p>

        <div class="jmf-sp-missao-paragrafos">
          <p>Unimos rapidez no atendimento — com comunicação direta e respostas objetivas — a fluxos de trabalho que integram dados fiscais com agilidade e zero complicação.</p>
          <p>Nosso contato é de sócio para sócio. Conhecemos o nome, a história e o modelo de operação de cada empresa que atendemos, garantindo orientação segura nas decisões estratégicas.</p>
          <p>O foco da JMF é simplificar a conformidade fiscal e entregar previsibilidade financeira. <strong class="jmf-sp-missao-strong">O crescimento e a estabilidade da sua empresa são o nosso maior compromisso.</strong></p>
        </div>

        <div class="jmf-cta-row">
          <a href={WA} target="_blank" rel="noopener noreferrer"
            class="jmf-p2-cbtn jmf-p2-cbtn-cyan jmf-ring" style="animation:jmfGlowPulse 3.5s ease-in-out infinite;">
            <i class="bi bi-whatsapp"></i>
            Entre em contato conosco
            <i class="bi bi-arrow-right" style="font-size:0.9em;margin-left:0.35rem;"></i>
          </a>
          <a href="tel:+554733265123" class="jmf-p2-cbtn jmf-p2-cbtn-ghost">
            <i class="bi bi-telephone"></i>
            (47) 3326-5123
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="jmf-par-sec" id="parceiros">
    <div class="jmf-par-bg" aria-hidden="true"></div>
    <div class="jmf-par-inner">
      <div class="jmf-par-head" data-reveal>
        <span class="jmf-eyebrow-paper">Parceiros</span>
        <h2 class="jmf-par-title">
          Quem confia na
          <span class="jmf-par-title-grad">JMF Contabilidade</span>
        </h2>
        <p class="jmf-par-lead">Empresas de Blumenau e de Santa Catarina que constroem suas trajetórias ao nosso lado.</p>
      </div>

      <div class="jmf-par-marquee">
        <Parceiros />
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var sec = document.querySelector('#nossa-missao');
      if (!sec) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { sec.classList.add('is-visible'); return; }
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
        });
      }, { threshold: 0.2 });
      obs.observe(sec);
    })();
  </script>

</Layout>
