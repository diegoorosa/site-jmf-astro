const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Como um planejamento tributário pode ajudar o seu negócio?", "acceptedAnswer": { "@type": "Answer", "text": "Redução da carga tributária com escolha do regime adequado, previsibilidade do fluxo de caixa, proteção contra penalidades e melhoria da competitividade. Uma empresa de serviços com R$ 80 mil/mês pode economizar até R$ 4.500/mês com planejamento tributário adequado." } },
    { "@type": "Question", "name": "O que significa uma consultoria tributária?", "acceptedAnswer": { "@type": "Answer", "text": "Análise pontual e estratégica da situação fiscal da empresa para identificar problemas, riscos e oportunidades. Diferente da rotina mensal, a consultoria responde perguntas como: qual o impacto de contratar mais funcionários? Faz sentido criar uma holding? Há créditos tributários não aproveitados?" } },
    { "@type": "Question", "name": "Por que um bom planejamento tributário é essencial?", "acceptedAnswer": { "@type": "Answer", "text": "Os impostos representam entre 10% e 34% do faturamento. Uma empresa de serviços no Lucro Presumido paga ~13,33%. No Simples Nacional, pode pagar entre 6% e 19,5%. A escolha errada pode custar R$ 40.000 a R$ 80.000 por ano para uma empresa com R$ 100 mil/mês." } },
    { "@type": "Question", "name": "Como posso ter o suporte da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123, retorno no mesmo dia útil. Primeira conversa gratuita: mapeamento da situação fiscal, estimativa de economia e estratégias disponíveis. Presencial ou videoconferência, segunda a sexta 08h às 18h." } },
    { "@type": "Question", "name": "A consultoria atende empresas de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF presta consultoria e planejamento tributário para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com reuniões por videoconferência sempre que o cliente preferir não se deslocar até o escritório." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  name: "Consultoria e Planejamento Tributário",
  description: "Planejamento tributário em Blumenau/SC: reduza impostos legalmente com Simples Nacional, Lucro Presumido ou Lucro Real."
};
---

<Layout
  title="Consultoria e Planejamento Tributário em Blumenau"
  description="Planejamento tributário em Blumenau/SC: reduza impostos legalmente com Simples Nacional, Lucro Presumido ou Lucro Real."
  canonical="https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario"
  ogUrl="https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Planejamento Tributário em Blumenau para Reduzir seus Impostos"
    subtitle="Nós verificamos os procedimentos fiscais, regimes de tributação e oportunidades de economia para sua empresa pagar menos impostos legalmente."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Consultoria e Planejamento Tributário" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver como funciona", href: "#vantagens", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: agosto de 2026</span>
    </div>
  </div>

  <!-- Empresa Protegida -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Sua empresa<br/><span class="pp3-grad">protegida pela lei!</span></h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Com um planejamento e consultoria tributária, sua empresa terá as melhores oportunidades do mercado para empreender com tranquilidade e com economia tributária.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Nós participamos das decisões estratégicas e no desenvolvimento de projetos das empresas com uma abordagem integrada. Oferecemos um serviço completo de planejamento e assessoria tributária e consultoria de negócios, ajudando a encontrar soluções personalizadas que buscam otimizar resultados e minimizar impactos fiscais.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1-1036x691.webp" alt="Consultoria Tributária JMF"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- Vantagens -->
  <section id="vantagens" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Conheça as vantagens que você tem ao contar<br/><span class="pp3-grad">com os nossos especialistas!</span></h2>
        <p class="text-gray-600 text-lg">Com os nossos benefícios, a sua empresa estará protegida e você terá uma consultoria próxima para auxiliar na sua tributação.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-shield-check"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Mais Segurança</h4>
          <p class="text-gray-600">Garanta a regularidade legal do seu negócio e a segurança por meio de uma equipe especializada em tributação.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-coin"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Planejamento Tributário</h4>
          <p class="text-gray-600">Nós fazemos o seu planejamento tributário para garantir que você não pague impostos excessivos.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-award"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Benefícios Fiscais</h4>
          <p class="text-gray-600">Cumprindo as normas da lei, sua empresa pode usufruir de alguns benefícios fiscais, e nós vamos te orientar no recolhimento.</p>
        </div>
      </div>
      <div class="text-center mt-10">
        <img src="/assets/images/mbr-2-816x544.webp" alt="Equipe de Consultoria Tributária"
          width="816" height="544" class="rounded-xl shadow-lg mx-auto max-w-xl w-full" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Tenha tranquilidade e eficiência<br/><span class="pp3-grad-light">na gestão dos seus tributos!</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Com uma assessoria e estratégia tributária, você conta com a orientação de especialistas para atender às suas demandas, além de encontrar soluções inteligentes para diminuir os efeitos da alta carga tributária no seu negócio.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Quero agendar uma reunião
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="pp3-grad">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Como um planejamento tributário pode ajudar o seu negócio?</summary>
              <div class="accordion-body">
                <p>O planejamento tributário é a análise sistemática das opções fiscais legais para reduzir a carga de impostos do seu negócio de forma completamente lícita. Para uma empresa em Blumenau/SC, os benefícios concretos são: redução da carga tributária através da escolha do regime mais adequado (<a href="/regimes-tributarios" class="text-[#1e40af] hover:underline font-semibold">Simples Nacional, Lucro Presumido ou Lucro Real</a>); previsibilidade do fluxo de caixa; proteção contra penalidades; e melhora da competitividade. Uma empresa de serviços em Blumenau com R$ 80 mil de faturamento mensal pode economizar até R$ 4.500/mês com um planejamento tributário adequado. A JMF realiza simulações comparativas — ou use nosso <a href="/simulador-regime-tributario" class="text-[#1e40af] hover:underline font-semibold">simulador de regime tributário gratuito</a> para uma estimativa imediata.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que significa uma consultoria tributária?</summary>
              <div class="accordion-body">
                <p>Uma consultoria tributária e contábil é um serviço especializado em que profissionais analisam a situação específica de uma empresa para identificar problemas, riscos e oportunidades fiscais. Diferentemente da rotina contábil mensal, a consultoria é uma análise pontual e estratégica — por exemplo, quando a empresa está crescendo e precisa saber se deve mudar de regime tributário, quando recebe uma notificação da Receita Federal, ou quando os sócios querem distribuir resultados de forma mais eficiente. Para empresas em Blumenau/SC, uma consultoria da JMF pode responder: qual o impacto de contratar mais funcionários? Faz sentido criar uma holding? Há créditos tributários não aproveitados nos últimos 5 anos?</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Por que um bom planejamento tributário é essencial?</summary>
              <div class="accordion-body">
                <p>O planejamento tributário é essencial porque os impostos representam, em média, entre 10% e 34% do faturamento de uma empresa brasileira. Para prestadores de serviços em Blumenau/SC, uma empresa de consultoria no Lucro Presumido paga alíquota efetiva de aproximadamente 13,33% sobre o faturamento. No Simples Nacional, dependendo do Anexo e do faturamento, essa mesma empresa pode pagar entre 6% e 19,5%. A escolha errada pode representar uma diferença de R$ 40.000 a R$ 80.000 por ano para uma empresa com R$ 100 mil mensais de faturamento. A JMF faz essa análise anualmente, antes do prazo de opção de cada regime.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como eu posso ter o suporte da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>Pelo WhatsApp (47) 3326-5123 você fala diretamente com um consultor e agenda uma reunião no mesmo dia útil. A primeira conversa é gratuita: mapeamos os principais pontos da situação fiscal da sua empresa, estimamos o potencial de economia tributária e apresentamos as estratégias disponíveis antes de qualquer proposta de honorários. Atendemos presencialmente no nosso escritório (Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro, Blumenau) ou por videoconferência, de segunda a sexta das 08h às 18h.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">A consultoria atende empresas de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF presta consultoria e planejamento tributário para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com reuniões por videoconferência sempre que o cliente preferir não se deslocar até o escritório.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/planejamento-tributario-como-pagar-menos-imposto-legalmente"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento tributário</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">7 estratégias para pagar menos imposto legalmente em 2026</p>
        </a>
        <a href="/blog/pro-labore-e-dividendos-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Distribuição de resultados</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Pró-labore e dividendos 2026: quanto retirar e como pagar menos imposto</p>
        </a>
        <a href="/blog/holding-familiar-vale-a-pena-para-pequenos-empresarios"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento patrimonial</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Holding familiar: vale a pena para pequenos empresários?</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e vamos juntos<br/><span class="pp3-grad">fazer a diferença no seu negócio!</span></h2>
          <p class="text-gray-600 text-lg mb-6">Se você precisa de um parceiro estratégico em contabilidade, você encontrou o lugar certo. Entre em contato e marque uma consulta sem custo.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>