---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es%20sobre%20planejamento%20tribut%C3%A1rio.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario#localbusiness",
  "name": "JMF Contabilidade – Planejamento Tributário",
  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario",
  "description": "Planejamento tributário em Blumenau/SC: reduza impostos legalmente com o enquadramento correto entre Simples Nacional (Fator R) e Lucro Presumido.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89010-060",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.92016,
    "longitude": -49.06705
  },
  "foundingDate": "1989-05-24",
  "areaServed": [
    { "@type": "City", "name": "Blumenau" },
    { "@type": "City", "name": "Indaial" },
    { "@type": "City", "name": "Gaspar" },
    { "@type": "City", "name": "Pomerode" },
    { "@type": "City", "name": "Timbó" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Planejamento Tributário",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abertura de Empresa" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gestão Contábil" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gestão Fiscal e Tributária" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gestão de Pessoal" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Planejamento Tributário (Simples Nacional e Lucro Presumido)" } }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/jmfcontabilidadebnu/",
    "https://www.instagram.com/jmf.contabilidade/",
    "https://www.linkedin.com/company/jmf-contabilidade/",
    "https://twitter.com/jmfcontab",
    "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
    "https://www.yelp.com/biz/jmf-contabilidade-escrit%C3%B3rio-de-contabilidade-blumenau",
    "https://www.apontador.com.br/local/sc/blumenau/assessoria_contabil/6a43ca8942af5752cc2a601d/jmf_contabilidade.html"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "00:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 5,
    "bestRating": 5,
    "worstRating": 1,
    "reviewCount": 150
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Como um planejamento tributário pode ajudar o seu negócio?", "acceptedAnswer": { "@type": "Answer", "text": "Redução da carga tributária com escolha do regime adequado entre Simples Nacional (incluindo Fator R) e Lucro Presumido, previsibilidade do fluxo de caixa, proteção contra penalidades e melhoria da competitividade. Uma empresa de serviços com R$ 80 mil/mês pode economizar até R$ 4.500/mês com enquadramento tributário adequado." } },
    { "@type": "Question", "name": "O que é avaliado no planejamento tributário da empresa?", "acceptedAnswer": { "@type": "Answer", "text": "Analisamos o faturamento, a margem operacional, os CNAEs e a folha de pagamento para definir o melhor enquadramento entre Simples Nacional e Lucro Presumido — tanto na abertura do CNPJ quanto na revisão anual de empresas já atendidas pelo escritório, incluindo o acompanhamento mensal do Fator R e a segregação de receitas monofásicas." } },
    { "@type": "Question", "name": "Por que um bom planejamento tributário é essencial?", "acceptedAnswer": { "@type": "Answer", "text": "Os impostos representam parte relevante do faturamento de uma empresa. Para prestadores de serviços em Blumenau/SC, uma empresa no Lucro Presumido paga alíquota efetiva aproximada de 13,33% sobre o faturamento, enquanto no Simples Nacional pode pagar entre 6% e 19,5%. A escolha errada pode representar uma diferença de R$ 40.000 a R$ 80.000 por ano para uma empresa com R$ 100 mil mensais de faturamento." } },
    { "@type": "Question", "name": "Como posso ter o suporte da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "Pelo WhatsApp (47) 3326-5123 você fala diretamente com nossa equipe e agenda um atendimento no mesmo dia útil. Mapeamos o perfil fiscal da sua empresa para apresentar o enquadramento ideal entre Simples Nacional e Lucro Presumido e nossa proposta de assessoria contábil mensal, presencialmente em Blumenau ou por videoconferência." } },
    { "@type": "Question", "name": "A JMF atende empresas de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF presta assessoria contábil e planejamento tributário para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com reuniões por videoconferência sempre que o cliente preferir não se deslocar até o escritório." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  name: "Planejamento Tributário",
  description: "Planejamento tributário em Blumenau/SC: reduza impostos legalmente escolhendo entre Simples Nacional (Fator R) e Lucro Presumido."
};
---

<Layout
  title="Planejamento Tributário em Blumenau | JMF Contabilidade"
  description="Planejamento tributário em Blumenau/SC: reduza impostos legalmente escolhendo entre Simples Nacional (Fator R) e Lucro Presumido."
  canonical="https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario"
  ogUrl="https://www.jmfcontabilidade.com.br/consultoria-e-planejamento-tributario"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Planejamento Tributário em Blumenau para Reduzir seus Impostos"
    subtitle="Analisamos os CNAEs, o faturamento e a folha de pagamento para definir o melhor enquadramento entre Simples Nacional e Lucro Presumido para sua empresa pagar menos impostos legalmente."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Planejamento Tributário" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver como funciona", href: "#vantagens", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: novembro de 2026</span>
    </div>
  </div>

  <!-- Empresa Protegida -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Sua empresa<br/><span class="pp3-grad">protegida pela lei!</span></h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Com um planejamento tributário bem estruturado desde a abertura ou na virada do ano fiscal, sua empresa opera com tranquilidade, segurança e a menor carga tributária permitida pela legislação.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Acompanhamos a rotina mensal das empresas atendidas pela JMF Contabilidade com visão preventiva: definimos os CNAEs adequados, monitoramos o Fator R no Simples Nacional, segregamos receitas monofásicas e comparamos anualmente a viabilidade entre Simples Nacional e Lucro Presumido.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-[#dbeafe] transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1-1036x691.webp" alt="Planejamento Tributário JMF"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- Vantagens -->
  <section id="vantagens" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Conheça as vantagens de contar<br/><span class="pp3-grad">com a nossa equipe contábil!</span></h2>
        <p class="text-gray-600 text-lg">Acompanhamento mensal próximo para manter sua empresa regular e no regime tributário mais econômico.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-shield-check"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Mais Segurança</h4>
          <p class="text-gray-600">Garanta a conformidade fiscal do seu CNPJ e evite autuações por enquadramento ou emissão incorreta de notas.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-coin"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Enquadramento Correto</h4>
          <p class="text-gray-600">Comparamos Simples Nacional (Fator R) e Lucro Presumido para que você não pague impostos desnecessários.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-award"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Revisão Recorrente</h4>
          <p class="text-gray-600">Acompanhamos a evolução do seu faturamento e folha ao longo do ano para ajustar a estratégia na virada de exercício.</p>
        </div>
      </div>
      <div class="text-center mt-10">
        <img src="/assets/images/mbr-2-816x544.webp" alt="Equipe de Planejamento Tributário"
          width="816" height="544" class="rounded-xl shadow-lg mx-auto max-w-xl w-full" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Tenha tranquilidade e eficiência<br/><span class="pp3-grad-light">na gestão dos seus tributos!</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Com a assessoria mensal da JMF Contabilidade, você conta com orientação próxima para manter o enquadramento fiscal adequado e cumprir todas as obrigações da sua empresa em dia.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Quero agendar uma reunião
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="pp3-grad">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Como um planejamento tributário pode ajudar o seu negócio?</summary>
              <div class="accordion-body">
                <p>O planejamento tributário é a análise das opções fiscais legais para reduzir a carga de impostos do seu negócio de forma lícita. Para uma empresa em Blumenau/SC, os benefícios concretos são: escolha do regime mais adequado (<a href="/regimes-tributarios" class="text-[#1e40af] hover:underline font-semibold">Simples Nacional ou Lucro Presumido</a>); previsibilidade do fluxo de caixa; proteção contra penalidades; e melhora da competitividade. Uma empresa de serviços em Blumenau com R$ 80 mil de faturamento mensal pode economizar até R$ 4.500/mês com o enquadramento correto — utilize também nosso <a href="/simulador-regime-tributario" class="text-[#1e40af] hover:underline font-semibold">simulador de regime tributário</a> para uma estimativa inicial.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que é avaliado no planejamento tributário da empresa?</summary>
              <div class="accordion-body">
                <p>Analisamos o faturamento mensal, a margem operacional, os CNAEs e a estrutura de folha de pagamento para definir o regime mais vantajoso entre Simples Nacional (incluindo a regra do Fator R) e Lucro Presumido. Esse estudo faz parte do nosso processo de abertura de empresa, migração de contabilidade e revisão anual dos clientes atendidos mensalmente pelo escritório.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Por que um bom planejamento tributário é essencial?</summary>
              <div class="accordion-body">
                <p>Porque os impostos representam parte expressiva do faturamento de uma empresa brasileira. Para prestadores de serviços em Blumenau/SC, uma empresa de consultoria no Lucro Presumido paga alíquota efetiva de aproximadamente 13,33% sobre o faturamento. No Simples Nacional, dependendo do Anexo e do Fator R, essa mesma empresa pode pagar entre 6% e 19,5%. A escolha errada pode representar uma diferença de R$ 40.000 a R$ 80.000 por ano para uma empresa com R$ 100 mil mensais de faturamento.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como eu posso ter o suporte da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>Pelo WhatsApp (47) 3326-5123 você fala diretamente com nossa equipe e agenda uma conversa no mesmo dia útil. Mapeamos o perfil da sua empresa para indicar o melhor enquadramento entre Simples Nacional e Lucro Presumido e apresentar nossa proposta de assessoria contábil mensal. Atendemos presencialmente no nosso escritório (Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro, Blumenau) ou por videoconferência, de segunda a sexta das 08h às 18h.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">A JMF atende empresas de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF presta assessoria contábil e planejamento tributário para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com reuniões por videoconferência sempre que o cliente preferir não se deslocar até o escritório.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/planejamento-tributario-como-pagar-menos-imposto-legalmente"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento tributário</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">7 estratégias para pagar menos imposto legalmente em 2026</p>
        </a>
        <a href="/blog/pro-labore-e-dividendos-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Distribuição de resultados</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Pró-labore e dividendos 2026: quanto retirar e como pagar menos imposto</p>
        </a>
        <a href="/blog/holding-familiar-vale-a-pena-para-pequenos-empresarios"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento patrimonial</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Holding familiar: vale a pena para pequenos empresários?</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e vamos juntos<br/><span class="pp3-grad">fazer a diferença no seu negócio!</span></h2>
          <p class="text-gray-600 text-lg mb-6">Se você precisa de um parceiro estratégico em contabilidade para cuidar do enquadramento e da rotina mensal da sua empresa, fale com nossa equipe.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
