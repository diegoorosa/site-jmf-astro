---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const pageTitle = 'Contabilidade para Construção Civil em Blumenau e SC | JMF Contabilidade';
const pageDescription = 'Especialistas em contabilidade para construtoras e incorporadoras em Blumenau. Economia com RET (4%), desoneração da folha, controle por obra e Simples Anexo IV.';
