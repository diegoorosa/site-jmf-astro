const pageTitle = 'Contabilidade para Engenharia, Arquitetura e Construtoras em Blumenau | JMF Contabilidade';
const pageDescription = 'Contabilidade mensal recorrente para escritórios de engenharia, arquitetura e construtoras no Lucro Presumido (mão de obra terceirizada) e Simples Nacional em Blumenau e SC.';
