const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qual o melhor regime tributário para escritórios de engenharia e arquitetura?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para escritórios de engenharia e arquitetura, o Simples Nacional com aplicação do Fator R costuma ser muito vantajoso, pois permite tributar o faturamento a partir de 6% (Anexo III) quando a folha e o pró-labore atingem 28% da receita. Conforme o faturamento cresce, avaliamos também a migração para o Lucro Presumido."
      }
    },
    {
      "@type": "Question",
      "name": "Vocês atendem construtoras no Lucro Presumido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Atendemos construtoras e empresas de administração de obras enquadradas no Lucro Presumido que operam com mão de obra terceirizada, cuidando de toda a contabilidade mensal, emissão de notas fiscais e apuração de impostos. Não atuamos com regime de Lucro Real, incorporação com RET, aferição de obras no CNO/SERO ou folha de pagamento de operários em canteiro."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona a abertura de CNPJ ou troca de contador para engenheiros e construtoras?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cuidamos de todo o processo de abertura da empresa, escolha dos CNAEs adequados e legalização municipal, além de orientar na documentação contábil necessária para o registro da pessoa jurídica no CREA ou CAU. Se a empresa já está ativa, realizamos a transição contábil sem interromper a emissão das suas notas."
      }
    }
  ]
};

const heroData = {
  tagline: 'Contabilidade Empresarial Recorrente',
  title: 'Contabilidade para <span class="pp3-grad">Engenharia, Arquitetura e Construtoras</span>',
  subtitle: 'Assessoria contábil, fiscal e tributária para escritórios de projetos, empresas de gerenciamento de obras e construtoras no Lucro Presumido (mão de obra terceirizada) e Simples Nacional.',
  breadcrumbs: [
    { label: 'Início', href: '/' },
    { label: 'Serviços', href: '/servicos' },
    { label: 'Engenharia e Construção Civil', href: '/contabilidade-para-construcao-civil' }
  ],
  ctas: [
    {
      label: 'Solicitar Proposta Contábil',
      href: 'https://wa.me/554733265123?text=Ol%C3%A1%2C%20tenho%20uma%20empresa%20de%20engenharia%20ou%20constru%C3%A7%C3%A3o%20civil%20e%20gostaria%20de%20uma%20proposta%20cont%C3%A1bil%20com%20a%20JMF.',
      variant: 'cta'
    },
    {
      label: 'Ver Serviços Atendidos',
      href: '#servicos',
      variant: 'outline'
    }
  ],
  subNotice: 'Atendimento focado em empresas no Simples Nacional e Lucro Presumido (com mão de obra terceirizada) em Blumenau e região.'
};

const updatedDate = 'Atualizado em 12/11/2026';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogUrl={canonicalUrl}
  schema={JSON.stringify(localBusinessSchema)}
  heroInterno={heroData}
  bodyClass="pp3"
>
  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>{updatedDate}</span>
    </div>
  </div>

  <!-- SEÇÃO 1: PILARES DE ATENDIMENTO -->
  <section class="bg-white" aria-labelledby="pilares">
    <div class="container mx-auto px-4 max-w-6xl">
      <header class="section-header text-center mb-12">
        <h2 id="pilares" class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-4">
          Gestão Contábil Organizada para<br/>
          <span class="pp3-grad">Engenharia e Construtoras</span>
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          Empresas de projetos técnicos, administração de obras e construtoras que trabalham com empreiteiros terceirizados precisam de enquadramento tributário preciso e emissão correta de notas fiscais para não pagar impostos além do devido.
        </p>
      </header>
      <p class="text-lg text-slate-600 mb-10 leading-relaxed max-w-3xl mx-auto text-center">
        Na JMF Contabilidade, cuidamos da rotina mensal da sua empresa em três frentes principais:
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article class="card-custom">
          <div class="pillar-number mb-4 text-4xl font-bold text-cyan-500">1</div>
          <h3 class="pillar-title font-bold text-xl text-slate-900 mb-3">Enquadramento no Simples Nacional (Fator R) ou Lucro Presumido</h3>
          <p class="pillar-text text-slate-600 leading-relaxed">Avaliamos o faturamento e a estrutura da sua empresa para definir o regime mais econômico — aplicando o Fator R (a partir de 6%) para serviços de engenharia e arquitetura ou estruturando a apuração no Lucro Presumido.</p>
        </article>
        <article class="card-custom">
          <div class="pillar-number mb-4 text-4xl font-bold text-cyan-500">2</div>
          <h3 class="pillar-title font-bold text-xl text-slate-900 mb-3">Emissão de Notas Fiscais e Retenções na Fonte</h3>
          <p class="pillar-text text-slate-600 leading-relaxed">Orientação prática para emissão de NFS-e de serviços técnicos, gerenciamento de obras e empreitada com terceiros, garantindo o destaque correto de ISS e das retenções federais (IRRF, PIS, COFINS e CSLL).</p>
        </article>
        <article class="card-custom">
          <div class="pillar-number mb-4 text-4xl font-bold text-cyan-500">3</div>
          <h3 class="pillar-title font-bold text-xl text-slate-900 mb-3">Escrituração Contábil e Distribuição de Lucros</h3>
          <p class="pillar-text text-slate-600 leading-relaxed">Conciliação bancária via extratos, emissão de balancetes e DRE mensal para manter a contabilidade regular e permitir a distribuição de lucros isentos de IRPF aos sócios com segurança.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SEÇÃO 2: QUEM ATENDEMOS -->
  <section class="bg-[#f8fafc]" aria-labelledby="quem-atendemos">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="section-header text-center mb-12">
        <h2 id="quem-atendemos" class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Perfis de Empresas que<br/>
          <span class="pp3-grad">Atendemos</span>
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Nossa estrutura contábil é dedicada a empresas prestadoras de serviços técnicos e construtoras enxutas enquadradas no Simples Nacional ou Lucro Presumido.
        </p>
      </header>
      <ul class="space-y-4 text-lg text-slate-600">
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Construtoras no Lucro Presumido com mão de obra terceirizada</strong> (empresas que contratam empreiteiros e prestadores terceirizados, sem equipe própria de operários em canteiro)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Escritórios de Engenharia</strong> (Civil, Elétrica, Mecânica, Produção, Ambiental e Segurança do Trabalho)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Escritórios de Arquitetura, Urbanismo e Design de Interiores</strong></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Empresas de Gerenciamento, Fiscalização e Administração de Obras</strong></span>
        </li>
      </ul>

      <div class="mt-8 p-5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600">
        <strong class="text-slate-900">Escopo de atuação:</strong> Para manter a qualidade e agilidade no atendimento mensal, a JMF Contabilidade <strong>não</strong> atua com empresas no regime do Lucro Real, incorporações com RET (Patrimônio de Afetação), regularização ou aferição de obras no CNO/SERO e gestão de folha de pagamento de operários em canteiro de obras.
      </div>
    </div>
  </section>

  <!-- SEÇÃO 3: SERVIÇOS -->
  <section id="servicos" class="bg-white" aria-labelledby="servicos">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="section-header text-center mb-12">
        <h2 id="servicos" class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          O Que Fazemos na Rotina da<br/>
          <span class="pp3-grad">Sua Empresa</span>
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Assessoria contábil, fiscal e societária completa para o dia a dia do seu CNPJ.
        </p>
      </header>
      <ul class="space-y-4 text-lg text-slate-600">
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Abertura de CNPJ e Legalização:</strong> constituição da empresa na JUCESC, alvarás municipais, definição estratégica de CNAEs e apoio documental para registro no CREA ou CAU</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Enquadramento Tributário:</strong> análise entre Simples Nacional (cálculo mensal do Fator R) e Lucro Presumido</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Apuração Fiscal Mensal:</strong> cálculo e emissão das guias de DAS, PIS, COFINS, IRPJ, CSLL e ISS, além da conferência de notas de serviços tomados de terceiros</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Contabilidade Regular e Obrigações Acessórias:</strong> conciliação contábil, Balanço Patrimonial, DRE e entrega de ECD, ECF, DCTFWeb e EFD-Reinf</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Pró-Labore e Folha Administrativa:</strong> gestão de pró-labore dos sócios, folha da equipe de escritório/projetos no eSocial e emissão de guias de INSS e FGTS</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-cyan-500 font-bold mt-1">•</span>
          <span><strong>Troca de Contador Sem Burocracia:</strong> migração segura da contabilidade de empresas já em atividade em Blumenau e região</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- SEÇÃO 4: DIFERENCIAIS -->
  <section class="bg-[#f8fafc]" aria-labelledby="diferenciais">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="section-header text-center mb-12">
        <h2 id="diferenciais" class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Diferenciais da<br/>
          <span class="pp3-grad">JMF Contabilidade</span>
        </h2>
      </header>
      <ul class="space-y-6 text-lg text-slate-600">
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <strong class="text-slate-900">Tradição desde 1989 no Vale do Itajaí:</strong> mais de 35 anos de experiência atendendo empresas de serviços e comércio em Blumenau e região.
          </div>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </div>
          <div>
            <strong class="text-slate-900">Atendimento direto e sem burocracia:</strong> contato ágil via WhatsApp e e-mail diretamente com a equipe contábil, fiscal e societária do escritório.
          </div>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <div>
            <strong class="text-slate-900">Foco em Simples Nacional e Lucro Presumido:</strong> processos digitais enxutos para manter suas guias, declarações e demonstrações contábeis sempre em dia.
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- SEÇÃO 5: FAQ -->
  <section class="bg-white" aria-labelledby="faq">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="section-header text-center mb-12">
        <h2 id="faq" class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Perguntas<br/>
          <span class="pp3-grad">Frequentes</span>
        </h2>
      </header>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema, null, 2)} />
      <div class="faq-accordion">
        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>Qual o melhor regime tributário para escritórios de engenharia e arquitetura?</span>
            <span class="accordion-icon" aria-hidden="true">+</span>
          </summary>
          <div class="accordion-body">
            <p>Para escritórios de engenharia e arquitetura, o Simples Nacional com aplicação do Fator R costuma ser muito vantajoso, pois permite tributar o faturamento a partir de 6% (Anexo III) quando a folha e o pró-labore atingem 28% da receita. Conforme o faturamento cresce, avaliamos também a migração para o Lucro Presumido.</p>
          </div>
        </details>
        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>Vocês atendem construtoras no Lucro Presumido?</span>
            <span class="accordion-icon" aria-hidden="true">+</span>
          </summary>
          <div class="accordion-body">
            <p>Sim. Atendemos construtoras e empresas de administração de obras enquadradas no Lucro Presumido que operam com mão de obra terceirizada, cuidando de toda a contabilidade mensal, emissão de notas fiscais e apuração de impostos. Não atuamos com regime de Lucro Real, incorporação com RET, aferição de obras no CNO/SERO ou folha de pagamento de operários em canteiro.</p>
          </div>
        </details>
        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>Como funciona a abertura de CNPJ ou troca de contador para engenheiros e construtoras?</span>
            <span class="accordion-icon" aria-hidden="true">+</span>
          </summary>
          <div class="accordion-body">
            <p>Cuidamos de todo o processo de abertura da empresa, escolha dos CNAEs adequados e legalização municipal, além de orientar na documentação contábil necessária para o registro da pessoa jurídica no CREA ou CAU. Se a empresa já está ativa, realizamos a transição contábil sem interromper a emissão das suas notas.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#0f172a]" aria-labelledby="cta-final">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="section-header text-center mb-12">
        <h2 id="cta-final" class="text-3xl md:text-4xl font-bold text-white mb-4">
          Mantenha a contabilidade da sua empresa<br/>
          <span class="pp3-grad">em dia e sem complicação</span>
        </h2>
        <p class="text-lg text-slate-300 leading-relaxed">
          Converse com a equipe da JMF Contabilidade para abrir seu CNPJ ou transferir a gestão contábil mensal da sua empresa em Blumenau e região.
        </p>
      </header>
