  "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
  "taxID": "81.335.895/0001-17",
  "identifier": {
    "@type": "PropertyValue",
    "name": "CRC",
    "value": "SC-002550/O"
  },
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-em-indaial",
  "description": "Contabilidade para empresas de Indaial/SC: rotina fiscal, Simples Nacional, Lucro Presumido e planejamento tributário com atendimento digital e sede em Blumenau.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
    "addressLocality": "Blumenau",
