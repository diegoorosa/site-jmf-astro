---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20a%20JMF%20Contabilidade%20e%20quero%20saber%20sobre%20contabilidade%20para%20minha%20empresa%20em%20Itaja%C3%AD.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-em-itajai#localbusiness",
  "name": "JMF Contabilidade – Itajaí",
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-em-itajai",
  "description": "Contabilidade para empresas em Itajaí/SC: porto, comércio exterior, logística, indústria e serviços. Simples Nacional ou Lucro Presumido. Atendimento digital, 60km de Blumenau.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Atendimento digital / Sede em Blumenau: Rua Rodolfo Freygang, 15, Sala 506",
    "addressLocality": "Itajaí",
    "addressRegion": "SC",
    "postalCode": "88301-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.9078,
    "longitude": -48.6619
  },
  "areaServed": [
    { "@type": "City", "name": "Itajaí" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "A JMF Contabilidade atende empresas em Itajaí?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Atendemos empresas de Itajaí/SC 100% digital. Itajaí fica a 60km de Blumenau (1h10), polo portuário e logístico. Fechamento mensal, documentos e comunicação via WhatsApp, portal e videoconferência."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona contabilidade para comércio exterior em Itajaí?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Empresas de comex em Itajaí (importadores, exportadores, despachantes, trading) lidam com: Drawback, RECOF, RECOF-SPED, admissão temporária, Regime Aduaneiro Especial, ICMS na importação, PIS/COFINS-Importação. A JMF tem expertise em tributação de comércio exterior."
      }
    },
    {
      "@type": "Question",
      "name": "Itajaí tem incentivos para logística e porto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Itajaí concentra o segundo maior porto do Brasil. Empresas de logística, armazenagem, terminais portuários e transportadoras podem acessar incentivos estaduais (PRODEC, TTD) e regimes aduaneiros especiais. A JMF assessora a estruturação tributária completa."
      }
    },
    {
      "@type": "Question",
      "name": "Atendimento remoto para Itajaí como funciona?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WhatsApp (47) 3326-5123, portal do cliente, e-mail, videoconferência. Para presença física, Blumenau a 60km (1h10 pela BR-101). Resposta no mesmo dia útil. Rotina mensal padrão: docs até dia 5, fechamento até dia 15, guias até dia 20."
      }
    }
  ]
});

const schema = [localBusinessSchema, faqSchema];
---

<Layout
  title="Contabilidade em Itajaí/SC | JMF Contabilidade"
  description="Contabilidade para empresas em Itajaí/SC: porto, comércio exterior, logística, indústria.  Simples Nacional ou Lucro Presumido."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-em-itajai"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-em-itajai"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para empresas em Itajaí"
    subtitle="Polo portuário, comércio exterior, logística e indústria. Expertise em tributação de comex e regimes aduaneiros. 60km de Blumenau."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Áreas de Atuação" },
      { label: "Contabilidade em Itajaí" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver serviços", href: "#servicos", variant: "outline" }
    ]}
  />

  <section id="servicos" class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Contabilidade em Itajaí:<br/><span class="pp3-grad">porto, comex, logística e indústria</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Itajaí abriga o segundo maior porto do Brasil e é um dos principais polos de comércio exterior, logística e indústria naval de Santa Catarina. Empresas da região operam com regimes aduaneiros especiais, tributação complexa de importação/exportação e incentivos estaduais específicos — exigem contabilidade com expertise técnica comprovada.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A JMF Contabilidade atende importadores, exportadores, trading companies, despachantes, operadores logísticos, terminais portuários e indústrias de Itajaí com planejamento tributário especializado em comércio exterior e regimes especiais. Atendimento 100% digital, estrutura de 35+ anos em Blumenau (60km / 1h10).
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Tributação de Comércio Exterior</h3>
          <p class="text-slate-600 leading-relaxed">
            Drawback (isenção/suspensão), RECOF/RECOF-SPED, admissão temporária, entreposto aduaneiro. ICMS na importação, PIS/COFINS-Importação, II, IPI. Recuperação de créditos.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Logística e Transporte</h3>
          <p class="text-slate-600 leading-relaxed">
            Transportadoras, armazenagem, terminais: ICMS interestadual, DIFAL, substituição tributária, antecipação de ICMS, frete como base de cálculo. Regimes especiais de SC.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Indústria Naval e Offshore</h3>
          <p class="text-slate-600 leading-relaxed">
            Estaleiros, naval, offshore: Lucro Presumido, créditos de ICMS, PIS/COFINS não cumulativos, exclusão ICMS base PIS/COFINS, incentivos PRODEC/TTD.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Fechamento Mensal Completo</h3>
          <p class="text-slate-600 leading-relaxed">
            Escrituração fiscal, SPED Fiscal/Contribuições, ECD/ECF, DCTF, PER/DCOMP, obrigações aduaneiras (DI, DU-E, LI). Tudo no prazo, sem multas, com relatórios gerenciais.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Itajaí — Comércio Exterior:<br/><span class="pp3-grad">particularidades tributárias</span></h2>

      <p class="text-lg text-slate-600 mb-6 leading-relaxed">
        Itajaí concentra operações com complexidade tributária única no estado:
      </p>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Regimes Aduaneiros Especiais:</strong> Drawback integrado (isenção + suspensão), RECOF-SPED (indústria), admissão temporária para feiras/manutenção. Exigem controle rigoroso de estoque e apuração de tributos suspensos.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>ICMS na Importação:</strong> base de cálculo = valor aduaneiro + II + IPI + despesas. Crédito de ICMS depende da destinação da mercadoria (revenda, industrialização, uso/consumo).</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>PIS/COFINS-Importação:</strong> alíquotas 2,1% / 9,65% (não cumulativo) ou 0,65% / 4% (cumulativo). Crédito vinculado à receita de revenda/industrialização no mercado interno.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Incentivos PRODEC/TTD para logística:</strong> terminais, armazéns, transportadoras em Itajaí podem acessar redução de ICMS via programas estaduais.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Dado real:</strong> Importador em Itajaí no Lucro Presumido paga PIS/COFINS-Importação (11,75%) sem direito a crédito integral se não houver receita de revenda no mercado interno. No Lucro Presumido, o crédito é pleno — mas a JMF atende apenas Simples Nacional, então o foco é estruturar a operação de comex para minimizar o custo da importação. A JMF simula o cenário ideal.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Atendimento para<br/><span class="pp3-grad">Itajaí</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>100% Digital:</strong> WhatsApp (47) 3326-5123, portal, e-mail, videoconferência. Expertise em comex: envio de DI/DU-E, planilhas de Drawback, controles de RECOF via portal.
        </p>
        <p>
          <strong>Presencial quando quiser:</strong> Blumenau a 60km (1h10 pela BR-101). Sede: Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro.
        </p>
        <p>
          <strong>Rotina comex:</strong> Recebimento docs até dia 5, apuração tributos aduaneiros até dia 10, fechamento completo até dia 15, guias e relatórios até dia 20.
        </p>
      </div>
    </div>
  </section>

  <section id="formulario" class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Fale com a <span class="pp3-grad">JMF</span></h2>
      <p class="text-lg text-slate-600 mb-8">Resposta no mesmo dia útil. Levantamento de obrigações pendentes sem custo. Simulação tributária para comex/logística gratuita.</p>
      <ContactForm />
    </div>
  </section>

</Layout>