---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20a%20JMF%20Contabilidade%20e%20quero%20saber%20sobre%20contabilidade%20para%20minha%20empresa%20em%20Itaja%C3%AD.";

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["AccountingService", "LocalBusiness"],
  "@id": "https://www.jmfcontabilidade.com.br/contabilidade-em-itajai#localbusiness",
  "name": "JMF Contabilidade – Itajaí",
  "url": "https://www.jmfcontabilidade.com.br/contabilidade-em-itajai",
  "description": "Contabilidade digital para empresas em Itajaí/SC: prestadores de serviços, comércio e profissionais liberais no Simples Nacional ou Lucro Presumido. Estrutura de 35+ anos em Blumenau.",
  "telephone": "+55-47-3326-5123",
  "email": "contato@jmfcontabilidade.com.br",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Atendimento digital / Sede em Blumenau: Rua Rodolfo Freygang, 15, Sala 506",
    "addressLocality": "Itajaí",
    "addressRegion": "SC",
    "postalCode": "88301-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.9078,
    "longitude": -48.6619
  },
  "areaServed": [
    { "@type": "City", "name": "Itajaí" },
    { "@type": "State", "name": "Santa Catarina" }
  ],
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "A JMF Contabilidade atende empresas em Itajaí?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. Atendemos empresas de serviços, comércio e profissionais liberais de Itajaí/SC de forma 100% digital. Toda a rotina mensal, envio de documentos, guias e suporte ocorrem via WhatsApp, portal do cliente, e-mail e videoconferência."
      }
    },
    {
      "@type": "Question",
      "name": "Quais regimes tributários vocês atendem em Itajaí?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nosso atendimento é focado em empresas enquadradas no Simples Nacional (incluindo planejamento do Fator R) e no Lucro Presumido, cuidando da abertura de CNPJ, troca de contador, apuração fiscal, folha de pagamento e contabilidade mensal."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona a abertura de CNPJ ou troca de contador em Itajaí?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Realizamos todo o processo de abertura na JUCESC e na Prefeitura de Itajaí de forma digital, definindo os CNAEs e o regime tributário mais econômico. Para empresas já ativas, conduzimos a migração contábil sem interromper sua emissão de notas fiscais."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona a rotina mensal de atendimento digital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Atendimento direto pelo WhatsApp (47) 3326-5123 com retorno no mesmo dia útil. Na rotina mensal, recebemos os documentos até o dia 5, realizamos o fechamento contábil e fiscal e disponibilizamos as guias e relatórios no prazo, além de suporte presencial em Blumenau (60km) quando necessário."
      }
    }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  serviceName: "Contabilidade em Itajaí",
  description: "Contabilidade digital para empresas em Itajaí/SC: prestadores de serviços, comércio e profissionais liberais no Simples Nacional ou Lucro Presumido.",
  url: "https://www.jmfcontabilidade.com.br/contabilidade-em-itajai"
};
---

<Layout
  title="Contabilidade em Itajaí/SC | JMF Contabilidade"
  description="Contabilidade digital para empresas em Itajaí/SC: prestadores de serviços, comércio e profissionais liberais no Simples Nacional ou Lucro Presumido."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-em-itajai"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-em-itajai"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para empresas em Itajaí"
    subtitle="Assessoria contábil, fiscal e trabalhista 100% digital para prestadores de serviços, comércio e profissionais liberais no Simples Nacional e Lucro Presumido."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Áreas de Atuação" },
      { label: "Contabilidade em Itajaí" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver serviços", href: "#servicos", variant: "outline" }
    ]}
  />

  <section id="servicos" class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Contabilidade em Itajaí:<br/><span class="pp3-grad">serviços, comércio e gestão mensal</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Itajaí é um dos municípios que mais crescem em Santa Catarina, impulsionado pelo setor de serviços, tecnologia, saúde, engenharia, construção e comércio local. Empresas e profissionais da cidade precisam de uma contabilidade ágil, organizada e que ajude a pagar o menor imposto dentro da lei.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        A JMF Contabilidade atende empresas de Itajaí com processos 100% digitais e a solidez de mais de 35 anos de experiência no Vale do Itajaí (sede em Blumenau, a 60 km). Cuidamos da abertura do seu CNPJ, enquadramento no Simples Nacional ou Lucro Presumido, folha de pagamento e apuração mensal de impostos sem burocracia.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Abertura de Empresa e Regularização</h3>
          <p class="text-slate-600 leading-relaxed">
            Constituição de CNPJ na JUCESC, inscrição municipal em Itajaí, alvarás de funcionamento e definição estratégica de CNAEs para iniciar sua operação com segurança.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Planejamento Tributário (Simples e Presumido)</h3>
          <p class="text-slate-600 leading-relaxed">
            Análise comparativa entre Simples Nacional (incluindo cálculo mensal do Fator R a partir de 6%) e Lucro Presumido para garantir a menor carga tributária legal para sua atividade.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Contabilidade e Fechamento Mensal</h3>
          <p class="text-slate-600 leading-relaxed">
            Conciliação contábil, Balanço Patrimonial, DRE, apuração de DAS, ISS, PIS, COFINS, IRPJ, CSLL e entrega de todas as declarações acessórias no prazo.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Departamento Pessoal e Pró-Labore</h3>
          <p class="text-slate-600 leading-relaxed">
            Gestão completa da folha de pagamento, pró-labore dos sócios, admissões, férias, rescisões e transmissão rigorosa ao eSocial, DCTFWeb e FGTS Digital.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Itajaí — Serviços e Comércio:<br/><span class="pp3-grad">pontos de atenção na rotina fiscal</span></h2>

      <p class="text-lg text-slate-600 mb-6 leading-relaxed">
        Manter a empresa regular em Santa Catarina exige atenção aos detalhes fiscais estaduais e municipais:
      </p>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Fator R no Simples Nacional:</strong> profissionais de TI, saúde, engenharia, arquitetura e consultoria podem reduzir a alíquota inicial de 15,5% (Anexo V) para 6% (Anexo III) com o acompanhamento mensal da folha e pró-labore.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Emissão de NFS-e e ISS Municipal:</strong> parametrização correta dos códigos de serviço e alíquotas de ISS em Itajaí, evitando retenções indevidas e bitributação.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Comércio Varejista e E-commerce em SC:</strong> controle de produtos monofásicos de PIS/COFINS no Simples Nacional para não pagar imposto duplicado no DAS, além de orientação sobre ICMS e DIFAL.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Distribuição de Lucros Isenta:</strong> escrituração contábil regular (Livro Diário e Balanço) para comprovar o lucro apurado e distribuir resultados aos sócios com segurança fiscal.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Escopo de atuação:</strong> Em Itajaí e região, a JMF Contabilidade atende empresas de serviços, comércio e profissionais liberais enquadrados no <strong>Simples Nacional</strong> e no <strong>Lucro Presumido</strong>. Não atuamos com regime de Lucro Real, despachos aduaneiros ou regimes especiais de comércio exterior (TTD/Drawback).
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Atendimento para<br/><span class="pp3-grad">Itajaí</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>100% Digital:</strong> atendimento ágil pelo WhatsApp (47) 3326-5123, portal do cliente, e-mail e videoconferência, sem necessidade de deslocamento para resolver as rotinas do dia a dia.
        </p>
        <p>
          <strong>Presencial quando quiser:</strong> nossa sede fica em Blumenau (60 km pela BR-101), na Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro.
        </p>
        <p>
          <strong>Rotina organizada:</strong> recebimento de documentos até o dia 5, fechamento contábil e fiscal até o dia 15 e envio antecipado das guias e relatórios mensais.
        </p>
        <p class="mt-4">
          <strong>Sede e equipe completa em Blumenau:</strong> conheça também nossa estrutura principal em <a href="/contabilidade-em-blumenau" class="text-blue-700 font-semibold hover:underline">Blumenau</a> — mais de 35 anos de experiência no Vale do Itajaí.
        </p>
      </div>
    </div>
  </section>

  <section id="formulario" class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Fale com a <span class="pp3-grad">JMF</span></h2>
      <p class="text-lg text-slate-600 mb-8">Retorno no mesmo dia útil. Solicite uma proposta para abrir sua empresa ou transferir a contabilidade do seu CNPJ em Itajaí.</p>
      <ContactForm />
    </div>
  </section>

</Layout>
