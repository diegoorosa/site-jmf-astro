const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Qual a importância de uma gestão fiscal e tributária?", "acceptedAnswer": { "@type": "Answer", "text": "Garante que sua empresa cumpra todas as obrigações perante a Receita Federal, o Estado de SC e o Município de Blumenau — recolhendo impostos corretos, nos prazos certos, sem pagar a mais nem a menos. Uma gestão fiscal deficiente é a principal causa de autuações no Brasil." } },
    { "@type": "Question", "name": "Como a gestão fiscal pode melhorar a sua empresa?", "acceptedAnswer": { "@type": "Answer", "text": "Fluxo de caixa com calendário tributário organizado, competitividade com elisão fiscal legal, prevenção de passivos com escrituração correta e acesso a crédito com certidões negativas sempre em dia. A JMF mantém um calendário atualizado de todas as obrigações acessórias." } },
    { "@type": "Question", "name": "Por que fazer um bom planejamento tributário?", "acceptedAnswer": { "@type": "Answer", "text": "Os impostos representam entre 10% e 34% do faturamento de uma empresa brasileira. Uma empresa de serviços com R$ 80 mil/mês pode pagar entre 11% e 17% dependendo do regime — diferença de até R$ 4.800/mês. A JMF realiza simulação comparativa entre Simples Nacional, Lucro Presumido e Lucro Real." } },
    { "@type": "Question", "name": "Como posso ter o auxílio da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123 com retorno no mesmo dia útil. Reunião de diagnóstico gratuita presencial ou por videoconferência. Empresas em migração passam por onboarding com regularização imediata de obrigações pendentes. Atendimento de segunda a sexta, 08h às 18h." } },
    { "@type": "Question", "name": "Atendem empresas de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade presta gestão fiscal e tributária para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com calendário de obrigações e guias enviados digitalmente." } }
  ]
});

const schema = [localBusinessSchema, faqSchema];

const serviceSchema = {
  name: "Gestão Fiscal e Tributária",
  description: "Gestão fiscal e tributária em Blumenau/SC: DAS, PGDAS, DCTF, SPED e EFD entregues no prazo. Sem multas por atraso."
};
---

<Layout
  title="Gestão Fiscal e Tributária em Blumenau | JMF Contabilidade"
  description="Gestão fiscal e tributária em Blumenau/SC: DAS, PGDAS, DCTF, SPED e EFD entregues no prazo. Sem multas por atraso."
  canonical="https://www.jmfcontabilidade.com.br/gestao-fiscal-e-tributaria"
  ogUrl="https://www.jmfcontabilidade.com.br/gestao-fiscal-e-tributaria"
  schema={schema}
  serviceSchema={serviceSchema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Gestão Fiscal e Tributária em Blumenau/SC"
    subtitle="Sua empresa em conformidade com a Receita Federal, Estado de SC e Município de Blumenau — impostos corretos, prazos certos, sem multas."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Soluções" },
      { label: "Gestão Fiscal e Tributária" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver vantagens", href: "#vantagens", variant: "outline" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: agosto de 2026</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0f172a] mb-6">Gestão Fiscal e Tributária:<br/><span class="pp3-grad">conformidade total, zero multas</span></h2>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Uma gestão fiscal deficiente é a principal causa de autuações no Brasil. A JMF Contabilidade assume toda a rotina fiscal da sua empresa: apuração de impostos, emissão de guias, transmissão de obrigações acessórias (SPED, EFD, DCTF, PGDAS-D) e monitoramento de prazos — tudo no prazo, sem surpresas.
      </p>

      <p class="text-lg text-slate-600 mb-8 leading-relaxed">
        Atendemos empresas de Blumenau, Indaial, Gaspar, Pomerode, Timbó e região. Seja no Simples Nacional, Lucro Presumido ou Lucro Real, sua empresa entrega todas as obrigações no prazo certo.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Apuração e Pagamento</h3>
          <p class="text-slate-600 leading-relaxed">
            DAS (Simples), guias de IRPJ/CSLL/PIS/COFINS (Lucro Presumido/Real), ICMS, ISS, INSS — tudo apurado e emitido no prazo.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Obrigações Acessórias (SPED/EFD)</h3>
          <p class="text-slate-600 leading-relaxed">
            EFD-ICMS/IPI, EFD-Contribuições, ECD, ECF, DCTF, PGDAS-D, DeSTDA. Transmissão validada, recibos arquivados.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Calendário Tributário</h3>
          <p class="text-slate-600 leading-relaxed">
            Calendário mensal personalizado com todas as obrigações, prazos e valores. Você sabe exatamente o que vence e quando.
          </p>
        </div>

        <div class="bg-white border-2 border-slate-200 rounded-xl p-6 hover:border-blue-700 transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Certidões Negativas</h3>
          <p class="text-slate-600 leading-relaxed">
            CNDs federais, estaduais e municipais monitoradas e renovadas automaticamente. Sua empresa sempre regular para licitações e crédito.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Particularidades tributárias -->
  <section class="py-16 bg-slate-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">O que a JMF faz<br/><span class="pp3-grad">pela sua gestão fiscal</span></h2>

      <ul class="space-y-4 text-slate-600 text-lg">
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Zero multas por atraso:</strong> sistema de alertas + equipe dedicada a prazos. Se perdermos um prazo, a multa é por nossa conta.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Revisão de enquadramento:</strong> a cada mudança de legislação ou faturamento, reavaliamos se o regime atual continua ótimo.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Créditos tributários:</strong> identificamos créditos de PIS/COFINS, ICMS, IPI não aproveitados nos últimos 5 anos.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-blue-700 font-bold mt-1">•</span>
          <span><strong>Defesa fiscal:</strong> notificações, intimações e autos de infração — respondemos no prazo com fundamentação técnica.</span>
        </li>
      </ul>

      <div class="mt-8 p-6 bg-white rounded-xl border-2 border-blue-200">
        <p class="text-slate-700 font-medium">
          <strong class="text-blue-700">Dado real:</strong> empresas que migram para a JMF frequentemente têm obrigações em atraso ou mal transmitidas. Nosso onboarding inclui regularização completa antes de assumir a rotina.
        </p>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Como funciona<br/><span class="pp3-grad">a rotina fiscal</span></h2>

      <div class="space-y-6 text-lg text-slate-600">
        <p>
          <strong>1. Recebimento de dados:</strong> notas fiscais (entrada/saída), movimentação bancária, folha de pagamento — via portal, WhatsApp ou integração.
        </p>
        <p>
          <strong>2. Apuração e validação:</strong> calculamos tributos, cruzamos com notas, validamos SPED. Inconsistências são resolvidas no dia.
        </p>
        <p>
          <strong>3. Emissão e transmissão:</strong> guias de pagamento + obrigações acessórias transmitidas. Recibos e comprovantes no portal do cliente.
        </p>
        <p>
          <strong>4. Monitoramento contínuo:</strong> certidões, prazos futuros, mudanças de legislação. Você recebe alertas antecipados.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <h2 class="text-3xl font-bold text-white mb-4">Fim das multas<br/><span class="pp3-grad-light">e do estresse fiscal!</span></h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Calendário tributário organizado, SPED validado, certidões sempre em dia. Fale com a JMF e durma tranquilo sabendo que sua gestão fiscal está em ordem.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>Falar com Especialista
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - Gestão Fiscal e Tributária"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Dúvidas sobre<br />
            <span class="pp3-grad">gestão fiscal e tributária</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Qual a importância de uma gestão fiscal e tributária?</summary>
              <div class="accordion-body">
                <p>Garante que sua empresa cumpra todas as obrigações perante a Receita Federal, o Estado de SC e o Município de Blumenau — recolhendo impostos corretos, nos prazos certos, sem pagar a mais nem a menos. Uma gestão fiscal deficiente é a principal causa de autuações no Brasil.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como a gestão fiscal pode melhorar a sua empresa?</summary>
              <div class="accordion-body">
                <p>Fluxo de caixa com calendário tributário organizado, competitividade com elisão fiscal legal, prevenção de passivos com escrituração correta e acesso a crédito com certidões negativas sempre em dia. A JMF mantém um calendário atualizado de todas as obrigações acessórias.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Por que fazer um bom planejamento tributário?</summary>
              <div class="accordion-body">
                <p>Os impostos representam entre 10% e 34% do faturamento de uma empresa brasileira. Uma empresa de serviços com R$ 80 mil/mês pode pagar entre 11% e 17% dependendo do regime — diferença de até R$ 4.800/mês. A JMF realiza simulação comparativa entre Simples Nacional, Lucro Presumido e Lucro Real.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como posso ter o auxílio da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>WhatsApp (47) 3326-5123 com retorno no mesmo dia útil. Reunião de diagnóstico gratuita presencial ou por videoconferência. Empresas em migração passam por onboarding com regularização imediata de obrigações pendentes. Atendimento de segunda a sexta, 08h às 18h.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Atendem empresas de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade presta gestão fiscal e tributária para empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com calendário de obrigações e guias enviados digitalmente.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/planejamento-tributario-como-pagar-menos-imposto-legalmente"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento tributário</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">7 estratégias para pagar menos imposto legalmente em 2026</p>
        </a>
        <a href="/blog/pro-labore-e-dividendos-2026"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Distribuição de resultados</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Pró-labore e dividendos 2026: quanto retirar e como pagar menos imposto</p>
        </a>
        <a href="/blog/holding-familiar-vale-a-pena-para-pequenos-empresarios"
          class="bg-white rounded-xl border border-gray-100 p-4 hover:border-[#1e40af] hover:shadow-sm transition-all group">
          <p class="text-xs text-gray-400 mb-1">Planejamento patrimonial</p>
          <p class="font-semibold text-[#0f172a] text-sm group-hover:text-[#1e40af] leading-snug">Holding familiar: vale a pena para pequenos empresários?</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e vamos juntos<br/><span class="pp3-grad">fazer a diferença no seu negócio!</span></h2>
          <p class="text-gray-600 text-lg mb-6">Se você precisa de um parceiro estratégico em contabilidade, você encontrou o lugar certo. Entre em contato e marque uma consulta sem custo.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>