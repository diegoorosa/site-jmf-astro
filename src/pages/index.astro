const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.jmfcontabilidade.com.br/#website",
    "url": "https://www.jmfcontabilidade.com.br",
    "name": "JMF Contabilidade",
    "inLanguage": "pt-BR",
    "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://www.jmfcontabilidade.com.br/blog?q={search_term_string}" }, "query-input": "required name=search_term_string" }
