    "address": { "@type": "PostalAddress", "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro", "addressLocality": "Blumenau", "addressRegion": "SC", "postalCode": "89010-060", "addressCountry": "BR" },
    "geo": { "@type": "GeoCoordinates", "latitude": -26.92016, "longitude": -49.06705 },
    "foundingDate": "1989-05-24",
    "areaServed": [
      { "@type": "City", "name": "Blumenau" },
      { "@type": "City", "name": "Gaspar" },
