      { "@type": "City", "name": "Timbó" },
      { "@type": "City", "name": "Brusque" },
      { "@type": "City", "name": "Itajaí" },
      { "@type": "City", "name": "Balneário Camboriú" },
      { "@type": "State", "name": "Santa Catarina" },
      { "@type": "GeoCircle", "geoMidpoint": { "@type": "GeoCoordinates", "latitude": -26.92016, "longitude": -49.06705 }, "geoRadius": "30000" }
    ],
    "hasMap": "https://www.google.com/maps/place/JMF+Contabilidade/@-26.92016,-49.06705,17z/",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Serviços de Contabilidade",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abertura de Empresa" } },
