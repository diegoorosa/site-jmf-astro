      "closes": "00:00"
    }],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": 5,
      "bestRating": 5,
      "worstRating": 1,
      "reviewCount": 150
    },
    "review": [
      { "@type": "Review", "author": { "@type": "Person", "name": "Bruno Schmitt Maes" }, "datePublished": "2026-05-28", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Contabilidade de confiança e atendimento personalizado. Sempre indico!" },
      { "@type": "Review", "author": { "@type": "Person", "name": "André Maciel Nuernberg" }, "datePublished": "2026-05-20", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Atendido pelo Diego, me salvou com o IRPF — tinha bastante informação solta e declarações antigas omissas. Foi o contador que conseguiu me regularizar com o sistema fiscal brasileiro." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Juliana Silva" }, "datePublished": "2026-04-30", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Faço meu imposto de renda com eles há alguns anos e sou sempre muito bem assessorada. São muito corretos e atenciosos." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Connie Faria" }, "datePublished": "2026-04-22", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Eu uso os serviços deles desde 2022 e estou muito satisfeita. São muito educados e profissionais brilhantes. Recomendo muito!!" },
      { "@type": "Review", "author": { "@type": "Person", "name": "Renato Duarte Simões Pires" }, "datePublished": "2026-05-26", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Um profissional extremamente competente, organizado e sempre disposto a ajudar. Transmite muita confiança e segurança em cada orientação. Seu trabalho é impecável!" }
