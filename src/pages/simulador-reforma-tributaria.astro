---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20fiz%20a%20simula%C3%A7%C3%A3o%20da%20Reforma%20Tribut%C3%A1ria%20no%20site%20da%20JMF%20e%20quero%20validar%20a%20escolha%20entre%20o%20Simples%20Tradicional%20e%20o%20H%C3%ADbrido.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["WebApplication", "Service"],
  "name": "Simulador Reforma Tributária — Simples Nacional Tradicional vs Híbrido (LC 214/2025)",
  "description": "Simule o impacto do IBS e da CBS com base nas regras da LC 214/2025 e na estrutura da Calculadora de Tributos da Receita Federal (GitHub / Portaria Cotec 342/2026). Compare Simples Tradicional e Híbrido com reduções setoriais (0%, 30%, 60% e alíquota zero) para 2027 e 2033.",
  "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock",
    "description": "Acesso gratuito ao simulador de transição da Reforma Tributária para micro e pequenas empresas",
    "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "url": "https://www.jmfcontabilidade.com.br",
    "logo": "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.webp",
    "sameAs": [
      "https://wa.me/554733265123",
      "https://www.instagram.com/jmfcontabilidade"
    ]
  },
  "areaServed": {
    "@type": "GeoShape",
    "addressCountry": "BR",
    "addressRegion": "SC",
    "addressLocality": "Blumenau",
    "description": "Brasil — foco em Santa Catarina e região Sul"
  },
  "serviceType": "Simulador tributário online para Reforma Tributária (Simples Tradicional vs Simples Híbrido) alinhado à LC 214/2025",
  "category": "FinanceApplication",
  "featureList": [
    "Regras de cálculo alinhadas à LC 214/2025 e à Calculadora de Tributos da Receita Federal",
    "Cálculo pelas faixas reais do Simples Nacional (LC 123/2006 — Anexos I, II, III e V)",
    "Aplicação automática de reduções setoriais (0%, 30% profissões regulamentadas, 60% saúde/educação e alíquota zero cesta básica)",
    "Simulação por etapa da transição: 2027 (início da CBS) e 2033 (regime pleno IBS + CBS)",
    "Memória de cálculo auditável com CST, cClassTrib e fundamentação legal da LC 214/2025",
    "Análise de competitividade B2B pela transferência de créditos tributários"
  ],
  "hasOutput": {
    "@type": "PropertyValue",
    "name": "Resultado do Simulador",
    "description": "Modelo tributário recomendado, desembolso no Simples Tradicional, desembolso no Simples Híbrido, crédito transferido a clientes PJ e memória de cálculo legal"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  }
});
---

<Layout
  title="Simulador Reforma Tributária — Simples Nacional Tradicional vs Híbrido | JMF Contabilidade"
  description="Sua empresa deve recolher IBS e CBS dentro ou fora do DAS? Calcule com as reduções oficiais da LC 214/2025 e regras da Calculadora da Receita Federal."
  canonical="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  ogUrl="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

<HeroInterno
  title="Simulador Reforma Tributária"
  subtitle="Descubra se a sua empresa deve continuar no Simples Tradicional ou migrar para o Simples Híbrido. Simule o impacto do IBS e da CBS com as reduções setoriais da LC 214/2025 e memória de cálculo no padrão da Receita Federal."
  breadcrumb={[
    { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
    { label: "Ferramentas" },
    { label: "Simulador Reforma Tributária" }
  ]}
  ctas={[
    { label: "Simular agora", href: "#simulador", variant: "cta" },
    { label: "Falar com especialista", href: WA, variant: "outline" }
  ]}
/>

<!-- SIMULADOR PRINCIPAL -->
<section id="simulador" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-sky-50 text-sky-700 px-4 py-2 rounded-full text-sm font-semibold mb-4 border border-sky-100">
          <i class="bi bi-shield-check"></i>
          LC 214/2025 • Base Calculadora de Tributos RFB (Código Aberto)
        </div>
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Simule seu regime na <span class="pp3-grad">Reforma Tributária</span></h2>
        <p class="text-gray-500 text-lg max-w-2xl mx-auto">
          Ajuste o faturamento, o enquadramento setorial e o perfil dos seus clientes para comparar o Simples Tradicional e o Simples Híbrido em 2027 e no regime pleno (2033).
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- FORMULÁRIO DE ENTRADAS -->
        <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-6 flex items-center gap-2">
              <span class="w-8 h-8 bg-sky-600 text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
              Dados de Operação
            </h3>

            <!-- Ano de Referência da Transição -->
            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="ano-transicao">
                Cenário da transição (LC 214/2025)
              </label>
              <select
                id="ano-transicao"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all bg-white"
              >
                <option value="2033" selected>2033 — Regime Pleno (CBS 8,8% + IBS 17,7% = 26,5% ref.)</option>
                <option value="2027">2027 — Início da CBS (CBS 8,8% + IBS 0,1% = 8,9% ref.)</option>
              </select>
              <p class="mt-1 text-xs text-gray-400">Em 2027 entram a CBS cheia e o IBS teste (0,1%); em 2033 ICMS e ISS são totalmente substituídos.</p>
            </div>

            <!-- Faturamento Médio Mensal -->
            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="faturamento">
                Faturamento médio mensal estimado
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
                <input
                  type="text"
                  id="faturamento"
                  inputmode="numeric"
                  value="50.000,00"
                  class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all"
                  autocomplete="off"
                />
              </div>
              <p id="rbt12-info" class="mt-1 text-xs text-gray-400">RBT12 estimado: R$ 600.000,00 (usado na faixa real do Simples Nacional)</p>
            </div>

            <!-- Segmento / Enquadramento LC 214/2025 -->
            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="atividade">
                Atividade e enquadramento LC 214/2025
              </label>
              <select
                id="atividade"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all bg-white"
              >
                <optgroup label="Tributação Integral (CST 000 — 0% redução)">
                  <option value="comercio_geral" selected>Comércio / Revenda em Geral (Anexo I)</option>
                  <option value="industria_geral">Indústria / Fabricação em Geral (Anexo II)</option>
                  <option value="servicos_geral">Serviços em Geral — TI, Manutenção, Agências (Anexo III)</option>
                </optgroup>
                <optgroup label="Redução de 30% — Art. 127 LC 214/2025 (CST 200)">
                  <option value="profissoes_reg">Profissões Regulamentadas — Eng., Arq., Advoc., Contab. (Anexo V)</option>
                  <option value="profissoes_reg_a3">Profissões Regulamentadas com Fator R ≥ 28% (Anexo III)</option>
                </optgroup>
                <optgroup label="Redução de 60% — Arts. 128 a 138 LC 214/2025 (CST 200)">
                  <option value="saude_educacao_a3">Saúde e Educação — Clínicas, Médicos, Ensino (Anexo III)</option>
                  <option value="saude_educacao_a5">Saúde / Clínicas sem Fator R (Anexo V)</option>
                  <option value="comercio_red60">Comércio — Alimentos, Saúde ou Agro com Redução 60% (Anexo I)</option>
                </optgroup>
                <optgroup label="Alíquota Zero — Art. 125 LC 214/2025 (CST 200)">
                  <option value="cesta_basica">Comércio — Cesta Básica Nacional de Alimentos (0% — Anexo I)</option>
                </optgroup>
              </select>
              <p class="mt-1 text-xs text-gray-400">Define a faixa real da LC 123/2006 e o redutor oficial de IBS/CBS</p>
            </div>

            <!-- Perfil B2B -->
            <div class="mb-5">
              <div class="flex justify-between items-center mb-1.5">
                <label class="text-sm font-semibold text-[#0f172a]" for="range-b2b">
                  Percentual de vendas para outras empresas (B2B)
                </label>
                <span id="label-b2b" class="text-sm font-bold text-sky-600">60% B2B</span>
              </div>
              <input
                type="range"
                id="range-b2b"
                min="0"
                max="100"
                value="60"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-sky-600"
              />
              <div class="flex justify-between text-xs text-gray-400 mt-1">
                <span>0% (Só Consumidor Final / B2C)</span>
                <span>100% (Só Empresas / B2B)</span>
              </div>
              <p class="mt-1.5 text-xs text-gray-400">Clientes PJ precisam de créditos fiscais de IBS/CBS para abater em suas próprias guias</p>
            </div>

            <!-- Insumos com Crédito -->
            <div class="mb-6">
              <div class="flex justify-between items-center mb-1.5">
                <label class="text-sm font-semibold text-[#0f172a]" for="range-insumos">
                  Compras de mercadorias e insumos tributados
                </label>
                <span id="label-insumos" class="text-sm font-bold text-sky-600">35% da receita</span>
              </div>
              <input
                type="range"
                id="range-insumos"
                min="0"
                max="80"
                value="35"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-sky-600"
              />
              <div class="flex justify-between text-xs text-gray-400 mt-1">
                <span>0% (Quase sem compras / Folha pura)</span>
                <span>80% (Alto volume de compras)</span>
              </div>
              <p class="mt-1.5 text-xs text-gray-400">Compras de fornecedores no regime regular (geram crédito integral de CBS/IBS no Híbrido)</p>
            </div>
          </div>

          <div class="bg-sky-50 border border-sky-100 rounded-xl p-4 text-sm text-sky-900">
            <i class="bi bi-info-circle mr-1.5"></i>
            <strong>Regra da LC 214/2025 (Art. 41):</strong> No Simples Híbrido, IRPJ, CSLL e CPP continuam no DAS reduzido, enquanto IBS e CBS são apurados por fora no regime não cumulativo (débito × crédito).
          </div>
        </div>

        <!-- PAINEL DE RESULTADOS -->
        <div id="resultado-container" class="rounded-2xl border border-gray-200 bg-gray-50/50 p-8 flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <h3 class="font-bold text-[#0f172a] text-lg flex items-center gap-2">
                <span class="w-8 h-8 bg-sky-600 text-white rounded-full flex items-center justify-center text-sm font-bold">2</span>
                <span id="titulo-cenario">Comparativo de Cenários (2033)</span>
              </h3>
              <span id="badge-cst" class="text-xs font-bold px-3 py-1 rounded-full bg-sky-100 text-sky-800 border border-sky-200">
                CST 000 • 0% redução
              </span>
            </div>

            <!-- ALERTA LIMITE SIMPLES -->
            <div id="alerta-limite" class="hidden mb-4 bg-red-50 border border-red-200 text-red-800 rounded-xl p-3 text-xs">
              <i class="bi bi-exclamation-triangle-fill mr-1"></i>
              Faturamento anual estimado acima de <strong>R$ 4.800.000,00</strong> (limite do Simples Nacional). A empresa precisará operar no Lucro Presumido ou Lucro Real.
            </div>

            <!-- CARDS DE CENÁRIOS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">

              <!-- Simples Tradicional -->
              <div id="card-tradicional" class="bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative">
                <p class="text-xs font-bold tracking-wide text-gray-500 mb-1">SIMPLES TRADICIONAL</p>
                <p id="trad-valor" class="text-2xl font-black text-[#0f172a] leading-tight">R$ 0,00</p>
                <p id="trad-aliquota" class="text-xs text-gray-500 mt-1">Alíquota efetiva: 0,00%</p>

                <div class="mt-4 pt-3 border-t border-dashed border-gray-200 space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-gray-500">Guia mensal:</span>
                    <strong class="text-gray-700">DAS Unificado</strong>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Crédito p/ cliente PJ:</span>
                    <strong id="trad-credito" class="text-amber-600">Reduzido (~0,0%)</strong>
                  </div>
                </div>
              </div>

              <!-- Simples Híbrido -->
              <div id="card-hibrido" class="bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative">
                <p class="text-xs font-bold tracking-wide text-gray-500 mb-1">SIMPLES HÍBRIDO</p>
                <p id="hib-valor" class="text-2xl font-black text-[#0f172a] leading-tight">R$ 0,00</p>
                <p id="hib-aliquota" class="text-xs text-gray-500 mt-1">Alíquota efetiva: 0,00%</p>

                <div class="mt-4 pt-3 border-t border-dashed border-gray-200 space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-gray-500">Apuração IBS/CBS:</span>
                    <strong class="text-gray-700">Por Fora (Déb./Créd.)</strong>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Crédito p/ cliente PJ:</span>
                    <strong id="hib-credito" class="text-green-600">Integral (26,5%)</strong>
                  </div>
                </div>
              </div>

            </div>

            <!-- DIAGNÓSTICO E VEREDITO -->
            <div id="veredito-box" class="rounded-xl p-5 mb-5 bg-white border transition-all duration-300 shadow-sm">
              <div class="flex items-start gap-3">
                <span id="veredito-icon" class="text-2xl flex-shrink-0 mt-0.5">💡</span>
                <div>
                  <h4 id="veredito-titulo" class="font-bold text-base mb-1 text-[#0f172a]">Diagnóstico Tributário</h4>
                  <p id="veredito-desc" class="text-sm leading-relaxed text-gray-600">
                    Ajuste os valores para visualizar a análise técnica e o impacto nas suas vendas.
                  </p>
                </div>
              </div>
            </div>

            <!-- MEMÓRIA DE CÁLCULO OFICIAL (PADRÃO CALCULADORA RFB) -->
            <details class="bg-white border border-gray-200 rounded-xl p-4 mb-5 group" open>
              <summary class="cursor-pointer font-bold text-xs uppercase tracking-wide text-[#0f172a] flex items-center justify-between list-none">
                <span class="flex items-center gap-2">
                  <i class="bi bi-file-earmark-code text-sky-600 text-sm"></i>
                  Memória de Cálculo e Base Legal (Padrão RFB)
                </span>
                <i class="bi bi-chevron-down text-gray-400 transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="mt-3 pt-3 border-t border-gray-100 text-xs space-y-2 text-gray-600">
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-gray-50 rounded-lg p-2.5">
                    <span class="block text-[11px] text-gray-400">Classificação RFB</span>
                    <strong id="mem-cst" class="text-[#0f172a]">—</strong>
                  </div>
                  <div class="bg-gray-50 rounded-lg p-2.5">
                    <span class="block text-[11px] text-gray-400">Alíquota IBS/CBS (Por Fora)</span>
                    <strong id="mem-aliq-efetiva" class="text-[#0f172a]">—</strong>
                  </div>
                </div>
                <div class="space-y-1 pt-1" id="mem-passos"></div>
                <div class="bg-sky-50/70 border border-sky-100 rounded-lg p-2.5 text-[11px] text-sky-900" id="mem-base-legal"></div>
              </div>
            </details>
          </div>

          <div>
            <!-- BOTÃO WHATSAPP DINÂMICO -->
            <a
              id="btn-whatsapp"
              href={WA}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full text-center px-6 py-4 bg-[#25d366] text-white font-bold rounded-xl hover:bg-[#1eb956] transition-colors shadow-sm text-sm"
            >
              <i class="bi bi-whatsapp text-lg"></i>
              Validar diagnóstico com a JMF
            </a>

            <p class="text-center text-xs text-gray-400 mt-3">
              Alíquotas de referência da LC 214/2025 (CBS 8,8% + IBS 17,7% no regime pleno) com cálculo por fora (Art. 12). Decisão formal exige auditoria de NCM/NBS e fornecedores.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- SEÇÃO EXPLICATIVA DA REFORMA -->
<section class="py-16 bg-[#f8fafc] border-t border-gray-100">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-3xl font-bold text-[#0f172a] mb-4 text-center">Entenda o impacto da <span class="pp3-grad">Reforma no Simples</span></h2>
    <p class="text-gray-600 text-center mb-10 max-w-2xl mx-auto">
      A partir de 2027, as empresas do Simples Nacional não serão obrigadas a sair do regime, mas poderão exercer a opção semestral entre duas formas de recolhimento:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
        <div class="w-10 h-10 bg-amber-100 text-amber-800 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">1</div>
        <h3 class="text-lg font-bold text-[#0f172a] mb-2">Simples Tradicional (Guia Única)</h3>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          Tudo continua unificado na guia do DAS. É ideal para empresas focadas no <strong>Consumidor Final (B2C)</strong>, pois mantém a simplicidade e a carga tributária menor de desembolso direto.
        </p>
        <div class="bg-amber-50 rounded-lg p-3 text-xs text-amber-800">
          <strong>Atenção:</strong> Seus clientes PJ só aproveitam crédito proporcional à fatia de IBS/CBS efetivamente recolhida dentro do seu DAS, o que pode gerar pressão por desconto em vendas B2B.
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
        <div class="w-10 h-10 bg-green-100 text-green-800 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">2</div>
        <h3 class="text-lg font-bold text-[#0f172a] mb-2">Simples Híbrido (Crédito Integral)</h3>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          A empresa paga o DAS reduzido (IRPJ, CSLL e CPP) e apura o IBS e a CBS por fora no regime de débitos e créditos, aproveitando as reduções setoriais da LC 214/2025 (30%, 60% ou alíquota zero).
        </p>
        <div class="bg-green-50 rounded-lg p-3 text-xs text-green-800">
          <strong>Vantagem:</strong> Seus clientes PJ aproveitam o crédito integral destacado na nota fiscal, mantendo sua empresa competitiva frente a fornecedores do Lucro Presumido e Lucro Real.
        </div>
      </div>
    </div>

    <!-- TABELA DE REDUÇÕES OFICIAIS -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="bg-[#0f172a] px-6 py-4">
        <h3 class="text-white font-bold">Reduções de Alíquota na LC 214/2025 (Base Calculadora RFB)</h3>
        <p class="text-white/60 text-xs mt-0.5">Alíquotas de referência aplicadas por fora (CBS 8,8% + IBS 17,7% = 26,5% em 2033)</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100">
              <th class="p-3 text-left font-semibold text-gray-700">Enquadramento</th>
              <th class="p-3 text-center font-semibold text-gray-700">CST / Base Legal</th>
              <th class="p-3 text-center font-semibold text-gray-700">Redução</th>
              <th class="p-3 text-center font-semibold text-gray-700">Ref. 2027</th>
              <th class="p-3 text-center font-semibold text-gray-700">Ref. 2033</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-xs md:text-sm">
            <tr>
              <td class="p-3 text-gray-700 font-medium">Regra Geral (Comércio, Indústria, Serviços gerais)</td>
              <td class="p-3 text-center text-gray-500">CST 000 • Art. 14</td>
              <td class="p-3 text-center font-semibold text-[#0f172a]">0%</td>
              <td class="p-3 text-center text-gray-700">8,90%</td>
              <td class="p-3 text-center font-bold text-[#0f172a]">26,50%</td>
            </tr>
            <tr class="bg-gray-50/50">
              <td class="p-3 text-gray-700 font-medium">Profissões Regulamentadas (Eng., Arq., Advoc., Contab.)</td>
              <td class="p-3 text-center text-gray-500">CST 200 • Art. 127</td>
              <td class="p-3 text-center font-semibold text-sky-700">30%</td>
              <td class="p-3 text-center text-gray-700">6,23%</td>
