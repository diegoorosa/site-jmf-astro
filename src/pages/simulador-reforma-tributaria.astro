// Parâmetros de transição da LC 214/2025 (Alíquotas de referência)
const TRANSICAO: Record<string, { label: string; cbsRef: number; ibsRef: number; substituiIcmsIss: boolean }> = {
  "2027": { label: "2027 — Início da CBS", cbsRef: 0.088, ibsRef: 0.001, substituiIcmsIss: false },
  "2033": { label: "2033 — Regime Pleno",  cbsRef: 0.088, ibsRef: 0.177, substituiIcmsIss: true },
};

function parseBRL(str: string): number {
  if (!str) return 0;
  const cleaned = str.replace(/\D/g, '');
  return cleaned ? parseFloat(cleaned) / 100 : 0;
}

function formatBRL(val: number): string {
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}

function formatPerc(val: number, dec = 2): string {
  return (val * 100).toFixed(dec).replace('.', ',') + '%';
}

function applyCurrencyMask(input: HTMLInputElement) {
  let v = input.value.replace(/\D/g, '');
  if (v === '') { input.value = ''; return; }
  const num = parseInt(v, 10) / 100;
  input.value = num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function obterFaixaSN(rbt12: number, faixas: FaixaSN[]): { aliquotaEfetiva: number; faixa: FaixaSN; numFaixa: number } {
  const idx = faixas.findIndex(f => rbt12 <= f.limite);
  const faixaIndex = idx === -1 ? faixas.length - 1 : idx;
  const faixa = faixas[faixaIndex];
  const rbtCalculo = Math.min(rbt12, 4800000);
  const aliquotaEfetiva = rbtCalculo > 0 ? (rbtCalculo * faixa.nominal - faixa.deducao) / rbtCalculo : faixa.nominal;
  return { aliquotaEfetiva, faixa, numFaixa: faixaIndex + 1 };
}

function calcular() {
  const faturamento = parseBRL((document.getElementById('faturamento') as HTMLInputElement).value);
  const atividade = (document.getElementById('atividade') as HTMLSelectElement).value;
  const ano = (document.getElementById('ano-transicao') as HTMLSelectElement).value;
  const percB2B = parseFloat((document.getElementById('range-b2b') as HTMLInputElement).value) / 100;
  const percInsumos = parseFloat((document.getElementById('range-insumos') as HTMLInputElement).value) / 100;

  // Labels dinâmicos
  document.getElementById('label-b2b')!.textContent = `${(percB2B * 100).toFixed(0)}% B2B`;
  document.getElementById('label-insumos')!.textContent = `${(percInsumos * 100).toFixed(0)}% da receita`;

  if (faturamento <= 0) return;

  const rbt12 = faturamento * 12;
  document.getElementById('rbt12-info')!.textContent = `RBT12 estimado: ${formatBRL(rbt12)} (faixa real da LC 123/2006)`;

  const alertaLimite = document.getElementById('alerta-limite')!;
  if (rbt12 > 4800000) {
    alertaLimite.classList.remove('hidden');
  } else {
    alertaLimite.classList.add('hidden');
  }

  const regra = REGRAS_ATIVIDADE[atividade];
  const anexoData = ANEXOS_SN[regra.anexo];
  const transicao = TRANSICAO[ano];

  // 1. Simples Nacional Tradicional (faixa real da LC 123/2006)
  const { aliquotaEfetiva: aliqSN, faixa, numFaixa } = obterFaixaSN(rbt12, anexoData.faixas);
  const impostoTradicional = faturamento * aliqSN;

  // Parcela do DAS correspondente aos tributos sobre consumo substituídos no ano escolhido
  const parcelaSubstituida = transicao.substituiIcmsIss
    ? (faixa.percPisCofins + faixa.percIcmsIss)
    : faixa.percPisCofins;

  // Crédito que o cliente PJ aproveita ao comprar do Simples Tradicional
  const creditoTransferidoTrad = aliqSN * parcelaSubstituida;

  // 2. Simples Híbrido (Art. 41 da LC 214/2025)
  // DAS reduzido: remove a fatia de PIS/COFINS (em 2027) ou PIS/COFINS + ICMS/ISS (em 2033)
  const aliqDasReduzido = aliqSN * (1 - parcelaSubstituida);
  const dasReduzido = faturamento * aliqDasReduzido;

  // Alíquotas CBS/IBS aplicadas por fora com a redução oficial da LC 214/2025
  const aliqRefTotal = transicao.cbsRef + transicao.ibsRef;
  const fatorReducao = 1 - regra.reducao;
  const aliqCbsEfetiva = transicao.cbsRef * fatorReducao;
  const aliqIbsEfetiva = transicao.ibsRef * fatorReducao;
  const aliqIbsCbsEfetiva = aliqRefTotal * fatorReducao;

  // Débito na saída (por fora) e Crédito nas entradas (insumos tributados na alíquota padrão de referência)
  const debitoIbsCbs = faturamento * aliqIbsCbsEfetiva;
  const creditoInsumos = (faturamento * percInsumos) * aliqRefTotal;
  const ibsCbsLiquido = Math.max(0, debitoIbsCbs - creditoInsumos);
  const saldoCredor = Math.max(0, creditoInsumos - debitoIbsCbs);

  const impostoHibridoTotal = dasReduzido + ibsCbsLiquido;
  const aliqEfetivaHib = impostoHibridoTotal / faturamento;

  // Atualização do cabeçalho e badges
  document.getElementById('titulo-cenario')!.textContent = `Comparativo (${transicao.label})`;
  document.getElementById('badge-cst')!.textContent = `CST ${regra.cst} • Redução ${(regra.reducao * 100).toFixed(0)}%`;

  // Atualização dos Cards
  document.getElementById('trad-valor')!.textContent = formatBRL(impostoTradicional);
  document.getElementById('trad-aliquota')!.textContent = `Alíquota efetiva: ${formatPerc(aliqSN)} (${anexoData.nome}, Faixa ${numFaixa})`;
  document.getElementById('trad-credito')!.textContent = `Reduzido (${formatPerc(creditoTransferidoTrad)})`;

  document.getElementById('hib-valor')!.textContent = formatBRL(impostoHibridoTotal);
  document.getElementById('hib-aliquota')!.textContent = `Alíquota efetiva: ${formatPerc(aliqEfetivaHib)}`;
  document.getElementById('hib-credito')!.textContent = regra.reducao === 1
    ? 'Alíquota Zero (0,00%)'
    : `Integral (${formatPerc(aliqIbsCbsEfetiva)})`;

  // Memória de Cálculo (padrão Calculadora RFB)
  document.getElementById('mem-cst')!.textContent = regra.cClassTrib;
  document.getElementById('mem-aliq-efetiva')!.textContent = `${formatPerc(aliqIbsCbsEfetiva)} (CBS ${formatPerc(aliqCbsEfetiva)} + IBS ${formatPerc(aliqIbsEfetiva)})`;

  const passos = [
    `<strong>1. Simples Tradicional:</strong> ${formatBRL(faturamento)} × ${formatPerc(aliqSN)} (Faixa ${numFaixa} do ${anexoData.nome}) = <strong>${formatBRL(impostoTradicional)}</strong>`,
    `<strong>2. DAS Reduzido (Híbrido):</strong> remove ${(parcelaSubstituida * 100).toFixed(1)}% do DAS → ${formatBRL(faturamento)} × ${formatPerc(aliqDasReduzido)} = <strong>${formatBRL(dasReduzido)}</strong>`,
    `<strong>3. Débito CBS/IBS (saída):</strong> ${formatBRL(faturamento)} × ${formatPerc(aliqIbsCbsEfetiva)} = <strong>${formatBRL(debitoIbsCbs)}</strong>`,
    `<strong>4. Crédito CBS/IBS (insumos):</strong> ${formatBRL(faturamento * percInsumos)} × ${formatPerc(aliqRefTotal)} = <strong>${formatBRL(creditoInsumos)}</strong>`,
    `<strong>5. CBS/IBS Líquido a recolher:</strong> <strong>${formatBRL(ibsCbsLiquido)}</strong>` + (saldoCredor > 0 ? ` <span class="text-emerald-700 font-semibold">(+ saldo credor de ${formatBRL(saldoCredor)}/mês)</span>` : ''),
    `<strong>6. Total Simples Híbrido:</strong> ${formatBRL(dasReduzido)} + ${formatBRL(ibsCbsLiquido)} = <strong>${formatBRL(impostoHibridoTotal)}</strong>`,
  ];
  document.getElementById('mem-passos')!.innerHTML = passos.map(p => `<div>${p}</div>`).join('');
  document.getElementById('mem-base-legal')!.innerHTML = `<strong>Fundamentação Legal:</strong> ${regra.baseLegal}`;

  // Destaques e Veredito
  const cardTrad = document.getElementById('card-tradicional')!;
  const cardHib = document.getElementById('card-hibrido')!;
  const vIcon = document.getElementById('veredito-icon')!;
  const vTitulo = document.getElementById('veredito-titulo')!;
  const vDesc = document.getElementById('veredito-desc')!;
  const btnWA = document.getElementById('btn-whatsapp') as HTMLAnchorElement;

  cardTrad.className = "bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative";
  cardHib.className = "bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative";

  let waTexto = "";
  const diferenca = impostoHibridoTotal - impostoTradicional;

  if (regra.reducao === 1.0) {
    // Alíquota Zero (Cesta Básica)
    cardHib.className = "bg-emerald-50/60 rounded-xl p-5 border-2 border-emerald-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "🛒";
    vTitulo.textContent = "Destaque Cesta Básica: Avalie o Simples Híbrido";
    vTitulo.className = "font-bold text-base mb-1 text-emerald-800";
    vDesc.innerHTML = `Com <strong>alíquota zero (Art. 125 da LC 214/2025)</strong> na saída, o Simples Híbrido reduz seu DAS em <strong>${formatBRL(impostoTradicional - impostoHibridoTotal)}/mês</strong>` +
      (saldoCredor > 0 ? ` e ainda pode gerar saldo credor de <strong>${formatBRL(saldoCredor)}/mês</strong> sobre insumos tributados (sujeito a auditoria de NCM).` : `.`);
    waTexto = `Olá! Simulei a Reforma Tributária (${ano}) no site da JMF para Cesta Básica (${formatBRL(faturamento)}/mês) e quero validar o Simples Híbrido.`;
  } else if (impostoHibridoTotal <= impostoTradicional) {
    // Híbrido já é mais barato no caixa
    cardHib.className = "bg-green-50/50 rounded-xl p-5 border-2 border-green-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "🏆";
    vTitulo.textContent = "Recomendação Estratégica: Simples Híbrido";
    vTitulo.className = "font-bold text-base mb-1 text-green-800";
    vDesc.innerHTML = `Além de entregar crédito integral de <strong>${formatPerc(aliqIbsCbsEfetiva)}</strong> para clientes PJ, o Simples Híbrido já gera economia direta de <strong>${formatBRL(Math.abs(diferenca))}/mês</strong> no caixa graças à redução setorial e aos créditos sobre insumos.`;
    waTexto = `Olá! Simulei a Reforma Tributária (${ano}) na JMF. Meu faturamento é ${formatBRL(faturamento)}/mês e o Simples Híbrido ficou mais vantajoso (${formatBRL(impostoHibridoTotal)} vs ${formatBRL(impostoTradicional)}). Quero validar.`;
  } else if (percB2B >= 0.50) {
    // Perfil fortemente B2B: vale avaliar Híbrido pela competitividade comercial
    cardHib.className = "bg-green-50/50 rounded-xl p-5 border-2 border-green-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "🏆";
    vTitulo.textContent = "Recomendação Estratégica: Simples Híbrido (Foco B2B)";
    vTitulo.className = "font-bold text-base mb-1 text-green-800";
    vDesc.innerHTML = `Com <strong>${(percB2B * 100).toFixed(0)}% das vendas para empresas (B2B)</strong>, o Simples Híbrido transfere crédito integral de <strong>${formatPerc(aliqIbsCbsEfetiva)}</strong> (contra apenas ${formatPerc(creditoTransferidoTrad)} no Tradicional). Embora o desembolso bruto seja ${formatBRL(diferenca)}/mês maior, o imposto é destacado por fora e preserva sua margem nas negociações PJ.`;
    waTexto = `Olá! Simulei a Reforma Tributária (${ano}) no site da JMF. Faturo ${formatBRL(faturamento)}/mês com ${(percB2B * 100).toFixed(0)}% B2B e o simulador indicou o Simples Híbrido. Quero validar meu enquadramento.`;
  } else if (percB2B < 0.35) {
    // Foco B2C: Tradicional vence
    cardTrad.className = "bg-sky-50/50 rounded-xl p-5 border-2 border-sky-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "💰";
    vTitulo.textContent = "Recomendação Estratégica: Simples Tradicional";
    vTitulo.className = "font-bold text-base mb-1 text-sky-800";
    vDesc.innerHTML = `Como a maior parte das vendas vai para o <strong>consumidor final (B2C)</strong>, o cliente não aproveita crédito tributário. O Simples Tradicional mantém a guia única e economiza <strong>${formatBRL(diferenca)}/mês</strong> em relação ao Híbrido.`;
    waTexto = `Olá! Simulei a Reforma Tributária (${ano}) no site da JMF (${formatBRL(faturamento)}/mês, foco B2C) e o resultado indicou Simples Tradicional. Quero planejar a transição.`;
  } else {
    // Zona mista (35% a 49% B2B)
    cardTrad.className = "bg-amber-50/50 rounded-xl p-5 border-2 border-amber-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "⚖️";
    vTitulo.textContent = "Zona de Decisão: Avalie Carteira de Clientes";
    vTitulo.className = "font-bold text-base mb-1 text-amber-800";
    vDesc.innerHTML = `O Simples Tradicional gera desembolso <strong>${formatBRL(diferenca)}/mês menor</strong>, mas entrega crédito de apenas ${formatPerc(creditoTransferidoTrad)} aos clientes PJ (vs ${formatPerc(aliqIbsCbsEfetiva)} no Híbrido). Vale auditar os principais contratos B2B antes da opção semestral.`;
    waTexto = `Olá! Fiz a simulação da Reforma Tributária (${ano}) na JMF (${formatBRL(faturamento)}/mês) e fiquei na zona mista entre Simples Tradicional e Híbrido. Gostaria de uma análise.`;
  }

  btnWA.href = `https://wa.me/554733265123?text=${encodeURIComponent(waTexto)}`;
}

