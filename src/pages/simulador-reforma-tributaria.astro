---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20fiz%20a%20simula%C3%A7%C3%A3o%20da%20Reforma%20Tribut%C3%A1ria%20no%20site%20da%20JMF%20e%20quero%20validar%20a%20escolha%20entre%20o%20Simples%20Tradicional%20e%20o%20H%C3%ADbrido.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["WebApplication", "Service"],
  "name": "Simulador Reforma Tributária — Simples Nacional Tradicional vs Híbrido (LC 214/2025)",
  "description": "Descubra se a sua empresa deve manter o Simples Nacional Tradicional ou optar pelo Simples Híbrido na Reforma Tributária. Simule impacto de IBS/CBS, competitividade B2B e desembolso tributário.",
  "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock",
    "description": "Acesso gratuito ao simulador de transição da Reforma Tributária para micro e pequenas empresas",
    "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "url": "https://www.jmfcontabilidade.com.br",
    "logo": "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.webp",
    "sameAs": [
      "https://wa.me/554733265123",
      "https://www.instagram.com/jmfcontabilidade"
    ]
  },
  "areaServed": {
    "@type": "GeoShape",
    "addressCountry": "BR",
    "addressRegion": "SC",
    "addressLocality": "Blumenau",
    "description": "Brasil — foco em Santa Catarina e região Sul"
  },
  "serviceType": "Simulador tributário online para Reforma Tributária (Simples Tradicional vs Simples Híbrido)",
  "category": "FinanceApplication",
  "featureList": [
    "Comparação entre Simples Nacional Tradicional (guia única) e Simples Híbrido (IBS/CBS por fora)",
    "Análise de perda ou retenção de clientes B2B pela transferência de créditos tributários",
    "Cálculo de alíquota efetiva e desembolso mensal projetado para 2027",
    "Avaliação do impacto de créditos sobre compras e insumos tributados",
    "Diagnóstico estratégico personalizado com recomendação prática para o seu CNPJ"
  ],
  "hasOutput": {
    "@type": "PropertyValue",
    "name": "Resultado do Simulador",
    "description": "Modelo tributário recomendado, desembolso no Simples Tradicional, desembolso no Simples Híbrido, crédito transferido a clientes PJ e recomendação estratégica"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  }
});
---

<Layout
  title="Simulador Reforma Tributária — Simples Nacional Tradicional vs Híbrido | JMF Contabilidade"
  description="Sua empresa deve recolher IBS e CBS dentro ou fora do DAS? Calcule a competitividade B2B e o impacto no caixa com o simulador da JMF Contabilidade."
  canonical="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  ogUrl="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

<HeroInterno
  title="Simulador Reforma Tributária"
  subtitle="Descubra se a sua empresa deve continuar no Simples Tradicional ou migrar para o Simples Híbrido em 2027. Simule o impacto do IBS, da CBS e da transferência de créditos para clientes B2B."
  breadcrumb={[
    { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
    { label: "Ferramentas" },
    { label: "Simulador Reforma Tributária" }
  ]}
  ctas={[
    { label: "Simular agora", href: "#simulador", variant: "cta" },
    { label: "Falar com especialista", href: WA, variant: "outline" }
  ]}
/>

<!-- SIMULADOR PRINCIPAL -->
<section id="simulador" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-sky-50 text-sky-700 px-4 py-2 rounded-full text-sm font-semibold mb-4 border border-sky-100">
          <i class="bi bi-shield-check"></i>
          Reforma Tributária • Lei Complementar 214/2025
        </div>
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Simule seu regime para <span class="pp3-grad">2027</span></h2>
        <p class="text-gray-500 text-lg max-w-2xl mx-auto">
          Ajuste as variáveis do seu faturamento e do perfil dos seus clientes para saber se a sua empresa deve optar pelo Simples Híbrido ou permanecer no modelo tradicional.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- FORMULÁRIO DE ENTRADAS -->
        <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-6 flex items-center gap-2">
              <span class="w-8 h-8 bg-sky-600 text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
              Dados de Operação
            </h3>

            <!-- Faturamento Médio Mensal -->
            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="faturamento">
                Faturamento médio mensal estimado
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
                <input
                  type="text"
                  id="faturamento"
                  inputmode="numeric"
                  value="50.000,00"
                  class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all"
                  autocomplete="off"
                />
              </div>
              <p class="mt-1 text-xs text-gray-400">Total médio de notas fiscais emitidas no mês</p>
            </div>

            <!-- Segmento / Atividade -->
            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="atividade">
                Atividade principal da empresa
              </label>
              <select
                id="atividade"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-base focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all bg-white"
              >
                <option value="comercio" selected>Comércio / Revenda (Anexo I)</option>
                <option value="industria">Indústria / Fabricação (Anexo II)</option>
                <option value="servicos_geral">Prestação de Serviços em Geral (Anexo III)</option>
                <option value="servicos_tecnicos">Serviços Técnicos / Profissionais (Anexo V)</option>
              </select>
              <p class="mt-1 text-xs text-gray-400">Determina a alíquota básica de tributos federais e subnacionais</p>
            </div>

            <!-- Perfil B2B -->
            <div class="mb-5">
              <div class="flex justify-between items-center mb-1.5">
                <label class="text-sm font-semibold text-[#0f172a]" for="range-b2b">
                  Percentual de vendas para outras empresas (B2B)
                </label>
                <span id="label-b2b" class="text-sm font-bold text-sky-600">60% B2B</span>
              </div>
              <input
                type="range"
                id="range-b2b"
                min="0"
                max="100"
                value="60"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-sky-600"
              />
              <div class="flex justify-between text-xs text-gray-400 mt-1">
                <span>0% (Só Consumidor Final / B2C)</span>
                <span>100% (Só Empresas / B2B)</span>
              </div>
              <p class="mt-1.5 text-xs text-gray-400">Clientes PJ precisam de créditos fiscais de IBS/CBS para abater em suas próprias guias</p>
            </div>

            <!-- Insumos com Crédito -->
            <div class="mb-6">
              <div class="flex justify-between items-center mb-1.5">
                <label class="text-sm font-semibold text-[#0f172a]" for="range-insumos">
                  Compras de mercadorias e insumos tributados
                </label>
                <span id="label-insumos" class="text-sm font-bold text-sky-600">35% da receita</span>
              </div>
              <input
                type="range"
                id="range-insumos"
                min="0"
                max="80"
                value="35"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-sky-600"
              />
              <div class="flex justify-between text-xs text-gray-400 mt-1">
                <span>0% (Quase sem compras / Folha pura)</span>
                <span>80% (Alto volume de compras)</span>
              </div>
              <p class="mt-1.5 text-xs text-gray-400">Itens comprados de fornecedores que tributam IBS e CBS integralmente</p>
            </div>
          </div>

          <div class="bg-sky-50 border border-sky-100 rounded-xl p-4 text-sm text-sky-900">
            <i class="bi bi-info-circle mr-1.5"></i>
            <strong>Regra da LC 214/2025:</strong> No Simples Híbrido, o IRPJ, CSLL e CPP continuam na guia do Simples, mas o IBS e a CBS são apurados pelo regime geral (débito × crédito).
          </div>
        </div>

        <!-- PAINEL DE RESULTADOS -->
        <div id="resultado-container" class="rounded-2xl border border-gray-200 bg-gray-50/50 p-8 flex flex-col justify-between shadow-sm">
          <div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-6 flex items-center gap-2">
              <span class="w-8 h-8 bg-sky-600 text-white rounded-full flex items-center justify-center text-sm font-bold">2</span>
              Comparativo de Cenários para 2027
            </h3>

            <!-- CARDS DE CENÁRIOS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">

              <!-- Simples Tradicional -->
              <div id="card-tradicional" class="bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative">
                <p class="text-xs font-bold tracking-wide text-gray-500 mb-1">SIMPLES TRADICIONAL</p>
                <p id="trad-valor" class="text-2xl font-black text-[#0f172a] leading-tight">R$ 0,00</p>
                <p id="trad-aliquota" class="text-xs text-gray-500 mt-1">Alíquota efetiva: 0,0%</p>
                
                <div class="mt-4 pt-3 border-t border-dashed border-gray-200 space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-gray-500">Guia mensal:</span>
                    <strong class="text-gray-700">DAS Unificado</strong>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Crédito p/ cliente PJ:</span>
                    <strong id="trad-credito" class="text-amber-600">Reduzido (~2,8%)</strong>
                  </div>
                </div>
              </div>

              <!-- Simples Híbrido -->
              <div id="card-hibrido" class="bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative">
                <p class="text-xs font-bold tracking-wide text-gray-500 mb-1">SIMPLES HÍBRIDO</p>
                <p id="hib-valor" class="text-2xl font-black text-[#0f172a] leading-tight">R$ 0,00</p>
                <p id="hib-aliquota" class="text-xs text-gray-500 mt-1">Alíquota efetiva: 0,0%</p>

                <div class="mt-4 pt-3 border-t border-dashed border-gray-200 space-y-1 text-xs">
                  <div class="flex justify-between">
                    <span class="text-gray-500">Apuração IBS/CBS:</span>
                    <strong class="text-gray-700">Por Fora (Débito/Crédito)</strong>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Crédito p/ cliente PJ:</span>
                    <strong class="text-green-600">Integral (26,5%)</strong>
                  </div>
                </div>
              </div>

            </div>

            <!-- DIAGNÓSTICO E VEREDITO -->
            <div id="veredito-box" class="rounded-xl p-5 mb-6 bg-white border transition-all duration-300 shadow-sm">
              <div class="flex items-start gap-3">
                <span id="veredito-icon" class="text-2xl flex-shrink-0 mt-0.5">💡</span>
                <div>
                  <h4 id="veredito-titulo" class="font-bold text-base mb-1 text-[#0f172a]">Diagnóstico Tributário</h4>
                  <p id="veredito-desc" class="text-sm leading-relaxed text-gray-600">
                    Ajuste os valores para visualizar a análise técnica e o impacto nas suas vendas.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <!-- BOTÃO WHATSAPP DINÂMICO -->
            <a
              id="btn-whatsapp"
              href={WA}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full text-center px-6 py-4 bg-[#25d366] text-white font-bold rounded-xl hover:bg-[#1eb956] transition-colors shadow-sm text-sm"
            >
              <i class="bi bi-whatsapp text-lg"></i>
              Validar diagnóstico para 2027 com a JMF
            </a>

            <p class="text-center text-xs text-gray-400 mt-3">
              Simulação estimada com alíquota de referência de 26,5% para IBS/CBS. A decisão formal exige auditoria da carteira de fornecedores.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- SEÇÃO EXPLICATIVA DA REFORMA -->
<section class="py-16 bg-[#f8fafc] border-t border-gray-100">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-3xl font-bold text-[#0f172a] mb-4 text-center">Entenda o impacto da <span class="pp3-grad">Reforma no Simples</span></h2>
    <p class="text-gray-600 text-center mb-10 max-w-2xl mx-auto">
      A partir de 2027, as empresas do Simples Nacional não serão obrigadas a sair do regime, mas terão que escolher entre duas formas de recolhimento:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
        <div class="w-10 h-10 bg-amber-100 text-amber-800 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">1</div>
        <h3 class="text-lg font-bold text-[#0f172a] mb-2">Simples Tradicional (Guia Única)</h3>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          Tudo continua unificado na guia do DAS. É ideal para empresas focadas no <strong>Consumidor Final (B2C)</strong>, pois mantém a simplicidade e a carga tributária menor de desembolso direto.
        </p>
        <div class="bg-amber-50 rounded-lg p-3 text-xs text-amber-800">
          <strong>Atenção:</strong> Seus clientes que são empresas (PJ) só receberão crédito correspondente à fatia de IBS/CBS do seu DAS (~2% a 4%), o que pode torná-lo menos competitivo.
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
        <div class="w-10 h-10 bg-green-100 text-green-800 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">2</div>
        <h3 class="text-lg font-bold text-[#0f172a] mb-2">Simples Híbrido (Crédito Integral)</h3>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          A empresa paga o DAS reduzido (IRPJ, CSLL e CPP) e apura o IBS e a CBS por fora no regime de débitos e créditos. É essencial para quem vende no <strong>mercado corporativo (B2B)</strong>.
        </p>
        <div class="bg-green-50 rounded-lg p-3 text-xs text-green-800">
          <strong>Vantagem:</strong> Seus clientes PJ aproveitam o crédito integral de 26,5% na nota fiscal, mantendo sua empresa competitiva frente aos grandes concorrentes.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
// ────────────────────────────────────────────────────────
// SIMULADOR REFORMA TRIBUTÁRIA — JMF Contabilidade
// Simples Nacional Tradicional vs Simples Híbrido (LC 214/2025)
// ────────────────────────────────────────────────────────

const ALIQUOTAS_SETORIAIS = {
  comercio: { baseDas: 0.085, parcelaIbsCbs: 0.34, dasReduzido: 0.056 },
  industria: { baseDas: 0.095, parcelaIbsCbs: 0.36, dasReduzido: 0.061 },
  servicos_geral: { baseDas: 0.105, parcelaIbsCbs: 0.32, dasReduzido: 0.071 },
  servicos_tecnicos: { baseDas: 0.155, parcelaIbsCbs: 0.28, dasReduzido: 0.111 }
};

const ALIQUOTA_PADRAO_REFORMA = 0.265; // 26,5% alíquota de referência IBS/CBS

function parseBRL(str) {
  if (!str) return 0;
  const cleaned = str.replace(/\D/g, '');
  return cleaned ? parseFloat(cleaned) / 100 : 0;
}

function formatBRL(val) {
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}

function applyCurrencyMask(input) {
  let v = input.value.replace(/\D/g, '');
  if (v === '') { input.value = ''; return; }
  const num = parseInt(v, 10) / 100;
  input.value = num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function calcular() {
  const faturamento = parseBRL(document.getElementById('faturamento').value);
  const atividade = document.getElementById('atividade').value;
  const percB2B = parseFloat(document.getElementById('range-b2b').value) / 100;
  const percInsumos = parseFloat(document.getElementById('range-insumos').value) / 100;

  // Elementos de UI
  const labelB2B = document.getElementById('label-b2b');
  const labelInsumos = document.getElementById('label-insumos');
  labelB2B.textContent = `${(percB2B * 100).toFixed(0)}% B2B`;
  labelInsumos.textContent = `${(percInsumos * 100).toFixed(0)}% da receita`;

  if (faturamento <= 0) return;

  const regra = ALIQUOTAS_SETORIAIS[atividade];

  // 1. Cálculo Simples Tradicional
  const impostoTradicional = faturamento * regra.baseDas;
  const aliqEfetivaTrad = (impostoTradicional / faturamento) * 100;
  const creditoTransferidoTrad = regra.baseDas * regra.parcelaIbsCbs * 100;

  // 2. Cálculo Simples Híbrido
  const dasReduzido = faturamento * regra.dasReduzido;
  const debitoIbsCbs = faturamento * ALIQUOTA_PADRAO_REFORMA;
  const creditoIbsCbs = (faturamento * percInsumos) * ALIQUOTA_PADRAO_REFORMA;
  const ibsCbsLiquido = Math.max(0, debitoIbsCbs - creditoIbsCbs);
  const impostoHibridoTotal = dasReduzido + ibsCbsLiquido;
  const aliqEfetivaHib = (impostoHibridoTotal / faturamento) * 100;

  // Atualização dos Cards
  document.getElementById('trad-valor').textContent = formatBRL(impostoTradicional);
  document.getElementById('trad-aliquota').textContent = `Alíquota efetiva: ${aliqEfetivaTrad.toFixed(1)}%`;
  document.getElementById('trad-credito').textContent = `Reduzido (~${creditoTransferidoTrad.toFixed(1)}%)`;

  document.getElementById('hib-valor').textContent = formatBRL(impostoHibridoTotal);
  document.getElementById('hib-aliquota').textContent = `Alíquota efetiva: ${aliqEfetivaHib.toFixed(1)}%`;

  // Destaques e Veredito
  const cardTrad = document.getElementById('card-tradicional');
  const cardHib = document.getElementById('card-hibrido');
  const vIcon = document.getElementById('veredito-icon');
  const vTitulo = document.getElementById('veredito-titulo');
  const vDesc = document.getElementById('veredito-desc');
  const btnWA = document.getElementById('btn-whatsapp');

  cardTrad.className = "bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative";
  cardHib.className = "bg-white rounded-xl p-5 border-2 border-gray-200 transition-all duration-300 relative";

  let waTexto = "";

  if (percB2B >= 0.50 && percInsumos >= 0.30) {
    // Perfil B2B com insumos: Híbrido é essencial
    cardHib.className = "bg-green-50/50 rounded-xl p-5 border-2 border-green-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "🏆";
    vTitulo.textContent = "Recomendação Estratégica: Simples Híbrido";
    vTitulo.className = "font-bold text-base mb-1 text-green-800";
    vDesc.innerHTML = `Com <strong>${(percB2B * 100).toFixed(0)}% do faturamento em vendas corporativas (B2B)</strong>, optar pelo modelo híbrido garante que seus clientes recebam o crédito fiscal de <strong>26,5%</strong>. Se mantiver o Simples tradicional, seus clientes só creditam ~${creditoTransferidoTrad.toFixed(1)}%, pressionando seus preços para baixo.`;
    waTexto = `Olá! Simulei a Reforma Tributária no site da JMF. Meu negócio fatura ${formatBRL(faturamento)} com ${(percB2B * 100).toFixed(0)}% B2B e o simulador indicou o Simples Híbrido. Quero validar meu enquadramento.`;
  } else if (percB2B < 0.35) {
    // Foco B2C: Tradicional é mais barato
    cardTrad.className = "bg-sky-50/50 rounded-xl p-5 border-2 border-sky-500 shadow-sm relative transition-all duration-300";
    vIcon.textContent = "💰";
    vTitulo.textContent = "Recomendação Estratégica: Simples Tradicional";
    vTitulo.className = "font-bold text-base mb-1 text-sky-800";
    const economia = impostoHibridoTotal - impostoTradicional;
    vDesc.innerHTML = `Como a maior parte das suas vendas é para o <strong>consumidor final (B2C)</strong>, o cliente não precisa de crédito de impostos. O Simples Tradicional preserva a simplicidade da guia única e economiza <strong>${formatBRL(economia)}/mês</strong> em relação ao modelo híbrido.`;
    waTexto = `Olá! Simulei a Reforma Tributária no site da JMF. Meu negócio fatura ${formatBRL(faturamento)} no Simples Tradicional e quero orientações sobre o planejamento para 2027.`;
  } else {
    // Zona mista de decisão
    if (impostoTradicional <= impostoHibridoTotal) {
      cardTrad.className = "bg-amber-50/50 rounded-xl p-5 border-2 border-amber-500 shadow-sm relative transition-all duration-300";
      vIcon.textContent = "⚖️";
      vTitulo.textContent = "Cenário de Equilíbrio: Simples Tradicional";
      vTitulo.className = "font-bold text-base mb-1 text-amber-800";
      vDesc.innerHTML = `O Simples Tradicional gera menor desembolso direto de caixa (${formatBRL(impostoHibridoTotal - impostoTradicional)}/mês a menos). Avalie junto à contabilidade se seus compradores PJ exigem crédito tributário cheio.`;
    } else {
      cardHib.className = "bg-green-50/50 rounded-xl p-5 border-2 border-green-500 shadow-sm relative transition-all duration-300";
      vIcon.textContent = "⚖️";
      vTitulo.textContent = "Cenário de Equilíbrio: Simples Híbrido";
      vTitulo.className = "font-bold text-base mb-1 text-green-800";
      vDesc.innerHTML = `Pelo volume de insumos tributados que você adquire, o Simples Híbrido já empata ou supera o Simples tradicional, entregando o diferencial competitivo do crédito integral nas vendas.`;
    }
    waTexto = `Olá! Fiz a simulação da Reforma Tributária na JMF e meu perfil ficou equilibrado entre Simples Tradicional e Híbrido (${formatBRL(faturamento)}/mês). Gostaria de agendar uma análise.`;
  }

  btnWA.href = `https://wa.me/554733265123?text=${encodeURIComponent(waTexto)}`;
}

// Event Listeners
document.getElementById('faturamento').addEventListener('input', (e) => {
  applyCurrencyMask(e.target);
  calcular();
});
document.getElementById('atividade').addEventListener('change', calcular);
document.getElementById('range-b2b').addEventListener('input', calcular);
document.getElementById('range-insumos').addEventListener('input', calcular);

// Execução inicial
calcular();
</script>

