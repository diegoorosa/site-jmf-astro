<script>
// ────────────────────────────────────────────────────────
// SIMULADOR REFORMA TRIBUTÁRIA — JMF Contabilidade
// Comparação: Simples Nacional (Fator R) vs Lucro Presumido
// Legislação base: LC 123/2006, CGSN 140/2018, Dec. 9.580/2018
// ────────────────────────────────────────────────────────

// Tabela Anexo III (Simples Nacional)
const ANEXO_III = [
  { limite: 180000,    nominal: 0.06,  deducao: 0 },
  { limite: 360000,    nominal: 0.112, deducao: 9360 },
  { limite: 720000,    nominal: 0.135, deducao: 17640 },
  { limite: 1800000,   nominal: 0.16,  deducao: 35640 },
  { limite: 3600000,   nominal: 0.21,  deducao: 125640 },
  { limite: 4800000,   nominal: 0.33,  deducao: 648000 },
];

// Tabela Anexo V (Simples Nacional)
const ANEXO_V = [
  { limite: 180000,    nominal: 0.155, deducao: 0 },
  { limite: 360000,    nominal: 0.18,  deducao: 4500 },
  { limite: 720000,    nominal: 0.195, deducao: 9900 },
  { limite: 1800000,   nominal: 0.205, deducao: 17100 },
  { limite: 3600000,   nominal: 0.23,  deducao: 62100 },
  { limite: 4800000,   nominal: 0.305, deducao: 540000 },
];

// Lucro Presumido - Presunção de lucro
// Serviços: 32% | Comércio/Indústria: 8%
const PRESUMAO_SERVICOS = 0.32;
const PRESUMAO_COMERCIO = 0.08;

// Alíquotas Lucro Presumido (federais)
const ALIQUOTAS_LP = {
  irpj: 0.15,
  irpj_adicional: 0.10, // acima de 240k/ano
  csll: 0.09,
  pis: 0.0165,
  cofins: 0.076,
};

function getFaixa(rbt12, tabela) {
  for (const faixa of tabela) {
    if (rbt12 <= faixa.limite) return faixa;
  }
  return tabela[tabela.length - 1];
}

function getAliquotaEfetiva(rbt12, tabela) {
  if (rbt12 <= 0) return 0;
  const faixa = getFaixa(rbt12, tabela);
  return (rbt12 * faixa.nominal - faixa.deducao) / rbt12;
}

function parseBRL(str) {
  if (!str) return 0;
  const cleaned = str.replace(/\./g, '').replace(',', '.');
  const n = parseFloat(cleaned);
  return isNaN(n) ? 0 : n;
}

function formatBRL(value) {
  return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}

function formatPct(value) {
  return value.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
}

function applyMask(input) {
  let v = input.value.replace(/\D/g, '');
  if (v === '') { input.value = ''; return; }
  const num = parseInt(v, 10) / 100;
  input.value = num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function calcular() {
  const faturamento = parseBRL(document.getElementById('faturamento').value);
  const prolabore   = parseBRL(document.getElementById('prolabore').value);
  const salarios    = parseBRL(document.getElementById('salarios').value);
  const despesasDed = parseBRL(document.getElementById('despesas-dedutiveis').value);

  const vazio = document.getElementById('estado-vazio');
  const resultado = document.getElementById('estado-resultado');

  if (faturamento <= 0) {
    vazio.style.display = 'flex';
    resultado.style.display = 'none';
    document.getElementById('resultado-container').className =
      'rounded-2xl border-2 border-dashed border-gray-200 p-8 flex flex-col items-center justify-center transition-all duration-500 min-h-[500px]';
    return;
  }

  // ── Cálculo da Folha com Encargos (Simples Nacional) ───────
  // Pró-labore: + 20% INSS patronal (contribuinte individual)
  const folhaProlaboreComEncargos = prolabore * 1.20;

  // CLT: + 20% INSS patronal + 8% FGTS + 8,33% 13º + 11,11% férias+1/3
  // Total encargos sobre salário bruto CLT ≈ 47,44%
  const folhaCLTComEncargos = salarios * 1.4744;

  const folhaMensalComEncargos = folhaProlaboreComEncargos + folhaCLTComEncargos;

  // ── Fator R (Simples Nacional) ────────────────────────────
  const receita12m = faturamento * 12;
  const folha12m   = folhaMensalComEncargos * 12;

  let fatorR;
  if (folha12m > 0 && receita12m <= 0) {
    fatorR = 0.28; // definição legislativa CGSN 140/2018
  } else if (folha12m <= 0 && receita12m > 0) {
    fatorR = 0.0;
  } else {
    fatorR = folha12m / receita12m;
  }

  const isAnexoIII = fatorR >= 0.28;
  const tabelaSimples = isAnexoIII ? ANEXO_III : ANEXO_V;
  const aliquotaSimples = getAliquotaEfetiva(receita12m, tabelaSimples);
  const dasMensal = faturamento * aliquotaSimples;

  // ── Lucro Presumido ───────────────────────────────────────
  // Presunção: 32% para serviços, 8% para comércio/indústria
  // Usamos 32% (serviços) como padrão - pode ser ajustado
  const presuncao = PRESUMAO_SERVICOS;
  const lucroPresumidoMensal = faturamento * presuncao;
  const lucroPresumidoAnual = lucroPresumidoMensal * 12;

  // IRPJ: 15% sobre lucro presumido + 10% adicional sobre excedente de R$ 20.000/mês (R$ 240.000/ano)
  const lucroPresumidoAnualParaIRPJ = lucroPresumidoAnual;
  const irpjBase = lucroPresumidoAnualParaIRPJ * ALIQUOTAS_LP.irpj;
  const irpjAdicional = Math.max(0, lucroPresumidoAnualParaIRPJ - 240000) * ALIQUOTAS_LP.irpj_adicional;
  const irpjTotal = irpjBase + irpjAdicional;

  // CSLL: 9% sobre lucro presumido
  const csllTotal = lucroPresumidoAnualParaIRPJ * ALIQUOTAS_LP.csll;

  // PIS/COFINS: não cumulativos sobre receita bruta (com créditos sobre despesas)
  // Simplificação: base = receita - despesas dedutíveis (aprox.)
  const receitaAnual = receita12m;
  const despesasAnuais = despesasDed * 12;
  const basePisCofins = Math.max(0, receitaAnual - despesasAnuais);
  const pisTotal = basePisCofins * ALIQUOTAS_LP.pis;
  const cofinsTotal = basePisCofins * ALIQUOTAS_LP.cofins;

  const totalLucroPresumidoAnual = irpjTotal + csllTotal + pisTotal + cofinsTotal;
  const totalLucroPresumidoMensal = totalLucroPresumidoAnual / 12;

  // Aliquota efetiva Lucro Presumido
  const aliquotaLucroPresumido = totalLucroPresumidoMensal / faturamento;

  // ── Comparação ───────────────────────────────────────────
  const diferenca = totalLucroPresumidoMensal - dasMensal;
  const simplesMenor = dasMensal < totalLucroPresumidoMensal;

  // ── Atualiza UI ─────────────────────────────────────────
  vazio.style.display = 'none';
  resultado.style.display = 'block';

  // Container border color
  const container = document.getElementById('resultado-container');
  container.className = simplesMenor
    ? 'rounded-2xl border-2 border-green-300 bg-green-50/30 p-8 flex flex-col justify-center transition-all duration-500 min-h-[500px]'
    : 'rounded-2xl border-2 border-blue-300 bg-blue-50/30 p-8 flex flex-col justify-center transition-all duration-500 min-h-[500px]';

  // Regime recomendado
  const regimeEl = document.getElementById('regime-recomendado');
  const regimeBadge = document.getElementById('regime-badge');
  if (simplesMenor) {
    regimeEl.textContent = 'Simples Nacional';
    regimeEl.className = 'text-3xl font-black leading-none mb-3 transition-all duration-300 text-green-700';
    regimeBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800';
    regimeBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Recomendado: Simples Nacional';
  } else {
    regimeEl.textContent = 'Lucro Presumido';
    regimeEl.className = 'text-3xl font-black leading-none mb-3 transition-all duration-300 text-blue-700';
    regimeBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800';
    regimeBadge.innerHTML = '<i class="bi bi-building-fill"></i> Recomendado: Lucro Presumido';
  }

  // Card Simples Nacional
  const cardSimples = document.getElementById('card-simples');
  const cardSimplesLabel = document.getElementById('card-simples-label');
  const cardSimplesValor = document.getElementById('card-simples-valor');
  const cardSimplesAliquota = document.getElementById('card-simples-aliquota');
  const cardSimplesDetalhe = document.getElementById('card-simples-detalhe');

  if (simplesMenor) {
    cardSimples.className = 'rounded-xl p-4 text-center border-2 border-green-200 bg-green-50 transition-all duration-300';
    cardSimplesLabel.textContent = 'SIMPLES NACIONAL (RECOMENDADO)';
    cardSimplesLabel.className = 'text-xs font-bold tracking-wide mb-1 text-green-700';
  } else {
    cardSimples.className = 'rounded-xl p-4 text-center border-2 border-dashed border-green-200 bg-green-50/40 transition-all duration-300';
    cardSimplesLabel.textContent = 'SIMPLES NACIONAL';
    cardSimplesLabel.className = 'text-xs font-bold tracking-wide mb-1 text-green-500';
  }
  cardSimplesValor.textContent = formatBRL(dasMensal);
  cardSimplesValor.className = simplesMenor ? 'text-2xl font-black leading-tight text-green-700' : 'text-2xl font-black leading-tight text-green-400';
  cardSimplesAliquota.textContent = `Alíquota efetiva: ${formatPct(aliquotaSimples * 100)}`;
  cardSimplesAliquota.className = 'text-xs mt-1 ' + (simplesMenor ? 'text-green-600' : 'text-green-400');
  cardSimplesDetalhe.textContent = `Anexo ${isAnexoIII ? 'III' : 'V'} • DAS unificado`;
  cardSimplesDetalhe.className = 'text-xs mt-1 ' + (simplesMenor ? 'text-green-500' : 'text-green-400');

  // Card Lucro Presumido
  const cardLucro = document.getElementById('card-lucro');
  const cardLucroLabel = document.getElementById('card-lucro-label');
  const cardLucroValor = document.getElementById('card-lucro-valor');
  const cardLucroAliquota = document.getElementById('card-lucro-aliquota');
  const cardLucroDetalhe = document.getElementById('card-lucro-detalhe');

  if (!simplesMenor) {
    cardLucro.className = 'rounded-xl p-4 text-center border-2 border-blue-200 bg-blue-50 transition-all duration-300';
    cardLucroLabel.textContent = 'LUCRO PRESUMIDO (RECOMENDADO)';
    cardLucroLabel.className = 'text-xs font-bold tracking-wide mb-1 text-blue-700';
  } else {
    cardLucro.className = 'rounded-xl p-4 text-center border-2 border-dashed border-blue-200 bg-blue-50/40 transition-all duration-300';
    cardLucroLabel.textContent = 'LUCRO PRESUMIDO';
    cardLucroLabel.className = 'text-xs font-bold tracking-wide mb-1 text-blue-500';
  }
  cardLucroValor.textContent = formatBRL(totalLucroPresumidoMensal);
  cardLucroValor.className = simplesMenor ? 'text-2xl font-black leading-tight text-blue-400' : 'text-2xl font-black leading-tight text-blue-700';
  cardLucroAliquota.textContent = `Alíquota efetiva: ${formatPct(aliquotaLucroPresumido * 100)}`;
  cardLucroAliquota.className = 'text-xs mt-1 ' + (simplesMenor ? 'text-blue-400' : 'text-blue-600');
  cardLucroDetalhe.textContent = `Serviços 32% • IRPJ+CSLL+PIS/COFINS`;
  cardLucroDetalhe.className = 'text-xs mt-1 ' + (simplesMenor ? 'text-blue-400' : 'text-blue-500');

  // Fator R e Anexo
  const fatorRDisplay = document.getElementById('fator-r-display');
  const anexoDisplay = document.getElementById('anexo-display');
  fatorRDisplay.textContent = formatPct(fatorR * 100);
  fatorRDisplay.className = `text-2xl font-black leading-tight ${isAnexoIII ? 'text-green-700' : 'text-orange-600'}`;
  anexoDisplay.textContent = `Anexo ${isAnexoIII ? 'III' : 'V'}`;
  anexoDisplay.className = `text-xs mt-1 ${isAnexoIII ? 'text-green-600' : 'text-orange-600'}`;

  // Economia
  const economiaMensalDisplay = document.getElementById('economia-mensal-display');
  const economiaAnualDisplay = document.getElementById('economia-anual-display');
  const economiaCard = document.getElementById('card-economia');

  if (Math.abs(diferenca) > 0.5) {
    economiaCard.style.display = 'block';
    if (simplesMenor) {
      economiaCard.className = 'rounded-xl p-4 text-center border-2 border-green-200 bg-green-50 transition-all duration-300';
      economiaMensalDisplay.textContent = formatBRL(diferenca) + '/mês';
      economiaMensalDisplay.className = 'text-2xl font-black leading-tight text-green-700';
      economiaAnualDisplay.textContent = `Economia de ${formatBRL(diferenca * 12)}/ano vs Lucro Presumido`;
      economiaAnualDisplay.className = 'text-xs mt-1 text-green-600';
    } else {
      economiaCard.className = 'rounded-xl p-4 text-center border-2 border-blue-200 bg-blue-50 transition-all duration-300';
      economiaMensalDisplay.textContent = formatBRL(Math.abs(diferenca)) + '/mês';
      economiaMensalDisplay.className = 'text-2xl font-black leading-tight text-blue-700';
      economiaAnualDisplay.textContent = `Economia de ${formatBRL(Math.abs(diferenca) * 12)}/ano vs Simples Nacional`;
      economiaAnualDisplay.className = 'text-xs mt-1 text-blue-600';
    }
  } else {
    economiaCard.style.display = 'none';
  }

  // Diagnóstico
  const diag = document.getElementById('diagnostico');
  const diagIcon = document.getElementById('diagnostico-icon');
  const diagTitulo = document.getElementById('diagnostico-titulo');
  const diagTexto = document.getElementById('diagnostico-texto');

  if (simplesMenor) {
    if (isAnexoIII) {
      diag.className = 'rounded-xl p-4 mb-5 bg-green-50 border border-green-200 transition-all duration-300';
      diagIcon.textContent = '✅';
      diagTitulo.textContent = 'Simples Nacional (Anexo III) — Melhor opção';
      diagTitulo.className = 'font-bold text-base mb-0.5 text-green-800';
      diagTexto.textContent = `Seu Fator R de ${formatPct(fatorR * 100)} garante o Anexo III (alíquota ${formatPct(aliquotaSimples * 100)}). O Simples Nacional é mais vantajoso que o Lucro Presumido, com economia de ${formatBRL(diferenca)}/mês.`;
      diagTexto.className = 'text-sm leading-relaxed text-green-800';
    } else {
      diag.className = 'rounded-xl p-4 mb-5 bg-amber-50 border border-amber-200 transition-all duration-300';
      diagIcon.textContent = '⚖️';
      diagTitulo.textContent = 'Simples Nacional (Anexo V) — Ainda vantajoso';
      diagTitulo.className = 'font-bold text-base mb-0.5 text-amber-800';
      const prolaboreNecessario = Math.ceil((0.28 * receita12m - folha12m) / 12 / 1.20 + prolabore);
      diagTexto.textContent = `Fator R de ${formatPct(fatorR * 100)} (Anexo V, alíquota ${formatPct(aliquotaSimples * 100)}). Mesmo no Anexo V, o Simples economiza ${formatBRL(diferenca)}/mês vs Lucro Presumido. Aumentar pró-labore para ~${formatBRL(prolaboreNecessario)}/mês migraria para Anexo III e aumentaria a economia.`;
      diagTexto.className = 'text-sm leading-relaxed text-amber-800';
    }
  } else {
    diag.className = 'rounded-xl p-4 mb-5 bg-blue-50 border border-blue-200 transition-all duration-300';
    diagIcon.textContent = '🏢';
    diagTitulo.textContent = 'Lucro Presumido — Melhor opção';
    diagTitulo.className = 'font-bold text-base mb-0.5 text-blue-800';
    if (isAnexoIII) {
      diagTexto.textContent = `Embora seu Fator R (${formatPct(fatorR * 100)}) garanta Anexo III (${formatPct(aliquotaSimples * 100)}), o Lucro Presumido sai mais barato (${formatPct(aliquotaLucroPresumido * 100)} efetivo) devido às despesas dedutíveis e créditos de PIS/COFINS. Economia de ${formatBRL(Math.abs(diferenca))}/mês.`;
    } else {
      diagTexto.textContent = `Fator R de ${formatPct(fatorR * 100)} (Anexo V, ${formatPct(aliquotaSimples * 100)}). O Lucro Presumido é mais vantajoso (${formatPct(aliquotaLucroPresumido * 100)} efetivo) com economia de ${formatBRL(Math.abs(diferenca))}/mês. Considere créditos de PIS/COFINS e planejamento para Reforma Tributária.`;
    }
    diagTexto.className = 'text-sm leading-relaxed text-blue-800';
  }
}

// Inputs com máscara BRL
const inputs = ['faturamento', 'prolabore', 'salarios', 'despesas-dedutiveis'];
inputs.forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener('input', () => { applyMask(el); calcular(); });
  el.addEventListener('paste', () => { setTimeout(() => { applyMask(el); calcular(); }, 0); });
});
</script>

</Layout>