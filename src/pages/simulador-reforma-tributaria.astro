---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20usei%20o%20Simulador%20de%20Reforma%20Tribut%C3%A1ria%20no%20site%20da%20JMF%20e%20quero%20validar%20os%20resultados%20com%20um%20especialista.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["WebApplication", "Service"],
  "name": "Simulador Reforma Tributária — Simples Nacional vs Lucro Presumido 2026",
  "description": "Compare Simples Nacional e Lucro Presumido com base na Reforma Tributária. Calcule Fator R, analise impacto do pró-labore e identifique a melhor estratégia tributária para sua empresa. Ferramenta gratuita.",
  "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock",
    "description": "Acesso gratuito ao simulador de reforma tributária para comparação de regimes",
    "url": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "url": "https://www.jmfcontabilidade.com.br",
    "logo": "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.webp",
    "sameAs": [
      "https://wa.me/554733265123",
      "https://www.instagram.com/jmfcontabilidade"
    ]
  },
  "areaServed": {
    "@type": "GeoShape",
    "addressCountry": "BR",
    "addressRegion": "SC",
    "addressLocality": "Blumenau",
    "description": "Brasil — foco em Santa Catarina e região Sul"
  },
  "serviceType": "Simulador tributário online para Reforma Tributária (Simples Nacional vs Lucro Presumido)",
  "category": "FinanceApplication",
  "featureList": [
    "Comparação entre Simples Nacional (Anexo III/V) e Lucro Presumido",
    "Cálculo do Fator R com identificação automática de Anexo",
    "Análise de impacto tributário de ajustes no pró-labore",
    "Cálculo de alíquota efetiva e DAS mensal estimado",
    "Comparação de economia entre regimes tributários",
    "Diagnóstico personalizado com sugestão de estratégia",
    "Tabelas atualizadas 2026 das alíquotas do Simples Nacional e Lucro Presumido"
  ],
  "hasOutput": {
    "@type": "PropertyValue",
    "name": "Resultado do Simulador",
    "description": "Regime recomendado, Fator R, Anexo aplicável, alíquota efetiva, DAS mensal, economia anual e estratégia de pró-labore"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  }
});
---

<Layout
  title="Simulador Reforma Tributária — Simples Nacional vs Lucro Presumido 2026"
  description="Compare Simples Nacional e Lucro Presumido com base na Reforma Tributária. Calcule Fator R, analise impacto do pró-labore e identifique a melhor estratégia tributária."
  canonical="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  ogUrl="https://www.jmfcontabilidade.com.br/simulador-reforma-tributaria"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

<HeroInterno
  title="Simulador Reforma Tributária"
  subtitle="Compare Simples Nacional vs Lucro Presumido, analise o Fator R e o impacto do pró-labore. Identifique a melhor estratégia tributária para sua empresa em 2026."
  breadcrumb={[
    { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
    { label: "Ferramentas" },
    { label: "Simulador Reforma Tributária" }
  ]}
  ctas={[
    { label: "Simular agora", href: "#simulador", variant: "cta" },
    { label: "Falar com especialista", href: WA, variant: "outline" }
  ]}
/>

<!-- SIMULADOR PRINCIPAL -->
<section id="simulador" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-700 px-4 py-2 rounded-full text-sm font-semibold mb-4">
          <i class="bi bi-bar-chart-line"></i>
          Ferramenta Gratuita
        </div>
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Simule <span class="pp3-grad">Reforma Tributária</span> agora</h2>
        <p class="text-gray-500 text-lg max-w-2xl mx-auto">
          Preencha os dados com a média dos últimos 12 meses. O simulador compara Simples Nacional e Lucro Presumido automaticamente.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- FORMULÁRIO -->
        <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
          <h3 class="font-bold text-[#0f172a] text-lg mb-6 flex items-center gap-2">
            <span class="w-8 h-8 bg-amber-600 text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
            Dados da empresa
          </h3>

          <div class="mb-5">
            <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="faturamento">
              Receita bruta mensal média — últimos 12 meses
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
              <input
                type="text"
                id="faturamento"
                inputmode="numeric"
                placeholder="15.000,00"
                class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
                autocomplete="off"
              />
            </div>
            <p class="mt-1 text-xs text-gray-400">Média do que sua empresa faturou por mês (total das notas fiscais emitidas)</p>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="prolabore">
              Pró-labore mensal — total dos sócios
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
              <input
                type="text"
                id="prolabore"
                inputmode="numeric"
                placeholder="5.000,00"
                class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
                autocomplete="off"
              />
            </div>
            <p class="mt-1 text-xs text-gray-400">Some o pró-labore declarado de todos os sócios. Se não há pró-labore, coloque 0</p>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="salarios">
              Salários brutos CLT mensais — total dos funcionários
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
              <input
                type="text"
                id="salarios"
                inputmode="numeric"
                placeholder="0,00"
                class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
                autocomplete="off"
              />
            </div>
            <p class="mt-1 text-xs text-gray-400">Total bruto de salários dos funcionários CLT. Se não há funcionários, deixe em 0</p>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="despesas-dedutiveis">
              Despesas operacionais dedutíveis mensais (Lucro Presumido)
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
              <input
                type="text"
                id="despesas-dedutiveis"
                inputmode="numeric"
                placeholder="2.000,00"
                class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
                autocomplete="off"
              />
            </div>
            <p class="mt-1 text-xs text-gray-400">Estimativa de despesas dedutíveis para base do Lucro Presumido (aluguel, energia, honorários, etc.)</p>
          </div>

          <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 text-sm text-amber-800">
            <i class="bi bi-info-circle mr-1.5"></i>
            <strong>Metodologia:</strong> Simples Nacional usa Fator R (CGSN 140/2018). Lucro Presumido usa presunção de 8% (comércio/indústria) ou 32% (serviços) sobre receita, menos despesas dedutíveis. IRPJ 15% + 10% (adicional) + CSLL 9% + PIS/COFINS não cumulativos. Resultado é estimativa orientativa.
          </div>
        </div>

        <!-- RESULTADO -->
        <div id="resultado-container" class="rounded-2xl border-2 border-dashed border-gray-200 p-8 flex flex-col items-center justify-center transition-all duration-500 min-h-[500px]">

          <div id="estado-vazio" class="text-center">
            <div class="w-20 h-20 rounded-full bg-gray-50 border-2 border-gray-100 flex items-center justify-center mx-auto mb-5">
              <i class="bi bi-bar-chart-line text-gray-300 text-3xl"></i>
            </div>
            <p class="text-gray-400 font-semibold text-lg">Preencha os dados ao lado</p>
            <p class="text-gray-300 text-sm mt-1">O resultado aparece aqui automaticamente</p>
          </div>

          <div id="estado-resultado" class="w-full" style="display:none">

            <!-- Regime Recomendado -->
            <div class="text-center mb-5">
              <p class="text-xs font-bold tracking-widest text-gray-400 mb-2">REGIME RECOMENDADO</p>
              <div id="regime-recomendado" class="text-3xl font-black leading-none mb-3 transition-all duration-300">—</div>
              <div id="regime-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold"></div>
            </div>

            <!-- Comparativo Principal -->
            <div class="grid grid-cols-2 gap-3 mb-5">
              <!-- Simples Nacional -->
              <div id="card-simples" class="rounded-xl p-4 text-center border-2 transition-all duration-300">
                <p id="card-simples-label" class="text-xs font-bold tracking-wide mb-1 opacity-70"></p>
                <p id="card-simples-valor" class="text-2xl font-black leading-tight"></p>
                <p id="card-simples-aliquota" class="text-xs mt-1 opacity-60"></p>
                <p id="card-simples-detalhe" class="text-xs mt-1 opacity-50"></p>
              </div>

              <!-- Lucro Presumido -->
              <div id="card-lucro" class="rounded-xl p-4 text-center border-2 border-dashed transition-all duration-300">
                <p id="card-lucro-label" class="text-xs font-bold tracking-wide mb-1 opacity-70"></p>
                <p id="card-lucro-valor" class="text-2xl font-black leading-tight opacity-60"></p>
                <p id="card-lucro-aliquota" class="text-xs mt-1 opacity-50"></p>
                <p id="card-lucro-detalhe" class="text-xs mt-1 opacity-40"></p>
              </div>
            </div>

            <!-- Fator R e Anexo -->
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div id="card-fator-r" class="rounded-xl p-4 text-center border-2 transition-all duration-300">
                <p class="text-xs font-bold tracking-wide mb-1 text-gray-500">FATOR R</p>
                <p id="fator-r-display" class="text-2xl font-black leading-tight"></p>
                <p id="anexo-display" class="text-xs mt-1 opacity-60"></p>
              </div>
              <div id="card-economia" class="rounded-xl p-4 text-center border-2 transition-all duration-300">
                <p class="text-xs font-bold tracking-wide mb-1 text-gray-500">ECONOMIA MENSAL</p>
                <p id="economia-mensal-display" class="text-2xl font-black leading-tight"></p>
                <p id="economia-anual-display" class="text-xs mt-1 opacity-60"></p>
              </div>
            </div>

            <!-- Diagnóstico -->
            <div id="diagnostico" class="rounded-xl p-4 mb-5 transition-all duration-300">
              <div class="flex items-start gap-3">
                <span id="diagnostico-icon" class="text-2xl flex-shrink-0 mt-0.5"></span>
                <div>
                  <h4 id="diagnostico-titulo" class="font-bold text-base mb-0.5"></h4>
                  <p id="diagnostico-texto" class="text-sm leading-relaxed"></p>
                </div>
              </div>
            </div>

            <!-- Botão WhatsApp -->
            <a href={WA} target="_blank" rel="noopener"
              class="block w-full text-center px-6 py-3.5 bg-[#f97316] text-white font-bold rounded-xl hover:bg-[#ea580c] transition-colors text-sm">
              <i class="bi bi-whatsapp mr-2"></i>Validar com especialista da JMF
            </a>

            <!-- Captura de e-mail após resultado -->
            <div
              class="mt-4 bg-[#f8fafc] border border-gray-200 rounded-xl p-4"
              x-data="{ sent: false, error: false, loading: false }"
            >
              <p class="text-xs font-bold text-[#0f172a] mb-0.5">Receber resultado por e-mail</p>
              <p class="text-xs text-gray-400 mb-2">A JMF envia uma análise completa comparando os regimes tributários.</p>
              <form
                x-show="!sent"
                action="https://formspree.io/f/xldnlbpk"
                method="POST"
                @submit.prevent="
                  loading = true;
                  fetch($el.action, { method: 'POST', body: new FormData($el), headers: { Accept: 'application/json' } })
                    .then(r => { if (r.ok) { sent = true; } else { error = true; } })
                    .catch(() => { error = true; })
                    .finally(() => { loading = false; });
                "
                class="flex flex-col gap-2"
              >
                <input type="hidden" name="_subject" value="Lead via Simulador Reforma Tributária — JMF" />
                <label for="calc-name" class="sr-only">Seu nome</label>
                <input id="calc-name" type="text" name="name" placeholder="Seu nome" required
                  class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500" />
                <label for="calc-email" class="sr-only">Seu e-mail</label>
                <input id="calc-email" type="email" name="email" placeholder="Seu e-mail" required
                  class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500" />
                <button type="submit" :disabled="loading"
                  class="w-full py-2 bg-amber-600 text-white text-xs font-semibold rounded-lg hover:bg-amber-700 transition-colors disabled:opacity-60">
                  <span x-show="!loading">Enviar</span>
                  <span x-show="loading">Enviando...</span>
                </button>
              </form>
              <p x-show="error" class="mt-1 text-xs text-red-600">Erro. Tente pelo WhatsApp.</p>
              <p x-show="sent" class="text-xs font-semibold text-green-700 flex items-center gap-1">
                <i class="bi bi-check-circle-fill"></i> Recebido! Em breve a JMF entra em contato.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- O QUE É O SIMULADOR -->
<section class="py-16 bg-[#fef3c7]">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-[#0f172a] mb-4">O que analisa o <span class="pp3-grad">Simulador de Reforma Tributária?</span></h2>
      <p class="text-gray-600 text-lg leading-relaxed mb-6">
        A Reforma Tributária (EC 132/2023 e PLP 68/2024) traz mudanças graduais até 2033. Hoje, a decisão entre <strong>Simples Nacional</strong> e <strong>Lucro Presumido</strong> ainda define a competitividade de muitas empresas. Este simulador cruza os dois regimes:
      </p>

      <div class="bg-white rounded-2xl p-6 mb-8 shadow-sm">
        <h3 class="font-bold text-[#0f172a] mb-4 text-center text-lg">O que é comparado</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-green-50 border border-green-200 rounded-xl p-4">
            <div class="text-2xl font-black text-green-700 mb-1">Simples Nacional</div>
            <div class="font-bold text-green-800 text-sm">Fator R define Anexo III (6%) ou V (15,5%)</div>
            <div class="text-green-700 text-xs mt-2">DAS unificado — simplicidade operacional</div>
          </div>
          <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
            <div class="text-2xl font-black text-blue-700 mb-1">Lucro Presumido</div>
            <div class="font-bold text-blue-800 text-sm">Presunção 8% (indústria/comércio) ou 32% (serviços)</div>
            <div class="text-blue-700 text-xs mt-2">IRPJ + CSLL + PIS/COFINS não cumulativos</div>
          </div>
        </div>
      </div>

      <h3 class="text-xl font-bold text-[#0f172a] mb-3">Principais variáveis analisadas</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6">
        {[
          { incl: true, text: "Fator R e Anexo aplicável (Simples Nacional)" },
          { incl: true, text: "Alíquota efetiva e DAS mensal (Simples)" },
          { incl: true, text: "Base de cálculo presumida (Lucro Presumido)" },
          { incl: true, text: "IRPJ, CSLL, PIS, COFINS estimados (Lucro Presumido)" },
          { incl: true, text: "Impacto do pró-labore no Fator R" },
          { incl: true, text: "Economia potencial entre regimes" },
          { incl: false, text: "ICMS/IPI (fora do escopo — varia por estado/operação)" },
          { incl: false, text: "Transição 2026-2033 (Reforma Tributária em andamento)" },
        ].map(item => (
          <div class="flex items-center gap-2.5 bg-white rounded-lg p-3 text-sm shadow-sm">
            <i class={`${item.incl ? 'bi-check-circle-fill text-green-600' : 'bi-x-circle-fill text-red-400'} bi flex-shrink-0`}></i>
            <span class={item.incl ? 'text-gray-700' : 'text-gray-400 line-through'}>{item.text}</span>
            {item.incl
              ? <span class="ml-auto text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-semibold flex-shrink-0">Incluso</span>
              : <span class="ml-auto text-xs bg-red-50 text-red-400 px-2 py-0.5 rounded-full font-semibold flex-shrink-0">Não incluso</span>
            }
          </div>
        ))}
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
        <i class="bi bi-exclamation-triangle-fill mr-2"></i>
        <strong>Importante:</strong> A Reforma Tributária institui o IBS (estadual/municipal) e CBS (federal) substituindo ICMS, ISS, IPI, PIS, COFINS. A transição vai de 2026 a 2033. Este simulador usa a legislação vigente em 2026 para decisão imediata. Converse com um especialista para planejamento de longo prazo.
      </div>
    </div>
  </div>
</section>

<!-- TABELAS DE REFERÊNCIA -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-2">Tabelas de <span class="pp3-grad">Referência 2026</span></h2>
        <p class="text-gray-500">Alíquotas vigentes para comparação entre regimes</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

        <!-- Anexo III -->
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
          <div class="bg-green-600 text-white p-4 flex items-center gap-3">
            <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
              <i class="bi bi-arrow-down-circle-fill text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-lg">Simples — Anexo III</h3>
              <p class="text-green-100 text-xs">Fator R ≥ 28% — Serviços favorecidos</p>
            </div>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50">
                <th class="p-3 text-left text-gray-500 font-semibold text-xs">Faturamento 12 meses</th>
                <th class="p-3 text-center text-gray-500 font-semibold text-xs">Alíq. Nominal</th>
                <th class="p-3 text-center text-gray-500 font-semibold text-xs">Parcela Ded.</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 180.000</td><td class="p-3 text-center font-bold text-green-700">6,00%</td><td class="p-3 text-center text-gray-400 text-xs">—</td></tr>
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 360.000</td><td class="p-3 text-center font-bold text-green-700">11,20%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 9.360</td></tr>
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 720.000</td><td class="p-3 text-center font-bold text-green-700">13,50%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 17.640</td></tr>
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 1.800.000</td><td class="p-3 text-center font-bold text-green-700">16,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 35.640</td></tr>
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 3.600.000</td><td class="p-3 text-center font-bold text-green-700">21,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 125.640</td></tr>
              <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 4.800.000</td><td class="p-3 text-center font-bold text-green-700">33,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 648.000</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Anexo V -->
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
          <div class="bg-orange-500 text-white p-4 flex items-center gap-3">
            <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
              <i class="bi bi-arrow-up-circle-fill text-xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-lg">Simples — Anexo V</h3>
              <p class="text-orange-100 text-xs">Fator R &lt; 28% — Alíquotas mais elevadas</p>
