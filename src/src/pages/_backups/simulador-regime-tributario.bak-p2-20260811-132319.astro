      tipo: "servicos",
      faixas: [
        { limite: 180000,   nominal: 0.06,  deducao: 0 },
        { limite: 360000,   nominal: 0.112, deducao: 9360 },
        { limite: 720000,   nominal: 0.135, deducao: 17640 },
        { limite: 1800000,  nominal: 0.16,  deducao: 35640 },
        { limite: 3600000,  nominal: 0.21,  deducao: 125640 },
        { limite: 4800000,  nominal: 0.33,  deducao: 648000 },
      ],
      impostos: "IRPJ, CSLL, PIS, COFINS, CPP, ISS/ICMS",
    },
    transporte_passageiros: {
      nome: "Transporte de Passageiros — Anexo III",
      tipo: "servicos",
      faixas: [
        { limite: 180000,   nominal: 0.06,  deducao: 0 },
        { limite: 360000,   nominal: 0.112, deducao: 9360 },
        { limite: 720000,   nominal: 0.135, deducao: 17640 },
        { limite: 1800000,  nominal: 0.16,  deducao: 35640 },
        { limite: 3600000,  nominal: 0.21,  deducao: 125640 },
        { limite: 4800000,  nominal: 0.33,  deducao: 648000 },
      ],
      impostos: "IRPJ, CSLL, PIS, COFINS, CPP, ISS/ICMS",
    },
  };

  // ── PARÂMETROS LP ─────────────────────────────────────────────────
  const LP_PARAMS: Record<string, { irpjPresuncao: number; csllPresuncao: number }> = {
    comercio_varejo:        { irpjPresuncao: 0.08, csllPresuncao: 0.12 },
    comercio_atacado:       { irpjPresuncao: 0.08, csllPresuncao: 0.12 },
    servicos_anexo3:        { irpjPresuncao: 0.32, csllPresuncao: 0.32 },
    servicos_anexo5:        { irpjPresuncao: 0.32, csllPresuncao: 0.32 },
    servicos_anexo6:        { irpjPresuncao: 0.32, csllPresuncao: 0.32 },
    servicos_32:            { irpjPresuncao: 0.32, csllPresuncao: 0.32 },
    industria:              { irpjPresuncao: 0.08, csllPresuncao: 0.12 },
    transporte_cargas:      { irpjPresuncao: 0.08, csllPresuncao: 0.12 },
    transporte_passageiros: { irpjPresuncao: 0.16, csllPresuncao: 0.12 },
  };

  // ── HELPERS ───────────────────────────────────────────────────────
  function parseBRL(v: string): number {
    return parseFloat(v.replace(/\./g, "").replace(",", ".")) || 0;
  }

  function toBRL(v: number): string {
    return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
  }

  function toPerc(v: number): string {
    return (v * 100).toFixed(2).replace(".", ",") + "%";
  }

  function maskBRL(input: HTMLInputElement) {
    let raw = input.value.replace(/\D/g, "");
    if (!raw) { input.value = ""; return; }
    const num = parseInt(raw) / 100;
    input.value = num.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcAliquotaSN(rbt12: number, tabela: { limite: number; nominal: number; deducao: number }[]): number {
    if (rbt12 <= 0) return 0;
    const faixa = tabela.find(f => rbt12 <= f.limite);
    if (!faixa) return tabela[tabela.length - 1].nominal;
    return (rbt12 * faixa.nominal - faixa.deducao) / rbt12;
  }

  // Fator R: se atividade é serviço e folha >= 28% da receita → usa Anexo III em vez de V
  function aplicarFatorR(atividade: string, folhaAnual: number, receita: number): string {
    if (!["servicos_anexo5", "servicos_32", "servicos_anexo6"].includes(atividade)) return atividade;
    const fatorR = receita > 0 ? folhaAnual / receita : 0;
    if (fatorR >= 0.28) return "servicos_anexo3"; // migra para Anexo III
    return atividade;
  }

  // LP: IRPJ + CSLL + PIS (0,65%) + COFINS (3%)
  function calcLP(receita: number, folhaAnual: number, atividade: string): {
    total: number; irpj: number; csll: number; pis: number; cofins: number; inss: number; aliquotaEfetiva: number;
    presuncaoIRPJ: number; presuncaoCSLL: number;
  } {
    const params = LP_PARAMS[atividade] || { irpjPresuncao: 0.32, csllPresuncao: 0.32 };
    const baseIRPJ  = receita * params.irpjPresuncao;
    const baseCSLL  = receita * params.csllPresuncao;
    const irpj  = baseIRPJ  * 0.15; // 15% + adicional 10% sobre o que exceder 240k/ano
    const adicionalIRPJ = Math.max(0, baseIRPJ - 240000) * 0.10;
    const csll  = baseCSLL  * 0.09;
    const pis   = receita   * 0.0065;
    const cofins = receita  * 0.03;
    const inss  = folhaAnual * 0.20; // 20% patronal
    const total = irpj + adicionalIRPJ + csll + pis + cofins + inss;
    const aliquotaEfetiva = receita > 0 ? total / receita : 0;
    return { total, irpj: irpj + adicionalIRPJ, csll, pis, cofins, inss, aliquotaEfetiva, presuncaoIRPJ: params.irpjPresuncao * 100, presuncaoCSLL: params.csllPresuncao * 100 };
  }

  // ── RENDERIZAR RESULTADO ─────────────────────────────────────────
  function simular() {
    const fatBruto   = parseBRL((document.getElementById("faturamento") as HTMLInputElement).value);
    const atividadeId = (document.getElementById("atividade") as HTMLSelectElement).value;
    const folhaMensal = parseBRL((document.getElementById("folha") as HTMLInputElement).value);
    const margemPerc  = parseFloat((document.getElementById("margem") as HTMLInputElement).value) || 0;

    if (fatBruto <= 0) { alert("Informe o faturamento anual."); return; }
    if (!atividadeId)  { alert("Selecione a atividade da empresa."); return; }
    if (fatBruto > 4800000) {
      alert("Faturamento acima de R$ 4,8 milhões. Empresas com este faturamento não podem optar pelo Simples Nacional — apenas Lucro Presumido ou Lucro Real.\n\nFale com a JMF para uma análise específica.");
      return;
    }

    const folhaAnual = folhaMensal * 12;

    // Fator R: determina o anexo correto para serviços
    const atividadeReal = aplicarFatorR(atividadeId, folhaAnual, fatBruto);
    const tabelaSN = TABELAS_SN[atividadeReal] || TABELAS_SN[atividadeId];
    const fatorR = folhaAnual > 0 && fatBruto > 0 ? folhaAnual / fatBruto : 0;

    // Cálculo SN
    const aliquotaSN  = calcAliquotaSN(fatBruto, tabelaSN.faixas);
    const totalSN     = fatBruto * aliquotaSN;

    // Cálculo LP
    const resLP = calcLP(fatBruto, folhaAnual, atividadeId);

    // Diferença
    const diff = resLP.total - totalSN;
    const snMelhor = diff > 0;

    // ── Preencher UI ──
    document.getElementById("resultado")!.classList.remove("hidden");

    // Header
    const header = document.getElementById("resultado-header")!;
    const tituloEl = document.getElementById("resultado-titulo")!;
    const subtituloEl = document.getElementById("resultado-subtitulo")!;
    const labelEl = document.getElementById("resultado-label")!;

    if (Math.abs(diff) < fatBruto * 0.005) {
      header.className = "rounded-2xl p-6 mb-6 text-center bg-gray-100";
      labelEl.textContent = "Resultado da simulação";
      tituloEl.textContent = "Regimes equivalentes";
      tituloEl.className = "text-2xl font-black mb-1 text-gray-700";
      subtituloEl.textContent = "A diferença é menor que 0,5% do faturamento. Outros fatores (obrigações acessórias, complexidade) devem decidir.";
    } else if (snMelhor) {
      header.className = "rounded-2xl p-6 mb-6 text-center bg-[#1e40af]";
      labelEl.textContent = "Para esta simulação, o regime mais vantajoso é";
      tituloEl.textContent = "Simples Nacional";
      tituloEl.className = "text-2xl font-black mb-1 text-white";
      subtituloEl.textContent = `Economia potencial de ${toBRL(diff)} por ano em relação ao Lucro Presumido`;
      subtituloEl.className = "text-sm text-white/80";
      labelEl.className = "text-sm font-semibold text-white/70 mb-1";
    } else {
      header.className = "rounded-2xl p-6 mb-6 text-center bg-[#f97316]";
      labelEl.textContent = "Para esta simulação, o regime mais vantajoso é";
      tituloEl.textContent = "Lucro Presumido";
      tituloEl.className = "text-2xl font-black mb-1 text-white";
      subtituloEl.textContent = `Economia potencial de ${toBRL(Math.abs(diff))} por ano em relação ao Simples Nacional`;
      subtituloEl.className = "text-sm text-white/80";
      labelEl.className = "text-sm font-semibold text-white/70 mb-1";
    }

    // Cards
    const cardSN = document.getElementById("card-simples")!;
    const cardLP = document.getElementById("card-lp")!;
    const snBadge = document.getElementById("sn-badge")!;
    const lpBadge = document.getElementById("lp-badge")!;

    if (snMelhor) {
      cardSN.className = "bg-white rounded-2xl border-2 border-[#1e40af] p-6 shadow-md";
      cardLP.className = "bg-white rounded-2xl border-2 border-gray-100 p-6 shadow-sm opacity-75";
      snBadge.textContent = "Mais vantajoso";
      snBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-[#1e40af] text-white";
      lpBadge.textContent = "Mais caro";
      lpBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-500";
    } else if (!snMelhor && Math.abs(diff) >= fatBruto * 0.005) {
      cardLP.className = "bg-white rounded-2xl border-2 border-[#f97316] p-6 shadow-md";
      cardSN.className = "bg-white rounded-2xl border-2 border-gray-100 p-6 shadow-sm opacity-75";
      lpBadge.textContent = "Mais vantajoso";
      lpBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-[#f97316] text-white";
      snBadge.textContent = "Mais caro";
      snBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-500";
    } else {
      cardSN.className = "bg-white rounded-2xl border-2 border-gray-200 p-6 shadow-sm";
      cardLP.className = "bg-white rounded-2xl border-2 border-gray-200 p-6 shadow-sm";
      snBadge.textContent = "Equivalente";
      snBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-600";
      lpBadge.textContent = "Equivalente";
      lpBadge.className = "text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-600";
    }

    // Dados SN
    document.getElementById("sn-anexo")!.textContent = tabelaSN.nome + (atividadeReal !== atividadeId ? ` (Fator R ${(fatorR*100).toFixed(1)}% ≥ 28%)` : "");
    document.getElementById("sn-aliquota")!.textContent = toPerc(aliquotaSN);
    document.getElementById("sn-das-mensal")!.textContent = toBRL(totalSN / 12);
    document.getElementById("sn-total-anual")!.textContent = toBRL(totalSN);
    document.getElementById("sn-impostos")!.textContent = tabelaSN.impostos;

    const snNota = document.getElementById("sn-nota")!;
    if (atividadeReal !== atividadeId) {
      snNota.textContent = `Fator R = ${(fatorR*100).toFixed(1)}% ≥ 28% → empresa migrou automaticamente para o Anexo III (menor alíquota).`;
      snNota.classList.remove("hidden");
    } else if (fatorR > 0 && fatorR < 0.28 && ["servicos_anexo5","servicos_32","servicos_anexo6"].includes(atividadeId)) {
      snNota.textContent = `Fator R = ${(fatorR*100).toFixed(1)}% < 28%. Aumentar o pró-labore pode migrar para o Anexo III e reduzir o DAS.`;
      snNota.classList.remove("hidden");
    } else {
      snNota.classList.add("hidden");
    }

    // Dados LP
    document.getElementById("lp-presuncao-label")!.textContent = `Base IRPJ: ${resLP.presuncaoIRPJ}% | Base CSLL: ${resLP.presuncaoCSLL}%`;
    document.getElementById("lp-aliquota")!.textContent = toPerc(resLP.aliquotaEfetiva);
    document.getElementById("lp-mensal")!.textContent = toBRL(resLP.total / 12);
    document.getElementById("lp-total-anual")!.textContent = toBRL(resLP.total);

    // Detalhamento LP
    const grid = document.getElementById("lp-detalhes-grid")!;
    const detalheLP = document.getElementById("detalhe-lp")!;
    const itensLP = [
      { label: "IRPJ (+ adicional)", valor: resLP.irpj },
      { label: "CSLL", valor: resLP.csll },
      { label: "PIS (0,65%)", valor: resLP.pis },
      { label: "COFINS (3%)", valor: resLP.cofins },
    ];
    if (folhaAnual > 0) itensLP.push({ label: "INSS Patronal (20%)", valor: resLP.inss });
    grid.innerHTML = itensLP.map(i => `
      <div class="bg-gray-50 rounded-xl p-3 text-center">
        <div class="text-xs text-gray-500 mb-1">${i.label}</div>
        <div class="font-bold text-[#0f172a] text-sm">${toBRL(i.valor)}</div>
        <div class="text-xs text-gray-400">${toPerc(i.valor / fatBruto)} do fat.</div>
      </div>
    `).join("");
    detalheLP.classList.remove("hidden");

    // Economia
    const econBox = document.getElementById("economia-box")!;
    const econValor = document.getElementById("economia-valor")!;
    const econDesc = document.getElementById("economia-desc")!;
    if (Math.abs(diff) >= fatBruto * 0.005) {
      econBox.classList.remove("hidden");
      econValor.textContent = toBRL(Math.abs(diff));
      econDesc.textContent = snMelhor
        ? "ao ano em favor do Simples Nacional (impostos a menos)"
        : "ao ano em favor do Lucro Presumido (impostos a menos)";
    } else {
      econBox.classList.add("hidden");
    }

    // Observações
    const obs = document.getElementById("obs-lista")!;
    const itensObs = [
      "ISS municipal (alíquota varia de 2% a 5% conforme município e serviço)",
      "INSS sobre pró-labore dos sócios (11% ou 20% conforme plano)",
      "Benefícios fiscais estaduais (redução de ICMS, créditos acumulados)",
      "Distribuição de lucros isenta de IR — pode mudar a lógica financeira",
      "Custo de compliance: LP exige ECD, ECF e SPED (mais obrigações acessórias)",
    ];
    if (margemPerc > 0) {
      itensObs.push(`Margem real de ${margemPerc}% informada — no LP, somente a presunção (${resLP.presuncaoIRPJ}%) define a base do IRPJ/CSLL`);
    }
    obs.innerHTML = itensObs.map(i => `<li class="flex gap-2"><i class="bi bi-dot text-[#1e40af] text-lg flex-shrink-0 -mt-0.5"></i>${i}</li>`).join("");

    document.getElementById("resultado")!.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // ── MÁSCARA ───────────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    const fatInput   = document.getElementById("faturamento") as HTMLInputElement;
    const folhaInput = document.getElementById("folha")       as HTMLInputElement;

    fatInput.addEventListener("input",   () => maskBRL(fatInput));
    folhaInput.addEventListener("input", () => maskBRL(folhaInput));

    document.getElementById("btn-simular")!.addEventListener("click", simular);

    fatInput.addEventListener("keydown", e => { if (e.key === "Enter") simular(); });
  });
  </script>

