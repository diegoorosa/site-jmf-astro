      tipo: "industria",
      faixas: [
        { limite: 180000,   nominal: 0.045, deducao: 0 },
        { limite: 360000,   nominal: 0.078, deducao: 5940 },
        { limite: 720000,   nominal: 0.1,   deducao: 13860 },
        { limite: 1800000,  nominal: 0.112, deducao: 22500 },
