---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20usei%20o%20simulador%20de%20regime%20tribut%C3%A1rio%20e%20gostaria%20de%20conversar%20com%20um%20especialista%20da%20JMF.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Simulador de Regime Tributário 2026 — Simples Nacional vs Lucro Presumido",
  "description": "Compare Simples Nacional e Lucro Presumido: calcule impostos com base no seu faturamento, atividade e folha de pagamento. Ferramenta gratuita.",
  "url": "https://www.jmfcontabilidade.com.br/simulador-regime-tributario",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "BRL" },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization"
  }
});
---

<Layout
  title="Simulador de Regime Tributário 2026 — Simples Nacional vs Lucro Presumido | JMF"
  description="Compare Simples Nacional e Lucro Presumido 2026: simule impostos com base no seu faturamento, atividade e folha. Descubra qual regime paga menos. Gratuito."
  canonical="https://www.jmfcontabilidade.com.br/simulador-regime-tributario"
  ogUrl="https://www.jmfcontabilidade.com.br/simulador-regime-tributario"
  schema={schema}
  heroInterno
>

  <HeroInterno
    title="Simulador de Regime Tributário 2026"
    subtitle="Compare Simples Nacional e Lucro Presumido com base no seu faturamento, atividade e folha de pagamento. Veja qual regime paga menos imposto."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Ferramentas" },
      { label: "Simulador de Regime Tributário" }
    ]}
    ctas={[
      { label: "Simular agora", href: "#simulador", variant: "cta" },
      { label: "Falar com contador", href: WA, variant: "outline" }
    ]}
  />

  <!-- AVISO -->
  <div class="bg-amber-50 border-b border-amber-200 py-2.5 px-4">
    <div class="container mx-auto text-xs text-amber-800 text-center">
      <i class="bi bi-info-circle mr-1"></i>
      Simulação para fins de orientação. Resultados variam conforme CNAE, estado, município e particularidades da empresa. Confirme com seu contador.
    </div>
  </div>

  <!-- SIMULADOR -->
  <section id="simulador" class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">

        <!-- FORMULÁRIO -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 mb-8">
          <h2 class="text-xl font-bold text-[#0f172a] mb-6 flex items-center gap-2">
            <span class="w-8 h-8 bg-[#dbeafe] rounded-full flex items-center justify-center text-[#1e40af] font-black text-sm">1</span>
            Dados da empresa
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

            <!-- Faturamento anual -->
            <div>
              <label for="faturamento" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Faturamento anual estimado (R$)
                <span class="text-red-400">*</span>
              </label>
              <input
                id="faturamento"
                type="text"
                inputmode="numeric"
                placeholder="Ex: 500.000,00"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-[#0f172a] focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent text-sm"
              />
              <p class="text-xs text-gray-400 mt-1">Limite Simples Nacional: R$ 4.800.000/ano</p>
            </div>

            <!-- Atividade principal -->
            <div>
              <label for="atividade" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Tipo de atividade
                <span class="text-red-400">*</span>
              </label>
              <select
                id="atividade"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-[#0f172a] focus:outline-none focus:ring-2 focus:ring-[#1e40af] bg-white text-sm"
              >
                <option value="">Selecione a atividade principal</option>
                <optgroup label="Comércio">
                  <option value="comercio_varejo">Comércio varejista (produtos em geral)</option>
                  <option value="comercio_atacado">Comércio atacadista</option>
                </optgroup>
                <optgroup label="Serviços">
                  <option value="servicos_anexo3">Serviços — Anexo III (TI, academias, manutenção)</option>
                  <option value="servicos_anexo5">Serviços — Anexo V (consultoria, engenharia, publicidade)</option>
                  <option value="servicos_anexo6">Serviços — Anexo VI (medicina, odonto, advocacia, contabilidade)</option>
                  <option value="servicos_32">Serviços — Lucro Presumido 32% (consultoria, corretagem)</option>
                </optgroup>
                <optgroup label="Indústria">
                  <option value="industria">Indústria / Fabricação</option>
                </optgroup>
                <optgroup label="Transporte">
                  <option value="transporte_cargas">Transporte de cargas</option>
                  <option value="transporte_passageiros">Transporte de passageiros</option>
                </optgroup>
              </select>
            </div>

            <!-- Folha de pagamento mensal -->
            <div>
              <label for="folha" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Folha de pagamento mensal (R$)
                <span class="text-xs font-normal text-gray-400 ml-1">pró-labore + salários + encargos</span>
              </label>
              <input
                id="folha"
                type="text"
                inputmode="numeric"
                placeholder="Ex: 15.000,00"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-[#0f172a] focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent text-sm"
              />
              <p class="text-xs text-gray-400 mt-1">Usado para calcular o Fator R (Simples Nacional serviços)</p>
            </div>

            <!-- Margem de lucro -->
            <div>
              <label for="margem" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Margem de lucro real estimada (%)
                <span class="text-xs font-normal text-gray-400 ml-1">sobre o faturamento</span>
              </label>
              <div class="relative">
                <input
                  id="margem"
                  type="number"
                  min="1"
                  max="99"
                  placeholder="Ex: 25"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 pr-10 text-[#0f172a] focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent text-sm"
                />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-semibold">%</span>
              </div>
              <p class="text-xs text-gray-400 mt-1">Influencia a vantagem do Lucro Presumido (IRPJ/CSLL sobre presunção)</p>
            </div>

          </div>

          <button
            id="btn-simular"
            class="mt-6 w-full md:w-auto px-10 py-4 bg-[#1e40af] text-white font-bold rounded-xl hover:bg-[#1e3a8a] transition-colors text-base flex items-center justify-center gap-2 disabled:opacity-50"
          >
            <i class="bi bi-calculator-fill"></i>
            Simular agora
          </button>
        </div>

        <!-- RESULTADO (oculto até calcular) -->
        <div id="resultado" class="hidden">

          <!-- Cabeçalho do resultado -->
          <div id="resultado-header" class="rounded-2xl p-6 mb-6 text-center">
            <div class="text-sm font-semibold mb-1 opacity-80" id="resultado-label"></div>
            <div class="text-2xl font-black mb-1" id="resultado-titulo"></div>
            <div class="text-sm opacity-80" id="resultado-subtitulo"></div>
          </div>

          <!-- Cards de comparação -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

            <!-- Simples Nacional -->
            <div id="card-simples" class="bg-white rounded-2xl border-2 p-6 shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="font-bold text-[#0f172a] text-lg">Simples Nacional</h3>
                  <p class="text-xs text-gray-400" id="sn-anexo"></p>
                </div>
                <div id="sn-badge" class="text-xs font-bold px-3 py-1 rounded-full"></div>
              </div>
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">Alíquota efetiva</span>
                  <span class="font-bold text-[#0f172a]" id="sn-aliquota">—</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">DAS mensal estimado</span>
                  <span class="font-bold text-[#0f172a]" id="sn-das-mensal">—</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">Total anual (DAS)</span>
                  <span class="font-bold text-[#0f172a]" id="sn-total-anual">—</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-sm text-gray-600">Impostos incluídos</span>
                  <span class="text-xs text-gray-500 text-right" id="sn-impostos">IRPJ, CSLL, PIS, COFINS, CPP, ISS/ICMS</span>
                </div>
              </div>
              <div id="sn-nota" class="mt-3 text-xs text-amber-700 bg-amber-50 rounded-lg p-2 hidden"></div>
            </div>

            <!-- Lucro Presumido -->
            <div id="card-lp" class="bg-white rounded-2xl border-2 p-6 shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="font-bold text-[#0f172a] text-lg">Lucro Presumido</h3>
                  <p class="text-xs text-gray-400" id="lp-presuncao-label"></p>
                </div>
                <div id="lp-badge" class="text-xs font-bold px-3 py-1 rounded-full"></div>
              </div>
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">Carga total estimada</span>
                  <span class="font-bold text-[#0f172a]" id="lp-aliquota">—</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">Impostos mensais</span>
                  <span class="font-bold text-[#0f172a]" id="lp-mensal">—</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-600">Total anual</span>
                  <span class="font-bold text-[#0f172a]" id="lp-total-anual">—</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-sm text-gray-600">Impostos calculados</span>
                  <span class="text-xs text-gray-500 text-right" id="lp-impostos">IRPJ + CSLL + PIS + COFINS + INSS patronal</span>
                </div>
              </div>
              <div id="lp-nota" class="mt-3 text-xs text-blue-700 bg-blue-50 rounded-lg p-2 hidden"></div>
            </div>

          </div>

          <!-- Economia anual -->
          <div id="economia-box" class="bg-[#0f172a] rounded-2xl p-6 mb-6 text-white text-center hidden">
            <p class="text-sm font-semibold text-white/70 mb-1">Economia potencial ao ano</p>
            <p class="text-4xl font-black text-[#1e40af]" id="economia-valor">—</p>
            <p class="text-sm text-white/60 mt-1" id="economia-desc"></p>
          </div>

          <!-- Detalhamento LP -->
          <div id="detalhe-lp" class="bg-white rounded-2xl border border-gray-100 p-6 mb-6 shadow-sm hidden">
            <h4 class="font-bold text-[#0f172a] mb-4 flex items-center gap-2">
              <i class="bi bi-list-check text-[#1e40af]"></i>
              Detalhamento — Lucro Presumido
            </h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="lp-detalhes-grid"></div>
          </div>

          <!-- Observações importantes -->
          <div id="obs-box" class="bg-[#dbeafe] rounded-2xl p-6 mb-6">
            <h4 class="font-bold text-[#0f172a] mb-3 flex items-center gap-2">
              <i class="bi bi-lightbulb-fill text-[#1e40af]"></i>
              O que esta simulação não considera
            </h4>
            <ul class="text-sm text-gray-700 space-y-1.5" id="obs-lista"></ul>
          </div>

          <!-- CTA -->
          <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm text-center">
            <p class="text-[#0f172a] font-bold text-lg mb-2">Quer uma análise completa e personalizada?</p>
            <p class="text-gray-500 text-sm mb-4">A JMF faz a simulação real com os dados da sua empresa, considerando CNAE, estado, município e histórico fiscal.</p>
            <a href={WA} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 bg-[#1e40af] text-white font-bold rounded-xl hover:bg-[#1e3a8a] transition-colors">
              <i class="bi bi-whatsapp"></i>Falar com a JMF — análise gratuita
            </a>
          </div>

          <!-- Captura de e-mail após resultado -->
          <div
            class="bg-[#f8fafc] border border-gray-200 rounded-2xl p-5 mt-4"
            x-data="{ sent: false, error: false, loading: false }"
          >
            <p class="text-sm font-bold text-[#0f172a] mb-0.5">Receber este resultado por e-mail</p>
            <p class="text-xs text-gray-500 mb-3">Deixe seu contato e a JMF envia uma análise personalizada para a sua empresa.</p>
            <form
              x-show="!sent"
              action="https://formspree.io/f/xldnlbpk"
              method="POST"
              @submit.prevent="
                loading = true;
                fetch($el.action, { method: 'POST', body: new FormData($el), headers: { Accept: 'application/json' } })
                  .then(r => { if (r.ok) { sent = true; } else { error = true; } })
                  .catch(() => { error = true; })
                  .finally(() => { loading = false; });
              "
              class="flex flex-col sm:flex-row gap-2"
            >
              <input type="hidden" name="_subject" value="Lead via Simulador de Regime Tributário — JMF" />
              <label for="sim-name" class="sr-only">Seu nome</label>
              <input id="sim-name" type="text" name="name" placeholder="Seu nome" required
                class="flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e40af]" />
              <label for="sim-email" class="sr-only">Seu e-mail</label>
              <input id="sim-email" type="email" name="email" placeholder="Seu e-mail" required
                class="flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e40af]" />
              <button type="submit" :disabled="loading"
                class="px-5 py-2.5 bg-[#1e40af] text-white text-sm font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors disabled:opacity-60 whitespace-nowrap">
                <span x-show="!loading">Enviar</span>
                <span x-show="loading">Enviando...</span>
              </button>
            </form>
            <p x-show="error" class="mt-2 text-xs text-red-600">Erro ao enviar. Tente pelo WhatsApp.</p>
            <p x-show="sent" class="text-sm font-semibold text-green-700 flex items-center gap-2">
              <i class="bi bi-check-circle-fill"></i> Recebido! Em breve a JMF entrará em contato.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- EXPLICAÇÃO DOS REGIMES -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-2">Entenda os regimes</h2>
        <p class="text-gray-500 mb-10">Como funciona cada um e quando cada regime costuma ser mais vantajoso.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-[#f0f7ff] rounded-2xl p-6">
            <div class="w-12 h-12 bg-[#1e40af] rounded-xl flex items-center justify-center mb-4">
              <i class="bi bi-receipt text-white text-xl"></i>
            </div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-3">Simples Nacional</h3>
            <ul class="text-sm text-gray-700 space-y-2">
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#1e40af] flex-shrink-0 mt-0.5"></i>Pagamento unificado via DAS (8 impostos em uma guia)</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#1e40af] flex-shrink-0 mt-0.5"></i>Faturamento até R$ 4,8 milhões/ano</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#1e40af] flex-shrink-0 mt-0.5"></i>Obrigações acessórias simplificadas</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#1e40af] flex-shrink-0 mt-0.5"></i>Alíquota cresce com o faturamento (6% a 33%)</li>
              <li class="flex gap-2"><i class="bi bi-info-circle-fill text-amber-500 flex-shrink-0 mt-0.5"></i>Serviços de saúde, advocacia e contabilidade pagam mais (Anexo V/VI)</li>
            </ul>
            <div class="mt-4 p-3 bg-blue-50 rounded-lg text-xs text-[#1e40af] font-medium">
              Geralmente vantajoso para: comércio com margem baixa, serviços com muita folha de pagamento (Fator R ≥ 28%) e empresas em crescimento.
            </div>
          </div>

          <div class="bg-[#fff7ed] rounded-2xl p-6">
            <div class="w-12 h-12 bg-[#f97316] rounded-xl flex items-center justify-center mb-4">
              <i class="bi bi-graph-up text-white text-xl"></i>
            </div>
            <h3 class="font-bold text-[#0f172a] text-lg mb-3">Lucro Presumido</h3>
            <ul class="text-sm text-gray-700 space-y-2">
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#f97316] flex-shrink-0 mt-0.5"></i>IRPJ e CSLL incidem sobre percentual presumido do faturamento</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#f97316] flex-shrink-0 mt-0.5"></i>PIS 0,65% + COFINS 3% (cumulativo)</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#f97316] flex-shrink-0 mt-0.5"></i>INSS patronal separado (20% sobre folha)</li>
              <li class="flex gap-2"><i class="bi bi-check-circle-fill text-[#f97316] flex-shrink-0 mt-0.5"></i>Sem limite de faturamento (exceto Lucro Real)</li>
              <li class="flex gap-2"><i class="bi bi-info-circle-fill text-amber-500 flex-shrink-0 mt-0.5"></i>Mais obrigações acessórias: ECD, ECF, SPED</li>
            </ul>
            <div class="mt-4 p-3 bg-orange-50 rounded-lg text-xs text-[#f97316] font-medium">
              Geralmente vantajoso para: serviços com alta margem e folha baixa, empresas próximas ao limite do Simples, e atividades vedadas no Simples.
            </div>
          </div>
        </div>

        <!-- Tabela de presunção LP -->
        <div class="mt-8 bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <div class="bg-[#0f172a] px-6 py-4">
            <h3 class="text-white font-bold">Percentuais de presunção — Lucro Presumido 2026</h3>
            <p class="text-white/60 text-xs mt-0.5">Base de cálculo do IRPJ e CSLL conforme atividade</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-700">Atividade</th>
                  <th class="p-3 text-center font-semibold text-gray-700">IRPJ (%)</th>
                  <th class="p-3 text-center font-semibold text-gray-700">CSLL (%)</th>
                  <th class="p-3 text-center font-semibold text-gray-700">IRPJ efetivo</th>
                  <th class="p-3 text-center font-semibold text-gray-700">CSLL efetiva</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                {[
                  { ativ: "Comércio varejista e atacado", irpj: 8, csll: 12, irpjEf: "1,20%", csllEf: "1,08%" },
                  { ativ: "Transporte de cargas", irpj: 8, csll: 12, irpjEf: "1,20%", csllEf: "1,08%" },
                  { ativ: "Indústria e fabricação", irpj: 8, csll: 12, irpjEf: "1,20%", csllEf: "1,08%" },
                  { ativ: "Transporte de passageiros", irpj: 16, csll: 12, irpjEf: "2,40%", csllEf: "1,08%" },
                  { ativ: "Serviços em geral (TI, manutenção)", irpj: 32, csll: 32, irpjEf: "4,80%", csllEf: "2,88%" },
                  { ativ: "Consultoria, corretagem, publicidade", irpj: 32, csll: 32, irpjEf: "4,80%", csllEf: "2,88%" },
                  { ativ: "Medicina, odonto, advocacia", irpj: 32, csll: 32, irpjEf: "4,80%", csllEf: "2,88%" },
                ].map((r, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
                    <td class="p-3 text-gray-700">{r.ativ}</td>
                    <td class="p-3 text-center font-semibold text-[#0f172a]">{r.irpj}%</td>
                    <td class="p-3 text-center font-semibold text-[#0f172a]">{r.csll}%</td>
                    <td class="p-3 text-center text-gray-500">{r.irpjEf}</td>
                    <td class="p-3 text-center text-gray-500">{r.csllEf}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-gray-400 p-3 border-t border-gray-50">IRPJ alíquota: 15% + adicional 10% sobre IRPJ que exceder R$ 60.000/trimestre. CSLL alíquota: 9%.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <div class="w-16 h-16 bg-[#1e40af] rounded-full flex items-center justify-center mx-auto mb-6">
        <i class="bi bi-graph-up-arrow text-white text-2xl"></i>
      </div>
      <h2 class="text-3xl font-bold text-white mb-4">Simulação não substitui análise real</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        A escolha do regime tributário depende do CNAE exato, do município (ISS), do histórico fiscal e de estratégias como distribuição de lucros e pró-labore. A JMF faz essa análise completa — de graça, antes de qualquer contrato.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#1e40af] text-white font-bold rounded-xl hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp"></i>Falar com especialista — gratuito
      </a>
    </div>
  </section>

  <script>
  // ─────────────────────────────────────────────────────────────────
