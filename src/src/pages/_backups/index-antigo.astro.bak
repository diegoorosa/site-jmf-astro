---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Parceiros from '../components/Parceiros.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.jmfcontabilidade.com.br/#website",
    "url": "https://www.jmfcontabilidade.com.br",
    "name": "JMF Contabilidade",
    "inLanguage": "pt-BR",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://www.jmfcontabilidade.com.br/blog?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": ["AccountingService", "LocalBusiness"],
    "@id": "https://www.jmfcontabilidade.com.br/#organization",
    "name": "JMF Contabilidade",
    "legalName": "JMF Contabilidade Empresarial e Fiscal Ltda",
    "taxID": "81.335.895/0001-17",
    "identifier": { "@type": "PropertyValue", "name": "CRC", "value": "SC-002550/O" },
    "url": "https://www.jmfcontabilidade.com.br",
    "logo": { "@type": "ImageObject", "url": "https://www.jmfcontabilidade.com.br/assets/images/jmf-contabilidade-jean-254x159.webp" },
    "description": "Escritório de contabilidade em Blumenau, Santa Catarina com mais de 35 anos de mercado. Especialistas em Simples Nacional, Lucro Presumido e abertura de empresas.",
    "telephone": "+55-47-3326-5123",
    "email": "contato@jmfcontabilidade.com.br",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Rodolfo Freygang, 15, Sala 506, Edifício Itaçú, Centro",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "postalCode": "89010-060",
      "addressCountry": "BR"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": -26.92016, "longitude": -49.06705 },
    "foundingDate": "1989-05-24",
    "areaServed": [
      { "@type": "City", "name": "Blumenau" },
      { "@type": "City", "name": "Indaial" },
      { "@type": "City", "name": "Gaspar" },
      { "@type": "City", "name": "Pomerode" },
      { "@type": "City", "name": "Timbó" },
      { "@type": "State", "name": "Santa Catarina" }
    ],
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday","Sunday"],
      "opens": "00:00",
      "closes": "00:00"
    }],
    "sameAs": [
      "https://www.facebook.com/jmfcontabilidadebnu/",
      "https://www.instagram.com/jmf.contabilidade/",
      "https://www.linkedin.com/company/jmf-contabilidade/",
      "https://twitter.com/jmfcontab",
      "https://maps.app.goo.gl/LzYJn5GURg5t5Lsa9",
      "https://www.yelp.com/biz/jmf-contabilidade-escrit%C3%B3rio-de-contabilidade-blumenau",
      "https://www.apontador.com.br/local/sc/blumenau/assessoria_contabil/6a43ca8942af5752cc2a601d/jmf_contabilidade.html"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": 5,
      "bestRating": 5,
      "worstRating": 1,
      "reviewCount": 152
    },
    "review": [
      { "@type": "Review", "author": { "@type": "Person", "name": "Bruno Schmitt Maes" }, "datePublished": "2026-05-28", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Contabilidade de confiança e atendimento personalizado. Sempre indico!" },
      { "@type": "Review", "author": { "@type": "Person", "name": "André Maciel Nuernberg" }, "datePublished": "2026-05-20", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Atendido pelo Diego, me salvou com o IRPF — tinha bastante informação solta e declarações antigas omissas. Foi o contador que conseguiu me regularizar com o sistema fiscal brasileiro." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Juliana Silva" }, "datePublished": "2026-04-30", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Faço meu imposto de renda com eles há alguns anos e sou sempre muito bem assessorada. São muito corretos e atenciosos." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Connie Faria" }, "datePublished": "2026-04-22", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Eu uso os serviços deles desde 2022 e estou muito satisfeita. São muito educados e profissionais brilhantes. Recomendo muito!!" },
      { "@type": "Review", "author": { "@type": "Person", "name": "Renato Duarte Simões Pires" }, "datePublished": "2026-05-26", "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }, "reviewBody": "Um profissional extremamente competente, organizado e sempre disposto a ajudar. Transmite muita confiança e segurança em cada orientação. Seu trabalho é impecável!" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Como funciona a troca de contador?", "acceptedAnswer": { "@type": "Answer", "text": "A troca de contador na JMF começa com um diagnóstico gratuito pelo WhatsApp ou telefone: levantamos o regime tributário atual da sua empresa, os meses em aberto, as obrigações acessórias pendentes (como SPED, ECD, DEFIS, DASN) e se há parcelamentos ou pendências na Receita Federal ou Sefaz. Com esse mapeamento, apresentamos um cronograma de transição com etapas e prazos claros. A JMF contata o contador anterior para solicitar os arquivos, backups e documentação necessária. Em paralelo, configuramos sua empresa em nossos sistemas e criamos o calendário de obrigações personalizado. Em média, o processo leva de 5 a 10 dias úteis para estar 100% operacional. Durante toda a transição, as obrigações acessórias e o fechamento mensal continuam sendo entregues dentro dos prazos sem interrupção. Você não precisa fazer nada além de assinar a procuração e nos fornecer os documentos básicos." } },
      { "@type": "Question", "name": "Vocês atendem Simples Nacional e Lucro Presumido?", "acceptedAnswer": { "@type": "Answer", "text": "Sim, a JMF Contabilidade atende empresas em todos os regimes tributários: Simples Nacional, Lucro Presumido e Lucro Real. Para empresas no Simples Nacional, calculamos o DAS mensalmente considerando o Anexo correto da atividade, o fator R quando aplicável e os sublimites de ISS e ICMS por estado. Para empresas próximas ao limite de faturamento anual (R$ 4,8 milhões), acompanhamos a evolução e planejamos a transição com antecedência. No Lucro Presumido, apuramos IRPJ e CSLL trimestralmente com base na margem de presunção correta para a atividade, além do PIS e COFINS mensais. Para o Lucro Real, estruturamos a apuração por LALUR e LACS, com controle de adições, exclusões e compensação de prejuízos fiscais. Em todos os regimes, você recebe um calendário de obrigações mensal personalizado e a JMF realiza anualmente a simulação comparativa entre regimes para garantir a menor carga tributária possível para o seu perfil de negócio." } },
      { "@type": "Question", "name": "Como funciona o envio de documentos e os prazos?", "acceptedAnswer": { "@type": "Answer", "text": "A JMF adota um fluxo de fechamento mensal padronizado e previsível. No início de cada mês, você recebe uma solicitação organizada com a lista de documentos necessários para aquele período: extratos bancários, notas fiscais de compra e venda, comprovantes de despesas, informações sobre folha de pagamento, pró-labore e eventuais movimentações específicas. O prazo para envio dos documentos é geralmente até o dia 5 do mês seguinte, o que nos permite realizar o fechamento contábil e fiscal dentro dos prazos legais. Tudo pode ser enviado por e-mail, WhatsApp ou através do nosso sistema de gestão — sem necessidade de deslocamento. Após o recebimento, nossa equipe realiza as conferências, apura os impostos e envia o resumo do mês: valor dos tributos, guias para pagamento, informações de folha e eventuais pontos de atenção. Em caso de divergências ou documentos faltantes, entramos em contato imediatamente para não atrasar o fechamento." } },
      { "@type": "Question", "name": "Quanto custa e quanto tempo leva para abrir uma empresa com a JMF?", "acceptedAnswer": { "@type": "Answer", "text": "O custo varia por tipo de empresa e atividade — normalmente entre R$ 900 e R$ 2.800 somando taxas oficiais e honorários, com o processo levando de 5 a 10 dias úteis em condições normais. A primeira conversa e a simulação de regime tributário são sempre gratuitas. Veja o detalhamento completo de custos e o passo a passo no nosso guia de abertura de empresa." } },
      { "@type": "Question", "name": "Vocês atendem clientes que não moram em Blumenau?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Atendemos pessoas físicas e empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, além de Blumenau. Documentos são enviados digitalmente por WhatsApp, e-mail ou sistema de gestão, e reuniões podem ser feitas por videoconferência — sem necessidade de deslocamento até o escritório." } }
    ]
  }
]);
---

<Layout
  title="JMF Contabilidade Blumenau | 35+ Anos | 152 Avaliações 5★"
  description="Escritório de contabilidade em Blumenau/SC com 35+ anos de experiência e 152 avaliações 5★ no Google. Simples Nacional, IRPF, abertura de empresa e planejamento tributário. Diagnóstico gratuito pelo WhatsApp."
  canonical="https://www.jmfcontabilidade.com.br/"
  ogUrl="https://www.jmfcontabilidade.com.br/"
  schema={schema}
>
  <!-- EXIT POPUP -->
  <div
    x-data="{ show: false }"
    x-init="
      document.addEventListener('mouseleave', (e) => {
        if (e.clientY <= 0 && !sessionStorage.getItem('popup_shown')) show = true;
      });
    "
    x-show="show"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4"
    @click.self="show=false; sessionStorage.setItem('popup_shown','1')"
    style="display:none"
  >
    <div class="relative max-w-sm w-full bg-white rounded-2xl shadow-2xl p-8 text-center">
      <button
        @click="show=false; sessionStorage.setItem('popup_shown','1')"
        class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center text-gray-400 hover:text-gray-700 transition-colors z-10"
        aria-label="Fechar"
      >
        <i class="bi bi-x-lg text-sm"></i>
      </button>
      <div class="w-14 h-14 bg-[#1e40af]/10 rounded-full flex items-center justify-center mx-auto mb-5">
        <i class="bi bi-whatsapp text-[#1e40af] text-2xl"></i>
      </div>
      <h3 class="text-lg font-bold text-[#0f172a] mb-2">Tem alguma dúvida?</h3>
      <p class="text-sm text-[#334155] mb-6 leading-relaxed">Fale agora com um especialista da JMF pelo WhatsApp. Resposta no mesmo dia útil.</p>
      <a href="https://wa.me/554733265123?text=Ol%C3%A1%2C%20estava%20no%20site%20da%20JMF%20e%20tenho%20uma%20d%C3%BAvida."
        target="_blank" rel="noopener noreferrer"
        @click="sessionStorage.setItem('popup_shown','1')"
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors duration-200">
        <i class="bi bi-whatsapp"></i>
        Falar no WhatsApp
      </a>
    </div>
  </div>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#0f172a] min-h-[92vh] flex items-center">
    <!-- Grade de linhas finas -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.14]" preserveAspectRatio="none">
      <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#3b82f6" stroke-width="1" />
      <line x1="8%" y1="22%" x2="100%" y2="22%" stroke="#3b82f6" stroke-width="1" />
      <line x1="34%" y1="0" x2="34%" y2="60%" stroke="#3b82f6" stroke-width="1" />
      <line x1="34%" y1="60%" x2="100%" y2="60%" stroke="#3b82f6" stroke-width="1" />
      <line x1="71%" y1="0" x2="71%" y2="100%" stroke="#3b82f6" stroke-width="1" />
      <line x1="0" y1="84%" x2="100%" y2="84%" stroke="#3b82f6" stroke-width="1" />
    </svg>

    <div class="relative z-10 container mx-auto px-4 py-28 md:py-32">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-3 mb-7">
          <span class="w-2 h-2 bg-blue-400"></span>
          <span class="text-blue-300 text-xs font-semibold tracking-[0.2em] uppercase" style="font-family:'Inter',sans-serif">35+ Anos de Mercado em Blumenau</span>
        </div>

        <h1 class="text-[2.6rem] md:text-6xl lg:text-7xl text-white tracking-tight leading-[1.05] mb-7" style="font-family:'Fraunces',serif;font-weight:500">
          Contabilidade que simplifica<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300" style="font-style:italic;font-weight:500">o caminho do seu negócio</span>
        </h1>

        <p class="text-lg md:text-xl text-white/55 leading-relaxed max-w-2xl mx-auto mb-10">
          Na JMF, você encontra método, prazos claros e orientação objetiva — sem burocracia, sem surpresas no fim do mês.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
          <a href={WA} target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-sm hover:bg-[#1e3a8a] transition-colors duration-200 text-lg">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/></svg>
            Fale com um Especialista
          </a>
          <a href="https://simulador.jmfcontabilidade.com.br/" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 px-8 py-4 border border-white/25 text-white/85 font-semibold rounded-sm hover:bg-white/5 hover:text-white transition-all duration-200 text-lg">
            Simular abertura de empresa
          </a>
        </div>

        <div class="inline-flex items-center gap-4 border-l border-blue-400/40 pl-4 text-left">
          <div class="flex items-center gap-1">
            <span class="text-white font-semibold text-sm">5.0</span>
            <div class="flex text-yellow-400 text-[11px]">★★★★★</div>
          </div>
          <span class="text-white/35 text-xs">152 avaliações no Google</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY STRIP -->
  <section class="bg-[#0f172a] border-t border-blue-400/15">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 max-w-5xl mx-auto divide-x divide-white/10">
        <div class="text-center py-8 md:py-10 px-2">
          <p class="text-3xl md:text-4xl text-white tracking-tight" style="font-family:'Fraunces',serif;font-weight:500">35+</p>
          <p class="text-white/40 text-xs uppercase tracking-wide mt-1">Anos de mercado</p>
        </div>
        <div class="text-center py-8 md:py-10 px-2">
          <p class="text-3xl md:text-4xl text-white tracking-tight" style="font-family:'Fraunces',serif;font-weight:500">152</p>
          <p class="text-white/40 text-xs uppercase tracking-wide mt-1">Avaliações 5.0 Google</p>
        </div>
        <div class="text-center py-8 md:py-10 px-2">
          <p class="text-3xl md:text-4xl text-white tracking-tight" style="font-family:'Fraunces',serif;font-weight:500">6</p>
          <p class="text-white/40 text-xs uppercase tracking-wide mt-1">Soluções contábeis</p>
        </div>
        <div class="text-center py-8 md:py-10 px-2">
          <p class="text-3xl md:text-4xl text-white tracking-tight" style="font-family:'Fraunces',serif;font-weight:500">100%</p>
          <p class="text-white/40 text-xs uppercase tracking-wide mt-1">Atendimento consultivo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS — ledger list -->
  <section id="servicos" class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mb-16">
        <span class="text-[#1e40af] text-xs font-semibold tracking-[0.2em] uppercase">Nossas Soluções</span>
        <h2 class="text-3xl md:text-4xl text-[#0f172a] tracking-tight mt-3 mb-4" style="font-family:'Fraunces',serif;font-weight:500">Tudo que sua empresa precisa, em um só lugar</h2>
        <p class="text-[#334155] text-lg">Da abertura ao fechamento mensal — cada serviço com método, prazo e responsável claro.</p>
      </div>

      <div class="max-w-4xl border-t border-[#0f172a]/12">
        {[
          { n: "01", title: "Abertura de Empresas", desc: "Abertura guiada do início ao fim, com escolha correta de CNAE e regime para reduzir custo e risco.", href: "/abertura-de-empresa" },
          { n: "02", title: "Consultoria e Planejamento Tributário", desc: "Planejamento legal para pagar o que é devido e evitar surpresas no caixa.", href: "/consultoria-e-planejamento-tributario" },
          { n: "03", title: "Gestão Contábil", desc: "Contabilidade organizada para fechamento mensal e decisão com clareza.", href: "/gestao-contabil" },
          { n: "04", title: "Gestão Pessoal", desc: "Departamento pessoal com rotina e conformidade para reduzir passivo trabalhista.", href: "/gestao-pessoal" },
          { n: "05", title: "Gestão Fiscal e Tributária", desc: "Fiscal no dia para você não correr risco por atraso ou apuração errada.", href: "/gestao-fiscal-e-tributaria" },
          { n: "06", title: "Imposto de Renda", desc: "Declaração com conferência e orientação para reduzir risco de inconsistência.", href: "/imposto-de-renda" },
          { n: "07", title: "Endereço Fiscal / Sede Virtual", desc: "Estrutura legal para o registro do seu CNPJ e Alvará sem os custos de um espaço físico, através de nossos parceiros estratégicos.", href: WA },
        ].map(s => (
          <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined} class="group grid grid-cols-[3rem_1fr] md:grid-cols-[4rem_1fr_2fr] gap-4 md:gap-8 items-start py-6 border-b border-[#0f172a]/12 hover:bg-[#1e40af]/[0.03] transition-colors px-2 -mx-2">
            <span class="text-[#1e40af]/50 text-sm pt-1" style="font-family:'Fraunces',serif">{s.n}</span>
            <h3 class="text-[#0f172a] text-lg md:text-xl font-semibold group-hover:text-[#1e40af] transition-colors">{s.title}</h3>
            <p class="text-[#334155] text-sm leading-relaxed md:pt-0.5 col-span-2 md:col-span-1">
              {s.desc} <span class="inline-flex items-center gap-1 text-[#0f172a] font-medium group-hover:gap-2 transition-all whitespace-nowrap">Saiba mais <i class="bi bi-arrow-right text-xs"></i></span>
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DIFERENCIAIS / COMO FUNCIONA -->
  <section class="py-24 bg-[#f8fafc]">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-[#1e40af] text-xs font-semibold tracking-[0.2em] uppercase">Como Funciona</span>
        <h2 class="text-3xl md:text-4xl text-[#0f172a] tracking-tight mt-3 mb-4" style="font-family:'Fraunces',serif;font-weight:500">Rotina mensal com previsibilidade</h2>
        <p class="text-[#334155] text-lg">Você sabe o que acontece, quando acontece e o que recebe. Sem improviso.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px max-w-5xl mx-auto bg-[#0f172a]/12 border border-[#0f172a]/12">
        <div class="bg-white p-8">
          <p class="text-[#1e40af] text-xs font-semibold tracking-[0.2em] uppercase mb-4">Ritual Mensal</p>
          <ul class="text-[#334155] text-sm space-y-2.5">
            <li class="flex items-start gap-2"><span class="text-[#1e40af] mt-1">—</span>Calendário de obrigações e prazos</li>
            <li class="flex items-start gap-2"><span class="text-[#1e40af] mt-1">—</span>Fluxo de documentos padronizado</li>
            <li class="flex items-start gap-2"><span class="text-[#1e40af] mt-1">—</span>Conferências e fechamento do mês</li>
            <li class="flex items-start gap-2"><span class="text-[#1e40af] mt-1">—</span>Resumo com impostos e pontos de atenção</li>
          </ul>
        </div>
        <div class="bg-white p-8">
          <p class="text-[#1e40af] text-xs font-semibold tracking-[0.2em] uppercase mb-4">O que você recebe</p>
          <ul class="text-[#334155] text-sm space-y-2.5">
