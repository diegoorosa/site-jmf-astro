---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Contabilidade para Pessoa Física",
  "provider": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
  "areaServed": [{ "@type": "City", "name": "Blumenau" },{ "@type": "City", "name": "Indaial" },{ "@type": "City", "name": "Gaspar" },{ "@type": "City", "name": "Pomerode" },{ "@type": "City", "name": "Timbó" },{ "@type": "State", "name": "Santa Catarina" }]
});
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Por que um profissional liberal precisa de contador?", "acceptedAnswer": { "@type": "Answer", "text": "Obrigações fiscais complexas: IRPF anual, Carnê-Leão mensal para quem recebe de PF, controle do livro-caixa e decisão sobre abrir PJ. Para faturamento acima de R$ 6 mil/mês, a PJ no Simples Nacional frequentemente reduz a carga tributária em 30% a 60% comparado à PF." } },
    { "@type": "Question", "name": "O que é o Carnê-Leão e quem precisa recolher?", "acceptedAnswer": { "@type": "Answer", "text": "Recolhimento mensal obrigatório do IRPF para quem recebe rendimentos de PF ou exterior sem retenção na fonte. Prazo: último dia útil do mês seguinte ao recebimento. Multa por atraso: 75% sobre o imposto devido mais juros SELIC. A JMF cuida do lançamento e recolhimento mensal." } },
    { "@type": "Question", "name": "Vale a pena abrir uma empresa (PJ) sendo profissional liberal?", "acceptedAnswer": { "@type": "Answer", "text": "Para a maioria com faturamento acima de R$ 5 mil/mês, sim. Como PF, alíquotas chegam a 27,5% + 20% INSS. Como PJ no Simples Nacional, entre 6% e 17,42%. Um profissional com R$ 10 mil/mês pode economizar entre R$ 800 e R$ 1.500 por mês. A JMF faz a simulação com seus números reais." } },
    { "@type": "Question", "name": "Como posso ter o auxílio da JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123, resposta no mesmo dia útil. Documentos por e-mail ou WhatsApp. Diagnóstico gratuito para análise de constituição de PJ. Presencial ou videoconferência, segunda a sexta 08h às 18h." } },
    { "@type": "Question", "name": "Atendem pessoa física de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade atende pessoas físicas e profissionais liberais de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com envio de documentos por e-mail ou WhatsApp e atendimento por videoconferência." } }
  ]
});
const schema = [serviceSchema, faqSchema];
---

<Layout
  title="Contabilidade para Pessoa Física em Blumenau/SC | JMF Contabilidade"
  description="Contabilidade para pessoa física em Blumenau/SC: IRPF, Carnê-Leão, profissionais liberais e autônomos. Maximize a restituição e evite a malha fina. JMF Contabilidade."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-para-pessoa-fisica"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-para-pessoa-fisica"
  schema={schema}
  heroInterno
>

  <HeroInterno
    title="Contabilidade para Pessoa Física em Blumenau/SC"
    subtitle="Um profissional liberal tem vários deveres mesmo como pessoa física, e para se manter resguardado, sem dificuldades com as entidades governamentais, é necessário contar com um contador."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Especialidades" },
      { label: "Contabilidade para Pessoa Física" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver vantagens", href: "#vantagens", variant: "outline" },
      { label: "Prefiro formulário", href: "#formulario", variant: "link" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: junho de 2026</span>
    </div>
  </div>

  <!-- Vantagens -->
  <section id="vantagens" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Confira as vantagens de contar com a nossa ajuda</h2>
        <p class="text-gray-600 text-lg">Temos as vantagens ideais para a sua proteção como pessoa física.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-file-text"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Declaração de Imposto de Renda</h4>
          <p class="text-gray-600">Elaboração completa e revisão da sua declaração, garantindo máxima economia dentro da lei.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-shield-check"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Proteção Assegurada à Pessoa Física</h4>
          <p class="text-gray-600">Mantemos você em conformidade com todas as obrigações fiscais, evitando problemas com a Receita Federal.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-person-check"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Atendimento Ágil e Individualizado</h4>
          <p class="text-gray-600">Cada cliente é único. Oferecemos soluções personalizadas com resposta no mesmo dia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Serviços para Profissionais Liberais -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Soluções completas para profissionais liberais</h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Médicos, dentistas, advogados, engenheiros, arquitetos, psicólogos e outros profissionais liberais precisam de uma assessoria contábil especializada para resolver as questões legais e fiscais da sua profissão.
          </p>
          <h5 class="font-semibold text-[#0f172a] mb-3 mt-4">Nossos serviços incluem:</h5>
          <ul class="text-gray-600 space-y-1 text-base leading-relaxed mb-6">
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Lançamento do livro-caixa (Carnê-Leão)</li>
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Apuração do ganho de capital na venda de bens</li>
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Elaboração e revisão de declarações de Imposto de Renda</li>
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Requerimento de alvarás e registro profissional</li>
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Gestão de empregados domésticos no eSocial</li>
            <li><i class="bi bi-check-circle text-[#1e40af] mr-2"></i>Planejamento tributário personalizado</li>
          </ul>
          <a href="#formulario"
            class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
            SOLICITE UMA CONSULTORIA
          </a>
        </div>
        <div class="lg:w-1/2">
          <img src="/assets/images/background1.webp" alt="Contabilidade para Profissionais Liberais"
            width="1900" height="1000" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Dark -->
  <section class="bg-[#0f172a] py-16">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <h2 class="text-3xl font-bold text-white mb-4">Esqueça-se dos trâmites burocráticos da sua vida profissional!</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Facilite agora a sua administração com uma contabilidade especializada em profissionais liberais e alcance de forma rápida a tranquilidade que você merece.
      </p>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors text-lg">
        <i class="bi bi-whatsapp mr-2"></i>AGENDE UMA REUNIÃO
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="text-[#1e40af]">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Por que um profissional liberal precisa de contador?</summary>
              <div class="accordion-body">
                <p>Um profissional liberal — médico, advogado, dentista, arquiteto — precisa de contador porque suas obrigações fiscais são complexas: além do IRPF anual, há o Carnê-Leão mensal obrigatório para quem recebe de pessoas físicas (com risco de multa de 75% sobre o imposto devido mais juros SELIC (podendo chegar a 150% em caso de fraude)), o controle do livro-caixa para deduzir despesas relacionadas à atividade, e a decisão estratégica sobre abrir ou não uma pessoa jurídica. Para profissionais com faturamento acima de R$ 6 mil/mês, a constituição de PJ no Simples Nacional frequentemente reduz a carga tributária em 30% a 60% comparado ao recolhimento como pessoa física. A JMF faz essa análise gratuitamente antes de qualquer proposta.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">O que é o Carnê-Leão e quem precisa recolher?</summary>
              <div class="accordion-body">
                <p>O Carnê-Leão é o recolhimento mensal obrigatório do IRPF que deve ser feito por toda pessoa física que recebe rendimentos de outras pessoas físicas ou do exterior sem retenção na fonte. Profissionais liberais autônomos — médicos que atendem em consultório próprio, advogados com honorários particulares, psicólogos e outros — estão obrigados. O prazo é até o último dia útil do mês seguinte ao recebimento. O não recolhimento gera multa de 75% sobre o imposto devido mais juros SELIC. A JMF cuida do lançamento e recolhimento mensal do Carnê-Leão, garantindo que você aproveite todas as deduções legais de despesas do consultório.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Vale a pena abrir uma empresa (PJ) sendo profissional liberal?</summary>
              <div class="accordion-body">
                <p>Para a maioria dos profissionais liberais com faturamento acima de R$ 5 mil/mês, a resposta é sim. Como pessoa física, as alíquotas do IRPF chegam a 27,5% sobre os rendimentos, mais 20% de INSS sem teto. Como PJ no Simples Nacional, uma clínica médica ou escritório de advocacia pode pagar entre 6% e 17,42% sobre o faturamento total (incluindo todos os tributos). Em termos práticos, um profissional com R$ 10 mil/mês de honorários pode economizar entre R$ 800 e R$ 1.500 por mês atuando como PJ versus PF. A JMF faz a simulação comparativa com os seus números reais, levando em conta o tipo de atividade, o regime de ISS do município de Blumenau e os custos fixos mensais da PJ.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como eu posso ter o auxílio da JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>Contratar os serviços da JMF para pessoa física em Blumenau é simples. Pelo WhatsApp (47) 3326-5123 nossa equipe responde no mesmo dia útil. Para a declaração de IRPF, você pode enviar os documentos digitalmente. Para profissionais liberais que desejam analisar a constituição de pessoa jurídica, a reunião de diagnóstico inicial é gratuita. Atendemos de segunda a sexta das 08h às 18h, presencialmente (Rua Rodolfo Freygang, 15, Sala 506, Centro, Blumenau) ou por videoconferência.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Atendem pessoa física de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade atende pessoas físicas e profissionais liberais de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí, com envio de documentos por e-mail ou WhatsApp e atendimento por videoconferência.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="formulario" class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-5/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-4">Entre em contato e vamos juntos fazer a diferença no seu negócio!</h2>
          <p class="text-gray-600 text-lg mb-6">Se você precisa de um parceiro estratégico em contabilidade, você encontrou o lugar certo. Entre em contato e marque uma consulta sem custo.</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-whatsapp text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">WhatsApp</p>
              <a href={WA} target="_blank" rel="noopener" class="text-[#1e40af] font-semibold">(47) 3326-5123</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e40af] flex items-center justify-center flex-shrink-0">
              <i class="bi bi-envelope text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-[#0f172a] text-sm">E-mail</p>
              <a href="mailto:contato@jmfcontabilidade.com.br" class="text-[#1e40af] font-semibold">contato@jmfcontabilidade.com.br</a>
            </div>
          </div>
        </div>
        <div class="lg:w-7/12">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
