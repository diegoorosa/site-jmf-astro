---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const WAsim = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20quero%20uma%20simula%C3%A7%C3%A3o%20tribut%C3%A1ria%20gratuita%20para%20minha%20empresa.";
const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Contabilidade para Empresas",
  "description": "Contabilidade completa para empresas em Blumenau/SC: Simples Nacional, Lucro Presumido e Lucro Real. Fechamento mensal, relatórios gerenciais e obrigações acessórias no prazo.",
  "provider": { "@type": "AccountingService", "name": "JMF Contabilidade", "@id": "https://www.jmfcontabilidade.com.br/#organization" },
  "areaServed": [{ "@type": "City", "name": "Blumenau" },{ "@type": "City", "name": "Indaial" },{ "@type": "City", "name": "Gaspar" },{ "@type": "City", "name": "Pomerode" },{ "@type": "City", "name": "Timbó" },{ "@type": "State", "name": "Santa Catarina" }]
});
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Por que a contabilidade é fundamental para o funcionamento das empresas?", "acceptedAnswer": { "@type": "Answer", "text": "A contabilidade registra movimentações financeiras, calcula impostos e fornece dados para decisões estratégicas. Sem contabilidade regular, empresas ficam expostas a autuações fiscais, processos trabalhistas e impossibilidade de participar de licitações públicas (que exigem CND atualizada)." } },
    { "@type": "Question", "name": "Como a contabilidade pode contribuir para o seu negócio?", "acceptedAnswer": { "@type": "Answer", "text": "Redução de impostos com planejamento tributário preventivo, decisões embasadas em DREs mensais, prevenção de erros com escrituração correta, crescimento estruturado com histórico contábil para financiamentos (BNDES/BADESC) e regularidade fiscal com certidões negativas para licitações." } },
    { "@type": "Question", "name": "Como a contabilidade especializada pode beneficiar o seu negócio?", "acceptedAnswer": { "@type": "Answer", "text": "O contador especializado se torna parceiro estrategico: identifica o regime tributário mais vantajoso (diferença de dezenas de milhares de reais por ano), estrutura relatórios de DRE e fluxo de caixa, e garante conformidade fiscal completa." } },
    { "@type": "Question", "name": "Como posso entrar em contato com a JMF Contabilidade?", "acceptedAnswer": { "@type": "Answer", "text": "WhatsApp (47) 3326-5123 com resposta no mesmo dia útil. Para troca de contabilidade, levantamento completo de obrigações pendentes sem custo. Formulário de contato no site com proposta em até 24 horas úteis. Presencial ou videoconferência, segunda a sexta 08h às 18h." } },
    { "@type": "Question", "name": "Vocês atendem empresas de Indaial, Gaspar, Pomerode e Timbó?", "acceptedAnswer": { "@type": "Answer", "text": "Sim. Além de Blumenau, a JMF Contabilidade atende empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí. O fechamento mensal e o envio de documentos são feitos digitalmente, sem necessidade de deslocamento até o escritório." } }
  ]
});
const schema = [serviceSchema, faqSchema];
---

<Layout
  title="Contabilidade para Empresas em Blumenau/SC | JMF Contabilidade"
  description="Contabilidade para empresas em Blumenau/SC: Simples Nacional, Lucro Presumido e Lucro Real. Fechamento mensal no prazo, relatórios claros. Mais de 35 anos de experiência."
  canonical="https://www.jmfcontabilidade.com.br/contabilidade-para-empresas"
  ogUrl="https://www.jmfcontabilidade.com.br/contabilidade-para-empresas"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Contabilidade para empresas em Blumenau com previsibilidade e fechamento mensal."
    subtitle="Rotina organizada para reduzir risco, cumprir prazos e deixar impostos e obrigações sob controle, com informação clara para decisão."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Especialidades" },
      { label: "Contabilidade para Empresas" }
    ]}
    ctas={[
      { label: "Falar no WhatsApp", href: WA, variant: "cta" },
      { label: "Ver vantagens", href: "#vantagens", variant: "outline" },
      { label: "Prefiro formulário", href: "#formulario", variant: "link" }
    ]}
  />

  <!-- Atualizado em -->
  <div class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-2 text-right">
      <span class="text-xs text-gray-400"><i class="bi bi-clock-history mr-1"></i>Atualizado em: junho de 2026</span>
    </div>
  </div>

  <!-- Para quem é -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-6 text-center">Para quem é a<br/><span class="pp3-grad">nossa contabilidade empresarial</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-2 flex items-center gap-2"><i class="bi bi-shop text-[#1e40af]"></i> Micro e pequenas empresas (ME/EPP)</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Se sua empresa fatura até R$ 4,8 milhões e precisa de uma contabilidade completa com entregas mensais no prazo, a JMF estrutura toda a rotina contábil, fiscal e trabalhista. Você recebe balancete, guias de impostos, folha de pagamento e certidões sem precisar cobrar — é entregue todo mês.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-2 flex items-center gap-2"><i class="bi bi-graph-up text-[#1e40af]"></i> Empresas em crescimento</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Empresas que estão saindo do MEI ou crescendo acima da média precisam de um contador que entenda de regime tributário <a href="/regimes-tributarios" class="text-[#1e40af] hover:underline font-semibold">comparativo (Simples Nacional vs Lucro Presumido)</a> e planejamento preventivo. A JMF faz a simulação anual de carga tributária para garantir que sua empresa nunca pague mais imposto do que deveria.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-2 flex items-center gap-2"><i class="bi bi-person-badge text-[#1e40af]"></i> Profissionais liberais e prestadores de serviço</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Médicos, dentistas, advogados, engenheiros, arquitetos, consultores e outros profissionais que querem organizar a contabilidade da sua clínica ou escritório e pagar menos impostos com a escolha correta entre PF e PJ — economia que pode chegar a 40% comparado ao IRPF.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-2 flex items-center gap-2"><i class="bi bi-arrow-left-right text-[#1e40af]"></i> Empresas trocando de contador</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Se você está insatisfeito com seu contador atual — atrasos, falta de comunicação, multas por obrigações perdidas — a JMF tem um processo de transição estruturado em 5 a 10 dias úteis. Fazemos o diagnóstico completo das pendências, contatamos o contador anterior e assumimos sem interromper sua rotina. Leia mais em <a href="/blog/troca-de-contador-quando-vale-e-como-fazer-sem-susto" class="text-[#1e40af] hover:underline">nosso guia de troca de contador</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vantagens -->
  <section id="vantagens" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Descubra as vantagens de<br/><span class="pp3-grad">ter o nosso suporte</span></h2>
        <p class="text-gray-600 text-lg">Oferecemos as soluções ideais para o sucesso do seu negócio.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-shield-check"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Sem Complicações</h4>
          <p class="text-gray-600">Cuidamos de toda a burocracia para você focar no que realmente importa: crescer seu negócio.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-graph-up-arrow"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Estratégia Fiscal</h4>
          <p class="text-gray-600">Planejamento tributário inteligente para reduzir legalmente a carga de impostos da sua empresa.</p>
        </div>
        <div class="card-custom text-center h-full">
          <div class="icon-circle"><i class="bi bi-calculator"></i></div>
          <h4 class="text-xl font-semibold text-[#0f172a] mb-3">Cobrança Justa</h4>
          <p class="text-gray-600">Transparência total nos custos. Você sabe exatamente pelo que está pagando.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contabilidade Eficiente -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Uma contabilidade eficiente<br/><span class="pp3-grad">para o seu empreendimento</span></h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-4">
            Ter uma contabilidade para o seu negócio de serviços, varejo e/ou produção é a chave para que você tenha mais lucro e mais economia.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Com a ajuda dos nossos especialistas qualificados, você assegura um atendimento personalizado que te orientará a atender todas as obrigações contábeis, fiscais e tributárias para que o seu negócio seja bem-sucedido.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={WA} target="_blank" rel="noopener"
              class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors">
              Falar no WhatsApp
            </a>
            <a href="#formulario"
              class="px-6 py-3 border-2 border-[#1e40af] text-[#1e40af] font-semibold rounded-lg hover:bg-white transition-colors">
              Prefiro formulário
            </a>
          </div>
        </div>
        <div class="lg:w-1/2">
          <img src="/assets/images/mbr-1-1036x691.webp" alt="Contabilidade para Empresas JMF"
            width="1036" height="691" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparativo de Regimes -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Qual o melhor regime tributário<br/><span class="pp3-grad">para a sua empresa?</span></h2>
        <p class="text-gray-600 text-lg">Comparativo rápido entre os três regimes mais utilizados</p>
      </div>
      <div class="overflow-x-auto rounded-xl shadow-lg">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="bg-[#1e40af] text-white p-4 text-left">Critério</th>
              <th class="bg-[#2563eb] text-white p-4 text-left"><i class="bi bi-building mr-1"></i>Simples Nacional</th>
              <th class="bg-[#ea580c] text-white p-4 text-left"><i class="bi bi-graph-up mr-1"></i>Lucro Presumido</th>
              <th class="bg-[#15803d] text-white p-4 text-left"><i class="bi bi-calculator mr-1"></i>Lucro Real</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="bg-white">
              <td class="p-4 font-semibold text-[#0f172a]">Limite de Faturamento</td>
              <td class="p-4 text-gray-700">Até <strong>R$ 4,8 milhões/ano</strong></td>
              <td class="p-4 text-gray-700">Até <strong>R$ 78 milhões/ano</strong></td>
              <td class="p-4 text-gray-700"><strong>Sem limite</strong></td>
            </tr>
            <tr class="bg-gray-50">
              <td class="p-4 font-semibold text-[#0f172a]">Base de Cálculo</td>
              <td class="p-4 text-gray-700">Receita bruta com alíquota unificada (DAS)</td>
              <td class="p-4 text-gray-700">Percentual presumido sobre receita (8% a 32%)</td>
              <td class="p-4 text-gray-700">Lucro contábil real apurado</td>
            </tr>
            <tr class="bg-white">
              <td class="p-4 font-semibold text-[#0f172a]">Complexidade</td>
              <td class="p-4 text-gray-700">Baixa — guia única (DAS)</td>
              <td class="p-4 text-gray-700">Média</td>
              <td class="p-4 text-gray-700">Alta — ECD, ECF, SPED</td>
            </tr>
            <tr class="bg-gray-50">
              <td class="p-4 font-semibold text-[#0f172a]">Melhor Para</td>
              <td class="p-4 text-gray-700">MPE com faturamento até R$ 4,8 mi</td>
              <td class="p-4 text-gray-700">Margem alta, faturamento médio</td>
              <td class="p-4 text-gray-700">Margem baixa, grandes empresas</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-6 p-4 bg-[#dbeafe] rounded-xl flex flex-col sm:flex-row items-center gap-4 justify-between">
        <p class="text-[#1e3a8a] font-semibold">Não sabe qual regime é o melhor para a sua empresa?</p>
        <a href={WAsim} target="_blank" rel="noopener"
          class="px-6 py-3 bg-[#1e40af] text-white font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors whitespace-nowrap">
          <i class="bi bi-whatsapp mr-2"></i>Quero a simulação gratuita
        </a>
      </div>
      <p class="text-center mt-3 text-sm text-gray-500">
        Guia completo: <a href="/regimes-tributarios" class="text-[#1e40af] hover:underline">Simples Nacional, Lucro Presumido ou Lucro Real — qual o melhor para sua empresa em Blumenau?</a>
        <span class="mx-2 text-gray-300">·</span>
        <a href="/simulador-regime-tributario" class="text-[#1e40af] hover:underline font-semibold">Simule agora →</a>
      </p>
    </div>
  </section>

  <!-- Por que empresas em Blumenau -->
  <section class="py-16 bg-[#f8fafc]">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-6">Contabilidade para empresas em Blumenau:<br/><span class="pp3-grad">o que muda quando você tem o parceiro certo</span></h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-5">
          Blumenau é hoje um dos maiores polos de serviços e tecnologia do Sul do Brasil. A cidade concentra mais de 1.500 empresas de TI e um comércio diversificado que vai de confecções a alimentos. Esse ecossistema tem características tributárias específicas — como o ISS municipal sobre serviços tecnológicos e as alíquotas de ICMS nas operações industriais — que exigem um contador com conhecimento do ambiente fiscal local.
        </p>
        <p class="text-gray-600 text-lg leading-relaxed mb-5">
          A JMF Contabilidade atua em Blumenau há mais de 35 anos. Conhecemos as particularidades da Sefaz-SC, as exigências da Prefeitura de Blumenau para emissão de NFS-e e os programas de incentivo disponíveis para empresas instaladas no município — informações que um escritório distante dificilmente teria.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8">
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-3 flex items-center gap-2"><i class="bi bi-calendar-check text-[#1e40af]"></i> Fechamento mensal até o dia 15</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Você recebe balancete, DRE e guias de impostos até o dia 15 de cada mês. Sem atraso, sem ligação cobrando documentos de última hora.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-3 flex items-center gap-2"><i class="bi bi-telephone text-[#1e40af]"></i> Resposta no mesmo dia útil</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Toda dúvida enviada até as 17h é respondida no mesmo dia útil. Para urgências, atendimento prioritário pelo WhatsApp com o contador responsável pela sua empresa.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-3 flex items-center gap-2"><i class="bi bi-bar-chart text-[#1e40af]"></i> Simulação tributária anual</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Todos os anos a JMF realiza uma simulação comparativa entre Simples Nacional, Lucro Presumido e Lucro Real para garantir que sua empresa pague o mínimo de impostos dentro da lei.</p>
          </div>
          <div class="bg-white rounded-xl border border-[#dbeafe] p-6">
            <h3 class="font-bold text-[#0f172a] mb-3 flex items-center gap-2"><i class="bi bi-file-earmark-check text-[#1e40af]"></i> Certidões sempre em dia</h3>
            <p class="text-gray-600 text-sm leading-relaxed">CND federal, estadual e municipal sempre disponíveis. Sua empresa pode participar de licitações e fechar contratos sem surpresas na hora H.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-start gap-10">
        <div class="lg:w-5/12">
          <img src="/assets/images/mbr-1036x624.webp" alt="Perguntas Frequentes - JMF Contabilidade"
            width="1036" height="624" class="rounded-xl shadow-lg w-full" loading="lazy" />
        </div>
        <div class="lg:w-7/12">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-8">
            Precisa de mais esclarecimentos?<br />
            <span class="pp3-grad">A nossa equipe pode fornecê-los</span>
          </h2>
          <div class="space-y-3">
            <details class="accordion-item">
              <summary class="accordion-summary">Por que a contabilidade é fundamental para o funcionamento das empresas?</summary>
              <div class="accordion-body">
                <p>A contabilidade é a espinha dorsal informacional de qualquer empresa — ela registra todas as movimentações financeiras, calcula os impostos devidos e fornece os dados que embasam as decisões mais críticas do negócio. Sem contabilidade regular, as empresas ficam expostas a autuações fiscais, processos trabalhistas e à impossibilidade de participar de licitações públicas — que exigem certidão negativa de débito (CND) atualizada. A JMF mantém sua empresa em conformidade e com relatórios financeiros mensais precisos, para que você tome decisões com dados reais e cresça com segurança no mercado de Blumenau.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como a contabilidade pode contribuir para o seu negócio?</summary>
              <div class="accordion-body">
                <p>Uma contabilidade especializada contribui de diversas formas concretas: na redução de impostos (planejamento tributário preventivo), na tomada de decisões (DREs mensais e análises de margem por produto/serviço), na prevenção de erros (escrituração correta evita autuações), no crescimento estruturado (histórico contábil confiável para financiamentos no BNDES/BADESC) e na regularidade fiscal (certidões negativas sempre disponíveis para licitações e contratos). A JMF entrega tudo isso para a sua empresa em Blumenau.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como a contabilidade especializada pode beneficiar o seu negócio?</summary>
              <div class="accordion-body">
                <p>O contador especializado da JMF oferece muito mais do que a simples entrega de declarações — ele se torna um parceiro estratégico. Na questão tributária, identificamos o regime de tributação mais vantajoso: a diferença entre o Simples Nacional, o Lucro Presumido e o Lucro Real pode ser de dezenas de milhares de reais por ano para uma mesma empresa. Na gestão financeira, estruturamos relatórios de DRE e fluxo de caixa que permitem ao empreendedor entender a rentabilidade real de cada produto ou serviço.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Como eu posso entrar em contato com a JMF Contabilidade?</summary>
              <div class="accordion-body">
                <p>Entrar em contato com a JMF Contabilidade em Blumenau é simples. A forma mais rápida é pelo WhatsApp (47) 3326-5123, onde nossa equipe responde no mesmo dia útil. Para empresas em processo de troca de contabilidade, realizamos um levantamento completo das obrigações pendentes sem custo. Você também pode usar o formulário de contato em nosso site e receber uma proposta personalizada por e-mail em até 24 horas úteis. Atendemos de segunda a sexta das 08h às 18h, presencialmente ou por videoconferência.</p>
              </div>
            </details>
            <details class="accordion-item">
              <summary class="accordion-summary">Vocês atendem empresas de Indaial, Gaspar, Pomerode e Timbó?</summary>
              <div class="accordion-body">
                <p>Sim. Além de Blumenau, a JMF Contabilidade atende empresas de Indaial, Gaspar, Pomerode, Timbó e demais cidades do Médio Vale do Itajaí. O fechamento mensal e o envio de documentos são feitos digitalmente, sem necessidade de deslocamento até o escritório.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos relacionados -->
  <section class="py-10 bg-[#f8fafc] border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <p class="text-sm font-semibold text-[#1e40af] uppercase tracking-wide mb-4">Do blog da JMF</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/blog/troca-de-contador-quando-vale-e-como-fazer-sem-susto"
