---
import Layout from '../layouts/Layout.astro';
import HeroInterno from '../components/HeroInterno.astro';
import '../styles/pages-p2.css';

const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20usei%20a%20Calculadora%20do%20Fator%20R%20no%20site%20da%20JMF%20e%20quero%20validar%20os%20resultados%20com%20um%20especialista.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calculadora do Fator R — Simples Nacional 2026",
  "description": "Calcule o Fator R da sua empresa e descubra se você está no Anexo III (6%) ou Anexo V (15,5%) do Simples Nacional. Ferramenta gratuita baseada na Resolução CGSN 140/2018.",
  "url": "https://www.jmfcontabilidade.com.br/calculadora-fator-r",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "BRL" },
  "provider": {
    "@type": "Organization",
    "name": "JMF Contabilidade",
    "@id": "https://www.jmfcontabilidade.com.br/#organization"
  }
});
---

<Layout
  title="Calculadora do Fator R — Simples Nacional 2026 | JMF Contabilidade Blumenau"
  description="Calcule o Fator R da sua empresa e descubra se você está no Anexo III (6%) ou Anexo V (15,5%) do Simples Nacional. Ferramenta gratuita com resultado imediato."
  canonical="https://www.jmfcontabilidade.com.br/calculadora-fator-r"
  ogUrl="https://www.jmfcontabilidade.com.br/calculadora-fator-r"
  schema={schema}
  heroInterno
  bodyClass="pp3"
>

  <HeroInterno
    title="Calculadora do Fator R"
    subtitle="Descubra se sua empresa está no Anexo III (6%) ou Anexo V (15,5%) do Simples Nacional — e quanto você pode economizar ajustando a folha de pagamento."
    breadcrumb={[
      { label: "Início", href: "https://www.jmfcontabilidade.com.br" },
      { label: "Ferramentas" },
      { label: "Calculadora do Fator R" }
    ]}
    ctas={[
      { label: "Calcular agora", href: "#calculadora", variant: "cta" },
      { label: "Falar com especialista", href: WA, variant: "outline" }
    ]}
  />

  <!-- CALCULADORA PRINCIPAL -->
  <section id="calculadora" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">

        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 bg-blue-50 text-[#1e40af] px-4 py-2 rounded-full text-sm font-semibold mb-4">
            <i class="bi bi-calculator"></i>
            Ferramenta Gratuita
          </div>
          <h2 class="text-3xl font-bold text-[#0f172a] mb-3">Calcule seu <span class="pp3-grad">Fator R agora</span></h2>
          <p class="text-gray-500 text-lg max-w-2xl mx-auto">
            Preencha os dados abaixo com a média dos últimos 12 meses. O resultado aparece automaticamente.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

          <!-- FORMULÁRIO -->
          <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
            <h3 class="font-bold text-[#0f172a] text-lg mb-6 flex items-center gap-2">
              <span class="w-8 h-8 bg-[#1e40af] text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
              Dados da empresa
            </h3>

            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="faturamento">
                Receita bruta mensal média — últimos 12 meses
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
                <input
                  type="text"
                  id="faturamento"
                  inputmode="numeric"
                  placeholder="15.000,00"
                  class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent transition-all"
                  autocomplete="off"
                />
              </div>
              <p class="mt-1 text-xs text-gray-400">Média do que sua empresa faturou por mês (total das notas fiscais emitidas)</p>
            </div>

            <div class="mb-5">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="prolabore">
                Pró-labore mensal — total dos sócios
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
                <input
                  type="text"
                  id="prolabore"
                  inputmode="numeric"
                  placeholder="5.000,00"
                  class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent transition-all"
                  autocomplete="off"
                />
              </div>
              <p class="mt-1 text-xs text-gray-400">Some o pró-labore declarado de todos os sócios. Se não há pró-labore, coloque 0</p>
            </div>

            <div class="mb-6">
              <label class="block text-sm font-semibold text-[#0f172a] mb-1.5" for="salarios">
                Salários brutos CLT mensais — total dos funcionários
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-sm">R$</span>
                <input
                  type="text"
                  id="salarios"
                  inputmode="numeric"
                  placeholder="0,00"
                  class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl text-[#0f172a] font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-[#1e40af] focus:border-transparent transition-all"
                  autocomplete="off"
                />
              </div>
              <p class="mt-1 text-xs text-gray-400">Total bruto de salários dos funcionários CLT. Se não há funcionários, deixe em 0</p>
            </div>

            <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-sm text-[#1e40af]">
              <i class="bi bi-info-circle mr-1.5"></i>
              <strong>Metodologia:</strong> A calculadora estima INSS patronal (20%) sobre pró-labore, e INSS patronal (20%) + FGTS (8%) + provisões de 13º e férias sobre salários CLT, conforme CGSN 140/2018. O resultado é uma estimativa orientativa.
            </div>
          </div>

          <!-- RESULTADO -->
          <div id="resultado-container" class="rounded-2xl border-2 border-dashed border-gray-200 p-8 flex flex-col items-center justify-center transition-all duration-500 min-h-96">

            <div id="estado-vazio" class="text-center">
              <div class="w-20 h-20 rounded-full bg-gray-50 border-2 border-gray-100 flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-calculator text-gray-300 text-3xl"></i>
              </div>
              <p class="text-gray-400 font-semibold text-lg">Preencha os dados ao lado</p>
              <p class="text-gray-300 text-sm mt-1">O resultado aparece aqui automaticamente</p>
            </div>

            <div id="estado-resultado" class="w-full" style="display:none">

              <!-- Fator R principal -->
              <div class="text-center mb-5">
                <p class="text-xs font-bold tracking-widest text-gray-400 mb-2">SEU FATOR R ESTIMADO</p>
                <div id="fator-r-display" class="text-6xl font-black leading-none mb-3 transition-all duration-300">—</div>

                <!-- Barra de progresso -->
                <div class="relative w-full h-4 bg-gray-100 rounded-full overflow-hidden mb-1">
                  <div id="barra-fator-r" class="absolute left-0 top-0 h-full rounded-full transition-all duration-700 ease-out" style="width:0%"></div>
                  <!-- Linha divisória em 28% -->
                  <div class="absolute top-0 bottom-0 border-l-2 border-dashed border-gray-500 z-10" style="left:28%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-400 px-0.5 mb-1">
                  <span>0%</span>
                  <span>50%</span>
                  <span>100%</span>
                </div>
                <div class="text-xs text-gray-500 text-center">Limite: <strong>28%</strong></div>
              </div>

              <!-- Diagnóstico -->
              <div id="diagnostico" class="rounded-xl p-4 mb-4 transition-all duration-300">
                <div class="flex items-start gap-3">
                  <span id="diagnostico-icon" class="text-2xl flex-shrink-0 mt-0.5"></span>
                  <div>
                    <h4 id="diagnostico-titulo" class="font-bold text-base mb-0.5"></h4>
                    <p id="diagnostico-texto" class="text-sm leading-relaxed"></p>
                  </div>
                </div>
              </div>

              <!-- Cards de DAS -->
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div id="card-atual" class="rounded-xl p-4 text-center border-2 transition-all duration-300">
                  <p id="card-atual-label" class="text-xs font-bold tracking-wide mb-1 opacity-70"></p>
                  <p id="card-atual-valor" class="text-xl font-black leading-tight"></p>
                  <p id="card-atual-aliquota" class="text-xs mt-1 opacity-60"></p>
                </div>
                <div id="card-alt" class="rounded-xl p-4 text-center border-2 border-dashed transition-all duration-300">
                  <p id="card-alt-label" class="text-xs font-bold tracking-wide mb-1 opacity-70"></p>
                  <p id="card-alt-valor" class="text-xl font-black leading-tight opacity-60"></p>
                  <p id="card-alt-aliquota" class="text-xs mt-1 opacity-50"></p>
                </div>
              </div>

              <!-- Economia -->
              <div id="economia-card" class="rounded-xl p-4 mb-4 transition-all duration-300" style="display:none">
                <div class="flex items-center gap-2 mb-1">
                  <i class="bi bi-piggy-bank-fill text-emerald-600 text-lg"></i>
                  <span id="economia-titulo" class="font-bold text-sm"></span>
                </div>
                <p id="economia-mensal" class="font-black text-xl"></p>
                <p id="economia-anual" class="text-xs mt-0.5 opacity-80"></p>
              </div>

              <!-- Botão WhatsApp -->
              <a href={WA} target="_blank" rel="noopener"
                class="block w-full text-center px-6 py-3.5 bg-[#f97316] text-white font-bold rounded-xl hover:bg-[#ea580c] transition-colors text-sm">
                <i class="bi bi-whatsapp mr-2"></i>Validar com especialista da JMF
              </a>

              <!-- Captura de e-mail após resultado -->
              <div
                class="mt-4 bg-[#f8fafc] border border-gray-200 rounded-xl p-4"
                x-data="{ sent: false, error: false, loading: false }"
              >
                <p class="text-xs font-bold text-[#0f172a] mb-0.5">Receber resultado por e-mail</p>
                <p class="text-xs text-gray-400 mb-2">A JMF envia uma análise completa do seu Fator R.</p>
                <form
                  x-show="!sent"
                  action="https://formspree.io/f/xldnlbpk"
                  method="POST"
                  @submit.prevent="
                    loading = true;
                    fetch($el.action, { method: 'POST', body: new FormData($el), headers: { Accept: 'application/json' } })
                      .then(r => { if (r.ok) { sent = true; } else { error = true; } })
                      .catch(() => { error = true; })
                      .finally(() => { loading = false; });
                  "
                  class="flex flex-col gap-2"
                >
                  <input type="hidden" name="_subject" value="Lead via Calculadora Fator R — JMF" />
                  <label for="calc-name" class="sr-only">Seu nome</label>
                  <input id="calc-name" type="text" name="name" placeholder="Seu nome" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-[#1e40af]" />
                  <label for="calc-email" class="sr-only">Seu e-mail</label>
                  <input id="calc-email" type="email" name="email" placeholder="Seu e-mail" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-[#1e40af]" />
                  <button type="submit" :disabled="loading"
                    class="w-full py-2 bg-[#1e40af] text-white text-xs font-semibold rounded-lg hover:bg-[#1e3a8a] transition-colors disabled:opacity-60">
                    <span x-show="!loading">Enviar</span>
                    <span x-show="loading">Enviando...</span>
                  </button>
                </form>
                <p x-show="error" class="mt-1 text-xs text-red-600">Erro. Tente pelo WhatsApp.</p>
                <p x-show="sent" class="text-xs font-semibold text-green-700 flex items-center gap-1">
                  <i class="bi bi-check-circle-fill"></i> Recebido! Em breve a JMF entra em contato.
                </p>
              </div>

            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- O QUE É FATOR R -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-4">O que é o <span class="pp3-grad">Fator R?</span></h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-6">
          O Fator R é um mecanismo do Simples Nacional que determina se empresas de serviços devem ser tributadas pelo <strong>Anexo III</strong> (alíquota inicial de 6%) ou pelo <strong>Anexo V</strong> (alíquota inicial de 15,5%). O resultado depende da proporção entre a folha de pagamento e o faturamento dos últimos 12 meses.
        </p>

        <div class="bg-white rounded-2xl p-6 mb-8 shadow-sm">
          <h3 class="font-bold text-[#0f172a] mb-4 text-center text-lg">A Fórmula do Fator R</h3>
          <div class="bg-[#f0f7ff] rounded-xl p-5 text-center mb-5">
            <p class="text-xs text-gray-500 mb-3 font-semibold tracking-wide">RESOLUÇÃO CGSN 140/2018 — ART. 19</p>
            <div class="text-lg font-bold text-[#1e40af] mb-1">
              Fator R = Folha de salários (últimos 12m) ÷ Receita bruta (últimos 12m)
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 text-center">
            <div class="bg-green-50 border border-green-200 rounded-xl p-4">
              <div class="text-3xl font-black text-green-700 mb-1">≥ 28%</div>
              <div class="font-bold text-green-800 text-lg">Anexo III</div>
              <div class="text-green-700 text-sm mt-1">Alíquota inicial: <strong>6%</strong></div>
            </div>
            <div class="bg-orange-50 border border-orange-200 rounded-xl p-4">
              <div class="text-3xl font-black text-orange-700 mb-1">&lt; 28%</div>
              <div class="font-bold text-orange-800 text-lg">Anexo V</div>
              <div class="text-orange-700 text-sm mt-1">Alíquota inicial: <strong>15,5%</strong></div>
            </div>
          </div>
        </div>

        <h3 class="text-xl font-bold text-[#0f172a] mb-3">O que compõe a folha de pagamento?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6">
          {[
            { incl: true, text: "Salários dos funcionários CLT" },
            { incl: true, text: "Pró-labore dos sócios" },
            { incl: true, text: "13º salário" },
            { incl: true, text: "Férias e 1/3 constitucional" },
            { incl: true, text: "INSS patronal (CPP)" },
            { incl: true, text: "FGTS dos funcionários CLT" },
            { incl: false, text: "Vale-transporte e vale-alimentação" },
            { incl: false, text: "Rescisões contratuais" },
          ].map(item => (
            <div class="flex items-center gap-2.5 bg-white rounded-lg p-3 text-sm shadow-sm">
              <i class={`${item.incl ? 'bi-check-circle-fill text-green-600' : 'bi-x-circle-fill text-red-400'} bi flex-shrink-0`}></i>
              <span class={item.incl ? 'text-gray-700' : 'text-gray-400 line-through'}>{item.text}</span>
              {item.incl
                ? <span class="ml-auto text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-semibold flex-shrink-0">Incluso</span>
                : <span class="ml-auto text-xs bg-red-50 text-red-400 px-2 py-0.5 rounded-full font-semibold flex-shrink-0">Não incluso</span>
              }
            </div>
          ))}
        </div>

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
          <i class="bi bi-exclamation-triangle-fill mr-2"></i>
          <strong>Importante:</strong> O Fator R usa os dados dos 12 meses anteriores ao mês de apuração (não o mês atual). Empresas com menos de 13 meses usam o período proporcional desde o início das atividades.
        </div>
      </div>
    </div>
  </section>

  <!-- TABELAS -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-[#0f172a] mb-2">Tabelas de <span class="pp3-grad">Alíquotas 2026</span></h2>
          <p class="text-gray-500">Tabelas vigentes conforme Lei Complementar 123/2006</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

          <!-- Anexo III -->
          <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
            <div class="bg-green-600 text-white p-4 flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                <i class="bi bi-arrow-down-circle-fill text-xl"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg">Anexo III</h3>
                <p class="text-green-100 text-xs">Fator R ≥ 28% — Serviços favorecidos</p>
              </div>
            </div>
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50">
                  <th class="p-3 text-left text-gray-500 font-semibold text-xs">Faturamento 12 meses</th>
                  <th class="p-3 text-center text-gray-500 font-semibold text-xs">Alíq. Nominal</th>
                  <th class="p-3 text-center text-gray-500 font-semibold text-xs">Parcela Ded.</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 180.000</td><td class="p-3 text-center font-bold text-green-700">6,00%</td><td class="p-3 text-center text-gray-400 text-xs">—</td></tr>
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 360.000</td><td class="p-3 text-center font-bold text-green-700">11,20%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 9.360</td></tr>
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 720.000</td><td class="p-3 text-center font-bold text-green-700">13,50%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 17.640</td></tr>
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 1.800.000</td><td class="p-3 text-center font-bold text-green-700">16,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 35.640</td></tr>
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 3.600.000</td><td class="p-3 text-center font-bold text-green-700">21,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 125.640</td></tr>
                <tr class="hover:bg-green-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 4.800.000</td><td class="p-3 text-center font-bold text-green-700">33,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 648.000</td></tr>
              </tbody>
            </table>
          </div>

          <!-- Anexo V -->
          <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
            <div class="bg-orange-500 text-white p-4 flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                <i class="bi bi-arrow-up-circle-fill text-xl"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg">Anexo V</h3>
                <p class="text-orange-100 text-xs">Fator R &lt; 28% — Alíquotas mais elevadas</p>
              </div>
            </div>
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50">
                  <th class="p-3 text-left text-gray-500 font-semibold text-xs">Faturamento 12 meses</th>
                  <th class="p-3 text-center text-gray-500 font-semibold text-xs">Alíq. Nominal</th>
                  <th class="p-3 text-center text-gray-500 font-semibold text-xs">Parcela Ded.</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 180.000</td><td class="p-3 text-center font-bold text-orange-700">15,50%</td><td class="p-3 text-center text-gray-400 text-xs">—</td></tr>
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 360.000</td><td class="p-3 text-center font-bold text-orange-700">18,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 4.500</td></tr>
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 720.000</td><td class="p-3 text-center font-bold text-orange-700">19,50%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 9.900</td></tr>
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 1.800.000</td><td class="p-3 text-center font-bold text-orange-700">20,50%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 17.100</td></tr>
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 3.600.000</td><td class="p-3 text-center font-bold text-orange-700">23,00%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 62.100</td></tr>
                <tr class="hover:bg-orange-50 transition-colors"><td class="p-3 text-gray-700">Até R$ 4.800.000</td><td class="p-3 text-center font-bold text-orange-700">30,50%</td><td class="p-3 text-center text-gray-500 text-xs">R$ 540.000</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <p class="text-center text-xs text-gray-400">
          Tabelas conforme Lei Complementar 123/2006 e Resolução CGSN 140/2018. Vigentes em 2026.
          Fórmula da alíquota efetiva: <strong>(RBT12 × Alíquota Nominal − Parcela a Deduzir) ÷ RBT12</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- EXEMPLO PRÁTICO -->
  <section class="py-16 bg-[#dbeafe]">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
