        </a>
      </div>
    </div>
  </section>

  <script>
  // ────────────────────────────────────────────────────────
  // CALCULADORA DO FATOR R — JMF Contabilidade
  // Legislação base: LC 123/2006 e CGSN 140/2018
  // ────────────────────────────────────────────────────────

  // Tabela Anexo III
  const ANEXO_III = [
    { limite: 180000,    nominal: 0.06,  deducao: 0 },
    { limite: 360000,    nominal: 0.112, deducao: 9360 },
    { limite: 720000,    nominal: 0.135, deducao: 17640 },
    { limite: 1800000,   nominal: 0.16,  deducao: 35640 },
    { limite: 3600000,   nominal: 0.21,  deducao: 125640 },
    { limite: 4800000,   nominal: 0.33,  deducao: 648000 },
  ];

  // Tabela Anexo V
  const ANEXO_V = [
    { limite: 180000,    nominal: 0.155, deducao: 0 },
    { limite: 360000,    nominal: 0.18,  deducao: 4500 },
    { limite: 720000,    nominal: 0.195, deducao: 9900 },
    { limite: 1800000,   nominal: 0.205, deducao: 17100 },
    { limite: 3600000,   nominal: 0.23,  deducao: 62100 },
    { limite: 4800000,   nominal: 0.305, deducao: 540000 },
  ];

  function getFaixa(rbt12, tabela) {
    for (const faixa of tabela) {
      if (rbt12 <= faixa.limite) return faixa;
    }
    return tabela[tabela.length - 1];
  }

  function getAliquotaEfetiva(rbt12, tabela) {
    if (rbt12 <= 0) return 0;
    const faixa = getFaixa(rbt12, tabela);
    return (rbt12 * faixa.nominal - faixa.deducao) / rbt12;
  }

  function parseBRL(str) {
    if (!str) return 0;
    const cleaned = str.replace(/\./g, '').replace(',', '.');
    const n = parseFloat(cleaned);
    return isNaN(n) ? 0 : n;
  }

  function formatBRL(value) {
    return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  function formatPct(value) {
    return value.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
  }

  function applyMask(input) {
    let v = input.value.replace(/\D/g, '');
    if (v === '') { input.value = ''; return; }
    const num = parseInt(v, 10) / 100;
    input.value = num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcular() {
    const faturamento = parseBRL(document.getElementById('faturamento').value);
    const prolabore   = parseBRL(document.getElementById('prolabore').value);
    const salarios    = parseBRL(document.getElementById('salarios').value);

    const vazio = document.getElementById('estado-vazio');
    const resultado = document.getElementById('estado-resultado');

    if (faturamento <= 0) {
      vazio.style.display = 'flex';
      resultado.style.display = 'none';
      document.getElementById('resultado-container').className =
        'rounded-2xl border-2 border-dashed border-gray-200 p-8 flex flex-col items-center justify-center transition-all duration-500 min-h-96';
      return;
    }

    // ── Cálculo da Folha com Encargos ──────────────────────
    // Pró-labore: + 20% INSS patronal (contribuinte individual)
    const folhaProlaboreComEncargos = prolabore * 1.20;

    // CLT: + 20% INSS patronal + 8% FGTS + 8,33% 13º + 11,11% férias+1/3
    // Total encargos sobre salário bruto CLT ≈ 47,44%
    const folhaCLTComEncargos = salarios * 1.4744;

    const folhaMensalComEncargos = folhaProlaboreComEncargos + folhaCLTComEncargos;

    // ── Fator R ────────────────────────────────────────────
    const receita12m = faturamento * 12;
    const folha12m   = folhaMensalComEncargos * 12;

    let fatorR;
    if (folha12m > 0 && receita12m <= 0) {
      fatorR = 0.28; // definição legislativa CGSN 140/2018
    } else if (folha12m <= 0 && receita12m > 0) {
      fatorR = 0.0;
    } else {
      fatorR = folha12m / receita12m;
    }

    const isAnexoIII = fatorR >= 0.28;
    const tabelaAtual = isAnexoIII ? ANEXO_III : ANEXO_V;
    const tabelaAlt   = isAnexoIII ? ANEXO_V   : ANEXO_III;

    const aliquotaAtual = getAliquotaEfetiva(receita12m, tabelaAtual);
    const aliquotaAlt   = getAliquotaEfetiva(receita12m, tabelaAlt);

    const dasMensalAtual = faturamento * aliquotaAtual;
    const dasMensalAlt   = faturamento * aliquotaAlt;
    const diferenca      = Math.abs(dasMensalAtual - dasMensalAlt);

    // ── Atualiza UI ────────────────────────────────────────
    vazio.style.display = 'none';
    resultado.style.display = 'block';

    // Container border color
    const container = document.getElementById('resultado-container');
    container.className = isAnexoIII
      ? 'rounded-2xl border-2 border-green-300 bg-green-50/30 p-8 flex flex-col justify-center transition-all duration-500 min-h-96'
      : 'rounded-2xl border-2 border-orange-300 bg-orange-50/30 p-8 flex flex-col justify-center transition-all duration-500 min-h-96';

    // Fator R display
    const fatorRDisplay = document.getElementById('fator-r-display');
    fatorRDisplay.textContent = formatPct(fatorR * 100);
    fatorRDisplay.className = `text-6xl font-black leading-none mb-3 transition-all duration-300 ${isAnexoIII ? 'text-green-700' : 'text-orange-600'}`;

    // Barra de progresso (capped at 100% width = 100% Fator R, mark at 28%)
    const barWidth = Math.min(fatorR * 100, 100);
    const barra = document.getElementById('barra-fator-r');
    barra.style.width = barWidth + '%';
    barra.className = `absolute left-0 top-0 h-full rounded-full transition-all duration-700 ease-out ${isAnexoIII ? 'bg-gradient-to-r from-[#16a34a] to-[#22c55e]' : 'bg-gradient-to-r from-[#f97316] to-[#fb923c]'}`;

    // Diagnóstico
    const diag = document.getElementById('diagnostico');
    const diagIcon = document.getElementById('diagnostico-icon');
    const diagTitulo = document.getElementById('diagnostico-titulo');
    const diagTexto = document.getElementById('diagnostico-texto');

    if (isAnexoIII) {
      diag.className = 'rounded-xl p-4 mb-4 bg-green-50 border border-green-200 transition-all duration-300';
      diagIcon.textContent = '✅';
      diagTitulo.textContent = 'Anexo III — Situação favorável';
      diagTitulo.className = 'font-bold text-base mb-0.5 text-green-800';
      diagTexto.textContent = `Seu Fator R de ${formatPct(fatorR * 100)} é igual ou superior a 28%. Sua empresa está no Anexo III, com alíquota efetiva de ${formatPct(aliquotaAtual * 100)}.`;
      diagTexto.className = 'text-sm leading-relaxed text-green-800';
    } else {
      diag.className = 'rounded-xl p-4 mb-4 bg-orange-50 border border-orange-200 transition-all duration-300';
      diagIcon.textContent = '⚠️';
      diagTitulo.textContent = 'Anexo V — Oportunidade de redução';
      diagTitulo.className = 'font-bold text-base mb-0.5 text-orange-800';
      if (folhaMensalComEncargos <= 0) {
        diagTexto.textContent = `Fator R de ${formatPct(fatorR * 100)}: sem pró-labore ou salários declarados. Aumentar o pró-labore pode elevar o Fator R acima de 28% e migrar para o Anexo III.`;
      } else {
        const prolaboreNecessario = Math.ceil((0.28 * receita12m - folha12m) / 12 / 1.20 + prolabore);
        diagTexto.textContent = `Fator R de ${formatPct(fatorR * 100)} — abaixo dos 28%. Estima-se que aumentar o pró-labore total para cerca de ${formatBRL(prolaboreNecessario)}/mês pode atingir o limite e migrar para o Anexo III.`;
      }
      diagTexto.className = 'text-sm leading-relaxed text-orange-800';
    }

    // Cards de DAS
    const cardAtualLabel = document.getElementById('card-atual-label');
    const cardAtualValor = document.getElementById('card-atual-valor');
    const cardAtualAliquota = document.getElementById('card-atual-aliquota');
    const cardAtual = document.getElementById('card-atual');

    const cardAltLabel = document.getElementById('card-alt-label');
    const cardAltValor = document.getElementById('card-alt-valor');
    const cardAltAliquota = document.getElementById('card-alt-aliquota');
    const cardAlt = document.getElementById('card-alt');

    if (isAnexoIII) {
      cardAtual.className = 'rounded-xl p-4 text-center border-2 border-green-200 bg-green-50 transition-all duration-300';
      cardAtualLabel.textContent = 'DAS MENSAL (ANEXO III)';
      cardAtualLabel.className = 'text-xs font-bold tracking-wide mb-1 text-green-700';
      cardAtualValor.textContent = formatBRL(dasMensalAtual);
      cardAtualValor.className = 'text-xl font-black leading-tight text-green-700';
      cardAtualAliquota.textContent = `Alíquota: ${formatPct(aliquotaAtual * 100)}`;
      cardAtualAliquota.className = 'text-xs mt-1 text-green-600';

      cardAlt.className = 'rounded-xl p-4 text-center border-2 border-dashed border-orange-200 bg-orange-50/40 transition-all duration-300';
      cardAltLabel.textContent = 'SE FOSSE ANEXO V';
      cardAltLabel.className = 'text-xs font-bold tracking-wide mb-1 text-orange-500';
      cardAltValor.textContent = formatBRL(dasMensalAlt);
      cardAltValor.className = 'text-xl font-black leading-tight text-orange-400';
      cardAltAliquota.textContent = `Alíquota: ${formatPct(aliquotaAlt * 100)}`;
      cardAltAliquota.className = 'text-xs mt-1 text-orange-400';
    } else {
      cardAtual.className = 'rounded-xl p-4 text-center border-2 border-orange-200 bg-orange-50 transition-all duration-300';
      cardAtualLabel.textContent = 'DAS MENSAL (ANEXO V)';
      cardAtualLabel.className = 'text-xs font-bold tracking-wide mb-1 text-orange-700';
      cardAtualValor.textContent = formatBRL(dasMensalAtual);
      cardAtualValor.className = 'text-xl font-black leading-tight text-orange-700';
      cardAtualAliquota.textContent = `Alíquota: ${formatPct(aliquotaAtual * 100)}`;
      cardAtualAliquota.className = 'text-xs mt-1 text-orange-600';

      cardAlt.className = 'rounded-xl p-4 text-center border-2 border-dashed border-green-200 bg-green-50/40 transition-all duration-300';
      cardAltLabel.textContent = 'POTENCIAL ANEXO III';
      cardAltLabel.className = 'text-xs font-bold tracking-wide mb-1 text-green-600';
      cardAltValor.textContent = formatBRL(dasMensalAlt);
      cardAltValor.className = 'text-xl font-black leading-tight text-green-600';
      cardAltAliquota.textContent = `Alíquota: ${formatPct(aliquotaAlt * 100)}`;
      cardAltAliquota.className = 'text-xs mt-1 text-green-500';
    }

    // Economia
    const economiaCard = document.getElementById('economia-card');
    const economiaTitulo = document.getElementById('economia-titulo');
    const economiaMensal = document.getElementById('economia-mensal');
    const economiaAnual = document.getElementById('economia-anual');

    if (diferenca > 0.5) {
      economiaCard.style.display = 'block';
      if (isAnexoIII) {
        economiaCard.className = 'rounded-xl p-4 mb-4 bg-green-50 border border-green-200 transition-all duration-300';
        economiaTitulo.textContent = 'Economia mensal no Anexo III';
        economiaTitulo.className = 'font-bold text-sm text-green-700';
        economiaMensal.textContent = `${formatBRL(diferenca)}/mês`;
        economiaMensal.className = 'font-black text-xl text-green-700';
        economiaAnual.textContent = `${formatBRL(diferenca * 12)} por ano em comparação com o Anexo V`;
        economiaAnual.className = 'text-xs mt-0.5 text-green-600';
      } else {
        economiaCard.className = 'rounded-xl p-4 mb-4 bg-amber-50 border border-amber-200 transition-all duration-300';
        economiaTitulo.textContent = 'Você poderia economizar migrando para o Anexo III';
        economiaTitulo.className = 'font-bold text-sm text-amber-800';
        economiaMensal.textContent = `${formatBRL(diferenca)}/mês`;
        economiaMensal.className = 'font-black text-xl text-amber-800';
        economiaAnual.textContent = `${formatBRL(diferenca * 12)} por ano — fale com a JMF para analisar como ajustar o pró-labore`;
        economiaAnual.className = 'text-xs mt-0.5 text-amber-700';
      }
    } else {
      economiaCard.style.display = 'none';
    }
  }

  // Inputs com máscara BRL
  const inputs = ['faturamento', 'prolabore', 'salarios'];
  inputs.forEach(id => {
    const el = document.getElementById(id);
    el.addEventListener('input', () => { applyMask(el); calcular(); });
    el.addEventListener('paste', () => { setTimeout(() => { applyMask(el); calcular(); }, 0); });
  });
  </script>

