---
const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
---

<div
  class="flex md:hidden fixed bottom-0 inset-x-0 z-40"
  style="padding-bottom: env(safe-area-inset-bottom, 0px); display:none"
  x-data="{ show: false }"
  x-init="
    const onScroll = () => { show = window.scrollY > 400 };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  "
  x-show="show"
>
  <a href="tel:+554733265123"
    class="flex-1 flex items-center justify-center gap-2 bg-[#0f172a] text-white font-semibold text-sm py-3.5">
    <i class="bi bi-telephone-fill"></i> Ligar
  </a>
  <a href={WA} target="_blank" rel="noopener noreferrer"
    class="flex-1 flex items-center justify-center gap-2 bg-[#25d366] text-white font-semibold text-sm py-3.5">
    <i class="bi bi-whatsapp"></i> WhatsApp
  </a>
</div>
