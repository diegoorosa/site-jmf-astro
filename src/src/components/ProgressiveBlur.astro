---
const GRADIENT_ANGLES = {
  top: 0,
  right: 90,
  bottom: 180,
  left: 270,
};

const {
  direction = 'bottom',
  blurLayers = 8,
  className = '',
  blurIntensity = 0.25,
} = Astro.props;

const layers = Math.max(blurLayers, 2);
const segmentSize = 1 / (blurLayers + 1);
const angle = GRADIENT_ANGLES[direction];
const isPositioned = /\b(absolute|fixed|sticky|relative)\b/.test(className);

const items = Array.from({ length: layers }, (_, index) => {
  const stops = [
    index * segmentSize,
    (index + 1) * segmentSize,
    (index + 2) * segmentSize,
    (index + 3) * segmentSize,
  ].map((pos, posIndex) => `rgba(255, 255, 255, ${posIndex === 1 || posIndex === 2 ? 1 : 0}) ${pos * 100}%`);

  return {
    gradient: `linear-gradient(${angle}deg, ${stops.join(', ')})`,
    blur: index * blurIntensity,
  };
});
---

<div class:list={[isPositioned ? '' : 'relative', 'pointer-events-none', className]}>
  {items.map((item) => (
    <div
      class="absolute inset-0 rounded-[inherit]"
      style={`mask-image:${item.gradient}; -webkit-mask-image:${item.gradient}; backdrop-filter:blur(${item.blur}px); -webkit-backdrop-filter:blur(${item.blur}px);`}
    />
  ))}
</div>
