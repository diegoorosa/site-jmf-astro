---
const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
---

<footer class="bg-[#0f172a] text-white pt-16 pb-[calc(80px+env(safe-area-inset-bottom,0px))] md:pb-6">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-10">

      <!-- Col 1: Logo -->
      <div>
        <img
          src="/assets/images/jmf-contabilidade-jean-397x249.webp"
          alt="JMF Contabilidade"
          width="397" height="249"
          class="max-w-[180px] mb-4"
          loading="lazy"
        />
      </div>

      <!-- Col 2: Navegação + Contato -->
      <div>
        <h5 class="text-white font-semibold mb-4 text-base">Navegação</h5>
        <ul class="space-y-2 mb-6">
          <li><a href="https://www.jmfcontabilidade.com.br" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Início</a></li>
          <li><a href="/sobre" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Sobre nós</a></li>
          <li><a href="/fale-conosco" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Contato</a></li>
          <li><a href="/blog" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Blog</a></li>
        </ul>

        <div class="space-y-2 text-sm">
          <div>
            <i class="bi bi-envelope mr-2 text-white/80"></i>
            <a href="mailto:contato@jmfcontabilidade.com.br" class="text-white/80 hover:text-white">contato@jmfcontabilidade.com.br</a>
          </div>
          <div>
            <i class="bi bi-whatsapp mr-2 text-white/80"></i>
            <a href={WA} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white">(47) 3326-5123</a>
          </div>
          <div class="flex gap-1">
            <i class="bi bi-geo-alt mr-2 text-white/80 mt-0.5 flex-shrink-0"></i>
            <a href="https://maps.app.goo.gl/MeVSo9QPre838yoHA" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white leading-relaxed">
              Rua Rodolfo Freygang, 15, Sala 506<br />
              Edifício Itaçú, Centro<br />
              Blumenau/SC — CEP: 89010-060
            </a>
          </div>
          <div>
            <i class="bi bi-clock mr-2 text-white/80"></i>
            <span class="text-white/75">Segunda a Sexta: 08:00 – 18:00</span>
          </div>
        </div>

        <!-- Mapa -->
        <div class="mt-4">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3557.4748768090267!2d-49.06704552461313!3d-26.92015599351466!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94df18c1c9a5ab59%3A0x813a374a25373e0b!2sJMF%20Contabilidade%20-%20Escrit%C3%B3rio%20de%20Contabilidade!5e0!3m2!1spt-BR!2sbr!4v1781225059891!5m2!1spt-BR!2sbr"
            width="100%" height="180"
            style="border:0;border-radius:8px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localização JMF Contabilidade"
          ></iframe>
        </div>

        <!-- Redes Sociais -->
        <div class="flex gap-3 mt-4">
          <a href="https://www.facebook.com/jmfcontabilidadebnu/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
             class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1e40af] transition-all hover:-translate-y-1">
            <i class="bi bi-facebook text-white"></i>
          </a>
          <a href="https://x.com/jmfcontab" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)"
             class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1e40af] transition-all hover:-translate-y-1">
            <i class="bi bi-twitter text-white"></i>
          </a>
          <a href="https://www.instagram.com/jmf.contabilidade/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
             class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1e40af] transition-all hover:-translate-y-1">
            <i class="bi bi-instagram text-white"></i>
          </a>
          <a href="https://www.linkedin.com/company/jmf-contabilidade/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
             class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1e40af] transition-all hover:-translate-y-1">
            <i class="bi bi-linkedin text-white"></i>
          </a>
        </div>
      </div>

      <!-- Col 3: Especialidades -->
      <div>
        <h5 class="text-white font-semibold mb-4 text-base">Especialidades</h5>
        <ul class="space-y-2">
          <li><a href="/contabilidade-para-empresas" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Contabilidade para Empresas</a></li>
          <li><a href="/contabilidade-para-pessoa-fisica" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Contabilidade para Pessoas Físicas</a></li>
        </ul>
      </div>

      <!-- Col 4: Soluções -->
      <div>
        <h5 class="text-white font-semibold mb-4 text-base">Soluções</h5>
        <ul class="space-y-2">
          <li><a href="/abertura-de-empresa" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Abertura de Empresa</a></li>
          <li><a href="/consultoria-e-planejamento-tributario" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Consultoria e Planejamento Tributário</a></li>
          <li><a href="/gestao-contabil" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Gestão Contábil</a></li>
          <li><a href="/gestao-fiscal-e-tributaria" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Gestão Fiscal e Tributária</a></li>
          <li><a href="/gestao-pessoal" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Gestão Pessoal</a></li>
          <li><a href="/imposto-de-renda" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Imposto de Renda</a></li>
        </ul>
      </div>

      <!-- Col 5: Ferramentas Gratuitas -->
      <div>
        <h5 class="text-white font-semibold mb-4 text-base">Ferramentas Gratuitas</h5>
        <ul class="space-y-2">
          <li><a href="/calculadora-fator-r" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Calculadora do Fator R</a></li>
          <li><a href="/calendario-fiscal-2026" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Calendário Fiscal 2026</a></li>
          <li><a href="/simulador-regime-tributario" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Simulador de Regime Tributário</a></li>
          <li><a href="/como-abrir-empresa-em-blumenau" class="text-white/80 hover:text-white hover:translate-x-1 inline-block transition-all text-sm">Guia: Como Abrir Empresa em Blumenau</a></li>
        </ul>
