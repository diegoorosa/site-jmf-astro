    </div>

    <!-- Copyright -->
    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-white/70 text-sm mb-1">© 2026 JMF Contabilidade Empresarial e Fiscal Ltda</p>
      <p class="text-white/70 text-xs mb-2">CRC SC-002550/O</p>
      <p class="text-white/70 text-xs"><a href="/politica-de-privacidade" class="hover:text-white underline">Política de Privacidade</a></p>
