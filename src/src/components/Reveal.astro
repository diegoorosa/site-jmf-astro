---
/**
 * Reveal.astro — anima entrada de elementos [data-reveal] via IntersectionObserver.
 * Import no Layout.astro (ou por página). Não faz nada se não houver alvos.
 * Respeita prefers-reduced-motion.
 */
---

<script is:inline>
  (function () {
    function initReveal() {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var els = document.querySelectorAll('[data-reveal]');
      var staggers = document.querySelectorAll('[data-reveal-stagger]');
      if (!els.length && !staggers.length) return;

      if (reduce) {
        els.forEach(function (el) { el.style.opacity = '1'; el.style.transform = 'none'; });
        staggers.forEach(function (el) {
          Array.prototype.forEach.call(el.children, function (c) { c.style.opacity = '1'; c.style.transform = 'none'; });
        });
        return;
      }

      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      els.forEach(function (el) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(28px)';
        el.style.transition = 'opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)';
        el.style.willChange = 'opacity, transform';
        obs.observe(el);
      });

      staggers.forEach(function (el) {
        var children = el.children;
        Array.prototype.forEach.call(children, function (c, i) {
          c.style.opacity = '0';
          c.style.transform = 'translateY(24px)';
          c.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
          c.style.transitionDelay = (i * 0.08) + 's';
        });
        var stagObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              Array.prototype.forEach.call(e.target.children, function (c) {
                c.style.opacity = '1';
                c.style.transform = 'translateY(0)';
              });
              stagObs.disconnect();
            }
          });
        }, { threshold: 0.1 });
        stagObs.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReveal);
    } else {
      initReveal();
    }
  })();
</script>
