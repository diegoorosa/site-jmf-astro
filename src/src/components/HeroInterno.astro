---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb: { label: string; href?: string }[];
  ctas?: { label: string; href: string; variant: 'cta' | 'outline' | 'link' }[];
}
const { title, subtitle, breadcrumb, ctas = [] } = Astro.props;
const WA = "https://wa.me/554733265123?text=Ol%C3%A1%2C%20conheci%20o%20site%20da%20JMF%20Contabilidade%20e%20quero%20mais%20informa%C3%A7%C3%B5es.";
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumb.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.label,
    ...(item.href ? { "item": item.href } : {})
  }))
});
---

<script type="application/ld+json" set:html={breadcrumbSchema} />
<section class="jmf-hero-int relative overflow-hidden bg-[#0a1628] py-28 md:py-36">
  <!-- Grade de linhas finas ciano (estilo P2) -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.18]" preserveAspectRatio="none">
    <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#67E8F9" stroke-width="1" />
    <line x1="8%" y1="32%" x2="100%" y2="32%" stroke="#67E8F9" stroke-width="1" />
    <line x1="38%" y1="0" x2="38%" y2="68%" stroke="#67E8F9" stroke-width="1" />
    <line x1="38%" y1="68%" x2="100%" y2="68%" stroke="#67E8F9" stroke-width="1" />
    <line x1="76%" y1="0" x2="76%" y2="100%" stroke="#67E8F9" stroke-width="1" />
    <line x1="0" y1="86%" x2="100%" y2="86%" stroke="#67E8F9" stroke-width="1" />
  </svg>
  <!-- Glow ciano no topo -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[40rem] h-40 bg-cyan-500/15 blur-3xl rounded-full pointer-events-none"></div>

  <div class="relative z-10 container mx-auto px-4 w-full">
    <div class="max-w-3xl mx-auto text-center" data-reveal>

      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-7">
        <ol class="flex flex-wrap justify-center gap-1.5 text-sm text-slate-400">
          {breadcrumb.map((item, i) => (
            <>
              {i > 0 && <li class="text-slate-600">›</li>}
              <li>
                {item.href
                  ? <a href={item.href} class="hover:text-cyan-300 transition-colors">{item.label}</a>
                  : <span class="text-cyan-300">{item.label}</span>
                }
              </li>
            </>
          ))}
        </ol>
      </nav>

      <h1 class="text-4xl md:text-5xl lg:text-6xl text-white tracking-tight leading-[1.05] mb-6" style="font-family:'Fraunces',serif;font-weight:500">{title}</h1>

      {subtitle && (
        <p class="text-white/60 text-lg md:text-xl mb-8 leading-relaxed max-w-2xl mx-auto">{subtitle}</p>
      )}

      {ctas.length > 0 && (
        <div class="flex flex-wrap gap-4 justify-center mt-8">
          {ctas.map(cta => (
            cta.variant === 'cta'
              ? <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined}
                   rel={cta.href.startsWith('http') ? 'noopener' : undefined}
                   class="group inline-flex items-center gap-2 px-7 py-3.5 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-semibold rounded-lg shadow-lg shadow-cyan-500/25 hover:shadow-cyan-400/40 hover:from-cyan-400 hover:to-cyan-500 transition-all duration-200">
                   {cta.label}
                   <i class="bi bi-arrow-right text-sm group-hover:translate-x-1 transition-transform"></i>
                 </a>
              : cta.variant === 'outline'
              ? <a href={cta.href} class="inline-flex items-center gap-2 px-7 py-3.5 border border-white/20 text-white/90 font-semibold rounded-lg hover:bg-white/5 hover:border-cyan-400/40 hover:text-white transition-all duration-200">{cta.label}</a>
              : <a href={cta.href} class="px-7 py-3 text-cyan-300/80 hover:text-cyan-200 underline underline-offset-4 transition-colors">{cta.label}</a>
          ))}
        </div>
      )}

    </div>
  </div>
</section>
