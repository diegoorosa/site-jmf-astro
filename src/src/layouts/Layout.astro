---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import Reveal from '../components/Reveal.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogUrl?: string;
  ogImage?: string;
  schema?: string | string[];
  bodyClass?: string;
  heroInterno?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogUrl,
  ogImage,
  schema,
  bodyClass = '',
  heroInterno = false,
  noindex = false,
} = Astro.props;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="JMF Contabilidade Blumenau" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage ?? "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.png"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={ogUrl ?? canonical ?? 'https://www.jmfcontabilidade.com.br/'} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@jmfcontab" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage ?? "https://www.jmfcontabilidade.com.br/assets/images/JMF-Logo-Open-Graph.png"} />

  <link rel="alternate" hreflang="pt-BR" href={canonical ?? 'https://www.jmfcontabilidade.com.br/'} />

  <link rel="preconnect" href="https://images.unsplash.com" />
  <link rel="preconnect" href="https://images.pexels.com" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />

  <link rel="stylesheet" href="/_astro/fonts.css" />

  <slot name="head" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />

  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Fonts (self-hosted via fontsource) -->

  <!-- Bootstrap Icons (self-hosted, defer) -->
  <link rel="stylesheet" href="/bi/bootstrap-icons.min.css" media="print" onload="this.media='all'" />

  <!-- JSON-LD Schemas -->
  {schemas.map(s => <script type="application/ld+json" set:html={s} />)}

  <noscript>
    <link rel="stylesheet" href="/bi/bootstrap-icons.min.css" />
  </noscript>

  <!-- Google Tag Manager (deferred to avoid main-thread blocking) -->
  <script defer>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T2Q7HGBD');</script>

  <!-- Google Ads Conversion Tag -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-1021062139"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-1021062139');
  </script>
</head>
<body class={`bg-white text-[#334155] ${bodyClass}`}>
  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T2Q7HGBD" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <Header />
  <slot />
  <Footer />
  <WhatsApp />
  <MobileCtaBar />
  <Reveal />

  <!-- Alpine.js -->
  <script>
    import Alpine from 'alpinejs';
    window.Alpine = Alpine;
    Alpine.start();
  </script>

  <!-- Smooth scroll -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
          const t = document.querySelector(a.getAttribute('href'));
          if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
      });
    });
  </script>

  <!-- WhatsApp conversion tracking -->
  <script>
    document.addEventListener('click', e => {
      const a = e.target.closest('a');
      if (a && /wa\.me|whatsapp/i.test(a.href)) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'clique_whatsapp',
          send_to: 'AW-1021062139/5ds-CMzY0rIbEPvX8OYD'
        });
      }
    }, true);
  </script>
</body>
</html>
